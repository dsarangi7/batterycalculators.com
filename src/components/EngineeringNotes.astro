---
export interface Note {
  topic: string;
  content: string;
}

export interface Props {
  title?: string;
  notes: Note[];
}

const {
  title = 'Engineering Considerations',
  notes,
} = Astro.props as Props;
---

<section class="mb-16 border-t border-hairline pt-12">
  <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">{title}</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {notes.map((note) => (
      <div class="bg-surface-soft border border-hairline p-5">
        <h4 class="text-primary font-bold text-sm mb-2 uppercase tracking-wider">{note.topic}</h4>
        <p class="text-body-sm text-muted font-light leading-relaxed">{note.content}</p>
      </div>
    ))}
  </div>
</section>
