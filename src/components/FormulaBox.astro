<!-- src/components/FormulaBox.astro -->
---
import { t, type Locale } from '../utils/i18n';

export interface Props {
  title?: string;
  lang?: Locale;
}

const { title, lang = 'en' } = Astro.props as Props;
const resolvedTitle = title || t('components.formula_box.default_title', lang);
---

<div class="min-w-0">
  <h2 class="text-title-lg text-primary uppercase mb-6 tracking-wider">{resolvedTitle}</h2>
  <div class="flex flex-col gap-4 text-body-sm text-muted">
    <slot />
  </div>
</div>
