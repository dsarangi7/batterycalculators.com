---
import { t, type Locale, getLocalePrefix } from '../utils/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props as Props;
const prefix = getLocalePrefix(lang);

const finderStrings = {
  title: t('components.calculator_finder.title', lang),
  subtitle: t('components.calculator_finder.subtitle', lang),
  step1Label: t('components.calculator_finder.step1_label', lang),
  step2Label: t('components.calculator_finder.step2_label', lang),
  back: t('components.calculator_finder.back', lang),
  resultsLabel: t('components.calculator_finder.results_label', lang),
  open: t('components.calculator_finder.open', lang),
  categorySolar: t('components.calculator_finder.category_solar', lang),
  categoryHomeBackup: t('components.calculator_finder.category_home_backup', lang),
  categoryRv: t('components.calculator_finder.category_rv', lang),
  categoryMarine: t('components.calculator_finder.category_marine', lang),
  categoryEv: t('components.calculator_finder.category_ev', lang),
  categoryBess: t('components.calculator_finder.category_bess', lang),
  categoryGeneral: t('components.calculator_finder.category_general', lang),
  goalSizingSolar: t('components.calculator_finder.goal_sizing_solar', lang),
  goalRuntimeSolar: t('components.calculator_finder.goal_runtime_solar', lang),
  goalChargingSolar: t('components.calculator_finder.goal_charging_solar', lang),
  goalDegradationSolar: t('components.calculator_finder.goal_degradation_solar', lang),
  goalSizingHome: t('components.calculator_finder.goal_sizing_home', lang),
  goalInverterHome: t('components.calculator_finder.goal_inverter_home', lang),
  goalRuntimeHome: t('components.calculator_finder.goal_runtime_home', lang),
  goalDegradationHome: t('components.calculator_finder.goal_degradation_home', lang),
  goalSizingRv: t('components.calculator_finder.goal_sizing_rv', lang),
  goalInverterRv: t('components.calculator_finder.goal_inverter_rv', lang),
  goalRuntimeRv: t('components.calculator_finder.goal_runtime_rv', lang),
  goalChargingRv: t('components.calculator_finder.goal_charging_rv', lang),
  goalSizingMarine: t('components.calculator_finder.goal_sizing_marine', lang),
  goalCableMarine: t('components.calculator_finder.goal_cable_marine', lang),
  goalRuntimeMarine: t('components.calculator_finder.goal_runtime_marine', lang),
  goalChargingMarine: t('components.calculator_finder.goal_charging_marine', lang),
  goalPackEv: t('components.calculator_finder.goal_pack_ev', lang),
  goalCableEv: t('components.calculator_finder.goal_cable_ev', lang),
  goalCrateEv: t('components.calculator_finder.goal_crate_ev', lang),
  goalConversionEv: t('components.calculator_finder.goal_conversion_ev', lang),
  goalRoiBess: t('components.calculator_finder.goal_roi_bess', lang),
  goalSizingBess: t('components.calculator_finder.goal_sizing_bess', lang),
  goalConversionBess: t('components.calculator_finder.goal_conversion_bess', lang),
  goalDegradationBess: t('components.calculator_finder.goal_degradation_bess', lang),
  goalSizingGeneral: t('components.calculator_finder.goal_sizing_general', lang),
  goalRuntimeGeneral: t('components.calculator_finder.goal_runtime_general', lang),
  goalConversionGeneral: t('components.calculator_finder.goal_conversion_general', lang),
  goalCrateGeneral: t('components.calculator_finder.goal_crate_general', lang),
};
---
<div class="bg-surface-card border border-hairline p-6 md:p-8" id="calculator-finder" data-finder-strings={JSON.stringify(finderStrings)} data-prefix={prefix}>
  <!-- Step 1: Category Selection -->
  <div id="cf-step1">
    <h2 class="text-title-lg text-primary mb-1" id="cf-title"></h2>
    <p class="text-body-sm text-muted mb-6" id="cf-subtitle"></p>

    <p class="text-label-uppercase text-m-blue-light text-[10px] block mb-3" id="cf-step1-label"></p>
    <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Application category">
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="solar"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="home-backup"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="rv"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="marine"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="ev"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="bess"
        role="radio"
        aria-checked="false"
      ></button>
      <button
        type="button"
        class="cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer"
        data-category="general"
        role="radio"
        aria-checked="false"
      ></button>
    </div>
  </div>

  <!-- Step 2: Goal Selection (hidden until step 1 completes) -->
  <div id="cf-step2" class="hidden mt-6 pt-6 border-t border-hairline">
    <div class="flex items-center justify-between mb-3">
      <p class="text-label-uppercase text-m-blue-light text-[10px]" id="cf-step2-label"></p>
      <button
        type="button"
        id="cf-back-btn"
        class="text-label-uppercase text-muted text-[10px] hover:text-primary transition-colors cursor-pointer"
        aria-label="Go back to category selection"
      ></button>
    </div>
    <div class="flex flex-wrap gap-2" id="cf-goals" role="radiogroup" aria-label="Calculation goal">
    </div>
  </div>

  <!-- Results -->
  <div id="cf-results" class="hidden mt-6 pt-6 border-t border-hairline">
    <p class="text-label-uppercase text-m-blue-light text-[10px] block mb-4" id="cf-results-label"></p>
    <ul class="space-y-2" id="cf-results-list" role="list">
    </ul>
  </div>
</div>

<script>
(function() {
  const finder = document.getElementById('calculator-finder');
  const strings = JSON.parse(finder?.getAttribute('data-finder-strings') || '{}');
  const prefix = finder?.getAttribute('data-prefix') || '';

  const categoryLabels: Record<string, string> = {
    'solar': strings.categorySolar || 'Solar / Off-grid',
    'home-backup': strings.categoryHomeBackup || 'Home Backup',
    'rv': strings.categoryRv || 'RV / Camper',
    'marine': strings.categoryMarine || 'Marine / Boat',
    'ev': strings.categoryEv || 'EV / Battery Pack',
    'bess': strings.categoryBess || 'BESS / Commercial',
    'general': strings.categoryGeneral || 'General Calculation',
  };

  const goalLabels: Record<string, Record<string, string>> = {
    'solar': {
      sizing: strings.goalSizingSolar || 'Size a battery bank for solar storage',
      runtime: strings.goalRuntimeSolar || 'Estimate runtime from solar loads',
      charging: strings.goalChargingSolar || 'Calculate solar charging time',
      degradation: strings.goalDegradationSolar || 'Estimate battery degradation over time',
    },
    'home-backup': {
      sizing: strings.goalSizingHome || 'Size a backup battery system',
      inverter: strings.goalInverterHome || 'Match battery to inverter / AC load',
      runtime: strings.goalRuntimeHome || 'Estimate backup runtime for essentials',
      degradation: strings.goalDegradationHome || 'Estimate battery degradation over time',
    },
    'rv': {
      sizing: strings.goalSizingRv || 'Size batteries for van / camper life',
      inverter: strings.goalInverterRv || 'Match battery to inverter / AC appliances',
      runtime: strings.goalRuntimeRv || 'Estimate off-grid runtime',
      charging: strings.goalChargingRv || 'Calculate alternator / solar charging time',
    },
    'marine': {
      sizing: strings.goalSizingMarine || 'Size a marine battery bank',
      cable: strings.goalCableMarine || 'Calculate cable loss or voltage drop',
      runtime: strings.goalRuntimeMarine || 'Estimate hotel-load runtime',
      charging: strings.goalChargingMarine || 'Calculate shore / alternator charge time',
    },
    'ev': {
      pack: strings.goalPackEv || 'Design a battery pack (series / parallel)',
      cable: strings.goalCableEv || 'Calculate wiring losses or voltage drop',
      crate: strings.goalCrateEv || 'Determine safe C-rate / current limits',
      conversion: strings.goalConversionEv || 'Convert between Ah, Wh, and energy units',
    },
    'bess': {
      roi: strings.goalRoiBess || 'Evaluate ROI and payback period',
      sizing: strings.goalSizingBess || 'Size a BESS for peak shaving or TOU',
      conversion: strings.goalConversionBess || 'Convert energy units or capacity',
      degradation: strings.goalDegradationBess || 'Estimate battery life and degradation',
    },
    'general': {
      sizing: strings.goalSizingGeneral || 'Size a battery bank',
      runtime: strings.goalRuntimeGeneral || 'Estimate runtime from load',
      conversion: strings.goalConversionGeneral || 'Convert between Ah, Wh, and units',
      crate: strings.goalCrateGeneral || 'Calculate C-rate or safe current',
    },
  };

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const rules: Record<string, { goals: { id: string; label: string }[]; recommendations: Record<string, { name: string; href: string }[]> }> = {
    'solar': {
      goals: [
        { id: 'sizing', label: goalLabels.solar.sizing },
        { id: 'runtime', label: goalLabels.solar.runtime },
        { id: 'charging', label: goalLabels.solar.charging },
        { id: 'degradation', label: goalLabels.solar.degradation },
      ],
      recommendations: {
        sizing: [
          { name: 'Solar Battery Sizing Calculator', href: `${prefix}/tools/solar-battery-sizing-calculator/` },
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
        ],
        runtime: [
          { name: 'Runtime Calculator', href: `${prefix}/tools/runtime-calculator/` },
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
        ],
        charging: [
          { name: 'Charging Time Calculator', href: `${prefix}/tools/charging-time-calculator/` },
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
        ],
        degradation: [
          { name: 'Battery Degradation Estimator', href: `${prefix}/tools/battery-degradation-estimator/` },
          { name: 'SOC Estimator', href: `${prefix}/tools/soc-estimator/` },
        ],
      },
    },
    'home-backup': {
      goals: [
        { id: 'sizing', label: goalLabels['home-backup'].sizing },
        { id: 'inverter', label: goalLabels['home-backup'].inverter },
        { id: 'runtime', label: goalLabels['home-backup'].runtime },
        { id: 'degradation', label: goalLabels['home-backup'].degradation },
      ],
      recommendations: {
        sizing: [
          { name: 'Home Backup Battery Calculator', href: `${prefix}/tools/home-backup-battery-calculator/` },
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
        ],
        inverter: [
          { name: 'Inverter Battery Calculator', href: `${prefix}/tools/inverter-battery-calculator/` },
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
        ],
        runtime: [
          { name: 'Runtime Calculator', href: `${prefix}/tools/runtime-calculator/` },
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
        ],
        degradation: [
          { name: 'Battery Degradation Estimator', href: `${prefix}/tools/battery-degradation-estimator/` },
          { name: 'SOC Estimator', href: `${prefix}/tools/soc-estimator/` },
        ],
      },
    },
    'rv': {
      goals: [
        { id: 'sizing', label: goalLabels.rv.sizing },
        { id: 'inverter', label: goalLabels.rv.inverter },
        { id: 'runtime', label: goalLabels.rv.runtime },
        { id: 'charging', label: goalLabels.rv.charging },
      ],
      recommendations: {
        sizing: [
          { name: 'RV Battery Calculator', href: `${prefix}/tools/rv-battery-calculator/` },
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
        ],
        inverter: [
          { name: 'Inverter Battery Calculator', href: `${prefix}/tools/inverter-battery-calculator/` },
          { name: 'Parallel String Calculator', href: `${prefix}/tools/parallel-string-calculator/` },
        ],
        runtime: [
          { name: 'Runtime Calculator', href: `${prefix}/tools/runtime-calculator/` },
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
        ],
        charging: [
          { name: 'Charging Time Calculator', href: `${prefix}/tools/charging-time-calculator/` },
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
        ],
      },
    },
    'marine': {
      goals: [
        { id: 'sizing', label: goalLabels.marine.sizing },
        { id: 'cable', label: goalLabels.marine.cable },
        { id: 'runtime', label: goalLabels.marine.runtime },
        { id: 'charging', label: goalLabels.marine.charging },
      ],
      recommendations: {
        sizing: [
          { name: 'Marine Battery Sizing Calculator', href: `${prefix}/tools/marine-battery-sizing-calculator/` },
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
        ],
        cable: [
          { name: 'DC Cable Loss Calculator', href: `${prefix}/tools/dc-cable-loss-calculator/` },
          { name: 'Voltage Drop Calculator', href: `${prefix}/tools/voltage-drop-calculator/` },
        ],
        runtime: [
          { name: 'Runtime Calculator', href: `${prefix}/tools/runtime-calculator/` },
          { name: 'Inverter Battery Calculator', href: `${prefix}/tools/inverter-battery-calculator/` },
        ],
        charging: [
          { name: 'Charging Time Calculator', href: `${prefix}/tools/charging-time-calculator/` },
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
        ],
      },
    },
    'ev': {
      goals: [
        { id: 'pack', label: goalLabels.ev.pack },
        { id: 'cable', label: goalLabels.ev.cable },
        { id: 'crate', label: goalLabels.ev.crate },
        { id: 'conversion', label: goalLabels.ev.conversion },
      ],
      recommendations: {
        pack: [
          { name: 'Battery Pack Calculator', href: `${prefix}/tools/battery-pack-calculator/` },
          { name: 'Parallel String Calculator', href: `${prefix}/tools/parallel-string-calculator/` },
        ],
        cable: [
          { name: 'DC Cable Loss Calculator', href: `${prefix}/tools/dc-cable-loss-calculator/` },
          { name: 'Voltage Drop Calculator', href: `${prefix}/tools/voltage-drop-calculator/` },
        ],
        crate: [
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
          { name: 'Battery Pack Calculator', href: `${prefix}/tools/battery-pack-calculator/` },
        ],
        conversion: [
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
          { name: 'SOC Estimator', href: `${prefix}/tools/soc-estimator/` },
        ],
      },
    },
    'bess': {
      goals: [
        { id: 'roi', label: goalLabels.bess.roi },
        { id: 'sizing', label: goalLabels.bess.sizing },
        { id: 'conversion', label: goalLabels.bess.conversion },
        { id: 'degradation', label: goalLabels.bess.degradation },
      ],
      recommendations: {
        roi: [
          { name: 'BESS ROI Calculator', href: `${prefix}/tools/bess-roi-calculator/` },
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
        ],
        sizing: [
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
          { name: 'Inverter Battery Calculator', href: `${prefix}/tools/inverter-battery-calculator/` },
        ],
        conversion: [
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
          { name: 'SOC Estimator', href: `${prefix}/tools/soc-estimator/` },
        ],
        degradation: [
          { name: 'Battery Degradation Estimator', href: `${prefix}/tools/battery-degradation-estimator/` },
          { name: 'BESS ROI Calculator', href: `${prefix}/tools/bess-roi-calculator/` },
        ],
      },
    },
    'general': {
      goals: [
        { id: 'sizing', label: goalLabels.general.sizing },
        { id: 'runtime', label: goalLabels.general.runtime },
        { id: 'conversion', label: goalLabels.general.conversion },
        { id: 'crate', label: goalLabels.general.crate },
      ],
      recommendations: {
        sizing: [
          { name: 'Battery Sizing Calculator', href: `${prefix}/tools/battery-sizing-calculator/` },
          { name: 'Parallel String Calculator', href: `${prefix}/tools/parallel-string-calculator/` },
        ],
        runtime: [
          { name: 'Runtime Calculator', href: `${prefix}/tools/runtime-calculator/` },
          { name: 'Charging Time Calculator', href: `${prefix}/tools/charging-time-calculator/` },
        ],
        conversion: [
          { name: 'Energy Conversion Calculator', href: `${prefix}/tools/energy-conversion-calculator/` },
          { name: 'SOC Estimator', href: `${prefix}/tools/soc-estimator/` },
        ],
        crate: [
          { name: 'C-Rate Calculator', href: `${prefix}/tools/c-rate-calculator/` },
          { name: 'Battery Pack Calculator', href: `${prefix}/tools/battery-pack-calculator/` },
        ],
      },
    },
  };

  let selectedCategory: string | null = null;
  let selectedGoal: string | null = null;

  const step1 = document.getElementById('cf-step1') as HTMLElement | null;
  const step2 = document.getElementById('cf-step2') as HTMLElement | null;
  const goalsContainer = document.getElementById('cf-goals') as HTMLElement | null;
  const resultsContainer = document.getElementById('cf-results') as HTMLElement | null;
  const resultsList = document.getElementById('cf-results-list') as HTMLElement | null;
  const backBtn = document.getElementById('cf-back-btn') as HTMLElement | null;

  // Populate translated text
  const titleEl = document.getElementById('cf-title');
  const subtitleEl = document.getElementById('cf-subtitle');
  const step1LabelEl = document.getElementById('cf-step1-label');
  const step2LabelEl = document.getElementById('cf-step2-label');
  const backBtnEl = document.getElementById('cf-back-btn');
  const resultsLabelEl = document.getElementById('cf-results-label');

  if (titleEl) titleEl.textContent = strings.title || 'Find the Right Calculator';
  if (subtitleEl) subtitleEl.textContent = strings.subtitle || '';
  if (step1LabelEl) step1LabelEl.textContent = strings.step1Label || '';
  if (step2LabelEl) step2LabelEl.textContent = strings.step2Label || '';
  if (backBtnEl) backBtnEl.textContent = `← ${strings.back || 'BACK'}`;
  if (resultsLabelEl) resultsLabelEl.textContent = strings.resultsLabel || '';

  // Populate category button labels
  const categoryBtns = step1?.querySelectorAll('.cf-option');
  categoryBtns?.forEach((btn) => {
    const cat = btn.getAttribute('data-category');
    if (cat && categoryLabels[cat]) {
      btn.textContent = categoryLabels[cat];
    }
  });

  function emitFinderEvent(category: string, goal: string) {
    if (typeof window !== 'undefined' && window.dataLayer) {
      window.dataLayer.push({
        event: 'calculator_finder_used',
        selected_category: category,
        selected_goal: goal,
      });
    }
  }

  function showResults(category: string, goal: string) {
    const data = rules[category];
    const recs = data?.recommendations[goal];
    if (!recs || recs.length === 0) return;

    if (resultsList) resultsList.innerHTML = '';
    recs.forEach(function(rec: { name: string; href: string }) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = rec.href;
      a.className = 'flex items-center justify-between bg-surface-elevated border border-hairline p-4 text-primary hover:border-primary transition-colors group';
      a.innerHTML = '<span class="text-title-sm text-primary group-hover:text-m-blue-light transition-colors">' + rec.name + '</span><span class="text-label-uppercase text-muted text-[10px] group-hover:text-primary transition-colors">' + (strings.open || 'OPEN') + ' →</span>';
      li.appendChild(a);
      if (resultsList) resultsList.appendChild(li);
    });

    if (resultsContainer) resultsContainer.classList.remove('hidden');
    emitFinderEvent(category, goal);
  }

  function showStep2(category: string) {
    selectedCategory = category;
    const data = rules[category];
    if (!data || !goalsContainer) return;

    goalsContainer.innerHTML = '';
    data.goals.forEach(function(goal: { id: string; label: string }) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cf-option bg-surface-elevated border border-hairline text-body-strong text-body-sm px-4 py-2 hover:border-primary hover:text-primary transition-colors cursor-pointer';
      btn.textContent = goal.label;
      btn.setAttribute('role', 'radio');
      btn.setAttribute('aria-checked', 'false');
      btn.setAttribute('data-goal', goal.id);
      btn.addEventListener('click', function() {
        selectedGoal = goal.id;
        goalsContainer.querySelectorAll('.cf-option').forEach(function(b) {
          b.classList.remove('border-primary', 'text-primary', 'bg-canvas');
          b.classList.add('border-hairline', 'text-body-strong');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('border-primary', 'text-primary', 'bg-canvas');
        btn.classList.remove('border-hairline', 'text-body-strong');
        btn.setAttribute('aria-checked', 'true');
        if (selectedCategory && selectedGoal) showResults(selectedCategory, selectedGoal);
      });
      goalsContainer.appendChild(btn);
    });

    if (step1) step1.classList.add('hidden');
    if (resultsContainer) resultsContainer.classList.add('hidden');
    if (step2) step2.classList.remove('hidden');
  }

  function showStep1() {
    selectedCategory = null;
    selectedGoal = null;
    if (step2) step2.classList.add('hidden');
    if (resultsContainer) resultsContainer.classList.add('hidden');
    if (step1) step1.classList.remove('hidden');

    if (step1) {
      step1.querySelectorAll('.cf-option').forEach(function(b) {
        b.classList.remove('border-primary', 'text-primary', 'bg-canvas');
        b.classList.add('border-hairline', 'text-body-strong');
        b.setAttribute('aria-checked', 'false');
      });
    }
  }

  if (step1) {
    step1.querySelectorAll('.cf-option').forEach(function(btn) {
      btn.addEventListener('click', function() {
        step1.querySelectorAll('.cf-option').forEach(function(b) {
          b.classList.remove('border-primary', 'text-primary', 'bg-canvas');
          b.classList.add('border-hairline', 'text-body-strong');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('border-primary', 'text-primary', 'bg-canvas');
        btn.classList.remove('border-hairline', 'text-body-strong');
        btn.setAttribute('aria-checked', 'true');
        showStep2(btn.getAttribute('data-category') || '');
      });
    });
  }

  if (backBtn) {
    backBtn.addEventListener('click', showStep1);
  }
})();
</script>
