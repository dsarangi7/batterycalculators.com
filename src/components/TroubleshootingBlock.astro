---
export interface Props {
  problem: string;
  causes: string[];
  explanation: string;
  checklist: string[];
  solutions: string[];
}

const {
  problem,
  causes,
  explanation,
  checklist,
  solutions,
} = Astro.props as Props;
---

<div class="bg-surface-soft border border-hairline p-6 mb-8">
  <h3 class="text-title-lg text-primary mb-4">{problem}</h3>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Causes -->
    <div>
      <h4 class="text-label-uppercase text-[10px] text-m-red tracking-wider mb-3 font-bold">Likely Causes</h4>
      <ul class="flex flex-col gap-2">
        {causes.map((cause) => (
          <li class="text-body-sm text-muted flex gap-2">
            <span class="text-m-red shrink-0">✗</span>
            <span>{cause}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Solutions -->
    <div>
      <h4 class="text-label-uppercase text-[10px] text-success tracking-wider mb-3 font-bold">Possible Solutions</h4>
      <ul class="flex flex-col gap-2">
        {solutions.map((solution) => (
          <li class="text-body-sm text-muted flex gap-2">
            <span class="text-success shrink-0">✓</span>
            <span>{solution}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Explanation -->
  <div class="mt-6 border-t border-hairline pt-4">
    <h4 class="text-label-uppercase text-[10px] text-m-blue-light tracking-wider mb-2 font-bold">Engineering Explanation</h4>
    <p class="text-body-sm text-muted font-light leading-relaxed">{explanation}</p>
  </div>

  <!-- Diagnostic Checklist -->
  <div class="mt-6 border-t border-hairline pt-4">
    <h4 class="text-label-uppercase text-[10px] text-primary tracking-wider mb-3 font-bold">Diagnostic Checklist</h4>
    <ul class="flex flex-col gap-2">
      {checklist.map((item) => (
        <li class="text-body-sm text-muted flex gap-2 items-start">
          <span class="text-m-blue-light shrink-0 mt-0.5">☐</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
