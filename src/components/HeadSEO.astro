---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  schema?: 'website' | 'webApplication' | 'faqPage' | 'collectionPage';
  schemaName?: string;
  schemaDescription?: string;
  schemaUrl?: string;
  faqItems?: FAQItem[];
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/og-default.png',
  schema = 'website',
  schemaName,
  schemaDescription,
  schemaUrl,
  faqItems = [],
  breadcrumbs = [],
} = Astro.props;

const siteUrl = 'https://batterycalculators.com';

// Normalize a URL to the site's single public convention:
// https://batterycalculators.com/<path>/ (query strings are preserved).
// Also rewrites path-only URLs to the preferred host.
const toPreferredUrl = (url: string): string => {
  if (!url) return `${siteUrl}/`;
  const qIndex = url.indexOf('?');
  const base = qIndex === -1 ? url : url.slice(0, qIndex);
  const query = qIndex === -1 ? '' : url.slice(qIndex);
  const trimmed = base.replace(/\/+$/, '');
  const withSlash = trimmed === '' ? '/' : `${trimmed}/`;
  const anchored = withSlash.startsWith('http') ? withSlash : `${siteUrl}${withSlash}`;
  return `${anchored}${query}`;
};

const pathname = Astro.url.pathname;
const currentUrl = toPreferredUrl(canonical || `${siteUrl}${pathname}`);
const imageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

let schemaData: Record<string, unknown> = {};
let faqSchemaData: Record<string, unknown> | null = null;
let breadcrumbSchemaData: Record<string, unknown> | null = null;

if (schema === 'website') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: schemaName || 'Battery Calculators',
    description: schemaDescription || description,
    url: toPreferredUrl(siteUrl),
    potentialAction: {
      '@type': 'SearchAction',
      target: toPreferredUrl(`${siteUrl}/tools?q={search_term_string}`),
      'query-input': 'required name=search_term_string',
    },
  };
} else if (schema === 'webApplication') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: schemaName || title.split('|')[0].trim(),
    description: schemaDescription || description,
    url: toPreferredUrl(schemaUrl || currentUrl),
    applicationCategory: 'EngineeringApplication',
    operatingSystem: 'Web Browser',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  };
} else if (schema === 'collectionPage') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: schemaName || title.split('|')[0].trim(),
    description: schemaDescription || description,
    url: toPreferredUrl(schemaUrl || currentUrl),
  };
}

if (breadcrumbs.length > 0) {
  const itemListElement = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: toPreferredUrl(siteUrl) },
    ...breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.label,
      ...(b.href ? { item: toPreferredUrl(`${siteUrl}${b.href}`) } : {}),
    })),
  ];
  breadcrumbSchemaData = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  };
}

if (faqItems.length > 0) {
  faqSchemaData = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  };
}
---

<!-- Canonical URL -->
<link rel="canonical" href={currentUrl} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={currentUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content="Battery Calculators" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Structured Data -->
{schemaData['@type'] && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
)}
{breadcrumbSchemaData && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchemaData)} />
)}
{faqSchemaData && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchemaData)} />
)}
