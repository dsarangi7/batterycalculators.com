---
import { t, type Locale, getLocalePrefix } from '../utils/i18n';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  lang?: Locale;
}

const { items, lang = 'en' } = Astro.props as Props;
const prefix = getLocalePrefix(lang);
---

<nav aria-label={t('components.breadcrumb.aria_label', lang)} class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-caption text-muted">
    <li>
      <a href={`${prefix}/`} class="hover:text-primary transition-colors">{t('components.breadcrumb.home', lang)}</a>
    </li>
    {items.map((item) => (
      <li class="flex items-center gap-1.5">
        <span class="text-hairline">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
        ) : (
          <span class="text-primary">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
