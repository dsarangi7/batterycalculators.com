---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import InputField from '../../components/InputField.astro';
import ResultBox from '../../components/ResultBox.astro';
import FormulaBox from '../../components/FormulaBox.astro';
import FAQSection from '../../components/FAQSection.astro';
import WorkedExample from '../../components/WorkedExample.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import EngineeringDiagram from '../../components/EngineeringDiagram.astro';

const whatIs = `Um calculador de bateria de backup para cortes de energia domésticos ajuda a estimar a capacidade da bateria, o tamanho do inversor e o sistema de energia de backup necessário para manter eletrodomésticos essenciais funcionando durante um apagão na rede elétrica. Independentemente de estar se preparando para a temporada de furacões, cortes de energia por incêndios florestais, tempestades de inverno ou apagões inesperados, esta ferramenta dimensiona seu banco de baterias com base nos dispositivos específicos que você quer alimentados — geladeira, máquina de CPAP, bomba d'água, roteador Wi-Fi, luzes e mais. Ela leva em consideração as perdas de conversão do inversor, os limites de profundidade de descarga da química da bateria e uma margem de segurança configurável para fornecer uma estimativa realista e de nível de engenharia.`;

const whyItMatters = [
  "Os cortes de energia nos EUA aumentaram 67% na última década — tempestades, incêndios florestais e tensão na rede tornam a energia de backup uma necessidade prática em muitas regiões.",
  "Sistemas de bateria subdimensionados deixam você sem refrigeração ou energia para dispositivos médicos durante apagões de vários dias. Uma geladeira cheia custa US$300–US$600 para reabastecer se os alimentos estragarem.",
  "Sistemas superdimensionados desperdiçam dinheiro — cada 5 kWh desnecessário de capacidade LFP adiciona US$2.000–US$4.000 ao custo. Dimensionar corretamente economiza milhares.",
  "Ignorar cargas de partida de eletrodomésticos como bombas d'água e geladeiras pode desligar seu inversor no pior momento — o dimensionamento correto de surto previne falhas no meio do apagão.",
  "Não planejar para temperaturas extremas significa que a capacidade da bateria cai 10–30% em climas frios, deixando você sem energia quando mais precisa durante tempestades de inverno."
];

const practicalApplications = [
  { title: "Preparação para Furacões e Tempestades", description: "Dimensione um sistema de bateria para manter cargas críticas durante apagões de 24–72 horas comuns durante furacões, tempestades e tempestades severas." },
  { title: "Cortes de Energia de Segurança Pública por Incêndios Florestais", description: "Prepare-se para cortes planejados da rede durante alto risco de incêndio. Utilitários da Califórnia e do oeste dos EUA regularmente desenergizam linhas para prevenir ignição." },
  { title: "Energia de Backup para Equipamentos Médicos", description: "Garanta tempo de bateria suficiente para máquinas de CPAP, concentradores de oxigênio, nebulizadores e outros dispositivos médicos de sustento de vida." },
  { title: "Backup para Tempestades de Inverno e Gelo", description: "Mantenha controles de aquecimento, bombas d'água, refrigeração e equipamentos de comunicação funcionando durante tempestades de gelo e nevascas que cortam a energia por dias." },
  { title: "Dimensionamento de Estação de Energia Portátil", description: "Use esta calculadora para combinar uma estação de energia portátil ou gerador solar às suas necessidades específicas de carga de emergência antes de comprar." },
  { title: "Proteção de Geladeira e Freezer", description: "Calcule exatamente quanto tempo uma bateria pode manter sua geladeira e freezer funcionando para prevenir a deterioração de alimentos durante apagões prolongados." }
];

const expertNotes: { title: string; variant: 'engineering' | 'tip' | 'warning'; content: string }[] = [
  {
    title: "Ciclos de Trabalho dos Eletrodomésticos Importam",
    variant: "engineering",
    content: "Uma geladeira consome 150W quando o compressor está ligado, mas ela alterna entre ligado e desligado — geralmente funcionando 30–50% do tempo. Esta calculadora usa a potência contínua para dimensionamento conservador. O tempo real de funcionamento pode ser 40–60% maior do que o calculado para cargas cíclicas como geladeiras e freezers."
  },
  {
    title: "LiFePO4 vs Chumbo-Ácido para Backup de Emergência",
    variant: "tip",
    content: "As baterias LiFePO4 (LFP) fornecem 80–100% de capacidade utilizável, pesam 60% menos, duram 10× mais ciclos e não requerem manutenção. As baterias de chumbo-ácido são limitadas a 50% de profundidade de descarga e perdem capacidade rapidamente em clima frio. Para backup de emergência onde a confiabilidade importa, a LFP é a recomendação clara."
  },
  {
    title: "Cargas de Partida Podem Desligar Seu Inversor",
    variant: "warning",
    content: "Bombas d'água, geladeiras e micro-ondas consomem 2–3× sua potência durante a inicialização. Se a classificação de surto do seu inversor for muito baixa, ele desligará precisamente quando você mais precisar. Sempre dimensione a capacidade de surto do inversor para o pior cenário de inicialização."
  }
];

const trustSection = {
  text: "Esta calculadora usa fórmulas padrão de engenharia elétrica para dimensionamento de sistemas de bateria, alinhadas com os padrões de inversores UL 1741 e diretrizes de interconexão IEEE 1547. Todos os cálculos são transparentes, derivados de dados públicos de potência de eletrodomésticos e especificações do fabricante. A matemática é totalmente verificável.",
  link: { label: "Veja nossa metodologia e derivações de fórmulas", href: "/methodology/" }
};

const references = [
  { title: "EIA dos EUA — Dados de Consumo Residencial de Eletricidade", url: "https://www.eia.gov/electricity/monthly/", source: "Administração de Informação Energética dos EUA" },
  { title: "UL 1741 — Padrão para Inversores de Recursos Energéticos Distribuídos", url: "https://www.ul.com/resources/ul-1741-edition-3", source: "Underwriters Laboratories" },
  { title: "FEMA — Orientação sobre Energia de Backup de Emergência", url: "https://www.fema.gov/emergency-managers/risk-management/power/guidance", source: "Agência Federal de Gestão de Emergências" },
  { title: "NREL — Dimensionamento de Armazenamento de Bateria para Aplicações Residenciais", url: "https://www.nrel.gov/docs/fy23osti/85472.pdf", source: "Laboratório Nacional de Energia Renovável" }
];

const faqItems = [
  {
    question: "Qual tamanho de bateria preciso para um corte de energia?",
    answer: "Para backup básico de internet e telefone (roteador Wi-Fi + notebook + luzes por 8 horas), você precisa de aproximadamente 300–500 Wh. Para proteção de alimentos (geladeira + freezer por 12 horas), planeje 2.000–4.000 Wh. Para backup completo de emergência com dispositivos médicos, 3.000–8.000 Wh cobrem a maioria das cargas domésticas críticas por 24 horas.",
  },
  {
    question: "Quanto tempo uma bateria de 100Ah vai durar uma geladeira?",
    answer: "Uma bateria LiFePO4 de 12V 100Ah (1.280 Wh) pode manter uma geladeira padrão funcionando por aproximadamente 8–12 horas. O compressor da geladeira alterna entre ligado e desligado, então o tempo real depende da temperatura ambiente, eficiência da geladeira e de quantas vezes a porta é aberta. Em condições quentes com aberturas frequentes da porta, espere algo mais próximo de 6–8 horas.",
  },
  {
    question: "LiFePO4 é melhor que chumbo-ácido para backup doméstico?",
    answer: "Sim, para energia de backup de emergência. LiFePO4 fornece 80–100% de profundidade de descarga utilizável vs 50% para chumbo-ácido, dura 3.000–6.000 ciclos vs 300–500 para chumbo-ácido, carrega mais rápido, pesa 60% menos e não requer manutenção. O custo inicial é maior, mas o custo por ciclo ao longo da vida é significativamente menor.",
  },
  {
    question: "Qual tamanho de inversor preciso para uma geladeira?",
    answer: "Uma geladeira padrão precisa de um inversor contínuo de 1.500–2.000W com pelo menos 3.000W de capacidade de surto. A carga em funcionamento é tipicamente 150W, mas a partida do compressor pode atingir 600W ou mais. Se você vai usar outros eletrodomésticos, some as watts em funcionamento e a maior carga de surto para dimensionar seu inversor.",
  },
  {
    question: "Uma estação de energia portátil pode rodar uma geladeira?",
    answer: "Sim, uma estação de energia portátil com classificação de 1.500W+ contínuo com 3.000W+ de surto pode rodar uma geladeira padrão. Você precisará de uma unidade com pelo menos 1.000–1.500 Wh de capacidade para 8–12 horas de backup. Opções populares incluem EcoFlow Delta 2 (1.024 Wh), Bluetti AC200MAX (2.048 Wh) e Goal Zero Yeti 1500X (1.516 Wh).",
  },
  {
    question: "Quanta energia de backup de bateria preciso para uma máquina de CPAP?",
    answer: "Uma máquina de CPAP típica consome 30–60W com umidificador (10–30W sem). Para 8 horas de sono, você precisa de 240–480 Wh. Uma bateria LiFePO4 de 12V 50Ah (640 Wh) fornece energia de CPAP para a noite inteira. Sem o umidificador, uma bateria de 12V 20Ah (256 Wh) pode durar uma noite.",
  },
  {
    question: "Devo usar 12V, 24V ou 48V para backup doméstico?",
    answer: "Para sistemas de backup doméstico acima de 1.000W, use 24V ou 48V. Voltagem maior reduz a corrente, permitindo fios mais finos e menores perdas. 48V é ideal para sistemas acima de 3.000W e é o padrão para sistemas modernos de bateria doméstica. 12V é prático apenas para configurações portáteis pequenas abaixo de 1.000W.",
  },
  {
    question: "Painéis solares podem recarregar minha bateria durante um apagão?",
    answer: "Sim, se você tiver um inversor híbrido com entrada para bateria. Uma matriz de painéis solares de 400W em 4–5 horas de sol pico pode gerar 1.600–2.000 Wh diários — suficiente para recarregar parcialmente uma bateria doméstica ou estender significativamente o tempo de backup. Esta é a estratégia mais eficaz para sobreviver a apagões de vários dias.",
  },
  {
    question: "Por que minha bateria não dura tanto quanto a calculadora diz?",
    answer: "Razões comuns: idade e degradação da bateria (capacidade cai 20–30% ao longo dos anos), tempo frio reduzindo capacidade 10–30%, cargas de surto reais maiores que as classificadas, perdas na fiação, consumo de energia em standby do inversor e padrões de ciclagem dos eletrodomésticos diferentes das premissas. Esta calculadora fornece estimativas conservadoras — resultados reais variam.",
  },
  {
    question: "Quais eletrodomésticos devo evitar rodar com backup de bateria?",
    answer: "Evite cargas resistivas de alto consumo: ar-condicionado (1.500–5.000W), fogões elétricos (2.000–5.000W), aquecedores de água elétricos (4.500W), secadoras de roupas (2.500–5.000W) e aquecedores de ambiente (1.500W). Esses esgotam baterias rapidamente e requerem sistemas impraticavelmente grandes. Foque em cargas críticas: refrigeração, iluminação, dispositivos médicos, comunicação e eletrônicos pequenos."
  },
];

const commonMistakes = [
  "Subdimensionar o inversor para cargas de surto — bombas d'água, geladeiras e micro-ondas consomem 2–3× a potência durante a inicialização, desligando inversores baratos.",
  "Ignorar perdas de eficiência do inversor — uma perda de conversão CA/CC de 10–15% significa que uma bateria de 1.000Wh fornece apenas 850–900Wh de energia CA utilizável.",
  "Dimensionar para potência sem considerar os ciclos de trabalho dos eletrodomésticos — geladeiras alternam 30–50% do tempo, então estimativas de funcionamento contínuo são conservadoras.",
  "Usar baterias de chumbo-ácido na capacidade total classificada — chumbo-ácido não deve exceder 50% de DoD, exigindo o dobro da capacidade nominal vs LiFePO4.",
  "Esquecer a margem de segurança para envelhecimento e temperatura da bateria — tempo frio reduz capacidade 10–30%, e capacidade degrada 20–30% ao longo da vida útil da bateria.",
  "Não planejar a instalação do interruptor de transferência — conectar um sistema de bateria à fiação doméstica sem um interruptor de transferência pode eletrocutar trabalhadores da concessionária.",
  "Superdimensionar o banco de baterias sem considerar estratégia de recarga — uma bateria de 10 kWh sem recarga solar ou gerador é um sistema de uso único.",
  "Rodar cargas resistivas de alto consumo da bateria — ar-condicionados, fogões elétricos e aquecedores de água (1.500–5.000W) esgotam baterias em horas."
];

const relatedArticles = [
  { title: "Planejamento de Backup de Bateria Doméstica", href: "/learn/home-battery-backup-planning/" },
  { title: "Guia de Tempo de Backup Doméstico", href: "/learn/home-backup-runtime-guide/" },
  { title: "LiFePO4 vs Chumbo-Ácido", href: "/learn/lifepo4-vs-lead-acid/" },
  { title: "Backup de Bateria para Toda a Casa", href: "/learn/whole-house-battery-backup/" },
  { title: "Guia de Bateria para Cortes de Energia", href: "/learn/power-outage-battery-guide/" },
];

const relatedCalculators = [
  { href: "/fridge-battery-backup-calculator/", title: "Calculadora de Bateria para Geladeira", description: "Dimensionamento de bateria especificamente para backup de geladeira durante apagões." },
  { href: "/cpap-battery-backup-calculator/", title: "Calculadora de Bateria para CPAP", description: "Dimensione baterias para energia noturna de CPAP." },
  { href: "/sump-pump-battery-backup-calculator/", title: "Calculadora de Bateria para Bomba d'Água", description: "Mantenha sua bomba d'água funcionando durante apagões de tempestade." },
  { href: "/portable-power-station-runtime-calculator/", title: "Calculadora de Tempo de Estação de Energia Portátil", description: "Veja quanto tempo uma estação de energia portátil roda suas cargas." },
  { href: "/solar-generator-sizing-calculator/", title: "Calculadora de Dimensionamento de Gerador Solar", description: "Dimensione um sistema completo de backup solar com painéis e bateria." },
  { href: "/tools/runtime-calculator/", title: "Calculadora de Tempo de Bateria", description: "Estime o tempo de descarga a partir da capacidade e carga." },
  { href: "/tools/battery-sizing-calculator/", title: "Calculadora de Dimensionamento de Bateria", description: "Dimensionamento completo de banco de baterias com degradação por temperatura." },
  { href: "/tools/solar-battery-sizing-calculator/", title: "Calculadora de Bateria Solar", description: "Dimensione baterias pareadas com matrizes de painéis solares." },
  { href: "/tools/energy-conversion-calculator/", title: "Calculadora de Conversão de Energia", description: "Converta entre Ah, Wh e kWh em qualquer voltagem." },
  { href: "/tools/charging-time-calculator/", title: "Calculadora de Tempo de Carga", description: "Estime o tempo de carga a partir de solar ou rede elétrica." },
  { href: "/tools/voltage-drop-calculator/", title: "Calculadora de Queda de Voltagem", description: "Dimensione extensões de fio para minimizar queda de voltagem." },
  { href: "/tools/dc-cable-loss-calculator/", title: "Calculadora de Perda em Cabo DC", description: "Calcule perdas de fiação em conexões DC." },
];

const appliancePresets = [
  { name: "Geladeira", runningW: 150, surgeW: 600 },
  { name: "Freezer", runningW: 120, surgeW: 500 },
  { name: "Roteador Wi-Fi", runningW: 12, surgeW: 12 },
  { name: "Luz LED", runningW: 10, surgeW: 10 },
  { name: "Notebook", runningW: 60, surgeW: 90 },
  { name: "TV", runningW: 100, surgeW: 150 },
  { name: "Máquina de CPAP", runningW: 40, surgeW: 80 },
  { name: "Ventilador", runningW: 50, surgeW: 75 },
  { name: "Bomba d'Água", runningW: 800, surgeW: 2000 },
  { name: "Micro-ondas", runningW: 1000, surgeW: 1500 },
];
---

<CalculatorLayout
  title="Calculadora de Bateria de Backup para Cortes de Energia Domésticos | Battery Calculators"
  description="Calcule qual tamanho de bateria, inversor e sistema de energia de backup você precisa para rodar eletrodomésticos essenciais durante um corte de energia, tempestade, furacão, apagão por incêndio florestal ou falha de emergência na rede elétrica."
  faqItems={faqItems}
  whatIs={whatIs}
  whyItMatters={whyItMatters}
  practicalApplications={practicalApplications}
  trustSection={trustSection}
  references={references}
  expertNotes={expertNotes}
  relatedCalculators={relatedCalculators}
  commonMistakes={commonMistakes}
  relatedArticles={relatedArticles}
  lang="pt"
>

  <!-- Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mb-16">

    <!-- Input Form -->
    <CalculatorCard>
      <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">Cargas de Eletrodomésticos</h3>
      <div class="flex flex-col gap-5" id="appliance-list">
        <div class="flex flex-col gap-2">
          <label class="text-label-uppercase text-xs text-primary">Adicionar Eletrodomésticos</label>
          <div class="relative flex items-center">
            <select id="appliance-select" class="select-input w-full">
              <option value="">Selecione um eletrodoméstico...</option>
              {appliancePresets.map((a) => (
                <option value={a.name} class="bg-surface-card">{a.name} ({a.runningW}W / {a.surgeW}W surto)</option>
              ))}
              <option value="custom" class="bg-surface-card">Carga Personalizada...</option>
            </select>
          </div>
          <p class="text-caption text-muted">Selecione eletrodomésticos para adicioná-los ao seu plano de backup.</p>
        </div>

        <div id="custom-load-fields" class="hidden flex-col gap-4 p-4 bg-surface-soft border border-hairline">
          <div class="flex flex-col gap-2">
            <label for="custom-name" class="text-label-uppercase text-xs text-primary">Nome do Eletrodoméstico Personalizado</label>
            <input id="custom-name" type="text" class="text-input w-full" placeholder="ex., Bomba de Poço" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label for="custom-running" class="text-label-uppercase text-xs text-primary">Potência em Funcionamento</label>
              <input id="custom-running" type="number" class="text-input w-full" value={500} min={1} />
            </div>
            <div class="flex flex-col gap-2">
              <label for="custom-surge" class="text-label-uppercase text-xs text-primary">Potência de Surto</label>
              <input id="custom-surge" type="number" class="text-input w-full" value={750} min={1} />
            </div>
          </div>
          <button id="add-custom-btn" type="button" class="btn-primary w-full">Adicionar Carga Personalizada</button>
        </div>

        <div id="selected-appliances" class="flex flex-col gap-2"></div>
      </div>

      <div class="border-t border-hairline mt-6 pt-6 flex flex-col gap-5">
        <h3 class="text-title-lg text-primary uppercase tracking-wider">Configurações de Backup</h3>

        <InputField id="backup-hours" label="Duração do Backup" value={8} min={0.5} max={72} step={0.5} unit="hours" helperText="Quanto tempo você precisa de energia de backup durante o apagão." />

        <InputField
          id="battery-voltage"
          label="Voltagem do Sistema de Bateria"
          type="select"
          value="24"
          helperText="12V para configurações portáteis pequenas, 24V para médio porte, 48V para toda a casa."
          options={[
            { label: "12 V", value: "12" },
            { label: "24 V", value: "24" },
            { label: "48 V", value: "48" },
          ]}
        />

        <InputField
          id="battery-chemistry"
          label="Química da Bateria"
          type="select"
          value="lifepo4"
          helperText="LiFePO4 recomendado: mais seguro, maior vida útil, maior descarga."
          options={[
            { label: "LiFePO4", value: "lifepo4" },
            { label: "AGM / Chumbo-Ácido Selado", value: "agm" },
            { label: "Chumbo-Ácido Acima do Nível", value: "flooded" },
          ]}
        />

        <InputField id="dod-percent" label="Profundidade de Descarga" value={80} min={10} max={100} step={1} unit="%" helperText="Definido automaticamente pela química. LiFePO4: 80%, Chumbo-Ácido: 50%. Você pode alterar." />

        <InputField id="inverter-efficiency" label="Eficiência do Inversor" value={90} min={80} max={98} step={1} unit="%" helperText="Inversores modernos de onda senoidal pura: 90–95%. Use 90% para dimensionamento conservador." />

        <InputField id="safety-margin" label="Margem de Segurança" value={20} min={0} max={50} step={1} unit="%" helperText="Capacidade extra de buffer para temperatura, envelhecimento e cargas inesperadas." />
      </div>

      <div class="border-t border-hairline mt-6 pt-6 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="solar-enabled" class="w-4 h-4 accent-m-blue-light" />
          <label for="solar-enabled" class="text-label-uppercase text-xs text-primary cursor-pointer">Ativar Recarga Solar</label>
        </div>

        <div id="solar-fields" class="hidden flex-col gap-5">
          <InputField id="solar-watts" label="Potência dos Painéis Solares" value={400} min={50} max={10000} step={50} unit="W" helperText="Potência total dos painéis solares conectados ao controlador de carga." />

          <InputField id="peak-sun-hours" label="Horas de Sol Pico" value={5} min={1} max={10} step={0.5} unit="hours" helperText="Média diária de horas de sol pico para sua localização. Média dos EUA: 4–6 horas." />

          <InputField id="charge-controller-efficiency" label="Eficiência do Controlador de Carga" value={95} min={80} max={99} step={1} unit="%" helperText="Controladores MPPT: 95–98%. Controladores PWM: 80–90%." />
        </div>
      </div>
    </CalculatorCard>

    <!-- Results -->
    <CalculatorCard class="border-m-blue-light flex flex-col justify-between">
      <div>
        <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">Resultados do Sistema de Backup</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <ResultBox
            label="Energia Necessária da Bateria"
            value="0 Wh"
            suffix="0 kWh total do banco de baterias"
            variant="primary"
            id="result-battery-wh"
          />
          <ResultBox
            label="Capacidade da Bateria"
            value="0 Ah"
            suffix="Em 24V nominal"
            id="result-battery-ah"
          />
          <ResultBox
            label="Carga Total em Funcionamento"
            value="0 W"
            suffix="Consumo contínuo"
            id="result-running-w"
          />
          <ResultBox
            label="Surto Estimado"
            value="0 W"
            suffix="Pico de inicialização"
            id="result-surge-w"
          />
          <ResultBox
            label="Inversor Contínuo"
            value="0 W"
            suffix="Mínimo recomendado"
            id="result-inverter-cont"
          />
          <ResultBox
            label="Classificação de Surto do Inversor"
            value="0 W"
            suffix="Mínimo recomendado"
            id="result-inverter-surge"
          />
        </div>

        <div class="bg-surface-soft border border-hairline p-4 mb-6">
          <h4 class="text-label-uppercase text-primary text-[10px] mb-3">Configurações de Bateria Sugeridas</h4>
          <div class="grid grid-cols-2 gap-3 text-body-sm text-muted">
            <div class="flex justify-between"><span>Baterias 12V 100Ah:</span> <span class="text-primary font-bold" id="result-bat-12v100">0</span></div>
            <div class="flex justify-between"><span>Baterias 12V 200Ah:</span> <span class="text-primary font-bold" id="result-bat-12v200">0</span></div>
            <div class="flex justify-between"><span>Baterias 24V 100Ah:</span> <span class="text-primary font-bold" id="result-bat-24v100">0</span></div>
            <div class="flex justify-between"><span>Baterias 48V 100Ah:</span> <span class="text-primary font-bold" id="result-bat-48v100">0</span></div>
          </div>
        </div>

        <div id="solar-results" class="hidden bg-surface-soft border border-hairline p-4 mb-6">
