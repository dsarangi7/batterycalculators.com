---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout
  title="Fale Conosco | Calculadoras de Bateria"
  description="Entre em contato com a equipe das Calculadoras de Bateria para feedback sobre calculadoras, relatos de erros, correções de conteúdo ou parcerias."
  canonical="https://batterycalculators.com/pt/contact/"
  lang="pt"
>
  <div class="max-w-3xl mx-auto">
    <Breadcrumb items={[{ label: 'Contato' }]} />

    <div class="mb-12 border-b border-hairline pb-8">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">CONTATO</span>
      <h1 class="text-display-md text-primary mb-6">Fale Conosco</h1>
      <p class="text-body-md text-body font-light">
        Para feedback sobre calculadoras, relatos de erros, correções de conteúdo ou parcerias, entre em contato pelo formulário ou e-mail abaixo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Contact Info -->
      <div class="md:col-span-1 flex flex-col gap-6 text-body-sm">
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">E-mail</h4>
          <p class="text-muted">
            <a href="mailto:dsarangi7@gmail.com" class="hover:text-primary transition-colors underline underline-offset-4">dsarangi7@gmail.com</a>
          </p>
          <p class="text-caption text-muted mt-1 italic">
            Para feedback sobre calculadoras, relatos de erros ou parcerias.
          </p>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">Tempo de Resposta</h4>
          <p class="text-muted">1–3 dias úteis</p>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">Assuntos</h4>
          <ul class="flex flex-col gap-1 text-muted">
            <li>Feedback sobre Calculadoras</li>
            <li>Relatos de Erros</li>
            <li>Correções de Conteúdo</li>
            <li>Parcerias</li>
          </ul>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">Escopo Educacional</h4>
          <p class="text-muted">
            Todos os algoritmos são públicos e destinados a verificações educacionais de dimensionamento de sistemas de bateria.
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2">
        <CalculatorCard>
          <form id="contact-form" class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-label-uppercase text-xs text-primary">Seu Nome</label>
              <input type="text" id="name" required class="text-input" placeholder="SEU NOME" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="text-label-uppercase text-xs text-primary">E-mail</label>
              <input type="email" id="email" required class="text-input" placeholder="VOCE@EXEMPLO.COM" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="topic" class="text-label-uppercase text-xs text-primary">Assunto</label>
              <select id="topic" required class="select-input">
                <option value="" disabled selected>Selecione um assunto</option>
                <option value="calculator-feedback">Feedback sobre Calculadora</option>
                <option value="bug-report">Relato de Erro</option>
                <option value="content-correction">Correção de Conteúdo</option>
                <option value="partnership">Parceria</option>
                <option value="other">Outro</option>
              </select>
            </div>

            <div class="flex flex-col gap-2">
              <label for="message" class="text-label-uppercase text-xs text-primary">Mensagem</label>
              <textarea id="message" required class="text-input h-32 resize-none" placeholder="SUA MENSAGEM AQUI..."></textarea>
            </div>

            <button type="submit" class="btn-primary w-full text-xs h-12">Enviar Mensagem</button>
          </form>
          
          <div id="form-success" class="hidden mt-4 p-4 border border-green-600 bg-surface-soft text-body-sm text-green-500">
            Obrigado pela sua mensagem. Este é um site estático — sua mensagem foi registrada localmente, mas não enviada a um servidor. Para dúvidas reais, envie um e-mail diretamente.
          </div>
        </CalculatorCard>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successDiv = document.getElementById('form-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      if (successDiv) {
        successDiv.classList.remove('hidden');
        setTimeout(() => {
          successDiv.classList.add('hidden');
        }, 8000);
      }
    });
  </script>
</Layout>
