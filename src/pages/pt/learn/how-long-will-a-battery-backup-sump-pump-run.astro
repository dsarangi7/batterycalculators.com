                <td class="p-4 font-mono text-primary">16–32 horas</td>
                <td class="p-4 text-muted">Imóveis desocupados, apagões de dias</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Máximo</td>
                <td class="p-4 font-mono text-primary">400Ah+ com gerador</td>
