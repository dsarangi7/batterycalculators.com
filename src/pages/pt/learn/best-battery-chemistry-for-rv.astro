---
import Layout from '../../../layouts/Layout.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import FAQSection from '../../../components/FAQSection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const faqItems = [
  {
    question: "Por que chumbo-ácido não é recomendado para RV?",
    answer: "Baterias de chumbo-ácido são pesadas (30+ kg para 100Ah), limitadas a 50% DoD e degradam rápido com vibração e ciclos térmicos do RV. Também emitem hidrogênio, exigindo caixas ventiladas. Baterias LFP pesam 60% menos, entregam o dobro de capacidade utilizável e duram 5–8× mais em padrões de RV.",
  },
  {
    question: "Quanto peso economizo migrando para lítio no RV?",
    answer: "Um banco típico de RV é 200–400Ah em 12V. Em chumbo-ácido inundada, pesa 120–240 kg. A mesma capacidade em LiFePO4 pesa 24–48 kg. Você economiza 100–200 kg, o que melhora consumo, aumenta carga útil e reduz desgaste de suspensão e pneus.",
  },
  {
    question: "Quanto custa um upgrade para lítio no RV?",
    answer: "Um upgrade completo (bateria LFP 12V 200Ah, BMS e fiação) custa $1.200–2.500. AGM equivalente custa $600–1.200, mas precisa de troca a cada 3–5 anos. LFP dura 10+ anos em RV, então o custo de vida útil é menor. Muitos recuperam o prêmio em 3–4 anos com menos trocas.",
  },
  {
    question: "Posso usar solar com baterias de lítio no RV?",
    answer: "Sim, e é a combinação ideal. Baterias LFP aceitam altas taxas de controladores solares, toleram operação parcial e mantêm capacidade por milhares de ciclos parciais. Um painel de 400W com bateria LFP de 200Ah sustenta a maioria das cargas de RV indefinidamente em dias ensolarados.",
  },
];
---

<Layout
  title="Melhor Química para Aplicações em RV | Calculadoras de Bateria"
  description="Ranking de químicas para baterias de RV: LiFePO4, AGM e chumbo-ácido inundada. Compare peso, vida em ciclos, resistência à vibração e custo."
  canonical="https://batterycalculators.com/pt/learn/best-battery-chemistry-for-rv/"
  schema="faqPage"
  schemaName="Melhor Química para Aplicações em RV"
  schemaDescription="Ranking de engenharia de químicas para baterias de RV."
  schemaUrl="https://batterycalculators.com/pt/learn/best-battery-chemistry-for-rv/"
  faqItems={faqItems}
  lang="pt"
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/pt/learn/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">← Voltar aos Guias</a>
      <Breadcrumb items={[
        { label: "Centro de Aprendizagem", href: "/pt/learn/" },
        { label: "Melhor Química para RV" }
      ]} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">QUÍMICA</span>
      <h1 class="text-display-md text-primary mb-6">Melhor Química para Aplicações em RV</h1>
      <p class="text-body-md text-body font-light">
        Baterias de RV enfrentam demandas únicas: limites de peso, vibração, ciclagem parcial e autonomia off-grid. Este ranking avalia cada química nas métricas que mais importam para a vida em RV.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">Ranking de Químicas para RV</h2>
        <div class="overflow-x-auto">
          <div class="bg-surface-soft border border-hairline overflow-hidden min-w-[640px]">
            <table class="w-full text-left text-body-sm">
              <thead>
                <tr class="border-b border-hairline bg-surface-card">
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Posição</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Química</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Peso</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">DoD</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Vibração</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Custo</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Veredito</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <tr>
                  <td class="p-4 font-mono text-primary font-bold">#1</td>
                  <td class="p-4 font-mono text-primary">LiFePO4</td>
                  <td class="p-4 font-mono text-primary">~12 kg/100Ah</td>
                  <td class="p-4 font-mono text-primary">80–100%</td>
                  <td class="p-4 font-mono text-primary">Excelente</td>
                  <td class="p-4 font-mono text-primary">Alto inicial</td>
                  <td class="p-4 text-muted">Melhor geral</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary font-bold">#2</td>
                  <td class="p-4 text-muted">AGM</td>
                  <td class="p-4 text-muted">~32 kg/100Ah</td>
                  <td class="p-4 text-muted">50%</td>
                  <td class="p-4 text-muted">Boa</td>
                  <td class="p-4 text-muted">Médio</td>
                  <td class="p-4 text-muted">Entrada econômica</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary font-bold">#3</td>
                  <td class="p-4 text-muted">Inundada</td>
                  <td class="p-4 text-muted">~30 kg/100Ah</td>
                  <td class="p-4 text-muted">50%</td>
                  <td class="p-4 text-muted">Ruim</td>
                  <td class="p-4 text-muted">Baixo</td>
                  <td class="p-4 text-muted">Não recomendada</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">#1 LiFePO4 — Melhor Geral para RV</h2>
        <p class="text-body-md text-body font-light mb-4">
          LiFePO4 é a escolha dominante para baterias modernas de RV. A redução de 60% no peso (de ~30 kg para ~12 kg por 100Ah) libera carga útil significativa. O DoD utilizável de 80–100% significa que um banco LFP de 200Ah entrega 2.048–2.560 Wh utilizáveis, enquanto o mesmo banco AGM entrega só 1.280 Wh.
        </p>
        <p class="text-body-md text-body font-light">
          Baterias LFP lidam melhor com vibração, oscilações térmicas e ciclagem parcial típicas de RV que qualquer chumbo-ácido. Aceitam altas taxas de alternadores, controladores solares e rede simultaneamente. A curva plana mantém 12,8V consistentes até quase esvaziar.
        </p>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">#2 AGM — Opção Econômica Inicial</h2>
        <p class="text-body-md text-body font-light">
          AGM não exige manutenção e é à prova de vazamento, sendo mais segura que inundada para RV. Tolera razoavelmente a vibração e pode ser montada em compartimentos fechados. Porém, o limite de 50% DoD e a vida de 3–5 anos em padrões de RV fazem do AGM um ponto de entrada econômico, não uma solução de longo prazo. Considere AGM se está testando o estilo RV antes do lítio.
        </p>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">#3 Chumbo-Ácido Inundada — Não Recomendada para RV</h2>
        <p class="text-body-md text-body font-light">
          Inundada exige caixas ventiladas, manutenção mensal e não tolera a vibração da estrada sem degradação acelerada. Risco de derramamento em curvas ou fora de estrada é preocupação de segurança. Não há razão de engenharia para escolher inundada para RV na era do LFP.
        </p>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <CalculatorCard class="border-m-blue-light">
          <h4 class="text-label-uppercase text-primary text-xs mb-3">Experimente</h4>
          <p class="text-body-sm text-muted mb-4">Calcule suas necessidades de RV com a Calculadora de Autonomia.</p>
          <a href="/pt/tools/runtime-calculator/" class="btn-primary text-xs py-3 px-6 inline-block">Abrir Calculadora de Autonomia</a>
        </CalculatorCard>
        <CalculatorCard class="border-m-blue-light">
          <h4 class="text-label-uppercase text-primary text-xs mb-3">Relacionado</h4>
          <p class="text-body-sm text-muted mb-4">Compare custos de vida útil com a Calculadora de Custo.</p>
          <a href="/pt/tools/solar-battery-sizing-calculator/" class="btn-primary-outline text-xs py-3 px-6 inline-block">Calculadora de Custo</a>
        </CalculatorCard>
      </div>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Artigos Relacionados</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">LiFePO4 vs AGM</h4>
            <p class="text-body-sm text-muted mb-3">Como o LFP se compara ao AGM em ciclo profundo.</p>
            <a href="/pt/learn/lifepo4-vs-agm/" class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors">Ler Guia →</a>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Guia de Autonomia LiFePO4</h4>
            <p class="text-body-sm text-muted mb-3">Entenda a descarga LFP para uso off-grid em RV.</p>
            <a href="/pt/learn/lifepo4-battery-runtime-guide/" class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors">Ler Guia →</a>
          </CalculatorCard>
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Referências</h2>
        <div class="text-body-sm text-muted space-y-2">
          <p>RV Industry Association: Tendências de Adoção de Lítio em Veículos Recreativos, 2024.</p>
          <p>Análise de Redução de Peso para Armazenamento Móvel — SAE International, 2023.</p>
          <p>Normas BCI de Tamanho para Baterias de RV, Battery Council International.</p>
        </div>
      </section>

      <FAQSection items={faqItems} />
    </div>
  </div>
</Layout>
