---
import Layout from '../../../layouts/Layout.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import FAQSection from '../../../components/FAQSection.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import ReferenceTable from '../../../components/ReferenceTable.astro';

const faqItems = [
  {
    question: "Qual é a diferença entre bateria Grupo 24 e Grupo 31?",
    answer: "Grupo 24 e 31 são tamanhos padrão de caixa BCI (Battery Council International). Grupo 24 tem tipicamente 70–85Ah, enquanto Grupo 31 tem 100–125Ah. As dimensões diferem: Grupo 24 é ~10,25\" x 6,8\" x 9,9\", e Grupo 31 é ~13\" x 6,8\" x 9,5\". Ambas comuns em marítimo e RV.",
  },
  {
    question: "Como escolho o tamanho certo para meu sistema solar?",
    answer: "Comece pelo consumo diário em Wh (multiplique Ah × tensão). Depois defina os dias de autonomia. Divida o total de Wh pela tensão para obter os Ah. Por exemplo, carga de 2kWh/dia com 2 dias em 48V precisa de ~83Ah (2000 × 2 / 48 ≈ 83Ah). Adicione sempre 20–30% para limites de profundidade.",
  },
  {
    question: "Posso misturar capacidades diferentes em série ou paralelo?",
    answer: "Nunca misture capacidades, químicas ou idades diferentes em um banco. Em série, a célula mais fraca limita toda a string. Em paralelo, a mais fraca drena das outras, causando desequilíbrio e falha prematura. Use sempre baterias idênticas do mesmo fabricante e lote.",
  },
  {
    question: "Qual é o tamanho mais comum de bateria de ciclo profundo?",
    answer: "A 12V de 100Ah é a mais popular em marítimo, RV e solar. Equilibra bem capacidade, peso e custo. Para sistemas menores, 50Ah é comum. Para maiores, usam-se 200Ah e 300Ah ou bancos paralelos de unidades menores.",
  },
];

const relatedTools = [
  { title: "Calculadora de Dimensionamento", href: "/pt/tools/battery-sizing-calculator/", description: "Calcule a capacidade ideal para sua aplicação" },
  { title: "Calculadora de Pack", href: "/pt/tools/battery-pack-calculator/", description: "Projete configurações série e paralelo" },
  { title: "Conversor de Energia", href: "/pt/tools/energy-conversion-calculator/", description: "Converta entre Wh, kWh, Ah e outras unidades" },
];

const references = [
  { title: "Tabela de Tamanhos BCI", url: "https://batteryuniversity.com/article/bu-105-battery-group-sizes" },
  { title: "NREL — Dimensionamento para Aplicações Estacionárias", url: "https://www.nrel.gov/docs/fy18osti/70755.pdf" },
];
---

<Layout
  title="Referência de Tamanhos Comuns — Ah e Wh por Aplicação | Calculadoras de Bateria"
  description="Tabela de tamanhos comuns de 7Ah a 400Ah. Capacidades padrão, tensões e energia para ciclo profundo, marítimo, RV e solar."
  canonical="https://batterycalculators.com/pt/learn/common-battery-sizes-reference/"
  faqItems={faqItems}
  lang="pt"
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/pt/learn/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Voltar aos Guias</a>
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">REFERÊNCIA</span>
      <h1 class="text-display-md text-primary mb-6">Referência de Tamanhos Comuns</h1>
      <p class="text-body-md text-body font-light">
        Capacidades padrão, tensões e energia dos tamanhos mais comuns. Compare a energia 12V, 24V e 48V em toda a faixa de ciclo profundo.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <section id="capacity-table">
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Tabela de Referência de Capacidade</h2>
        <p class="text-body-md text-body font-light mb-4">
          A tabela mostra as capacidades mais comuns em ampères-hora (Ah) com a energia em watt-horas (Wh) em 12V, 24V e 48V. Energia = Ah × Tensão.
        </p>
        <div class="bg-surface-soft border border-hairline overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-body-sm min-w-[640px]">
              <thead>
                <tr class="border-b border-hairline bg-surface-card">
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Capacidade</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Energia 12V</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Energia 24V</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Energia 48V</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Uso Típico</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <tr>
                  <td class="p-4 font-mono text-primary">7 Ah</td>
                  <td class="p-4 text-muted">84 Wh</td>
                  <td class="p-4 text-muted">168 Wh</td>
                  <td class="p-4 text-muted">336 Wh</td>
                  <td class="p-4 text-muted">UPS, alarmes</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">18 Ah</td>
                  <td class="p-4 text-muted">216 Wh</td>
                  <td class="p-4 text-muted">432 Wh</td>
                  <td class="p-4 text-muted">864 Wh</td>
                  <td class="p-4 text-muted">Pequenos eletrônicos, scooters</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">35 Ah</td>
                  <td class="p-4 text-muted">420 Wh</td>
                  <td class="p-4 text-muted">840 Wh</td>
                  <td class="p-4 text-muted">1.680 Wh</td>
                  <td class="p-4 text-muted">Mobilidade, sonares pequenos</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">50 Ah</td>
                  <td class="p-4 text-muted">600 Wh</td>
                  <td class="p-4 text-muted">1.200 Wh</td>
                  <td class="p-4 text-muted">2.400 Wh</td>
                  <td class="p-4 text-muted">RV pequeno, solar portátil, pesca</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">100 Ah</td>
                  <td class="p-4 text-muted">1.200 Wh</td>
                  <td class="p-4 text-muted">2.400 Wh</td>
                  <td class="p-4 text-muted">4.800 Wh</td>
                  <td class="p-4 text-muted">RV, banco marítimo, solar</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">150 Ah</td>
                  <td class="p-4 text-muted">1.800 Wh</td>
                  <td class="p-4 text-muted">3.600 Wh</td>
                  <td class="p-4 text-muted">7.200 Wh</td>
                  <td class="p-4 text-muted">RV grande, cabana off-grid</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">200 Ah</td>
                  <td class="p-4 text-muted">2.400 Wh</td>
                  <td class="p-4 text-muted">4.800 Wh</td>
                  <td class="p-4 text-muted">9.600 Wh</td>
                  <td class="p-4 text-muted">Marítimo grande, solar residencial</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">300 Ah</td>
                  <td class="p-4 text-muted">3.600 Wh</td>
                  <td class="p-4 text-muted">7.200 Wh</td>
                  <td class="p-4 text-muted">14.400 Wh</td>
                  <td class="p-4 text-muted">Backup total, comercial</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">400 Ah</td>
                  <td class="p-4 text-muted">4.800 Wh</td>
                  <td class="p-4 text-muted">9.600 Wh</td>
                  <td class="p-4 text-muted">19.200 Wh</td>
                  <td class="p-4 text-muted">BESS, industrial, telecom</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <p class="text-caption text-muted mt-3">Energia = Capacidade (Ah) × Tensão. A energia utilizável depende dos limites de profundidade por química.</p>
      </section>

      <section id="sizes-by-application">
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Tamanhos por Aplicação</h2>
        <p class="text-body-md text-body font-light mb-4">
          Cada aplicação tem requisitos distintos. Aqui estão os tamanhos mais comuns por caso de uso e o porquê.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Pequenos Eletrônicos</h4>
            <p class="text-body-sm text-muted">
              7–35 Ah. Para UPS, alarmes, scooters de mobilidade e portáteis. Leves e compactos, para baixa potência com autonomia moderada.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">RV / Camper</h4>
            <p class="text-body-sm text-muted">
              50–200 Ah. Para luzes, refrigeração, bombas e eletrônicos off-grid. Uma LiFePO4 de 100Ah dá ~1.200Wh — suficiente para um fim de semana moderado sem rede.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Backup Solar</h4>
            <p class="text-body-sm text-muted">
              100–400 Ah. Armazena solar para a noite ou blecautes. Depende de consumo, painéis e dias de autonomia. Um banco 48V 200Ah dá 9,6kWh — típico para residências pequenas.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Marítimo</h4>
            <p class="text-body-sm text-muted">
              50–300 Ah. Bancos de serviços para navegação, iluminação, refrigeração e eletrônicos. Marítimas de ciclo profundo devem aguentar ciclagem e vibração. 100–200Ah é a faixa mais popular.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Backup Residencial</h4>
            <p class="text-body-sm text-muted">
              200–400 Ah (48V). Para cargas críticas em blecautes — geladeira, luzes, internet, médicos. Um banco 48V 200Ah (9,6kWh) roda essenciais por 1–2 dias conforme o consumo.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">BESS Comercial</h4>
            <p class="text-body-sm text-muted">
              300+ Ah. Sistemas comerciais e de utilidade. Normalmente em racks 48V ou contêineres. Unidades de 400Ah são blocos para instalações multi-MWh.
            </p>
          </CalculatorCard>
        </div>
      </section>

      <section id="form-factors">
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Formatos e Grupos BCI</h2>
        <p class="text-body-md text-body font-light mb-4">
          Baterias vêm em caixas padrão definidas pelo BCI (Battery Council International). O grupo define dimensões físicas, posição dos terminais e faixa aproximada. Escolher o grupo certo garante encaixe no compartimento.
        </p>
        <div class="bg-surface-soft border border-hairline overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-body-sm min-w-[640px]">
              <thead>
                <tr class="border-b border-hairline bg-surface-card">
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Grupo</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Dimensões (C × L × A)</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Capacidade Típica</th>
                  <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Uso Comum</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <tr>
                  <td class="p-4 font-mono text-primary">Grupo 24</td>
                  <td class="p-4 text-muted">10,25" × 6,8" × 9,9"</td>
                  <td class="p-4 text-muted">70–85 Ah</td>
                  <td class="p-4 text-muted">Marítimo, RV, ciclo profundo</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">Grupo 27</td>
                  <td class="p-4 text-muted">12,1" × 6,8" × 8,9"</td>
                  <td class="p-4 text-muted">90–110 Ah</td>
                  <td class="p-4 text-muted">RV, banco marítimo</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">Grupo 31</td>
                  <td class="p-4 text-muted">13" × 6,8" × 9,5"</td>
                  <td class="p-4 text-muted">100–125 Ah</td>
                  <td class="p-4 text-muted">Caminhões, marítimo</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">Grupo 4D</td>
                  <td class="p-4 text-muted">20,8" × 8,5" × 9,7"</td>
                  <td class="p-4 text-muted">150–210 Ah</td>
                  <td class="p-4 text-muted">Marítimo grande, comercial</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">Grupo 8D</td>
                  <td class="p-4 text-muted">20,8" × 11" × 10"</td>
                  <td class="p-4 text-muted">220–300 Ah</td>
                  <td class="p-4 text-muted">Industrial, telecom, BESS</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <p class="text-body-md text-body font-light mt-4">
          Baterias rack (comuns em LiFePO4) usam formato padrão de rack 19 polegadas em vez de grupos BCI. São medidas em unidades de rack (U) para instalações em rack ou parede em solar e backup.
        </p>
      </section>

      <CalculatorCard class="border-m-blue-light">
        <h4 class="text-label-uppercase text-primary text-xs mb-3">Experimente</h4>
        <p class="text-body-sm text-muted mb-4">
          Use a Calculadora de Dimensionamento para saber exatamente quanta capacidade você precisa por carga, autonomia e tensão.
        </p>
        <a href="/pt/tools/battery-sizing-calculator/" class="btn-primary text-xs py-3 px-6 inline-block">Abrir Calculadora de Dimensionamento</a>
      </CalculatorCard>

      <ReferenceTable
        title="Referência de Capacidade e Energia"
        description="Baixe esta tabela para referência offline"
        headers={["Capacidade", "Energia 12V", "Energia 24V", "Energia 48V", "Uso Típico"]}
        rows={[
          ["7 Ah", "84 Wh", "168 Wh", "336 Wh", "UPS, alarmes"],
          ["18 Ah", "216 Wh", "432 Wh", "864 Wh", "Pequenos eletrônicos, scooters"],
          ["35 Ah", "420 Wh", "840 Wh", "1.680 Wh", "Mobilidade, sonares pequenos"],
          ["50 Ah", "600 Wh", "1.200 Wh", "2.400 Wh", "RV pequeno, solar portátil, pesca"],
          ["100 Ah", "1.200 Wh", "2.400 Wh", "4.800 Wh", "RV, banco marítimo, solar"],
          ["150 Ah", "1.800 Wh", "3.600 Wh", "7.200 Wh", "RV grande, cabana off-grid"],
          ["200 Ah", "2.400 Wh", "4.800 Wh", "9.600 Wh", "Marítimo grande, solar residencial"],
          ["300 Ah", "3.600 Wh", "7.200 Wh", "14.400 Wh", "Backup total, comercial"],
          ["400 Ah", "4.800 Wh", "9.600 Wh", "19.200 Wh", "BESS, industrial, telecom"],
        ]}
        source="Battery University / BCI"
      />

      <ReferenceTable
        title="Grupos de Bateria e Dimensões"
        description="Baixe esta tabela para referência offline"
        headers={["Grupo", "Dimensões (C × L × A)", "Capacidade Típica", "Uso Comum"]}
        rows={[
          ["Grupo 24", '10,25" × 6,8" × 9,9"', "70–85 Ah", "Marítimo, RV, ciclo profundo"],
          ["Grupo 27", '12,1" × 6,8" × 8,9"', "90–110 Ah", "RV, banco marítimo"],
          ["Grupo 31", '13" × 6,8" × 9,5"', "100–125 Ah", "Caminhões, marítimo"],
          ["Grupo 4D", '20,8" × 8,5" × 9,7"', "150–210 Ah", "Marítimo grande, comercial"],
          ["Grupo 8D", '20,8" × 11" × 10"', "220–300 Ah", "Industrial, telecom, BESS"],
        ]}
        source="Tabela BCI / Battery University"
      />

      <FAQSection items={faqItems} />

      <RelatedTools tools={relatedTools} />

      <section class="border-t border-hairline pt-12">
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Referências</h2>
        <ul class="flex flex-col gap-2 text-body-sm text-muted">
          {references.map((ref) => (
            <li class="flex gap-2">
              <span class="text-m-blue-light shrink-0">—</span>
              <a href={ref.url} class="hover:text-primary transition-colors underline underline-offset-2" target="_blank" rel="noopener noreferrer">{ref.title}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
