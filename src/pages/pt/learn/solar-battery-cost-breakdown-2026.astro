              </tr>
              <tr>
                <td class="p-4 text-muted">Custo total em 15 anos (só bateria)</td>
                <td class="p-4 font-mono text-primary">$5,000 – $8,000</td>
                <td class="p-4 font-mono text-primary">$7,500 – $15,000</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Energia total entregue em 15 anos</td>
