                  <td class="p-4 text-muted">Zona de descarga profunda</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">20%</td>
                  <td class="p-4 text-muted">11.76V</td>
                  <td class="p-4 text-muted">23.52V</td>
