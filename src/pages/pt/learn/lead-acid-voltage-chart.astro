          description="Relação aproximada para um pack de 12V; a tensão do chumbo-ácido é geralmente mais linear que a do LiFePO4."
          xLabel="SOC %"
          yLabel="Tensão (V)"
          data={[
            { x: 0, y: 11.5, label: "0%" },
            { x: 10, y: 11.64, label: "10%" },
            { x: 20, y: 11.76, label: "20%" },
            { x: 30, y: 11.88, label: "30%" },
            { x: 40, y: 12.0, label: "40%" },
            { x: 50, y: 12.12, label: "50%" },
            { x: 60, y: 12.24, label: "60%" },
            { x: 70, y: 12.34, label: "70%" },
            { x: 80, y: 12.46, label: "80%" },
            { x: 90, y: 12.58, label: "90%" },
            { x: 100, y: 12.7, label: "100%" },
          ]}
          yMin={11.0}
          yMax={13.2}
          caption="Valores de chumbo-ácido ventilada a 25°C. A tensão real varia por fabricante, idade, temperatura e condições de medição."
