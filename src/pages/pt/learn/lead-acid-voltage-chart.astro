---
import Layout from "../../../layouts/Layout.astro";
import CalculatorCard from "../../../components/CalculatorCard.astro";
import FAQSection from "../../../components/FAQSection.astro";
import ReferenceChart from "../../../components/ReferenceChart.astro";
import ReferenceTable from "../../../components/ReferenceTable.astro";

const faqItems = [
  {
    question:
      "Qual é a tensão de repouso de uma bateria de chumbo-ácido 12V totalmente carregada?",
    answer:
      "Uma bateria ventilada de chumbo-ácido totalmente carregada repousa em aproximadamente 12,6–12,8V. Baterias AGM e gel normalmente repousam um pouco acima, em 12,8–13,0V. Após a carga, a carga superficial pode elevar a leitura para 13,0–13,4V, então aguarde pelo menos 30 minutos antes de medir a tensão de repouso.",
  },
  {
    question: "Como a temperatura afeta as leituras de tensão do chumbo-ácido?",
    answer:
      "A temperatura afeta o equilíbrio químico das células. O frio aumenta a resistência interna e reduz as leituras. A 0°C, uma bateria cheia pode ler 0,2–0,3V abaixo do valor a 25°C. Em calor alto (acima de 40°C), as leituras podem ficar levemente elevadas. Compense sempre a temperatura ao estimar o SOC pela tensão.",
  },
  {
    question: "O que é carga superficial?",
    answer:
      "Carga superficial é uma elevação temporária da tensão após a carga. É causada pela concentração desigual de ácido perto das placas. Dissipasse em 30–60 minutos de repouso. Medir logo após carregar dá uma leitura falsamente alta de SOC. Deixe a bateria repousar antes de medir.",
  },
  {
    question:
      "Baterias ventiladas, AGM e gel têm curvas de tensão diferentes?",
    answer:
      "Sim. AGM e gel têm tensões de repouso levemente maiores que ventiladas no mesmo SOC. AGM normalmente repousa 0,1–0,2V acima da ventilada. Gel é similar à AGM. As diferenças são pequenas, mas relevantes ao estimar o SOC pela tensão. Use a curva correta para seu tipo.",
  },
];

const tableOfContents = [
  { id: "flooded-lead-acid", label: "Chumbo-Ácido Ventilada" },
  { id: "agm-gel", label: "AGM e Gel" },
  { id: "surface-charge", label: "Carga Superficial" },
  { id: "temperature-effects", label: "Efeitos da Temperatura" },
  { id: "common-mistakes", label: "Erros Comuns" },
];

const relatedCalculators = [
  {
    title: "Calculadora de Dimensionamento de Bateria",
    href: "/pt/tools/battery-sizing-calculator/",
  },
  { title: "Calculadora de Autonomia de Bateria", href: "/pt/tools/runtime-calculator/" },
];

const references = [
  {
    title: "Battery University — Tensão de Chumbo-Ácido",
    url: "https://batteryuniversity.com/article/bu-403-lead-acid",
  },
  {
    title: "Concorde Battery — Especificações AGM",
    url: "https://www.concordebattery.com/products/sealed-lead-acid/",
  },
];
---

<Layout
  title="Tabela de Tensão de Bateria Chumbo-Ácido — Referência de SOC | Calculadoras de Bateria"
  description="Tabelas de referência de tensão para baterias de chumbo-ácido ventiladas, AGM e gel a 12V, 24V e 48V. Tensão aproximada de repouso por estado de carga."
  canonical="https://batterycalculators.com/pt/learn/lead-acid-voltage-chart/"
  faqItems={faqItems}
  lang="pt"
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a
        href="/pt/learn/"
        class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block"
        >&larr; Voltar aos Guias</a
      >
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4"
        >REFERÊNCIA</span
      >
      <h1 class="text-display-md text-primary mb-6">
        Tabela de Tensão de Bateria Chumbo-Ácido
      </h1>
      <p class="text-body-md text-body font-light">
        Valores aproximados de tensão de repouso para baterias de chumbo-ácido
        ventiladas, AGM e gel nas tensões comuns de banco. Use esta tabela para estimar o
        estado de carga a partir de leituras de tensão.
