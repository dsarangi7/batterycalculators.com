---
import Layout from '../../../layouts/Layout.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import FormulaBox from '../../../components/FormulaBox.astro';
import FAQSection from '../../../components/FAQSection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const faqItems = [
  {
    question: "Quanto tempo uma bateria de 300Ah alimenta uma casa?",
    answer: "Uma bateria LFP de 300Ah 48V armazena 15.360 Wh no total, com 12.288 Wh utilizáveis a 80% de DoD. Para uma casa que consome 10 kWh/dia, isso fornece aproximadamente 1,1 dia de autonomia. Apenas para cargas essenciais (2–3 kWh/dia), dura 4–5 dias.",
  },
  {
    question: "Quanto tempo dura uma bateria de 300Ah 12V no camping?",
    answer: "A 12,8V, uma bateria LFP de 300Ah fornece 3.072 Wh utilizáveis a 80% de DoD. Para cargas típicas de camping (geladeira 50W, luzes 24W, celular 15W = 89W), a autonomia é de aproximadamente 31 horas — suficiente para 3 dias de camping sem recarga.",
  },
  {
    question: "Quantos painéis solares para carregar uma bateria de 300Ah?",
    answer: "Uma bateria LFP de 300Ah 48V armazena 15.360 Wh. Com 5 horas de sol pleno, você precisa de aproximadamente 3.072W de painéis solares (antes das perdas). Um arranjo de 3,5–4 kW considera perdas do sistema e margem para dias nublados.",
  },
  {
    question: "Uma bateria de 300Ah é boa para backup residencial?",
    answer: "Uma bateria LFP de 300Ah 48V (15,36 kWh) oferece excelente backup noturno para cargas essenciais. Ela alimenta geladeira, roteador, luzes e dispositivos médicos por mais de 12 horas. Para backup de vários dias, considere baterias em paralelo ou um banco maior.",
  },
];
---

<Layout
  title="Quanto Tempo Dura uma Bateria de 300Ah? | Calculadoras de Bateria"
  description="Exemplos de autonomia para baterias de 300Ah em backup residencial, RV, marítimo e solar off-grid. Inclui cálculos resolvidos e orientação de dimensionamento."
  canonical="https://batterycalculators.com/pt/learn/how-long-will-a-300ah-battery-last/"
  schema="faqPage"
  schemaName="Quanto Tempo Dura uma Bateria de 300Ah"
  schemaDescription="Exemplos de autonomia para baterias de 300Ah em cenários comuns de carga."
  schemaUrl="https://batterycalculators.com/pt/learn/how-long-will-a-300ah-battery-last/"
  faqItems={faqItems}
  lang="pt"
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/pt/learn/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">← Voltar aos Guias</a>
      <Breadcrumb items={[
        { label: "Centro de Aprendizagem", href: "/pt/learn/" },
        { label: "Quanto Tempo Dura uma Bateria de 300Ah" }
      ]} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">EXEMPLOS PRÁTICOS</span>
      <h1 class="text-display-md text-primary mb-6">Quanto Tempo Dura uma Bateria de 300Ah?</h1>
      <p class="text-body-md text-body font-light">
        Uma bateria de 300Ah é uma capacidade intermediária comumente usada em sistemas maiores de RV, pequeno backup residencial e cabanas off-grid. A 48V, ela fornece mais de 15 kWh de energia total — suficiente para backup residencial noturno relevante ou vários dias de camping.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Energia por Tensão</h2>
        <div class="bg-surface-soft border border-hairline overflow-hidden">
          <table class="w-full text-left text-body-sm">
            <thead>
              <tr class="border-b border-hairline bg-surface-card">
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Tensão</th>
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Energia total</th>
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Utilizável (80% DoD)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="p-4 font-mono text-primary">12.8V</td>
                <td class="p-4 text-muted">3.840 Wh</td>
                <td class="p-4 font-mono text-primary">3.072 Wh</td>
              </tr>
              <tr>
                <td class="p-4 font-mono text-primary">25.6V</td>
                <td class="p-4 text-muted">7.680 Wh</td>
                <td class="p-4 font-mono text-primary">6.144 Wh</td>
              </tr>
              <tr>
                <td class="p-4 font-mono text-primary">51.2V</td>
                <td class="p-4 text-muted">15.360 Wh</td>
                <td class="p-4 font-mono text-primary">12.288 Wh</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <FormulaBox title="Fórmula de Autonomia">
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          Autonomia (h) = Capacidade (Ah) × Tensão (V) × DoD / (Carga (W) / Eficiência)
        </div>
      </FormulaBox>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Tabela de Autonomia: LFP 300Ah 48V</h2>
        <p class="text-body-md text-body font-light mb-4">
          Com 80% de DoD e 92% de eficiência, uma bateria LFP de 300Ah 48V fornece 12.288 Wh de energia utilizável:
        </p>
        <div class="bg-surface-soft border border-hairline overflow-hidden">
          <table class="w-full text-left text-body-sm">
            <thead>
              <tr class="border-b border-hairline bg-surface-card">
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Carga</th>
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Potência (W)</th>
                <th class="p-4 text-label-uppercase text-primary text-xs tracking-wider">Autonomia</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="p-4 text-muted">Roteador + luzes + celular</td>
                <td class="p-4 font-mono text-primary">50 W</td>
                <td class="p-4 font-mono text-primary">~226 horas</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Geladeira + essenciais</td>
                <td class="p-4 font-mono text-primary">150 W</td>
                <td class="p-4 font-mono text-primary">~75 horas</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">TV + notebook + luzes</td>
                <td class="p-4 font-mono text-primary">250 W</td>
                <td class="p-4 font-mono text-primary">~45 horas</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Ar-condicionado pequeno</td>
                <td class="p-4 font-mono text-primary">800 W</td>
                <td class="p-4 font-mono text-primary">~14 horas</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Chaleira elétrica</td>
                <td class="p-4 font-mono text-primary">1.500 W</td>
                <td class="p-4 font-mono text-primary">~7,4 horas</td>
              </tr>
              <tr>
                <td class="p-4 text-muted">Micro-ondas + geladeira</td>
                <td class="p-4 font-mono text-primary">2.000 W</td>
                <td class="p-4 font-mono text-primary">~5,5 horas</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Cenário: Backup Residencial</h2>
        <p class="text-body-md text-body font-light mb-4">
          Para backup residencial noturno com cargas essenciais:
        </p>
        <CalculatorCard>
          <div class="flex flex-col gap-4 text-body-sm text-muted">
            <p><strong>Dados:</strong> 300 Ah a 48V LFP, 80% de DoD, 92% de eficiência</p>
            <p><strong>Cargas:</strong> Geladeira (60W) + roteador (10W) + 4 lâmpadas LED (24W) + celular (15W) + CPAP (30W) = 139W</p>
            <p><strong>Energia utilizável:</strong></p>
            <div class="font-mono text-primary pl-4 border-l-2 border-m-blue-light">
              300 × 48 × 0,80 = 11.520 Wh
            </div>
            <p><strong>Carga efetiva:</strong></p>
            <div class="font-mono text-primary pl-4 border-l-2 border-m-blue-light">
              139 / 0,92 = 151 W
            </div>
            <p><strong>Autonomia:</strong></p>
            <div class="font-mono text-primary pl-4 border-l-2 border-m-blue-light">
              11.520 / 151 = 76,3 horas ≈ 3,2 dias
            </div>
          </div>
        </CalculatorCard>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <CalculatorCard class="border-m-blue-light">
          <h4 class="text-label-uppercase text-primary text-xs mb-3">Experimente</h4>
          <p class="text-body-sm text-muted mb-4">
            Use a Calculadora de Autonomia para sua configuração específica.
          </p>
          <a href="/pt/tools/runtime-calculator/" class="btn-primary text-xs py-3 px-6 inline-block">Abrir Calculadora de Autonomia</a>
        </CalculatorCard>
        <CalculatorCard class="border-m-blue-light">
          <h4 class="text-label-uppercase text-primary text-xs mb-3">Relacionado</h4>
          <p class="text-body-sm text-muted mb-4">
            Dimensione um arranjo solar para manter seu banco de 300Ah totalmente carregado.
          </p>
          <a href="/pt/tools/solar-battery-sizing-calculator/" class="btn-primary-outline text-xs py-3 px-6 inline-block">Calculadora Solar</a>
        </CalculatorCard>
      </div>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Artigos Relacionados</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Quanto Tempo Dura uma Bateria de 200Ah?</h4>
            <p class="text-body-sm text-muted mb-3">Exemplos de autonomia para baterias de 200Ah em cargas comuns.</p>
            <a href="/pt/learn/how-long-will-a-200ah-battery-last/" class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors">Ler Guia →</a>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">Quanto Tempo Durará uma Bateria?</h4>
            <p class="text-body-sm text-muted mb-3">O método geral para calcular autonomia a partir de capacidade e carga.</p>
            <a href="/pt/learn/how-long-will-a-battery-last/" class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors">Ler Guia →</a>
          </CalculatorCard>
        </div>
      </section>

      <FAQSection items={faqItems} />
    </div>
  </div>
</Layout>
