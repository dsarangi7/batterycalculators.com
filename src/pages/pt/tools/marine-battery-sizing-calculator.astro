        { label: "Banco Doméstico", icon: "battery" },
        { label: "Banco de Partida", icon: "battery" },
        { label: "Cargas Marítimas", icon: "load" },
      ]}
    />
  </section>

  <section class="mb-16">
    <ComparisonTable
      title="Padrões de Baterias Marítimas"
      headers={["Padrão", "Escopo", "Requisitos Principais", "Limite de Queda de Tensão"]}
      rows={[
        ["ISO 13297", "Instalação elétrica marítima", "Dimensionamento de cabos, fusíveis, sinalização", "3% crítico / 10% não crítico"],
        ["ABYC E-11", "Sistemas AC/DC em barcos", "Codificação de cores de fios, proteção contra sobrecorrente", "3% para instrumentos do leme"],
        ["USCG 33 CFR 183", "Sistemas elétricos em barcos", "Proteção contra ignição, ligação de tanques de combustível", "N/A (focado em segurança)"],
        ["IEC 60092", "Instalações elétricas marítimas", "Fiação a bordo, quadros de comando", "Varia por tipo de circuito"],
      ]}
