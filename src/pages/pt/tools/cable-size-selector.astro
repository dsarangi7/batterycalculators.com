---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import InputField from '../../../components/InputField.astro';
import ResultBox from '../../../components/ResultBox.astro';
import FormulaBox from '../../../components/FormulaBox.astro';
import FAQSection from '../../../components/FAQSection.astro';
import WorkedExample from '../../../components/WorkedExample.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import EngineeringDiagram from '../../../components/EngineeringDiagram.astro';

const whatIs = `O dimensionamento de cabos para sistemas de energia DC determina a seção transversal mínima do condutor que satisfaz tanto a <strong>capacidade de corrente</strong> (capacidade térmica de condução de corrente) quanto os limites de <strong>queda de tensão</strong>. A capacidade de corrente é regida por padrões IEC/Código Nacional de Eletricidade e previne o derretimento do isolamento por aquecimento resistivo. A queda de tensão depende da corrente, comprimento do cabo, material do condutor e seção transversal — e deve permanecer abaixo de limiares específicos da aplicação (3% para cargas críticas marinhas, 2% para fiação DC solar). O tamanho correto do cabo é o maior dos dois mínimos: o mínimo de capacidade de corrente e o mínimo de queda de tensão.`;

const whyItMatters = [
  "Cabos subdimensionados causam queda de tensão que aciona desconectamentos de baixa tensão do BMS e desligamentos de inversores.",
  "Um cabo seguro pelos padrões de capacidade de corrente pode ainda apresentar queda de tensão inaceitável em trechos longos.",
  "Em sistemas 12V, uma queda de 0,5V representa 4% de perda — suficiente para escurecer luzes e derrubar eletrônicos.",
  "Tensões mais altas do sistema (48V vs 12V) reduzem a corrente para a mesma potência, reduzindo dramaticamente os requisitos de cabo.",
  "A resistência do cobre aumenta 0,393% por °C — ambientes quentes exigem cabos maiores.",
];

const practicalApplications = [
  { title: "Sistemas Elétricos Marinhos", description: "Dimensione cabos de bateria para atender limites de queda de tensão ISO 13297 para navegação e propulsão." },
  { title: "Fiação DC Solar PV", description: "Calcule o dimensionamento do fio do controlador de carga ao banco de baterias." },
  { title: "Automotivo e RV", description: "Dimensione cabos de bateria a inversor para sistemas 12V e 24V de alta corrente." },
  { title: "Fiação de Cabana Off-Grid", description: "Selecione tamanhos de cabo para trechos longos entre bancos de baterias remotos e cargas." },
  { title: "Distribuição DC Telecom", description: "Verifique o dimensionamento de cabos para distribuição DC 48V para equipamentos de telecom." },
];

const expertNotes = [
  { title: 'Dimensionamento por Dois Critérios', variant: 'engineering', content: 'Sempre verifique AMBOS capacidade de corrente e queda de tensão. Um cabo pode ser termicamente seguro (capacidade OK) mas ainda apresentar queda de tensão excessiva em trechos longos. O tamanho final do cabo é o maior dos dois mínimos.' },
  { title: 'Redução por Temperatura', variant: 'warning', content: 'A resistência do cobre aumenta 0,393% por °C. A 60°C (compartimento do motor), a resistência do cabo é 15,7% maior que a 20°C. Sempre conte com a temperatura real de operação, não a temperatura ambiente do salão.' },
];

const trustSection = {
  text: "Esta calculadora usa o modelo padrão de queda de tensão baseado em resistividade com fatores de correção de temperatura. Valores de capacidade de corrente seguem IEC 60364 e tabelas do Capítulo 3 da NEC. Todas as fórmulas e valores intermediários são exibidos para verificação independente.",
  link: { label: "Ver nossa metodologia completa", href: "/methodology/" },
};

const references = [
  { title: "IEC 60364 — Instalações Elétricas de Baixa Tensão", url: "https://www.iec.ch/", source: "International Electrotechnical Commission" },
  { title: "NEC Capítulo 3 — Métodos e Materiais de Fiação", url: "https://www.nfpa.org/codes-and-standards/nfpa-70-standard-for-electrical-safety-in-the-workplace", source: "NFPA / National Electrical Code" },
  { title: "ISO 13297 — Instalação Elétrica Marinha", url: "https://www.iso.org/standard/68333.html", source: "International Organization for Standardization" },
  { title: "Copper Development Association — Tabelas de Fios", url: "https://www.copper.org/", source: "Copper Development Association" },
];

const faqItems = [
  {
    question: "Qual é a diferença entre dimensionamento por capacidade de corrente e queda de tensão?",
    answer: "A capacidade de corrente é a corrente máxima que um cabo pode suportar sem superaquecer (segurança contra incêndio). A queda de tensão é a tensão perdida ao longo do comprimento do cabo (desempenho. Você deve satisfazer AMBOS os critérios — use o tamanho de cabo maior.",
  },
  {
    question: "Por que a queda de tensão é mais crítica em sistemas 12V?",
    answer: "Uma carga de 400W consome 33A a 12V, mas apenas 8,3A a 48V. A 12V, uma queda de 0,5V é 4,2% de perda. A 48V, o mesmo cabo produz apenas uma queda de 0,12V (0,25%). Tensão mais alta reduz dramaticamente os requisitos de cabo.",
  },
  {
    question: "Que fio AWG preciso para 30 amperes a 5 metros?",
    answer: "Para 30A a 5m em um sistema 12V com queda máxima de 3%: 6 AWG (13,3 mm²) de cobre. A 48V, 10 AWG (5,26 mm²) é suficiente. Sempre verifique a capacidade de corrente também — 10 AWG é nominal para 30A ao ar livre.",
  },
  {
    question: "Devo usar cabo de cobre ou alumínio?",
    answer: "Cobre é preferido para a maioria das instalações de bateria/solar: menor resistência, maior flexibilidade, sem problemas de oxidação. Alumínio é mais leve e barato, mas precisa de 1,6× a seção transversal e composto anti-óxido nas conexões.",
  },
  {
    question: "Qual é a porcentagem aceitável de queda de tensão?",
    answer: "Sistemas de energia DC: máximo 3% para cargas críticas (navegação, segurança), 5% para cargas gerais, 10% para iluminação não crítica. Fiação DC solar visa ≤2% entre controlador de carga e bateria.",
  },
  {
    question: "Como o comprimento do cabo afeta a queda de tensão?",
    answer: "A queda de tensão é diretamente proporcional ao comprimento. Dobrar a distância do cabo dobra a queda. Para um cabo de 5m com queda de 0,5V, um cabo de 10m terá queda de 1,0V na mesma corrente e tamanho de fio.",
  },
  {
    question: "Posso usar um cabo que passa na capacidade de corrente mas falha na queda de tensão?",
    answer: "Não. O cabo será termicamente seguro, mas os equipamentos funcionarão incorretamente devido à tensão insuficiente. O dimensionamento por queda de tensão é um requisito de desempenho, não apenas uma recomendação.",
  },
  {
    question: "Como a temperatura afeta o dimensionamento do cabo?",
    answer: "Temperaturas mais altas aumentam a resistência do condutor (0,393%/°C para cobre). Um cabo nominal para 30A a 20°C pode suportar apenas 25A a 60°C. Sempre reduza a capacidade de corrente para a temperatura real de operação.",
  },
  {
    question: "O que é resistência de malha?",
    answer: "A resistência de malha é a resistência total dos condutores positivo e de retorno. Como a corrente flui para fora e volta, o comprimento total do cabo é 2× a distância unidirecional. Resistência de malha = ρ × (2 × distância) / área.",
  },
  {
    question: "Como medir a queda de tensão real?",
    answer: "Meça a tensão nos terminais da bateria sob carga, depois nos terminais da carga sob a mesma carga. A diferença é a queda de tensão. Compare a porcentagem com os limites do seu sistema.",
  },
];

const commonMistakes = [
  "Usar distância unidirecional em vez de distância de malha — a queda de tensão se aplica a ambos os condutores de alimentação e retorno. Sempre dobre a distância unidirecional.",
  "Verificar apenas capacidade de corrente, não queda de tensão — um cabo seguro pelos padrões térmicos pode ainda causar mau funcionamento do equipamento em trechos longos.",
  "Ignorar efeitos de temperatura — a 60°C, a resistência do cobre é 15,7% maior que a 20°C. Ambientes quentes precisam de cabos maiores.",
  "Usar tensão nominal em vez da tensão real da bateria — uma queda de 0,5V a 12,8V é 3,9%, mas a 12,0V é 4,2%.",
  "Esquecer resistência de conexão — terminais corroídos e parafusos frouxos adicionam resistência significativa não incluída em cálculos apenas do cabo.",
  "Usar alumínio sem aumento de tamanho — alumínio precisa de 1,6× a seção transversal do cobre para mesma queda de tensão.",
  "Não considerar corrente de pico vs. média — queda de tensão é proporcional à corrente. Cargas de pico causam quedas transitórias que acionam falhas do BMS.",
  "Assumir que tamanho de cabo é o mesmo para todas as tensões — uma carga de 2kW precisa de 167A a 12V, mas apenas 42A a 48V, exigindo cabos dramaticamente diferentes.",
];

const relatedArticles = [
  { href: "/learn/voltage-drop-explained/", title: "Queda de Tensão Explicada" },
  { href: "/reference/awg-wire-size-chart/", title: "Guia de Dimensionamento de Cabo DC" },
  { href: "/reference/marine-electrical-standards/", title: "Dimensionamento de Fio Marinho" },
];
---

<CalculatorLayout
  title="Seletor de Tamanho de Cabo | Calculadoras de Bateria"
  description="Selecione o tamanho correto do cabo para seu sistema DC com base em limites de queda de tensão, capacidade de corrente e material do condutor."
  faqItems={faqItems}
  commonMistakes={commonMistakes}
  relatedArticles={relatedArticles}
  relatedCalculators={[
    { href: "/tools/voltage-drop-calculator/", title: "Calculadora de Queda de Tensão", description: "Calcule a queda de tensão para um cabo específico." },
    { href: "/tools/dc-cable-loss-calculator/", title: "Perda de Cabo DC", description: "Calcule perdas de potência resistiva diretamente." },
    { href: "/tools/battery-sizing-calculator/", title: "Ferramenta de Dimensionamento de Bateria", description: "Determine requisitos de dimensionamento por consumo diário." },
    { href: "/tools/parallel-string-calculator/", title: "Ferramenta de String Paralela", description: "Configure layouts de strings série e paralelo." },
    { href: "/tools/runtime-calculator/", title: "Calculadora de Autonomia", description: "Calcule autonomia a partir de perfis de potência." },
    { href: "/tools/battery-pack-calculator/", title: "Calculadora de Pacote de Bateria", description: "Projete configurações de células série/paralelo." },
  ]}
  whatIs={whatIs}
  whyItMatters={whyItMatters}
  practicalApplications={practicalApplications}
  trustSection={trustSection}
  references={references}
  expertNotes={expertNotes}
  lang="pt"
>

  <!-- Main Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mb-16">

    <!-- Input Form -->
    <CalculatorCard>
      <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">Parâmetros do Sistema</h3>
      <div class="flex flex-col gap-6">
        <InputField id="voltage" label="Tensão DC do Sistema (V)" value={12.8} min={1} step="any" helperText="Tensão nominal da bateria. Comum: 12,8V, 25,6V, 51,2V." />
        <InputField id="power" label="Potência da Carga (Watts)" value={500} min={1} step="any" helperText="Potência contínua total consumida da bateria." />
        <InputField id="distance" label="Distância Unidirecional do Cabo (metros)" value={5} min={0.1} step="any" helperText="Distância da bateria à carga. A calculadora dobra isto para a malha." />
        <InputField
          id="material"
          label="Material do Condutor"
          type="select"
          value="copper"
          options={[
            { label: "Cobre (Alta condutividade)", value: "copper" },
            { label: "Alumínio (Menor custo, mais leve)", value: "aluminum" },
          ]}
        />
        <InputField id="temperature" label="Temperatura de Operação (°C)" value={30} min={-40} max={200} helperText="Temperatura ambiente onde o cabo é instalado. Afeta a resistência." />
        <InputField id="max-drop" label="Queda de Tensão Máx. Permitida (%)" value={3} min={0.5} max={10} step={0.5} helperText="Crítico marinho: 3%, Solar DC: 2%, Geral: 5%, Não crítico: 10%." />
      </div>
    </CalculatorCard>

    <!-- Calculation Results -->
    <CalculatorCard class="border-m-blue-light flex flex-col justify-between">
      <div>
        <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">Recomendação de Cabo</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <ResultBox
            label="Tamanho de Cabo Recomendado"
            value="6 AWG"
            suffix="13,3 mm² cobre"
            variant="primary"
            id="result-cable"
          />
          <ResultBox
            label="Queda de Tensão"
            value="2,48%"
            suffix="0,32V ao longo da malha"
            id="result-drop"
          />
          <ResultBox
            label="Corrente da Carga"
            value="39,1 A"
            suffix="Consumo contínuo"
            id="result-current"
          />
          <ResultBox
            label="Perda de Potência no Cabo"
            value="12,4 W"
            suffix="2,48% da potência da carga"
            id="result-loss"
          />
        </div>
      </div>

      <!-- Action Area -->
      <div class="border-t border-hairline pt-6">
        <h4 class="text-label-uppercase text-primary text-xs mb-2">Notas de Dimensionamento de Cabo</h4>
        <p class="text-body-sm text-muted" id="cable-notes">
          A 12,8V, o cabo recomendado atende tanto o limite de queda de tensão quanto os requisitos de capacidade de corrente. Verifique ambos os critérios antes de selecionar.
        </p>
      </div>
    </CalculatorCard>

  </div>

  <!-- AWG Voltage Drop Table -->
  <section class="mb-16 border-t border-hairline pt-12">
    <h2 class="text-title-lg text-primary uppercase mb-6 tracking-wider">Queda de Tensão por Tamanho AWG</h2>
    <p class="text-body-sm text-muted mb-8">Comparação interativa de queda de tensão para os parâmetros do seu sistema. A linha destacada atende seu limite de queda de tensão.</p>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b border-hairline">
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Tamanho AWG</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Área (mm²)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Cap. Corrente (A)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Queda de Tensão (%)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Perda (W)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Status</th>
          </tr>
        </thead>
        <tbody id="awg-table-body">
        </tbody>
      </table>
    </div>
  </section>

  <!-- Formulas and Worked Examples -->
  <section class="mb-16 border-t border-hairline pt-12">
    <h2 class="text-display-sm text-primary uppercase tracking-wider mb-8">Fórmulas e Exemplos Práticos</h2>
    <FormulaBox title="Fórmulas Matemáticas">
      <p>
        O dimensionamento de cabo requer a satisfação de dois critérios independentes — capacidade de corrente e queda de tensão:
      </p>
      <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
        Corrente da Carga (A) = Potência (W) / Tensão do Sistema (V)
      </div>
      <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
        Resistência da Malha (Ω) = ρ(T) × (2 × Distância) / Área
      </div>
      <p>
        Onde ρ(T) é a resistividade corrigida por temperatura:
      </p>
      <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
        ρ(T) = ρ(20°C) × [1 + α × (T - 20)]
      </div>
      <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
        Queda de Tensão (%) = (I × R_malha / V_fonte) × 100
      </div>
      <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
        Área Mín. para Queda = ρ(T) × 2L / R_máx
        onde R_máx = (V × queda_máx%) / (100 × I)
      </div>
    </FormulaBox>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      <WorkedExample
        number={1}
        title="Circuito Marinho 12V — 30A, 5m"
        scenario="Dimensione um cabo de cobre para um circuito de luz de navegação de 30A com trecho unidirecional de 5m em um sistema de 12,8V a 25°C. Máximo 3% de queda de tensão."
        inputs={[
          { label: "Tensão do Sistema", value: "12,8 V" },
          { label: "Corrente da Carga", value: "30 A" },
          { label: "Distância Unidirecional", value: "5 m (10 m malha)" },
          { label: "Condutor", value: "Cobre a 25°C" },
          { label: "Queda Máx.", value: "3%" },
        ]}
        steps={[
          { label: "Passo 1: Resistência máx. permitida", formula: "R_máx = (12,8 × 0,03) / 30", result: "0,0128 Ω" },
          { label: "Passo 2: Área necessária do cabo", formula: "A = 1,72×10⁻⁸ × 10 / 0,0128", result: "13,44 mm²" },
          { label: "Passo 3: Selecionar AWG", formula: "13,44 mm² → 6 AWG (13,3 mm²)", result: "6 AWG" },
          { label: "Passo 4: Queda real de tensão", formula: "V_queda = 30 × (1,72e-8 × 10 / 13,3e-6)", result: "0,388V (3,03%)" },
        ]}
        answer="6 AWG (13,3 mm²) cobre — atende o limite de 3% de queda de tensão."
        interpretation="A 3,03%, está bem no limite. Para margem confortável, 4 AWG (21,15 mm²) reduz a queda para 1,9%. Para navegação crítica, sempre adicione margem."
        variant="marine"
      />

      <WorkedExample
        number={2}
        title="Sistema Solar 48V — Controlador 20A, 15m"
        scenario="Um sistema solar 48V com controlador de carga de 20A ao longo de um trecho de 15m a 35°C. Fiação DC solar visa ≤2% de queda."
        inputs={[
          { label: "Tensão do Sistema", value: "51,2 V" },
          { label: "Corrente de Carga", value: "20 A" },
          { label: "Distância Unidirecional", value: "15 m (30 m malha)" },
          { label: "Condutor", value: "Cobre a 35°C" },
          { label: "Queda Máx.", value: "2%" },
        ]}
        steps={[
          { label: "Passo 1: Resistividade corrigida pela temp.", formula: "ρ(35°C) = 1,72×10⁻⁸ × [1 + 0,00393 × 15]", result: "1,82×10⁻⁸ Ω·m" },
          { label: "Passo 2: Resistência máx. permitida", formula: "R_máx = (51,2 × 0,02) / 20", result: "0,0512 Ω" },
          { label: "Passo 3: Área necessária do cabo", formula: "A = 1,82×10⁻⁸ × 30 / 0,0512", result: "10,66 mm²" },
          { label: "Passo 4: Selecionar AWG", formula: "10,66 mm² → 8 AWG (8,37) ou 6 AWG (13,3)", result: "6 AWG recomendado" },
        ]}
        answer="6 AWG (13,3 mm²) cobre — alcança 1,44% de queda de tensão, bem dentro do alvo de 2%."
        interpretation="Tensão mais alta do sistema (48V vs 12V) mantém a corrente baixa. Com distância de 15m, 6 AWG fornece margem confortável abaixo do alvo de 2% para DC solar."
        variant="solar"
      />

      <WorkedExample
        number={3}
        title="Inversor RV 12V — 2000W, 1m"
        scenario="Um inversor de 2000W consome 167A de uma bateria 12V. Dimensione o cabo para trecho de 1m com ≤3% de queda."
        inputs={[
          { label: "Potência do Inversor", value: "2000 W" },
          { label: "Tensão do Sistema", value: "12,8 V" },
          { label: "Corrente da Carga", value: "167 A" },
          { label: "Distância Unidirecional", value: "1 m (2 m malha)" },
          { label: "Queda Máx.", value: "3%" },
        ]}
        steps={[
          { label: "Passo 1: Resistência máx. permitida", formula: "R_máx = (12,8 × 0,03) / 167", result: "0,0023 Ω" },
          { label: "Passo 2: Área necessária do cabo", formula: "A = 1,72×10⁻⁸ × 2 / 0,0023", result: "14,96 mm²" },
          { label: "Passo 3: Selecionar AWG", formula: "14,96 mm² → 4 AWG (21,15 mm²)", result: "4 AWG" },
        ]}
        answer="4 AWG (21,15 mm²) cobre — alcança 1,38% de queda de tensão."
        interpretation="Sistemas 12V de alta corrente exigem cabos muito grossos. É por isso que sistemas 24V ou 48V são preferidos para cargas acima de 2kW — reduzem drasticamente os requisitos de cabo."
        variant="rv"
      />
    </div>
  </section>

  <EngineeringDiagram
    title="Sistema de Dimensionamento de Cabo DC"
    description="Da bateria pelo cabo até a carga, mostrando onde a tensão é perdida e a corrente é limitada"
    variant="circuit"
    steps={[
      { label: "Fonte da Bateria", icon: "battery" },
      { label: "Cabo Positivo", icon: "cable" },
      { label: "Carga Conectada", icon: "load" },
      { label: "Cabo de Retorno", icon: "cable" },
    ]}
  />

  <ComparisonTable
    title="Queda de Tensão Aceitável por Aplicação"
    headers={["Aplicação", "Queda Máx.", "Padrão", "Alvo", "Notas"]}
    rows={[
      ["Crítico Marinho", "3%", "ISO 13297", "1% preferido", "Navegação, bombas de porão, eletrônicos"],
      ["Fiação DC Solar", "2%", "NEC 690", "1%", "Controlador de carga à bateria"],
      ["Automotivo", "2%", "SAE J1127", "1%", "Bateria ao arranque, ignição"],
      ["Telecom 48V", "1%", "ITU-T", "0,5%", "Distribuição de energia DC"],
      ["DC Geral", "3%", "IEEE", "1%", "Sistemas de bateria à carga"],
      ["Iluminação Não Crítica", "10%", "ISO 13297", "5%", "Luzes de cabana, cargas domésticas"],
    ]}
    caption="Padrões da indústria para queda de tensão máxima permitida em sistemas DC"
  />

  <ComparisonTable
    title="Cobre vs Alumínio — Dimensionamento de Cabo"
    headers={["Parâmetro", "Cobre", "Alumínio", "Proporção"]}
    rows={[
      ["Resistividade (Ω·m)", "1,72×10⁻⁸", "2,82×10⁻⁸", "1,64×"],
      ["Área para mesma queda", "1,0×", "1,6×", "Al precisa 60% mais"],
      ["Peso por metro", "1,0×", "0,5×", "Al é 50% mais leve"],
      ["Custo por cap. corrente", "1,0×", "0,6×", "Al é 40% mais barato"],
      ["Risco de oxidação", "Baixo", "Alto", "Al precisa anti-óxido"],
      ["Flexibilidade", "Alta", "Baixa", "Cu preferido para trechos apertados"],
    ]}
    caption="Comparação de materiais para condutores de energia DC"
  />

  <FAQSection items={faqItems} />

  <!-- Calculation Script -->
  <script>
    const voltageInput = document.getElementById('voltage') as HTMLInputElement;
    const powerInput = document.getElementById('power') as HTMLInputElement;
    const distanceInput = document.getElementById('distance') as HTMLInputElement;
    const materialSelect = document.getElementById('material') as HTMLSelectElement;
    const temperatureInput = document.getElementById('temperature') as HTMLInputElement;
    const maxDropInput = document.getElementById('max-drop') as HTMLInputElement;

    // Result elements
    const resultCableBox = document.getElementById('result-cable');
    const resultCableValue = resultCableBox?.querySelector('.text-display-md') as HTMLElement;
    const resultCableNote = resultCableBox?.querySelector('.text-caption') as HTMLElement;

    const resultDropBox = document.getElementById('result-drop');
    const resultDropValue = resultDropBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultDropNote = resultDropBox?.querySelector('.text-caption') as HTMLElement;

    const resultCurrentBox = document.getElementById('result-current');
    const resultCurrentValue = resultCurrentBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultCurrentNote = resultCurrentBox?.querySelector('.text-caption') as HTMLElement;

    const resultLossBox = document.getElementById('result-loss');
    const resultLossValue = resultLossBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultLossNote = resultLossBox?.querySelector('.text-caption') as HTMLElement;

    const cableNotes = document.getElementById('cable-notes');
    const awgTableBody = document.getElementById('awg-table-body');

    const AWG_SIZES = [
      { awg: '18', areaMm2: 0.823, ampacityA: 10 },
      { awg: '16', areaMm2: 1.31, ampacityA: 15 },
      { awg: '14', areaMm2: 2.08, ampacityA: 20 },
      { awg: '12', areaMm2: 3.31, ampacityA: 25 },
      { awg: '10', areaMm2: 5.26, ampacityA: 35 },
      { awg: '8', areaMm2: 8.37, ampacityA: 50 },
      { awg: '6', areaMm2: 13.3, ampacityA: 65 },
      { awg: '4', areaMm2: 21.15, ampacityA: 85 },
      { awg: '2', areaMm2: 33.6, ampacityA: 115 },
      { awg: '1/0', areaMm2: 53.5, ampacityA: 150 },
      { awg: '2/0', areaMm2: 67.4, ampacityA: 175 },
      { awg: '4/0', areaMm2: 107.0, ampacityA: 230 },
    ];

    const COPPER_RESISTIVITY = 1.72e-8;
    const ALUMINUM_RESISTIVITY = 2.82e-8;
    const TEMP_COEF = 0.00393;

    function calculateCableMetrics(
      voltage: number, power: number, distance: number,
      material: string, temperature: number, areaMm2: number
    ): { dropPct: number; dropV: number; current: number; lossW: number } {
      const current = power / voltage;
      const rho20 = material === 'copper' ? COPPER_RESISTIVITY : ALUMINUM_RESISTIVITY;
      const rhoT = rho20 * (1 + TEMP_COEF * (temperature - 20));
      const loopLength = 2 * distance;
      const areaM2 = areaMm2 * 1e-6;
      const loopR = rhoT * loopLength / areaM2;
      const dropV = current * loopR;
      const dropPct = (dropV / voltage) * 100;
      const lossW = current * current * loopR;
      return { dropPct, dropV, current, lossW };
    }

    function getRecommendedAWG(
      voltage: number, power: number, distance: number,
      material: string, temperature: number, maxDropPct: number
    ): { awg: string; areaMm2: number; dropPct: number; meetsAmpacity: boolean } {
      const current = power / voltage;
      const rho20 = material === 'copper' ? COPPER_RESISTIVITY : ALUMINUM_RESISTIVITY;
      const rhoT = rho20 * (1 + TEMP_COEF * (temperature - 20));
      const loopLength = 2 * distance;

      // Min area for voltage drop
      const rMax = (voltage * maxDropPct / 100) / current;
      const minAreaForDrop = rhoT * loopLength / rMax;

      // Min area for ampacity
      let minAreaForAmpacity = 0;
      for (const awg of AWG_SIZES) {
        if (awg.ampacityA >= current) {
          minAreaForAmpacity = awg.areaMm2;
          break;
        }
      }
      if (minAreaForAmpacity === 0) minAreaForAmpacity = AWG_SIZES[AWG_SIZES.length - 1].areaMm2;

      const minArea = Math.max(minAreaForDrop, minAreaForAmpacity);

      // Find smallest AWG that meets both criteria
      let best = AWG_SIZES[AWG_SIZES.length - 1];
      for (const awg of AWG_SIZES) {
        if (awg.areaMm2 >= minArea) {
          best = awg;
          break;
        }
      }

      const metrics = calculateCableMetrics(voltage, power, distance, material, temperature, best.areaMm2);
      return { awg: best.awg, areaMm2: best.areaMm2, dropPct: metrics.dropPct, meetsAmpacity: best.ampacityA >= current };
    }

    function updateCalculations() {
      const voltage = parseFloat(voltageInput.value) || 12.8;
      const power = parseFloat(powerInput.value) || 500;
      const distance = parseFloat(distanceInput.value) || 5;
      const material = materialSelect.value;
      const temperature = parseFloat(temperatureInput.value) || 30;
      const maxDrop = parseFloat(maxDropInput.value) || 3;

      const rec = getRecommendedAWG(voltage, power, distance, material, temperature, maxDrop);
      const metrics = calculateCableMetrics(voltage, power, distance, material, temperature, rec.areaMm2);
      const current = power / voltage;

      // Render cable
      if (resultCableValue) resultCableValue.textContent = `${rec.awg} AWG`;
      if (resultCableNote) resultCableNote.textContent = `${rec.areaMm2} mm² ${material}`;

      // Render drop
      if (resultDropValue) resultDropValue.textContent = `${metrics.dropPct.toFixed(2)}%`;
      if (resultDropNote) resultDropNote.textContent = `${metrics.dropV.toFixed(3)}V ao longo da malha`;

      // Render current
      if (resultCurrentValue) resultCurrentValue.textContent = `${current.toFixed(1)} A`;
      if (resultCurrentNote) resultCurrentNote.textContent = 'Consumo contínuo';

      // Render loss
      if (resultLossValue) resultLossValue.textContent = `${metrics.lossW.toFixed(1)} W`;
      if (resultLossNote) resultLossNote.textContent = `${metrics.dropPct.toFixed(1)}% da potência da carga`;

      // Render notes
      if (cableNotes) {
        if (current > 100) {
          cableNotes.textContent = `Sistema 12V de alta corrente. Considere atualizar para 48V para reduzir corrente e requisitos de cabo. A ${current.toFixed(0)}A, a espessura do cabo é substancial.`;
        } else if (metrics.dropPct > maxDrop) {
          cableNotes.textContent = `Aviso: Nenhum tamanho AWG padrão atende o limite de ${maxDrop}% de queda a esta distância. Considere trechos de cabo mais curtos, tensão mais alta do sistema, ou aceitar maior queda.`;
        } else if (!rec.meetsAmpacity) {
          cableNotes.textContent = `O cabo atende os limites de queda de tensão, mas pode não atender os requisitos de capacidade de corrente a ${current.toFixed(0)}A contínuo. Verifique a capacidade para sua instalação.`;
        } else {
          cableNotes.textContent = `A ${voltage}V com ${current.toFixed(0)}A de corrente de carga, ${rec.awg} AWG de cobre atende tanto o limite de ${maxDrop}% de queda de tensão quanto os requisitos de capacidade de corrente.`;
        }
      }

      // Render AWG table
      if (awgTableBody) {
        awgTableBody.innerHTML = '';
        for (const awg of AWG_SIZES) {
          const m = calculateCableMetrics(voltage, power, distance, material, temperature, awg.areaMm2);
          const meetsDrop = m.dropPct <= maxDrop;
          const meetsAmp = awg.ampacityA >= current;
          const isRecommended = awg.awg === rec.awg;

          const row = document.createElement('tr');
          row.className = `border-b border-hairline ${isRecommended ? 'bg-surface-elevated' : ''}`;
          row.innerHTML = `
            <td class="p-3 text-body-sm text-primary font-mono">${isRecommended ? '→ ' : ''}${awg.awg} AWG</td>
            <td class="p-3 text-body-sm text-muted">${awg.areaMm2}</td>
            <td class="p-3 text-body-sm text-muted">${awg.ampacityA}</td>
            <td class="p-3 text-body-sm ${meetsDrop ? 'text-success' : 'text-red-500'}">${m.dropPct.toFixed(2)}%</td>
            <td class="p-3 text-body-sm text-muted">${m.lossW.toFixed(1)} W</td>
            <td class="p-3 text-body-sm ${meetsDrop && meetsAmp ? 'text-success' : 'text-red-500'}">${meetsDrop && meetsAmp ? '✓ OK' : meetsDrop ? 'Cap. baixa' : 'Queda alta'}</td>
          `;
          awgTableBody.appendChild(row);
        }
      }

      // Update drop box border color
      if (resultDropBox) {
        resultDropBox.className = "bg-surface-soft p-6 border col-span-1 md:col-span-2 " +
          (metrics.dropPct > 10 ? "border-red-600" :
           metrics.dropPct > maxDrop ? "border-yellow-500" : "border-hairline");
      }
    }

    [voltageInput, powerInput, distanceInput, materialSelect, temperatureInput, maxDropInput].forEach(el => {
      el.addEventListener('input', updateCalculations);
    });

    updateCalculations();
  </script>
</CalculatorLayout>
