---
import Layout from "../../layouts/Layout.astro";

const popularCalculators = [
  {
    title: "Calculadora de Autonomia",
    url: "/pt/tools/runtime-calculator/",
    description:
      "Estime a autonomia da bateria a partir de capacidade, carga e eficiência.",
  },
  {
    title: "Calculadora de Dimensionamento Solar",
    url: "/pt/tools/solar-battery-sizing-calculator/",
    description:
      "Dimensione seu banco solar a partir do consumo diário e dos dias de autonomia.",
  },
  {
    title: "Calculadora de Pack de Bateria",
    url: "/pt/tools/battery-pack-calculator/",
    description:
      "Projete packs a partir de células individuais com configurações série-paralelo.",
  },
];
---

<Layout
  title="Página Não Encontrada | Calculadoras de Bateria"
  description="A página que você procura não existe. Explore nossas calculadoras de bateria ou visite a central de aprendizagem."
  canonical="https://batterycalculators.com/pt/404/"
  lang="pt"
>
  <div class="max-w-[700px] mx-auto text-center py-12 md:py-20">
    <!-- Error Code -->
    <span class="text-label-uppercase text-m-blue-light text-xs block mb-4"
      >ERRO</span
    >
    <h1 class="text-display-lg text-primary mb-6">404</h1>
    <p
      class="text-body-md text-body font-light mb-10 mx-auto whitespace-normal"
    >
      A página que você procura não existe ou foi movida. Verifique o
      URL ou navegue usando as opções abaixo.
    </p>

    <!-- Action Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16"
    >
      <a href="/pt/" class="btn-primary text-xs">Início</a>
      <a href="/pt/tools/" class="btn-primary-outline text-xs">Explorar Calculadoras</a
      >
      <a href="/pt/learn/" class="btn-primary-outline text-xs">Central de Aprendizagem</a>
    </div>

    <!-- Popular Calculators -->
    <div class="border-t border-hairline pt-12">
      <span class="text-label-uppercase text-primary text-xs block mb-6"
        >Calculadoras Populares</span
      >
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          popularCalculators.map((calc) => (
            <a
              href={calc.url}
              class="bg-surface-card border border-hairline p-6 flex flex-col gap-3 hover:border-primary transition-colors text-left group"
            >
              <span class="text-title-md text-primary group-hover:text-m-blue-light transition-colors">
                {calc.title}
              </span>
              <span class="text-body-sm text-muted">{calc.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
