---
import Layout from "../../layouts/Layout.astro";
import CalculatorCard from "../../components/CalculatorCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQSection from "../../components/FAQSection.astro";

const resources = [
  {
    title: "Gráfico de Tensão LiFePO4",
    description:
      "Tensão de repouso de referência para baterias LiFePO4 de 12V, 24V e 48V por estado de carga.",
    category: "Gráfico de Referência",
    href: "/pt/learn/lifepo4-voltage-chart/",
    tags: ["lifepo4", "tensão", "soc"],
  },
  {
    title: "Gráfico de Referência de SOC",
    description:
      "Referência de estado de carga e explicação para baterias LiFePO4, incluindo por que o comportamento da tensão pode enganar no meio do SOC.",
    category: "Gráfico de Referência",
    href: "/pt/learn/lifepo4-soc-chart/",
    tags: ["soc", "estado de carga", "estimativa"],
  },
  {
    title: "Referência de Dimensionamento de Bateria",
    description:
      "Tabelas práticas de dimensionamento de bateria para aplicações em RV, solar, marítimo, backup residencial e BESS comercial.",
    category: "Referência",
    href: "/pt/learn/battery-sizing-reference/",
    tags: ["dimensionamento", "planejamento", "referência"],
  },
  {
    title: "Referência de C-Rate",
    description:
      "Referência de C-rate para converter corrente de descarga/carga em capacidade de bateria (e vice-versa).",
    category: "Tabela de Referência",
    href: "/pt/learn/battery-c-rate-reference/",
    tags: ["c-rate", "carga", "descarga"],
  },
  {
    title: "Gráfico de Correção por Temperatura",
    description:
      "Como a temperatura afeta a capacidade utilizável, o comportamento de carga e o risco de degradação, com fatores de correção.",
    category: "Gráfico de Referência",
    href: "/pt/learn/battery-temperature-correction-chart/",
    tags: ["temperatura", "correção", "capacidade"],
  },
];

const faqItems = [
  {
    question: "O que são estes recursos?",
    answer:
      "São páginas de referência sobre os principais tópicos de engenharia de baterias — gráficos, tabelas e orientações de dimensionamento — escritas para serem fáceis de consultar ao projetar ou solucionar problemas em sistemas de bateria.",
  },
  {
    question: "As referências são práticas para projetos reais?",
    answer:
      "Sim. Os gráficos e tabelas baseiam-se em relações padrão de engenharia e em nossas premissas verificadas. Os resultados reais ainda dependem da química da bateria, temperatura, idade e condições de operação.",
  },
  {
    question: "Com que frequência as referências são atualizadas?",
    answer:
      "Elas são atualizadas conforme a orientação de engenharia subjacente é revisada. Quando ocorrem mudanças importantes (novas químicas, correções ou tabelas aprimoradas), o conteúdo de referência é atualizado.",
  },
];
---

<Layout
  title="Recursos Gratuitos de Engenharia de Baterias — Tabelas e Guias | Calculadoras de Bateria"
  description="Recursos gratuitos de engenharia de baterias: gráficos de referência, tabelas de tensão, guias de dimensionamento e referências de planejamento para aplicações solares, de RV e marítimas."
  canonical="https://batterycalculators.com/pt/resources/"
  lang="pt"
  faqItems={faqItems}
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a
        href="/pt/"
        class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block"
        >&larr; Início</a
      >
      <Breadcrumb items={[{ label: "Recursos" }]} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4"
        >Recursos de Referência</span
      >
      <h1 class="text-display-md text-primary mb-6">
        Recursos de Referência em Engenharia de Baterias
      </h1>
      <p class="text-body-md text-body font-light">
        Gráficos, tabelas e referências de dimensionamento para o projeto de sistemas de bateria. Use
        estas páginas como referências rápidas ao planejar e projetar sua
        instalação.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">
          Recursos Disponíveis
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            resources.map((resource) => (
              <CalculatorCard class="flex flex-col justify-between">
                <div>
                  <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">
                    {resource.category}
                  </span>
                  <h3 class="text-title-lg text-primary mb-3">
                    {resource.title}
                  </h3>
                  <p class="text-body-sm text-muted mb-4">
                    {resource.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {resource.tags.map((tag) => (
                      <span class="text-[10px] text-primary border border-hairline px-2 py-0.5 uppercase tracking-wider">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="flex gap-3">
                  <a
                    href={resource.href}
                    class="btn-primary text-xs py-3 px-6 inline-block"
                  >
                    Abrir Referência
                  </a>
                </div>
              </CalculatorCard>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">
          Como Usar Estes Recursos
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">1. Abra a Referência</h4>
            <p class="text-body-sm text-muted">
              Selecione a referência de que precisa e consulte o gráfico ou a tabela
              diretamente no navegador.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">
              2. Use como Referência Rápida
            </h4>
            <p class="text-body-sm text-muted">
              Mantenha a referência à mão ao projetar, verificar ou ajustar
              sistemas de bateria.
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">
              3. Valide com as Calculadoras
            </h4>
            <p class="text-body-sm text-muted">
              Combine estas referências com nossas calculadoras online para personalizar
              os resultados para sua bateria e condições de carga.
            </p>
          </CalculatorCard>
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">
          Calculadoras Relacionadas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">Calculadora de Autonomia</h4>
            <p class="text-body-sm text-muted mb-3">
              Calcule a autonomia exata para sua bateria e configuração de carga
              específicas.
            </p>
            <a
              href="/pt/tools/runtime-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >Abrir Calculadora →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">
              Calculadora de Dimensionamento de Bateria
            </h4>
            <p class="text-body-sm text-muted mb-3">
              Dimensione seu banco de baterias a partir de cargas, autonomia e requisitos
              de química.
            </p>
            <a
              href="/pt/tools/battery-sizing-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >Abrir Calculadora →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">Estimador de SOC</h4>
            <p class="text-body-sm text-muted mb-3">
              Estime o estado de carga por tensão ou contagem de coulombs.
            </p>
            <a
              href="/pt/tools/soc-estimator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >Abrir Calculadora →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">Dimensionamento Solar de Bateria</h4>
            <p class="text-body-sm text-muted mb-3">
              Dimensione bancos solares a partir do consumo diário e da autonomia.
            </p>
            <a
              href="/pt/tools/solar-battery-sizing-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >Abrir Calculadora →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">Gerador de Passaporte de Bateria</h4>
            <p class="text-body-sm text-muted mb-3">
              Crie um relatório estruturado de ciclo de vida e prontidão de conformidade da bateria.
            </p>
            <a
              href="/pt/battery-passport-generator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >Abrir Gerador →</a
            >
          </CalculatorCard>
        </div>
      </section>

      <FAQSection items={faqItems} />
    </div>
  </div>
</Layout>
