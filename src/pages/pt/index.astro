---
import Layout from "../../layouts/Layout.astro";
import CalculatorCard from "../../components/CalculatorCard.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import CalculatorFinder from "../../components/CalculatorFinder.astro";

const categories = [
  {
    href: "/pt/solar/",
    title: "Solar",
    description: "Dimensionamento, planejamento off-grid e backup residencial com PV + armazenamento",
    calculatorCount: 3,
  },
  {
    href: "/pt/home-backup/",
    title: "Residencial",
    description: "Cargas essenciais, planejamento de autonomia e preparação para apagões",
    calculatorCount: 3,
  },
  {
    href: "/pt/rv/",
    title: "Veículo Recreativo",
    description: "Planejamento de energia para vans/camper, estimativas de autonomia, compatibilidade de inversores",
    calculatorCount: 3,
  },
  {
    href: "/pt/marine/",
    title: "Marítimo",
    description: "Planejamento elétrico de embarcações, estimativa de cargas e dimensionamento de baterias",
    calculatorCount: 3,
  },
  {
    href: "/pt/ev/",
    title: "Veículo Elétrico",
    description: "Projeto de packs, configuração série/paralelo, planejamento de tensão",
    calculatorCount: 4,
  },
  {
    href: "/pt/bess/",
    title: "BESS",
    description: "ROI comercial, corte de pico e planejamento de tarifas",
    calculatorCount: 3,
  },
  {
    href: "/pt/engineering/",
    title: "Engenharia",
    description: "C-rate, SOC/SOH, queda de tensão e análise de perda em cabos",
    calculatorCount: 6,
  },
];

const featuredCalculators = [
  {
    name: "Calculadora de Autonomia",
    href: "/pt/tools/runtime-calculator/",
    category: "Célula e Pack",
    description: "Estime a autonomia de descarga a partir de capacidade, carga e eficiência.",
  },
  {
    name: "Calculadora de Dimensionamento de Bateria",
    href: "/pt/tools/battery-sizing-calculator/",
    category: "Elétrico",
    description: "Dimensione bancos de baterias a partir de cargas diárias, autonomia e temperatura.",
  },
  {
    name: "Calculadora de C-Rate",
    href: "/pt/tools/c-rate-calculator/",
    category: "Célula e Pack",
    description: "Calcule correntes de carga/descarga e velocidade de C-rate.",
  },
  {
    name: "Calculadora de Queda de Tensão DC",
    href: "/pt/tools/voltage-drop-calculator/",
    category: "Elétrico",
    description: "Calcule a queda de tensão em condutores DC.",
  },
  {
    name: "Calculadora de Perda em Cabo DC",
    href: "/pt/tools/dc-cable-loss-calculator/",
    category: "Elétrico",
    description: "Determine perdas resistivas em linhas DC.",
  },
  {
    name: "Calculadora de ROI de BESS",
    href: "/pt/tools/bess-roi-calculator/",
    category: "ROI e Vida Útil",
    description: "Avalie VPL e payback para armazenamento de energia comercial.",
  },
];

const learnArticles = [
  {
    title: "O Que É C-Rate de Bateria?",
    href: "/pt/learn/what-is-battery-c-rate/",
    category: "Fundamentos de Células",
  },
  {
    title: "Como Calcular a Autonomia da Bateria",
    href: "/pt/learn/how-to-calculate-battery-runtime/",
    category: "Projeto de Sistemas",
  },
  {
    title: "Como Dimensionar um Banco de Baterias",
    href: "/pt/learn/how-to-size-a-battery-bank/",
    category: "Projeto de Sistemas",
  },
];
---

<Layout
  title="Calculadoras de Bateria para Solar, Residencial, RV, Marítimo, EV | Calculadoras de Bateria"
  description="Calculadoras de bateria gratuitas de nível de engenharia para proprietários de imóveis, usuários de solar, proprietários de RV, sistemas marítimos, construtores de baterias DIY e profissionais."
  schema="website"
  schemaName="Calculadoras de Bateria"
  schemaDescription="Calculadoras de bateria de nível de engenharia para solar, backup residencial, RV, marítimo, EV e sistemas de armazenamento de energia."
  lang="pt"
>
  <!-- Hero Section -->
  <section class="border-b border-hairline pb-6 md:pb-8">
    <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-10 min-h-[28vh] md:min-h-[34vh] items-center">
      <!-- Left column: copy + CTAs + pills -->
      <div class="max-w-[700px]">
        <div class="mb-3">
          <span
            class="text-label-uppercase text-m-blue-light text-[11px] block mb-2"
            >PLATAFORMA DE UTILIDADES DE ENGENHARIA</span
          >
          <h1 class="text-display-md text-primary leading-tight mb-3">
            Calculadoras de Bateria e Ferramentas de Engenharia
          </h1>
          <p class="text-body-md text-body font-light max-w-[650px]">
            Calculadoras gratuitas para solar, backup residencial, RV, marítimo, EV,
            packs de baterias e sistemas de armazenamento de energia.
          </p>
        </div>

        <!-- CTA row -->
        <div class="mt-5 flex flex-col sm:flex-row gap-3">
          <a
            href="/pt/tools/"
            class="btn-primary-outline text-xs text-center sm:text-sm inline-flex flex-1 h-11 items-center justify-center"
          >
            Explorar Calculadoras
          </a>
          <a
            href="/pt/learn/"
            class="btn-secondary text-xs text-center sm:text-sm inline-flex flex-1 h-11 items-center justify-center"
          >
            Centro de Aprendizagem
          </a>
        </div>

        <!-- Quick category pills -->
        <div class="mt-5 flex flex-wrap gap-2">
          {
            [
              { label: "Solar", href: "/pt/solar/" },
              { label: "Residencial", href: "/pt/home-backup/" },
              { label: "Veículo Recreativo", href: "/pt/rv/" },
              { label: "Marítimo", href: "/pt/marine/" },
              { label: "Veículo Elétrico", href: "/pt/ev/" },
              { label: "BESS", href: "/pt/bess/" },
              { label: "Engenharia", href: "/pt/engineering/" },
            ].map((pill) => (
              <a
                href={pill.href}
                class="text-label-uppercase text-muted text-[10px] border border-hairline px-3 py-2 hover:border-primary transition-colors bg-transparent"
              >
                {pill.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right column: Popular Battery Tools panel -->
      <div class="bg-surface-card border border-hairline">
        <div class="border-b border-hairline px-6 py-4">
          <h2 class="text-title-sm text-primary font-bold">Ferramentas Populares de Bateria</h2>
        </div>
        <div class="divide-y divide-hairline">
          {
            [
              {
                name: "Dimensionamento de Bateria Solar",
                desc: "Dimensionamento solar + armazenamento",
                href: "/pt/tools/solar-battery-sizing-calculator/",
              },
              {
                name: "Bateria de Backup Residencial",
                desc: "Planejamento de autonomia para apagões",
                href: "/pt/tools/home-backup-battery-calculator/",
              },
              {
                name: "Backup para Apagões",
                desc: "Dimensionamento para tempestades e emergências",
                href: "/pt/home-power-outage-battery-backup-calculator/",
              },
              {
                name: "Calculadora de Bateria para RV",
                desc: "Planejamento de energia para acampamento",
                href: "/pt/tools/rv-battery-calculator/",
              },
              {
                name: "Calculadora de Pack de Baterias",
                desc: "Projeto série-paralelo",
                href: "/pt/tools/battery-pack-calculator/",
              },
              {
                name: "Calculadora de ROI de BESS",
                desc: "Payback e economia",
                href: "/pt/tools/bess-roi-calculator/",
              },
              {
                name: "Gerador de Passaporte de Bateria",
                desc: "Ciclo de vida, rastreabilidade e conformidade",
                href: "/pt/battery-passport-generator/",
              },
            ].map((tool) => (
              <a
                href={tool.href}
                class="block px-6 py-4 hover:bg-surface-elevated transition-colors group"
              >
                <span class="text-title-sm text-primary group-hover:text-m-blue-light transition-colors block">
                  {tool.name}
                </span>
                <span class="text-body-sm text-muted text-[13px]">
                  {tool.desc}
                </span>
              </a>
            ))
          }
        </div>
        <div class="border-t border-hairline px-6 py-3">
          <a
            href="/pt/tools/"
            class="text-label-uppercase text-m-blue-light text-[10px] hover:text-primary transition-colors"
          >
            VER TODAS AS FERRAMENTAS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Cards Section -->
  <section class="pt-6 md:pt-8 pb-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-title-lg text-primary">Ferramentas por Categoria</h2>
      <a
        href="/pt/tools/"
        class="text-label-uppercase text-muted text-[10px] hover:text-primary transition-colors"
        >VER TODAS AS FERRAMENTAS →</a
      >
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {categories.map((cat) => <CategoryCard {...cat} />)}
    </div>

    <!-- Calculator Finder -->
    <div class="mt-8">
      <CalculatorFinder lang="pt" />
    </div>
  </section>

  <!-- Featured Calculators Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-title-lg text-primary">Calculadoras em Destaque</h2>
      <a
        href="/pt/tools/"
        class="text-label-uppercase text-muted text-[10px] hover:text-primary transition-colors"
        >VER TODAS →</a
      >
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        featuredCalculators.map((calc) => (
          <a href={calc.href} class="block group">
            <CalculatorCard class="h-full flex flex-col justify-between">
              <div>
                <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">
                  {calc.category}
                </span>
                <h3 class="text-title-lg text-primary mb-2 group-hover:text-m-blue-light transition-colors">
                  {calc.name}
                </h3>
                <p class="text-body-sm text-muted mb-6">{calc.description}</p>
              </div>
              <span class="btn-primary-outline text-xs text-center py-3 w-full">
                Abrir Calculadora
              </span>
            </CalculatorCard>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Learning Center Preview -->
  <section class="mb-16 border-t border-hairline pt-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-title-lg text-primary">Centro de Aprendizagem</h2>
      <a
        href="/pt/learn/"
        class="text-label-uppercase text-muted text-[10px] hover:text-primary transition-colors"
        >VER TODOS OS GUIAS →</a
      >
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        learnArticles.map((article) => (
          <a href={article.href} class="block group">
            <CalculatorCard class="h-full flex flex-col justify-between">
              <div>
                <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">
                  {article.category}
                </span>
                <h3 class="text-title-lg text-primary mb-3 group-hover:text-m-blue-light transition-colors">
                  {article.title}
                </h3>
              </div>
              <span class="text-label-uppercase text-muted text-[10px] group-hover:text-primary transition-colors">
                LER GUIA →
              </span>
            </CalculatorCard>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Trust Section -->
  <section class="bg-surface-card border border-hairline p-8 md:p-12 mb-16">
    <h2 class="text-title-lg text-primary mb-8 text-center">
      Cálculos Confiáveis, Construídos para Trabalho de Engenharia
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <svg class="mx-auto mb-4 opacity-90" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-body-strong)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h12l-4 4 4 4H4" />
          <path d="M12 12h8" />
        </svg>
        <h3 class="text-title-sm text-primary mb-2">Fórmulas Transparentes</h3>
        <p class="text-body-sm text-muted">
          Todas as equações e premissas são visíveis.
        </p>
      </div>
      <div class="text-center">
        <svg class="mx-auto mb-4 opacity-90" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-body-strong)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8" />
        </svg>
        <h3 class="text-title-sm text-primary mb-2">Cálculos Instantâneos</h3>
        <p class="text-body-sm text-muted">
          Resultados atualizados imediatamente no seu navegador.
        </p>
      </div>
      <div class="text-center">
        <svg class="mx-auto mb-4 opacity-90" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-body-strong)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="0" />
          <path d="M7 11V7a5 5 0 0 1 9.9-1" />
        </svg>
        <h3 class="text-title-sm text-primary mb-2">Sem Cadastro</h3>
        <p class="text-body-sm text-muted">
          Use todas as ferramentas sem criar uma conta.
        </p>
      </div>
      <div class="text-center">
        <svg class="mx-auto mb-4 opacity-90" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-body-strong)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="9" y1="13" x2="15" y2="13" />
          <line x1="9" y1="17" x2="13" y2="17" />
        </svg>
        <h3 class="text-title-sm text-primary mb-2">Referências de Engenharia</h3>
        <p class="text-body-sm text-muted">
          Baseado em princípios estabelecidos de engenharia elétrica.
        </p>
      </div>
    </div>
  </section>
</Layout>
