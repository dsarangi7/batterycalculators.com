---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryToolGrid from '../../components/CategoryToolGrid.astro';
import FAQSection from '../../components/FAQSection.astro';

const tools = [
  {
    name: "Calculadora de Bateria para RV",
    href: "/pt/tools/rv-battery-calculator/",
    description: "Calcule o tamanho do banco de baterias para seu RV ou camper. Estime o consumo diário e capacidade necessária para suas viagens.",
    available: true,
  },
  {
    name: "Calculadora Bateria-Inversor",
    href: "/pt/tools/inverter-battery-calculator/",
    description: "Calcule a capacidade da bateria para cargas de inversor AC com ajustes de DoD e eficiência.",
    available: true,
  },
  {
    name: "Autonomia de Bateria do Camper",
    href: "/pt/tools/runtime-calculator/",
    description: "Estime quanto tempo a bateria do camper alimentará luzes, geladeira, ventiladores e dispositivos durante boondocking.",
    available: true,
  },
  {
    name: "Compatibilidade Inversor-Bateria",
    href: "/pt/tools/energy-conversion-calculator/",
    description: "Converta entre Ah e Wh para combinar os requisitos de carga do inversor com a capacidade da bateria.",
    available: true,
  },
];

const learnArticles = [
  { title: "Guia de Dimensionamento de Bateria para RV", href: "/pt/learn/rv-battery-sizing-guide/" },
  { title: "Guia de Autonomia de Bateria do Camper", href: "/pt/learn/camper-battery-runtime-guide/" },
  { title: "Planejamento de Bateria para Van Life", href: "/pt/learn/van-life-battery-planning/" },
  { title: "Quantas Baterias para RV?", href: "/pt/learn/how-many-batteries-for-rv/" },
  { title: "Guia de Bateria Lítio para RV", href: "/pt/learn/rv-lithium-battery-guide/" },
  { title: "Como Dimensionar um Banco de Baterias", href: "/pt/learn/how-to-size-a-battery-bank/" },
  { title: "Referência de Dimensionamento de Bateria", href: "/pt/learn/battery-sizing-reference/" },
  { title: "Gráfico de Tensão LiFePO4", href: "/pt/learn/lifepo4-voltage-chart/" },
  { title: "Melhor Química de Bateria para RV", href: "/pt/learn/best-battery-chemistry-for-rv/" },
  { title: "12V vs 24V para Baterias de RV", href: "/pt/learn/12v-vs-24v-rv-batteries/" },
];

const faqItems = [
  {
    question: "Quantas baterias preciso para meu RV?",
    answer: "Para acampamento de fim de semana, uma única bateria LFP de 100Ah 12V tipicamente fornece energia suficiente para luzes, bomba d'água, carregamento de telefone e uma geladeira pequena. Para vida em RV tempo integral ou boondocking estendido, 200–400Ah a 12V (ou um sistema de 24V) é recomendado para alimentar eletrodomésticos como micro-ondas, máquinas de café e sistemas de entretenimento.",
  },
  {
    question: "Qual a melhor química de bateria para uso em RV?",
    answer: "LiFePO4 (Lithium Iron Phosphate) é a química recomendada para aplicações em RV. Oferece 80–90% de capacidade utilizável (vs 50% para chumbo-ácido), vida útil de 3000–5000 ciclos, redução de 50% no peso e zero manutenção. O custo inicial mais alto é compensado por 3–5x mais vida útil e desempenho superior em ambientes de RV.",
  },
  {
    question: "Devo usar um sistema de 12V ou 24V no meu RV?",
    answer: "12V é o padrão para a maioria dos RVs e compatível com a maior variedade de eletrodomésticos e acessórios. 24V se torna vantajoso para sistemas maiores (acima de 2 kW) porque reduz pela metade a corrente, reduzindo custos de fiação e queda de tensão. Se você está construindo um sistema novo do zero com necessidades significativas de energia, 24V vale a consideração.",
  },
  {
    question: "Quanto tempo a bateria do RV durará durante boondocking?",
    answer: "A autonomia depende da capacidade da bateria e do perfil de carga diário. Um camper típico de fim de semana com uma bateria LFP de 100Ah executando luzes (50W), uma geladeira (60W), bomba d'água (intermitente) e carregamento de telefone pode esperar 2–3 dias entre cargas. Boondockers tempo integral com sistemas de 300Ah+ e painéis solares podem ir indefinidamente com gerenciamento cuidadoso de cargas.",
  },
  {
    question: "Preciso de painéis solares para o sistema de bateria do RV?",
    answer: "Painéis solares são altamente recomendados para sistemas de bateria de RV, especialmente para boondocking estendido. Uma matriz solar de 200–400W pode reabastecer 600–1200 Wh por dia, cobrindo o consumo diário da maioria das configurações moderadas de RV. Sem solar, você precisaria usar um gerador ou dirigir para recarregar, ambos com limitações.",
  },
];

const relatedCategories = [
  { href: "/pt/solar/", title: "Solar", description: "Dimensionamento de bateria solar e planejamento off-grid" },
  { href: "/pt/marine/", title: "Marítimo", description: "Sistemas de bateria para barcos e iates" },
  { href: "/pt/engineering/", title: "Engenharia", description: "Ferramentas de C-rate, SOC, queda de tensão e perda em cabos" },
];

const breadcrumbItems = [
  { label: "RV e Camper" },
];
---

<Layout
  title="Calculadoras de Bateria para RV e Camper | Calculadoras de Bateria"
  description="Calculadoras gratuitas de bateria para RV para dimensionamento de bateria de camper, planejamento de autonomia van life e compatibilidade inversor-bateria."
  schema="website"
  schemaName="Calculadoras de Bateria para RV e Camper"
  schemaDescription="Calculadoras de bateria de nível de engenharia para sistemas de energia de RV, camper e van life."
  breadcrumbs={[{ label: 'RV e Camper' }]}
  lang="pt"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mb-12 md:mb-16 border-b border-hairline pb-12">
    <div class="max-w-4xl">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">RV E CAMPER</span>
      <h1 class="text-display-md text-primary mb-6">Calculadoras de Bateria para RV e Camper</h1>
      <p class="text-body-md text-body max-w-2xl font-light">
        Planeje o sistema de bateria do seu RV ou camper com ferramentas de nível de engenharia. Dimensione baterias para boondocking, estime a autonomia para eletrodomésticos e combine cargas de inversor com capacidade de bateria.
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="max-w-4xl text-body-md text-body font-light flex flex-col gap-6">
      <p>
        Sistemas de bateria de RV devem equilibrar três restrições que raramente coexistem em aplicações estacionárias: espaço limitado, peso limitado e a necessidade de energia off-grid confiável. Diferente de sistemas de backup residencial onde o tamanho da bateria é limitado apenas pelo orçamento, instalações em RV devem caber dentro da capacidade de peso do veículo e das dimensões do compartimento disponível.
      </p>
      <p>
        O primeiro passo no design de bateria de RV é catalogar cada carga elétrica que você planeja usar. Cargas comuns de RV incluem iluminação LED (10–20W total), uma geladeira compressor 12V (40–60W contínuo, 200–400 Wh/dia), bomba d'água (intermitente), ventiladores de ventilação (5–15W cada), carregamento de telefone e laptop (50–100 Wh/dia) e sistemas de entretenimento (50–200W).
      </p>
      <p>
        A seleção de tensão do sistema afeta custo e desempenho. Um sistema de 12V é o mais comum e compatível com a maior variedade de eletrodomésticos e acessórios de RV. Para sistemas maiores excedendo 2 kW de carga contínua, 24V reduz o consumo de corrente pela metade, permitindo fiação mais fina e reduzindo a queda de tensão.
      </p>
      <p>
        Baterias de lítio LiFePO4 tornaram-se o padrão para aplicações sérias de RV. Sua profundidade de descarga de 80–90% significa que você pode usar quase a capacidade total classificada sem danificar a vida útil dos ciclos. Uma bateria LFP de 200Ah 12V fornece 2.048 Wh de energia utilizável com aproximadamente 23 kg, comparada a um banco de chumbo-ácido exigindo 400Ah (e 60+ kg) para fornecer a mesma energia utilizável a 50% DoD.
      </p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary mb-6">Calculadoras Disponíveis</h2>
    <CategoryToolGrid tools={tools} />
  </section>

  {learnArticles.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">Guias de RV e Camper</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learnArticles.map((article) => (
          <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
            <span class="text-label-uppercase text-muted text-[10px] block mb-2">CENTRO DE APRENDIZAGEM</span>
            <h3 class="text-title-sm text-primary">{article.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <FAQSection items={faqItems} />

  {relatedCategories.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">Categorias Relacionadas</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {relatedCategories.map((cat) => (
          <a href={cat.href} class="bg-surface-card border border-hairline p-6 hover:border-primary transition-colors block">
            <h3 class="text-title-md text-primary mb-2">{cat.title}</h3>
            <p class="text-body-sm text-muted">{cat.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-surface-soft border border-hairline p-6 text-caption text-muted mb-8">
    <span class="text-primary font-bold text-[10px] tracking-wider uppercase border border-hairline px-1.5 py-0.5 mr-2 inline-block mb-3">
      Aviso de Engenharia
    </span>
    Todas as calculadoras fornecem apenas estimativas de dimensionamento. A autonomia real depende da idade da bateria, temperatura, características das cargas e perdas na fiação. Verifique os cálculos para sistemas elétricos de RV críticos para segurança.
  </section>
</Layout>
