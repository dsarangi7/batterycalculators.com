---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "Resumo Semanal da Indústria de Baterias — Semana 31, 2026 | Calculadoras de Bateria";
const description = "Esta semana em baterias: Hanoi Power Corporation inaugura o primeiro portfólio de armazenamento em baterias de 100 MWh na capital vietnamita, Alpiq segue aquisição da Harmony Energy com anúncio de projeto de 1,2 GWh e Colômbia contrata 725 MW de energia solar no segundo dia de leilão de energia verde.";
const canonical = "https://batterycalculators.com/pt/news/battery-industry-weekly-2026-week-31/";
const publishDate = "2026-07-31";
const lastUpdated = "2026-07-31";
const readingTime = 20;

const faqItems = [
  {
    "question": "O que é o Resumo Semanal da Indústria de Baterias?",
    "answer": "Um resumo editorial curto que cobre as notícias mais importantes da indústria de baterias a cada semana — baterias para veículos elétricos, armazenamento em escala de rede, regulamentação, fabricação e pesquisa."
  },
  {
    "question": "Como as histórias são selecionadas?",
    "answer": "O gerador busca feeds RSS de fontes confiáveis, remove histórias duplicadas semelhantes, pontua por relevância e seleciona as principais histórias da semana."
  },
  {
    "question": "Quando o resumo é publicado?",
    "answer": "Uma nova edição é gerada toda sexta-feira, cobrindo a semana atual."
  }
];

const breadcrumbs = [
  { label: 'Notícias', href: '/pt/news/' },
  { label: 'Semana 31, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Resumo Semanal da Indústria de Baterias — Semana 31, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="pt"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/pt/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Voltar para Notícias</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">EDIÇÃO SEMANAL</span>
      <h1 class="text-display-md text-primary mb-4">Resumo Semanal da Indústria de Baterias — Semana 31</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>27 de julho – 2 de agosto de 2026</span>
        <span>{readingTime} min de leitura</span>
      </div>
      <p class="text-body-md text-body font-light">
        Esta semana em baterias: Hanoi Power Corporation inaugura o primeiro portfólio de armazenamento em baterias de 100 MWh na capital vietnamita, Alpiq segue aquisição da Harmony Energy com anúncio de projeto de 1,2 GWh e Colômbia contrata 725 MW de energia solar no segundo dia de leilão de energia verde.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hanoi Power Corporation inaugura o primeiro portfólio de armazenamento em baterias de 100 MWh na capital vietnamita</h2>
      <p class="text-body-md text-body font-light mb-4">A Hanoi Power Corporation (EVNHANOI) iniciou a operação piloto de cinco sistemas de armazenamento de energia em baterias em subestações em Hanói, Vietnã.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alpiq segue aquisição da Harmony Energy com anúncio de projeto de 1,2 GWh</h2>
      <p class="text-body-md text-body font-light mb-4">Duas semanas após anunciar a aquisição da Harmony Energy, a empresa suíça de energia Alpiq revelou seu primeiro projeto de baterias em larga escala em seu país de origem.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Colômbia contrata 725 MW de energia solar no segundo dia de leilão de energia verde</h2>
      <p class="text-body-md text-body font-light mb-4">O Leilão de Contratação de Energia Limpa do país contratou 995 MW de energia solar e quase 100 MW de sistemas de armazenamento de energia em baterias ao longo de dois dias.</p>
      <p class="text-body-md text-body font-light">O post A Colômbia contrata 725 MW de energia solar no segundo dia de le</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">PESQUISA</span>
      <h2 class="text-title-xl text-primary mb-4">Antora Energy capta US$ 550 milhões em Série C para escalar implantação de baterias térmicas nos EUA</h2>
      <p class="text-body-md text-body font-light mb-4">A provedora de tecnologia de armazenamento de energia térmica (TES) Antora Energy captou US$ 550 milhões em rodada Série C para acelerar a implantação de seus sistemas de armazenamento em baterias térmicas para instalações industriais.</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Veolia operará microrrede de 350 MW para data center de IA no centro de Ohio</h2>
      <p class="text-body-md text-body font-light mb-4">A empresa de serviços ambientais Veolia foi selecionada para operar e manter uma microrrede de 350 MW para alimentar um campus de data center de IA em New Albany, Ohio, EUA, que inclui um BESS de 430 MWh.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARÍTIMO</span>
      <h2 class="text-title-xl text-primary mb-4">Armazenamento em baterias é importante motor de crescimento, diz CEO da NextEra, em meio a fusão para criar maior concessionária regulada dos EUA</h2>
      <p class="text-body-md text-body font-light mb-4">A NextEra Energy registrou aumento de 9,5% em seu lucro líquido no 2º trimestre de 2026, enquanto avançava em seu plano de fusão com a Dominion Energy para formar a maior concessionária regulada de energia do mundo.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Georgia Power conclui construção de BESS de 198 MWh ao lado da Base Aérea Moody</h2>
      <p class="text-body-md text-body font-light mb-4">A concessionária Georgia Power concluiu a construção da Instalação de Baterias Moody de 49,5 MW/198 MWh, localizada nos arredores de Valdosta, Geórgia, EUA.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Europa Central e Oriental: Alcemi do Reino Unido compra projetos de 2,3 GWh na Romênia, e maior BESS da Eslováquia entra em operação</h2>
      <p class="text-body-md text-body font-light mb-4">A Alcemi, desenvolvedora de alguns dos maiores projetos do Reino Unido, entrou no mercado romeno de armazenamento em baterias, enquanto o maior projeto da Eslováquia até hoje entrou em operação.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">VEÍCULOS ELÉTRICOS</span>
      <h2 class="text-title-xl text-primary mb-4">Demanda por veículos elétricos na Europa e BESS nos EUA levam LG Energy Solution de volta ao lucro no 2º trimestre</h2>
      <p class="text-body-md text-body font-light mb-4">A LG Energy Solution (LG ES) registrou um segundo trimestre lucrativo neste ano, com investimentos em armazenamento em baterias nos EUA e produção de células para veículos elétricos na Europa dando resultado.</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Greenvolt inaugura BESS de 200 MW/800 MWh contratado no mercado de capacidade na Polônia</h2>
      <p class="text-body-md text-body font-light mb-4">A Greenvolt Power inaugurou a Instalação de Armazenamento de Energia em Baterias Turośń Kościelna de 200 MW na Polônia, que será otimizada pela comercializadora de energia Entrix.</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Fontes</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/hanoi-power-corporation-inaugurates-the-first-100mwh-battery-storage-portfolio-in-vietnamese-capital/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/alpiq-follows-harmony-energy-acquisition-with-1-2gwh-project-announcement/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/31/colombia-awards-725-mw-of-solar-on-second-day-of-green-energy-auction/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Colombia awards 725 MW of solar on second day of green energy auction — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/antora-energy-closes-us550-million-series-c-to-scale-us-thermal-battery-deployment/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Antora Energy closes US$550 million Series C to scale US thermal battery deployment — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/veolia-to-operate-350mw-microgrid-for-ai-data-centre-in-central-ohio/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Veolia to operate 350MW microgrid for AI data centre in central Ohio — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/battery-storage-is-an-important-growth-driver-nextera-ceo-says-amid-merger-to-create-largest-regulated-utility-in-us/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Battery storage is an important growth driver, NextEra CEO says, amid merger to create largest regulated utility in US — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/georgia-power-completes-construction-of-198mwh-bess-next-to-moody-air-force-base/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Georgia Power completes construction of 198MWh BESS next to Moody Air Force Base — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/central-eastern-europe-uks-alcemi-buys-2-3gwh-romania-projects-slovakias-biggest-bess-brought-online/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Central & Eastern Europe: UK’s Alcemi buys 2.3GWh Romania projects, Slovakia’s biggest BESS brought online — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/ev-demand-in-europe-bess-in-the-us-drive-lg-energy-solutions-return-to-profit-in-q2/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EV demand in Europe, BESS in the US drive LG Energy Solution’s return to profit in Q2 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/greenvolt-inaugurates-200mw-800mwh-capacity-market-contracted-bess-in-poland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Greenvolt inaugurates 200MW/800MWh capacity market-contracted BESS in Poland — Energy Storage News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Aviso Legal</h3>
        <p class="text-body-sm text-muted">
          Este artigo resume notícias e análises disponíveis publicamente. BatteryCalculators.com não garante a precisão de informações de terceiros. Sempre verifique os fatos com fontes primárias antes de tomar decisões de engenharia ou aquisição. Este conteúdo é fornecido apenas para fins informativos e não constitui aconselhamento profissional de engenharia.
        </p>
      </div>
    </section>

  </article>
</Layout>
