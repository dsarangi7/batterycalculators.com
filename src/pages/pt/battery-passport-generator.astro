---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import InputField from '../../components/InputField.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const applicationOptions = [
  { label: "ESS Estacionário", value: "Stationary ESS" },
  { label: "ESS Marítimo", value: "Marine ESS" },
  { label: "VE (Veículo Elétrico)", value: "EV" },
  { label: "Pacote Industrial", value: "Industrial" },
  { label: "UPS / Energia de Reserva", value: "UPS" },
  { label: "Armazenamento de Segunda Vida", value: "Second-life" },
  { label: "Outra Aplicação", value: "Other" }
];

const chemistryOptions = [
  { label: "LFP (Fosfato de Ferro Lítio / LiFePO4)", value: "LFP / LiFePO4" },
  { label: "NMC (Níquel Manganês Cobalto)", value: "NMC" },
  { label: "NCA (Níquel Cobalto Alumínio)", value: "NCA" },
  { label: "LTO (Titanato de Lítio)", value: "LTO" },
  { label: "Chumbo-Ácido (Ciclo Profundo)", value: "Lead-acid" },
  { label: "Íon-Sódio", value: "Sodium-ion" },
  { label: "Outra Química", value: "Other" }
];

const carbonUnitOptions = [
  { label: "kg CO2e / kWh", value: "kg CO2e/kWh" },
  { label: "kg CO2e total", value: "kg CO2e total" },
  { label: "Desconhecido / Não Declarado", value: "Unknown" }
];

const secondLifeOptions = [
  { label: "Alta adequação (SOH >= 80%, baixa contagem de ciclos)", value: "High" },
  { label: "Média adequação (SOH 70-79%, estresse moderado)", value: "Medium" },
  { label: "Baixa adequação (SOH < 70% ou incidentes de segurança registrados)", value: "Low" },
  { label: "Desconhecido / Não Testado", value: "Unknown" }
];

const faqItems = [
  {
    question: "O que é um passaporte de bateria?",
    answer: "Um passaporte de bateria é um registro digital estruturado que armazena e compartilha informações-chave sobre o ciclo de vida de uma bateria. Rastreia detalhes como origem de fabricação, composição de materiais, pegada de carbono, histórico de desempenho, Estado de Saúde (SOH) e instruções de reciclagem para promover segurança, transparência e reutilização na economia circular."
  },
  {
    question: "Quem precisa de um passaporte de bateria?",
    answer: "Sob regulamentações como o Regulamento de Baterias da UE, passaportes de bateria são obrigatórios para baterias industriais (acima de 2 kWh), baterias de veículos elétricos (VE) e grandes baterias de Meios de Transporte Leves (LMT). Usuários-alvo incluem fabricantes, OEMs, laboratórios de baterias, desenvolvedores de ESS e equipes de reciclagem."
  },
  {
    question: "Isto é um Passaporte de Bateria da UE certificado?",
    answer: "Não. Esta ferramenta gera um relatório de prontidão do Passaporte de Bateria para fins de engenharia e planejamento. Não é uma certificação de conformidade legal. A conformidade oficial exige verificação independente, arquiteturas de dados específicas (como registros descentralizados), identificadores digitais seguros e modelos de pegada de carbono auditados."
  },
  {
    question: "Posso usar este relatório como Passaporte de Bateria oficial?",
    answer: "Não. Este relatório é uma avaliação de prontidão e lacunas de dados para engenharia e planejamento. Um Passaporte de Bateria oficial pode exigir dados verificados, modelos de dados aprovados, identificadores digitais, infraestrutura QR, declarações de fornecedores, metodologia de pegada de carbono, registros autenticados e revisão regulatória."
  },
  {
    question: "Quais dados de bateria são necessários para um passaporte de bateria?",
    answer: "Os dados necessários são divididos em cinco grupos principais: 1) Identidade da Bateria (números de série, química, fabricante), 2) Desempenho e Durabilidade (SOH, eficiência de ida-e-volta, ciclos), 3) Dados de Ciclo de Vida e Operacionais (temperaturas, incidentes de segurança), 4) Sustentabilidade (pegada de carbono, matérias-primas, conteúdo reciclado) e 5) Documentação (declarações de conformidade, manuais de segurança)."
  },
  {
    question: "O passaporte de bateria inclui dados de SOH?",
    answer: "Sim. O Estado de Saúde (SOH) é um parâmetro operacional crítico. Deve ser atualizado periodicamente durante a vida ativa da bateria para informar operadores, avaliadores de segunda vida e recicladores sobre a capacidade restante e degradação de capacidade do sistema."
  },
  {
    question: "O que é prontidão de passaporte de bateria?",
    answer: "A prontidão do passaporte de bateria mede quão completa e precisa são os dados de um fabricante ou operador em relação aos requisitos regulatórios. Um escore alto de prontidão indica que todos os documentos de identidade, desempenho, pegada de carbono e segurança estão compilados e prontos para submissão formal ao registro."
  },
  {
    question: "Esta ferramenta pode criar um código QR?",
    answer: "Esta ferramenta gera um placeholder visual de código QR no cartão de visualização e no relatório impresso. Não gera nem hospeda uma URL de banco de dados persistente e ativa. Em sistemas de produção, o código QR vincula-se a uma página de registro de passaporte de produto digital segura."
  },
  {
    question: "Posso usar isto para baterias ESS marítimas?",
    answer: "Sim. Equipes de sistemas de armazenamento de energia marítima (ESS) podem usar esta ferramenta para compilar dados de linha de base, rastrear eventos operacionais, avaliar SOH e verificar se sua documentação atende regulamentações industriais padrão de baterias."
  },
  {
    question: "O que falta em um passaporte de bateria completo?",
    answer: "Um passaporte pronto para produção requer: integração com ledger distribuído seguro (ou registros de API autorizados), declarações verificadas de pegada de carbono do ciclo de vida (ISO 14067/14044), auditorias oficiais de cadeia de suprimentos e conexão BMS em tempo real para enviar dados de telemetria."
  },
  {
    question: "Quando entra em vigor o requisito de Passaporte de Bateria da UE?",
    answer: "O requisito de Passaporte de Bateria da UE está programado para entrar em vigor em fevereiro de 2027. Baterias industriais e VE colocadas no mercado da UE devem carregar um código QR visível vinculado à sua entrada no registro de passaporte digital até esse prazo."
  },
  {
    question: "Quanto custa um Passaporte de Bateria?",
    answer: "O custo varia conforme o escopo da implementação. Para avaliações internas de prontidão, ferramentas gratuitas como esta podem ajudar a estruturar dados. A conformidade formal tipicamente envolve plataformas de software, auditorias e taxas de registro. Orce infraestrutura de gestão de dados, verificação de terceiros e manutenção contínua ao planejar um programa completo de Passaporte de Bateria."
  },
  {
    question: "Posso preparar dados do Passaporte de Bateria sem um provedor pago?",
    answer: "Sim, você pode começar organizando dados existentes usando planilhas ou ferramentas gratuitas. No entanto, a conformidade formal exige identificadores digitais seguros, cálculos verificados de pegada de carbono e integração com registros. A maioria das organizações usa plataformas especializadas para a implementação final, mas o preparo inicial de dados pode ser feito independentemente."
  },
  {
    question: "Qual é a diferença entre um Passaporte de Bateria e uma ficha técnica de bateria?",
    answer: "Uma ficha técnica de bateria fornece especificações técnicas estáticas do fabricante. Um Passaporte de Bateria é um registro digital dinâmico que rastreia todo o ciclo de vida da bateria, incluindo dados de desempenho em tempo real, histórico de manutenção, pegada de carbono e instruções de reciclagem. Passaportes são atualizados ao longo do tempo, enquanto fichas técnicas permanecem fixas."
  },
  {
    question: "O Passaporte de Bateria precisa de dados de pegada de carbono?",
    answer: "Sim, dados de pegada de carbono são um requisito central sob regulamentações como o Regulamento de Baterias da UE. Você precisa declarar a pegada de carbono do produto (PCF) usando metodologias reconhecidas como ISO 14067 ou diretrizes PEF. Isso inclui emissões do ciclo de vida desde a extração de matérias-primas até manufatura, uso e processamento no fim da vida."
  }
];

const relatedTools = [
  { href: "/tools/battery-degradation-estimator/", title: "Estimador de Degradação", description: "Calcule perda de capacidade e SOH ao longo do tempo." },
  { href: "/tools/runtime-calculator/", title: "Calculador de Autonomia", description: "Estime autonomia a partir de capacidade, carga e eficiência." },
  { href: "/tools/battery-sizing-calculator/", title: "Calculador de Dimensionamento de Bateria", description: "Dimensione pacotes de armazenamento com base em perfis de carga elétrica." },
  { href: "/tools/soc-estimator/", title: "Estimador de SOC", description: "Estime o Estado de Carga a partir de tensão ou integração de corrente." }
];

const breadcrumbs = [
  { label: 'Ferramentas', href: '/pt/tools/' },
  { label: 'Gerador de Passaporte de Bateria' }
];
---

<Layout
  title="Gerador de Passaporte de Bateria | Ferramenta de Prontidão de Passaporte Digital"
  description="Crie um relatório de prontidão de passaporte de bateria com dados de ciclo de vida, SOH, desempenho, durabilidade, rastreabilidade, pegada de carbono e campos de checklist de conformidade."
  schema="webApplication"
  schemaName="Gerador de Passaporte de Bateria"
  schemaDescription="Um gerador de relatório e avaliação de prontidão de passaporte de bateria estruturado para engenharia."
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  lang="pt"
>
  <div class="mb-8 print:hidden">
    <Breadcrumb items={breadcrumbs} />
    <span class="text-label-uppercase text-m-blue-light text-[11px] block mt-4 mb-2">UTILIDADE DE PLANEJAMENTO DE ENGENHARIA</span>
    <h1 class="text-display-md text-primary leading-tight mb-3">Gerador de Passaporte de Bateria</h1>
    <p class="text-body-md text-body font-light max-w-4xl">
      Crie um relatório estruturado de ciclo de vida e prontidão de conformidade de bateria usando dados de identidade, SOH, desempenho, durabilidade, rastreabilidade, pegada de carbono e documentação.
    </p>
  </div>

  <section id="hero-section" class="bg-surface-card border border-hairline p-6 md:p-8 mb-12 print:hidden relative overflow-hidden">
    <div class="absolute -right-24 -top-24 w-72 h-72 rounded-full bg-m-blue-dark/15 blur-[80px] pointer-events-none"></div>
    <div class="absolute -left-24 -bottom-24 w-72 h-72 rounded-full bg-m-red/10 blur-[80px] pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8 items-center relative z-10">
      <div>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-3">Conformidade e Planejamento de Ciclo de Vida</h2>
        <p class="text-body-sm text-body leading-relaxed mb-6">
          Regulamentações como o upcoming Regulamento de Baterias da UE e iniciativas globais de rastreabilidade mineral exigem que sistemas de bateria industrial documentem parâmetros técnicos, de segurança e de carbono centrais. Use esta ferramenta de planejamento de engenharia para autoavaliar seus dados, medir seu nível de prontidão de conformidade e exportar um relatório formatado de prontidão de ciclo de vida.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#generator-tool" class="btn-primary text-xs h-11 inline-flex items-center">
            Iniciar Relatório de Passaporte de Bateria
          </a>
          <a href="#data-fields" class="btn-primary-outline text-xs h-11 inline-flex items-center">
            Ver Campos de Dados Necessários
          </a>
        </div>
      </div>

      <div class="bg-canvas border border-hairline p-6 relative rounded-none flex flex-col justify-between h-full min-h-[200px]">
        <div class="absolute top-0 left-0 w-full h-[4px] bg-gradient-to-r from-m-blue-light via-m-blue-dark to-m-red"></div>
        <div>
          <div class="flex justify-between items-start mb-4">
            <div>
              <span class="text-[9px] text-muted tracking-wider uppercase block">PRÉ-VISUALIZAÇÃO INICIAL DO PASSAPORTE</span>
              <span class="text-sm font-mono text-primary font-bold">BP-2026-X9B2</span>
            </div>
            <span class="text-[9px] font-bold border border-m-blue-light text-m-blue-light px-2 py-0.5 uppercase tracking-wider">Pronto para Revisão</span>
          </div>

          <div class="grid grid-cols-2 gap-y-3 gap-x-2 border-t border-hairline pt-3 mb-4 text-xs font-light text-body">
            <div>
              <span class="text-[10px] text-muted block">Modelo da Bateria:</span>
              <span class="text-primary font-medium">LiFePO4 ESS Marítimo</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">Química:</span>
              <span class="text-primary font-medium">LFP / LiFePO4</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">Tensão Nominal:</span>
              <span class="text-primary font-medium">51,2 V</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">Capacidade Nominal:</span>
              <span class="text-primary font-medium">200 Ah</span>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-end border-t border-hairline pt-3">
          <div>
            <span class="text-[10px] text-muted block">Completude dos Dados:</span>
            <div class="flex items-center gap-2">
              <div class="w-24 h-2 bg-surface-card rounded-none overflow-hidden">
                <div class="bg-m-blue-light h-full" style="width: 82%"></div>
              </div>
              <span class="text-xs font-mono text-primary font-bold">82%</span>
            </div>
          </div>
          <div class="w-10 h-10 border border-hairline flex items-center justify-center p-0.5 bg-white shrink-0">
            <div class="w-full h-full bg-canvas grid grid-cols-3 gap-0.5 p-0.5">
              <div class="bg-primary"></div><div class="bg-primary"></div><div class="bg-canvas"></div>
              <div class="bg-primary"></div><div class="bg-canvas"></div><div class="bg-primary"></div>
              <div class="bg-canvas"></div><div class="bg-primary"></div><div class="bg-primary"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="generator-tool" class="mb-16 scroll-mt-6">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8">
      
      <div id="form-column" class="flex flex-col gap-6 print:hidden">
        
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-blue-light text-m-blue-light flex items-center justify-center font-mono text-xs font-bold">A</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">Identidade da Bateria</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="identity-name" label="Nome do Pacote/Sistema de Bateria" type="text" value="" placeholder="ex: Navis Marine LFP-10" />
            <InputField id="identity-manufacturer" label="Fabricante / Organização" type="text" value="" placeholder="ex: Apex Power Systems" />
            <InputField id="identity-application" label="Perfil de Aplicação" type="select" options={applicationOptions} value="Stationary ESS" />
            <InputField id="identity-category" label="Categoria da Bateria" type="text" value="" placeholder="ex: Pacote Industrial / ESS" />
            <InputField id="identity-chemistry" label="Química da Célula" type="select" options={chemistryOptions} value="LFP / LiFePO4" />
            <InputField id="identity-nominal-voltage" label="Tensão Nominal (V)" type="number" value="" placeholder="ex: 51,2" min={0.1} step="any" />
            <InputField id="identity-nominal-capacity" label="Capacidade Nominal (Ah)" type="number" value="" placeholder="ex: 200" min={0.1} step="any" />
            <div class="flex flex-col gap-2 w-full">
              <label for="identity-energy-capacity" class="text-label-uppercase text-xs text-primary flex justify-between">
                <span>Capacidade Energética (kWh)</span>
                <span id="auto-calc-indicator" class="text-[9px] text-m-blue-light lowercase tracking-normal hidden">Auto-calculado</span>
              </label>
              <div class="relative flex items-center">
                <input id="identity-energy-capacity" type="number" class="text-input w-full" placeholder="ex: 10,24" min={0.01} step="any" />
                <span class="absolute right-3 text-caption text-muted">kWh</span>
              </div>
              <p class="text-caption text-muted">Deixe vazio para auto-calculado a partir de Volts × Ah.</p>
            </div>
            <InputField id="identity-manufacturing-date" label="Data de Fabricação" type="text" value="" placeholder="AAAA-MM-DD" />
            <InputField id="identity-country" label="País de Fabricação" type="text" value="" placeholder="ex: Alemanha" />
            <InputField id="identity-serial-number" label="Número de Série / ID do Pacote" type="text" value="" placeholder="ex: SN-LFP4-883719" />
          </div>
        </CalculatorCard>

        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-blue-dark text-m-blue-dark flex items-center justify-center font-mono text-xs font-bold">B</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">Desempenho e Durabilidade</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="perf-rated-cycles" label="Vida Útil Ciclos Nomeada (ciclos)" type="number" value="" placeholder="ex: 6000" min={1} />
            <InputField id="perf-current-cycles" label="Contagem de Ciclos Atual" type="number" value="" placeholder="ex: 120" min={0} />
            <InputField id="perf-soh" label="Estado de Saúde (SOH %)" type="number" value="" placeholder="ex: 98" min={0} max={120} />
            <InputField id="perf-efficiency" label="Eficiência Ida-e-Volta (%)" type="number" value="" placeholder="ex: 95" min={0} max={100} />
            <InputField id="perf-temp-min" label="Temp Mín Operação (°C)" type="number" value="" placeholder="ex: -10" step="any" />
            <InputField id="perf-temp-max" label="Temp Máx Operação (°C)" type="number" value="" placeholder="ex: 45" step="any" />
            <InputField id="perf-dod" label="DoD Recomendado (%)" type="number" value="" placeholder="ex: 80" min={0} max={100} />
            <InputField id="perf-warranty" label="Período de Garantia (Anos)" type="number" value="" placeholder="ex: 10" min={0} />
            <InputField id="perf-service-life" label="Vida Útil Esperada (Anos)" type="number" value="" placeholder="ex: 15" min={0} />
          </div>
        </CalculatorCard>

        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-red text-m-red flex items-center justify-center font-mono text-xs font-bold">C</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">Dados de Ciclo de Vida e Operacionais</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="life-commissioning-date" label="Data de Comissionamento" type="text" value="" placeholder="AAAA-MM-DD" />
            <InputField id="life-profile" label="Perfil Operacional" type="text" value="" placeholder="ex: Redução de Pico Solar" />
            <InputField id="life-average-c-rate" label="C-Rate Médio" type="number" value="" placeholder="ex: 0,5" min={0} step="any" />
            <InputField id="life-max-discharge" label="Corrente Máx Descarga (A)" type="number" value="" placeholder="ex: 200" min={0} step="any" />
            <InputField id="life-max-charge" label="Corrente Máx Carga (A)" type="number" value="" placeholder="ex: 100" min={0} step="any" />
            <InputField id="life-average-temp" label="Temp Operação Média (°C)" type="number" value="" placeholder="ex: 23" step="any" />
            <InputField id="life-thermal-events" label="Eventos Térmicos Observados" type="number" value="" placeholder="ex: 0" min={0} />
            <InputField id="life-safety-incidents" label="Incidentes de Segurança Observados" type="number" value="" placeholder="ex: 0" min={0} />
            <InputField id="life-maintenance-status" label="Status de Manutenção" type="text" value="" placeholder="ex: Nominal" />
          </div>
        </CalculatorCard>

        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-hairline text-muted flex items-center justify-center font-mono text-xs font-bold">D</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">Sustentabilidade e Rastreabilidade</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="sust-carbon-value" label="Valor da Pegada de Carbono" type="number" value="" placeholder="ex: 68" min={0} step="any" />
            <InputField id="sust-carbon-unit" label="Unidade da Pegada de Carbono" type="select" options={carbonUnitOptions} value="kg CO2e/kWh" />
            <InputField id="sust-carbon-method" label="Padrão de Metodologia ACV" type="text" value="" placeholder="ex: ISO 14067" />
            <InputField id="sust-recycled" label="Conteúdo Reciclado Declarado?" type="select" options={[{label: "Não Declarado", value: ""}, {label: "Sim", value: "yes"}, {label: "Não", value: "no"}]} value="" />
            <InputField id="sust-critical-materials" label="Materiais Críticos Declarados?" type="select" options={[{label: "Não Declarado", value: ""}, {label: "Sim", value: "yes"}, {label: "Não", value: "no"}]} value="" />
            <InputField id="sust-traceability" label="Rastreabilidade do Fornecedor Disponível?" type="select" options={[{label: "Não Declarado", value: ""}, {label: "Sim", value: "yes"}, {label: "Não", value: "no"}]} value="" />
            <InputField id="sust-recycling-instructions" label="Instruções de Reciclagem Declaradas?" type="select" options={[{label: "Não Declarado", value: ""}, {label: "Sim", value: "yes"}, {label: "Não", value: "no"}]} value="" />
            <InputField id="sust-second-life" label="Avaliação de Adequação de Segunda Vida" type="select" options={secondLifeOptions} value="Unknown" />
          </div>
        </CalculatorCard>

        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-hairline text-muted flex items-center justify-center font-mono text-xs font-bold">E</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">Checklist de Documentação</h3>
          </div>
          <p class="text-caption text-muted mb-4">Marque todos os documentos compilados para este sistema de bateria:</p>
          <div class="flex flex-col gap-3">
            {[
              { id: "doc-datasheet", label: "Ficha técnica compilada" },
              { id: "doc-conformity", label: "Declaração de Conformidade CE / UL assinada" },
              { id: "doc-safety-manual", label: "Manual de segurança do operador publicado" },
              { id: "doc-transport", label: "Certificação de segurança de transporte UN 38.3 arquivada" },
              { id: "doc-bms", label: "Protocolo de comunicação BMS / exportação de telemetria mapeado" },
              { id: "doc-carbon-decl", label: "Declaração de Pegada de Carbono do Produto (PCF) certificada" },
              { id: "doc-material", label: "Composição detalhada de materiais e inventário de matérias-primas críticas" },
              { id: "doc-recycling", label: "Instruções de reciclagem e processamento no fim da vida" }
            ].map(doc => (
              <label class="flex items-start gap-3 text-body-sm text-body cursor-pointer select-none">
                <input id={doc.id} type="checkbox" class="w-4 h-4 border border-hairline text-primary focus:ring-0 focus:outline-none accent-m-blue-light mt-0.5 rounded-none" />
                <span>{doc.label}</span>
              </label>
            ))}
