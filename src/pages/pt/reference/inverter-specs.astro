---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import ReferenceTable from '../../../components/ReferenceTable.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import FAQSection from '../../../components/FAQSection.astro';

const faqItems = [
  {
    question: "Qual é a diferença entre inversores de onda senoidal pura e onda senoidal modificada?",
    answer: "Inversores de onda senoidal pura (PSW) produzem uma forma de onda senoidal suave idêntica à da rede elétrica. Inversores de onda senoidal modificada (MSW) produzem uma forma de onda escalonada que se aproxima de uma senoide. PSW é obrigatório para eletrônicos sensíveis, equipamentos médicos, motores e aparelhos com microprocessadores. MSW é aceitável para cargas resistivas simples (lâmpadas, aquecedores), mas pode danificar motores e eletrônicos.",
  },
  {
    question: "Qual tamanho de inversor preciso para meu RV?",
    answer: "Para cargas básicas (lâmpadas, carga de celular, TV), um inversor de 1000W é suficiente. Para micro-ondas (1000W), cafeteira (800W) e secador de cabelo (1500W), use um inversor de 2000–3000W. Some todas as cargas simultâneas e adicione 20% de margem. Considere inversores-carregadores para integração com energia de cais.",
  },
  {
    question: "Como dimensiono um inversor para meu banco de baterias?",
    answer: "Combine a potência contínua do inversor com suas cargas. Para dimensionar o banco de baterias, divida a potência do inversor pela tensão da bateria para obter a corrente consumida. Um inversor de 2000W em 12V consome ~167A. Certifique-se de que seu banco de baterias sustenta essa corrente. Para chumbo-ácido, a descarga máxima não deve exceder 25% da capacidade. Para LFP, 80% DoD é aceitável.",
  },
  {
    question: "Qual é a diferença entre um inversor e um inversor-carregador?",
    answer: "Um inversor converte a energia CC da bateria em saída CA. Um inversor-carregador adiciona um carregador de bateria CA embutido que pode carregar as baterias a partir de energia de cais ou gerador. Inversores-carregadores alternam automaticamente entre modo inversor e modo carregador. São ideais para aplicações de RV, marítimas e backup residencial.",
  },
  {
    question: "Qual eficiência devo esperar de um inversor de qualidade?",
    answer: "Inversores de onda senoidal pura de qualidade operam com 88–94% de eficiência em carga nominal. Em cargas leves (10–20% da capacidade nominal), a eficiência cai para 80–85%. O pico de eficiência ocorre tipicamente a 40–60% da carga. Verifique sempre a curva de eficiência, não apenas o pico. Maior eficiência significa menor consumo da bateria.",
  },
  {
    question: "Posso ligar um ar-condicionado em um inversor a bateria?",
    answer: "Sim, mas você precisa de um sistema grande. Um ar-condicionado de RV de 15,000 BTU consome 1,500–2,000W em operação, mas exige 3,000–4,000W para o surto de partida. Você precisa de um inversor de no mínimo 5,000W e pelo menos 200Ah de LFP 12V (ou 400Ah de chumbo-ácido) para 8 horas de autonomia. Um dispositivo de partida suave reduz o surto a níveis gerenciáveis.",
  },
];

const relatedCalculators = [
  { title: 'Calculadora de Bateria para Inversor', href: '/pt/tools/inverter-battery-calculator/', type: 'calculator' },
  { title: 'Calculadora de Autonomia', href: '/pt/tools/runtime-calculator/', type: 'calculator' },
  { title: 'Calculadora de Dimensionamento de Bateria', href: '/pt/tools/battery-sizing-calculator/', type: 'calculator' },
  { title: 'Calculadora de Perdas em Cabos CC', href: '/pt/tools/dc-cable-loss-calculator/', type: 'calculator' },
];

const relatedGuides = [
  { title: 'Guia de Autonomia de Bateria para Inversor', href: '/pt/learn/inverter-battery-runtime-guide/', type: 'guide' },
  { title: 'Referência de Dimensionamento de Bateria', href: '/pt/learn/battery-sizing-reference/', type: 'guide' },
];

const tableOfContents = [
  { id: 'inverter-specs', label: 'Especificações de Inversores' },
  { id: 'inverter-types', label: 'Comparativo de Tipos de Inversor' },
];
---

<ArticleLayout
  title="Referência de Especificações de Inversores | Calculadoras de Bateria"
  description="Referência completa de especificações de inversores abrangendo inversores de 500W a 10kW com tensão de entrada, saída, eficiência, peso e comparativo de tipos de inversor."
  canonical="https://batterycalculators.com/pt/reference/inverter-specs/"
  lang="pt"
  category="REFERÊNCIA"
  categoryHref="/pt/reference/"
  breadcrumbItems={[{ label: 'Especificações de Inversores' }]}
  relatedCalculators={relatedCalculators}
  relatedGuides={relatedGuides}
  tableOfContents={tableOfContents}
  faqItems={faqItems}
>
  <p class="text-body-md text-body font-light mb-8">
    Esta referência abrange inversores comuns CC-CA de 500W a 10kW para aplicações de RV, marítimas, solares e backup residencial. As especificações representam produtos típicos dos principais fabricantes em 2026.
  </p>

  <div id="inverter-specs">
    <ReferenceTable
    lang="pt"
      title="Especificações de Inversores"
      description="Modelos comuns de inversores com tensão de entrada, saída, eficiência, capacidade de surto e peso."
      headers={['Potência', 'Tensão de Entrada', 'Saída', 'Eficiência', 'Surto (10s)', 'Peso (lbs)', 'Formato']}
      rows={[
        ['500W', '12V CC', '120V CA, 60Hz', '88%', '1,000W', '5.5', 'Compacto'],
        ['1,000W', '12V CC', '120V CA, 60Hz', '90%', '2,000W', '7.5', 'Compacto'],
        ['1,500W', '12V CC', '120V CA, 60Hz', '90%', '3,000W', '10', 'Médio'],
        ['2,000W', '12V CC', '120V CA, 60Hz', '91%', '4,000W', '12', 'Médio'],
        ['3,000W', '12/24V CC', '120V CA, 60Hz', '92%', '6,000W', '15', 'Grande'],
        ['3,000W', '24V CC', '120V CA, 60Hz', '92%', '6,000W', '14', 'Grande'],
        ['5,000W', '24/48V CC', '120/240V CA', '93%', '10,000W', '28', 'Para rack'],
        ['5,000W', '48V CC', '120/240V CA', '93%', '10,000W', '25', 'Para rack'],
        ['7,500W', '48V CC', '120/240V CA', '93%', '15,000W', '40', 'De piso'],
        ['10,000W', '48V CC', '120/240V CA', '94%', '20,000W', '55', 'De piso'],
      ]}
      source="Especificações típicas das linhas Victron, Magnum, Aims Power e Growatt"
    />
  </div>

  <div id="inverter-types">
    <ComparisonTable
      title="Comparativo de Tipos de Inversor"
      headers={['Recurso', 'Onda Senoidal Pura', 'Onda Senoidal Modificada', 'Inversor-Carregador']}
      rows={[
        ['Forma de Onda de Saída', 'Onda senoidal suave', 'Aproximação escalonada', 'Onda senoidal pura'],
        ['Faixa de Preço', '$$$', '$', '$$$$'],
        ['Eficiência', '88–94%', '85–90%', '88–94%'],
        ['Cargas Compatíveis', 'Todas as cargas', 'Somente resistivas', 'Todas as cargas'],
        ['Compatível com Motores', 'Sim', 'Não (superaquece)', 'Sim'],
        ['Equipamento Médico', 'Sim', 'Não', 'Sim'],
        ['Eletrônicos Sensíveis', 'Sim', 'Não (pode danificar)', 'Sim'],
        ['Carregador Embutido', 'Não', 'Não', 'Sim (30–100A)'],
        ['Chave de Transferência', 'Não', 'Não', 'Sim (30–50A)'],
        ['Ideal Para', 'Solar, RV, marítimo', 'Lâmpadas, ferramentas básicas', 'RV, marítimo, backup residencial'],
        ['Peso Típico (2kW)', '12 lbs', '8 lbs', '25 lbs'],
        ['Monitoramento Remoto', 'Alguns modelos', 'Não', 'Maioria dos modelos'],
      ]}
      caption="Onda senoidal pura é recomendada para todas as aplicações. Onda senoidal modificada é aceitável apenas para cargas resistivas simples."
    />
  </div>

  <div class="bg-surface-card border border-hairline p-6 mb-12">
    <h3 class="text-title-lg text-primary uppercase tracking-wider mb-3">Aviso Legal</h3>
    <p class="text-body-sm text-muted font-light">
      As especificações de inversores variam por fabricante, modelo e condições de operação. As classificações de eficiência são em carga nominal; a eficiência real varia com o nível de carga e a tensão da bateria. As classificações de surto são tipicamente para 10 segundos. Consulte sempre as folhas de dados dos fabricantes para especificações de produtos específicos. Esta referência é apenas para fins informativos e educacionais.
    </p>
  </div>
</ArticleLayout>
