---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import ReferenceTable from '../../../components/ReferenceTable.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import FAQSection from '../../../components/FAQSection.astro';

const faqItems = [
  {
    question: "Qual química de bateria é melhor para armazenamento solar?",
    answer: "LiFePO4 (LFP) é a química recomendada para armazenamento solar. Oferece 3,000–5,000 ciclos a 80% DoD, 90–160 Wh/kg de densidade de energia e zero manutenção. NMC oferece maior densidade de energia, mas com custo mais alto e riscos de fuga térmica. Chumbo-ácido continua viável apenas para instalações com orçamento limitado e ciclagem pouco frequente.",
  },
  {
    question: "NMC é mais seguro que LFP?",
    answer: "Não. LiFePO4 é a química de íons de lítio mais segura, com início de fuga térmica acima de 270°C. NMC tem início de fuga térmica em torno de 150–210°C e exige BMS mais sofisticado. Para aplicações residenciais e marítimas onde a segurança é primordial, LFP é a escolha preferida.",
  },
  {
    question: "Posso usar baterias de chumbo-ácido para energia solar?",
    answer: "Sim, mas com limitações significativas. Chumbo-ácido inundada exige manutenção mensal, limite de 50% DoD e vida útil de 3–5 anos. As variantes AGM e Gel são seladas e livres de manutenção, mas custam 1.5–2× mais que a inundada. Chumbo-ácido é recomendado apenas para instalações econômicas com ciclagem pouco frequente ou backup de emergência.",
  },
  {
    question: "Qual é a diferença entre NMC e NCA?",
    answer: "Ambas são químicas de lítio à base de níquel. NMC (Níquel Manganês Cobalto) oferece melhor vida útil em ciclos (1,000–2,000 ciclos) e estabilidade térmica. NCA (Níquel Cobalto Alumínio) tem densidade de energia ligeiramente maior (150–250 Wh/kg), mas menor vida útil (500–1,000 ciclos) e custo mais alto. NMC é preferida para armazenamento estacionário; NCA é comum em VEs.",
  },
  {
    question: "Como a temperatura afeta a química da bateria?",
    answer: "Todas as químicas têm melhor desempenho a 20–25°C. LFP opera de −20°C a 60°C, mas não pode carregar abaixo de 0°C. A capacidade do chumbo-ácido cai ~20% a 0°C. NMC e NCA têm janelas seguras de operação mais estreitas (0–45°C). Baterias de gel suportam melhor o calor que AGM, mas têm taxas de carga menores.",
  },
  {
    question: "Qual química devo usar em aplicação de RV ou marítima?",
    answer: "LiFePO4 é a melhor escolha para aplicações de ciclo profundo em RV e marítimas. Entrega 80–100% de capacidade utilizável, pesa 60% menos que chumbo-ácido e dura 10–15 anos. Baterias de gel são uma boa alternativa econômica para partida marítima, mas LFP domina os bancos residenciais.",
  },
];

const relatedCalculators = [
  { title: 'Calculadora de Dimensionamento de Bateria Solar', href: '/pt/tools/solar-battery-sizing-calculator/', type: 'calculator' },
  { title: 'Calculadora de Custo de Bateria', href: '/pt/tools/solar-battery-sizing-calculator/', type: 'calculator' },
  { title: 'Calculadora de Taxa C', href: '/pt/tools/c-rate-calculator/', type: 'calculator' },
  { title: 'Estimador de Degradação de Bateria', href: '/pt/tools/battery-degradation-estimator/', type: 'calculator' },
];

const relatedGuides = [
  { title: 'LiFePO4 vs Chumbo-ácido', href: '/pt/learn/lifepo4-vs-lead-acid/', type: 'guide' },
  { title: 'Melhor Química de Bateria para Energia Solar', href: '/pt/learn/best-battery-chemistry-for-solar/', type: 'guide' },
  { title: 'Gráfico de Tensão LiFePO4', href: '/pt/learn/lifepo4-voltage-chart/', type: 'guide' },
];

const tableOfContents = [
  { id: 'chemistry-specs', label: 'Especificações das Químicas' },
  { id: 'application-matrix', label: 'Matriz de Aplicações' },
  { id: 'electrical-properties', label: 'Propriedades Elétricas' },
  { id: 'lifecycle-comparison', label: 'Comparativo de Vida Útil' },
];
---

<ArticleLayout
  title="Comparativo de Químicas de Bateria | Calculadoras de Bateria"
  description="Referência completa de engenharia para químicas de bateria: LiFePO4, NMC, NCA, chumbo-ácido e gel. Compare tensão, densidade de energia, vida útil em ciclos, custo, segurança e faixa de temperatura."
  canonical="https://batterycalculators.com/pt/reference/battery-chemistry-comparison/"
  lang="pt"
  category="REFERÊNCIA"
  categoryHref="/pt/reference/"
  breadcrumbItems={[{ label: 'Comparativo de Químicas de Bateria' }]}
  relatedCalculators={relatedCalculators}
  relatedGuides={relatedGuides}
  tableOfContents={tableOfContents}
  faqItems={faqItems}
>
  <p class="text-body-md text-body font-light mb-8">
    Esta referência abrange as cinco químicas de bateria mais comuns usadas em armazenamento solar, RV, aplicações marítimas, VE e telecom. Os dados representam células típicas de produção a 25°C. O desempenho real varia conforme fabricante, qualidade da célula e condições de operação.
  </p>

  <div id="chemistry-specs">
    <ReferenceTable
    lang="pt"
      title="Especificações Principais das Químicas"
      description="Comparativo lado a lado das principais especificações para baterias LFP, NMC, NCA, chumbo-ácido inundada e gel."
      headers={['Especificação', 'LiFePO4 (LFP)', 'NMC', 'NCA', 'Chumbo-ácido Inundada', 'Chumbo-ácido Gel']}
      rows={[
        ['Tensão Nominal (por célula)', '3.2V', '3.6V', '3.6V', '2.0V', '2.0V'],
        ['Densidade de Energia (Wh/kg)', '90–160', '150–220', '150–250', '30–50', '30–50'],
        ['Densidade de Energia (Wh/L)', '200–350', '350–650', '350–650', '60–100', '60–100'],
        ['Vida Útil em Ciclos (80% DoD)', '3,000–5,000', '1,000–2,000', '500–1,000', '300–500', '500–800'],
        ['Vida Útil de Calendário (anos)', '10–15', '8–12', '5–8', '3–5', '5–8'],
        ['DoD Utilizável', '80–100%', '80–90%', '80–90%', '50%', '50–70%'],
        ['Autodescarga (por mês)', '1–3%', '1–3%', '1–3%', '5–15%', '2–5%'],
        ['Custo por kWh ($)', '250–400', '200–350', '250–400', '100–200', '150–250'],
        ['Classificação de Segurança', 'Excelente', 'Boa', 'Razoável', 'Razoável (ácido/ventilação)', 'Boa (selada)'],
        ['Temp. de Operação (°C)', '−20 a 60', '0 a 45', '0 a 45', '−20 a 50', '−20 a 50'],
        ['Temp. de Carga (°C)', '0 a 45', '0 a 45', '0 a 45', '−20 a 50', '−20 a 50'],
        ['Manutenção', 'Nenhuma', 'Nenhuma', 'Nenhuma', 'Reposição mensal de água', 'Nenhuma'],
      ]}
      source="Médias do setor de Battery University, DOE Battery2030 e folhas de dados de fabricantes"
    />
  </div>

  <div id="application-matrix">
    <ComparisonTable
      title="Melhor Química por Aplicação"
      headers={['Aplicação', 'Recomendada', 'Segunda Opção', 'Observações']}
      rows={[
        ['Armazenamento Solar (Residencial)', 'LiFePO4', 'NMC', 'LFP preferida para ciclagem diária e segurança. NMC apenas onde o espaço é limitado.'],
        ['Bateria Residencial de RV', 'LiFePO4', 'AGM', 'LFP oferece 80–100% de DoD e zero manutenção. AGM como opção econômica.'],
        ['Ciclo Profundo Marítimo', 'LiFePO4', 'Gel', 'LFP se destaca em resistência à vibração e peso. Gel para orçamentos menores.'],
        ['Veículo Elétrico (VE)', 'NMC', 'NCA', 'NMC domina os VEs por densidade de energia e carga rápida. LFP ganhando espaço.'],
        ['Backup de Telecom', 'LiFePO4', 'VRLA', 'LFP para vida útil acima de 10 anos. VRLA para sistemas legados de 48V.'],
        ['Partida de Motor (SLI)', 'Chumbo-ácido Inundada', 'AGM', 'Chumbo-ácido continua dominante para alta corrente de partida.'],
        ['UPS / Backup de Emergência', 'VRLA (AGM)', 'LiFePO4', 'VRLA comprovada em UPS. LFP crescendo para backup de longa duração.'],
        ['Carrinho de Golfe / Utilitários', 'LiFePO4', 'Chumbo-ácido Inundada', 'LFP pela economia de peso e vida útil. Chumbo-ácido para orçamentos menores.'],
      ]}
      caption="A seleção depende da frequência de ciclagem, restrições de espaço, orçamento e requisitos de segurança."
    />
  </div>

  <div id="electrical-properties">
    <ReferenceTable
    lang="pt"
      title="Propriedades Elétricas na Tensão Nominal"
      description="Características elétricas típicas para configurações comuns de pacotes (4S LFP = 12.8V, 3S NMC = 10.8V, 6V chumbo-ácido)."
      headers={['Propriedade', 'Pacote LFP 12.8V', 'Pacote NMC 10.8V', 'Célula Chumbo-ácido 6V']}
      rows={[
        ['Tensão de Carga', '14.4–14.6V', '12.6–12.8V', '7.0–7.2V'],
        ['Tensão de Flutuação', '13.6V', '12.0V', '6.8V'],
        ['Corte de Descarga', '10.0V', '8.0V', '5.25V'],
        ['Capacidade Nominal (100Ah)', '1,280 Wh', '1,080 Wh', '600 Wh (50% DoD)'],
        ['Capacidade Utilizável (100Ah)', '1,024 Wh', '864 Wh', '300 Wh'],
        ['Descarga Contínua Máx. (1C)', '100A', '100A', '25A (0.25C típico)'],
        ['Resistência Interna (por célula)', '0.5–2.0 mΩ', '5–15 mΩ', '10–30 mΩ'],
        ['Eficiência de Ciclo Completo', '95–98%', '90–95%', '75–85%'],
        ['Eficiência de Carga', '98–99%', '95–98%', '80–85%'],
      ]}
      source="Valores típicos de dados de teste de fabricantes a 25°C, taxa de 0.5C"
    />
  </div>

  <div id="lifecycle-comparison">
    <ReferenceTable
    lang="pt"
      title="Análise de Custo de Ciclo de Vida"
      description="Comparativo do custo total de propriedade para um sistema de armazenamento utilizável de 5 kWh ao longo de 10 anos."
      headers={['Fator de Custo', 'LiFePO4', 'NMC', 'Chumbo-ácido Gel', 'Chumbo-ácido Inundada']}
      rows={[
        ['Custo Inicial da Bateria', '$1,250–2,000', '$1,000–1,750', '$750–1,250', '$500–1,000'],
        ['Trocas em 10 Anos', '0–1', '1–2', '1–2', '2–3'],
        ['Custo Total de Bateria (10 anos)', '$1,250–2,000', '$1,500–2,625', '$1,125–1,875', '$1,000–2,000'],
        ['Custo do BMS (se separado)', '$0–50', '$0–50', 'N/A', 'N/A'],
        ['Custo de Manutenção (10 anos)', '$0', '$0', '$0', '$200–400'],
        ['Perda de Energia (10 anos a $0.15/kWh)', '$50–75', '$75–113', '$150–225', '$150–225'],
        ['Custo Total de Propriedade', '$1,300–2,125', '$1,575–2,788', '$1,275–2,100', '$1,350–2,625'],
        ['Custo por kWh por Ciclo', '$0.01–0.02', '$0.03–0.06', '$0.05–0.10', '$0.08–0.15'],
      ]}
      source="Estimativa baseada em dados de preços do setor e especificações de vida útil em ciclos"
    />
  </div>

  <div class="bg-surface-card border border-hairline p-6 mb-12">
    <h3 class="text-title-lg text-primary uppercase tracking-wider mb-3">Aviso Legal</h3>
    <p class="text-body-sm text-muted font-light">
      Todos os valores desta referência são faixas típicas baseadas em dados publicados de fabricantes e médias do setor em 2026. O desempenho real varia conforme fabricante, qualidade da célula, temperatura, taxa de carga/descarga e condições de operação. Esta referência é apenas para fins informativos e educacionais. Consulte sempre as folhas de dados dos fabricantes para especificações de produtos específicos antes de tomar decisões de compra.
    </p>
  </div>

  <section class="mb-12 border-t border-hairline pt-12">
    <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">Ferramentas Relacionadas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/pt/tools/solar-battery-sizing-calculator/" class="block bg-surface-card border border-hairline p-4 hover:border-m-blue-light transition-colors">
        <span class="text-label-uppercase text-m-blue-light text-xs block mb-2">Calculadora</span>
        <span class="text-primary font-bold">Calculadora de Dimensionamento de Bateria Solar</span>
        <p class="text-body-sm text-muted mt-1">Determine o tamanho ideal do banco de baterias para seu sistema solar.</p>
      </a>
      <a href="/pt/tools/battery-pack-calculator/" class="block bg-surface-card border border-hairline p-4 hover:border-m-blue-light transition-colors">
        <span class="text-label-uppercase text-m-blue-light text-xs block mb-2">Calculadora</span>
        <span class="text-primary font-bold">Calculadora de Pacote de Baterias</span>
        <p class="text-body-sm text-muted mt-1">Projete configurações de baterias em série e paralelo.</p>
      </a>
    </div>
  </section>
</ArticleLayout>
