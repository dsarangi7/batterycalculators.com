---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';

const referencePages = [
  { title: 'Referência de Tensão de Bateria', description: 'Todas as tensões comuns de bateria com configurações típicas, aplicações e requisitos de cabos.', href: '/pt/reference/battery-voltage-reference/' },
  { title: 'Referência de Taxa C', description: 'Referência completa de taxa C de 0,05C a 5C com valores de corrente para capacidades comuns.', href: '/pt/reference/c-rate-reference/' },
  { title: 'Referência de Temperatura de Bateria', description: 'Efeitos da temperatura na capacidade e nos limites de carga/descarga para LFP, NMC e chumbo-ácido.', href: '/pt/reference/battery-temperature-reference/' },
  { title: 'Normas Elétricas Marítimas', description: 'Requisitos das normas ISO 13297, ABYC E-11 e USCG 33 CFR 183 para sistemas elétricos marítimos.', href: '/pt/reference/marine-electrical-standards/' },
  { title: 'Referência de Dimensionamento Solar', description: 'Horas de sol pleno, dimensionamento de arranjos e configurações de sistemas para aplicações solares comuns.', href: '/pt/reference/solar-sizing-reference/' },
  { title: 'Referência de Fórmulas de Bateria', description: 'Todas as fórmulas essenciais de bateria, incluindo lei de Ohm, taxa C, queda de tensão, dimensionamento e cálculos de energia.', href: '/pt/reference/battery-formulas-reference/' },
];

const relatedCalculators = [
  { title: 'Calculadora de Dimensionamento de Bateria', href: '/pt/tools/battery-sizing-calculator/', type: 'calculator' as const },
  { title: 'Calculadora de Taxa C', href: '/pt/tools/c-rate-calculator/', type: 'calculator' as const },
  { title: 'Calculadora de Autonomia', href: '/pt/tools/runtime-calculator/', type: 'calculator' as const },
  { title: 'Calculadora de Queda de Tensão', href: '/pt/tools/voltage-drop-calculator/', type: 'calculator' as const },
];
---

<ArticleLayout
  title="Biblioteca de Referência Técnica | Calculadoras de Bateria"
  description="Tabelas de referência rápida, fórmulas e normas para sistemas de baterias, dimensionamento solar, elétrica marítima e mais. Baixe versões CSV de cada tabela de referência."
  canonical="https://batterycalculators.com/pt/reference/"
  lang="pt"
  category="REFERÊNCIA"
  categoryHref="/pt/reference/"
  breadcrumbItems={[{ label: 'Biblioteca de Referência' }]}
  relatedCalculators={relatedCalculators}
>
  <p class="text-body-md text-body font-light mb-8">
    Esta biblioteca de referência fornece dados técnicos, fórmulas de engenharia e normas do setor para o projeto de sistemas de baterias. Cada tabela pode ser baixada como CSV para uso em planilhas e ferramentas de engenharia. Use estas referências junto com as calculadoras para um projeto preciso do sistema.
  </p>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">Páginas de Referência</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {referencePages.map((page) => (
        <CalculatorCard>
          <a href={page.href} class="text-primary hover:underline font-bold block mb-2">{page.title}</a>
          <p class="text-body-sm text-muted">{page.description}</p>
        </CalculatorCard>
      ))}
    </div>
  </section>
</ArticleLayout>
