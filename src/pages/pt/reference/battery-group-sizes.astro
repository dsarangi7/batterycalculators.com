---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import ReferenceTable from '../../../components/ReferenceTable.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import FAQSection from '../../../components/FAQSection.astro';

const faqItems = [
  {
    question: "Qual é a diferença entre baterias do Grupo 24 e do Grupo 27?",
    answer: "Baterias do Grupo 27 são fisicamente maiores e têm mais capacidade. Uma bateria típica de chumbo-ácido do Grupo 24 tem 70–85 Ah, enquanto uma do Grupo 27 tem 85–105 Ah. O Grupo 27 mede aproximadamente 12.9 × 6.8 × 9.0 inches contra 10.5 × 6.8 × 9.0 inches do Grupo 24. Se a bandeja da bateria comportar, o Grupo 27 oferece mais autonomia.",
  },
  {
    question: "Qual tamanho de grupo de bateria preciso para meu RV?",
    answer: "A maioria das bandejas de bateria residencial de RV aceita Grupo 24 ou Grupo 27. Para chumbo-ácido, o Grupo 27 oferece mais capacidade (85–105 Ah). Para LiFePO4, muitas baterias de 100Ah são construídas nas dimensões do Grupo 31 (13 × 7 × 9 inches). Meça sempre a bandeja da bateria antes de comprar.",
  },
  {
    question: "Os tamanhos de grupo BCI são iguais aos tamanhos DIN ou EN?",
    answer: "Não. BCI (Battery Council International) é a norma norte-americana. DIN (Deutsche Industrie Norm) e EN (European Norm) usam normas dimensionais diferentes. Um Grupo 31 BCI não é igual a um DIN 100. Verifique sempre as dimensões ao fazer referência cruzada entre normas.",
  },
  {
    question: "Posso usar uma bateria do Grupo 31 em uma bandeja do Grupo 24?",
    answer: "Somente se a bandeja for grande o suficiente. As dimensões do Grupo 31 (aproximadamente 13 × 6.8 × 9.4 inches) são maiores que as do Grupo 24 (10.5 × 6.8 × 9.0 inches). O Grupo 31 é cerca de 2.5 inches mais comprido. Muitas bandejas de RV e marítimas têm suportes ajustáveis que acomodam o Grupo 31.",
  },
  {
    question: "Para que são usadas as baterias dos Grupos 4D e 8D?",
    answer: "Os Grupos 4D e 8D são baterias grandes de ciclo profundo usadas em caminhões comerciais, ônibus, bancos residenciais marítimos e aplicações industriais. O Grupo 4D oferece 150–220 Ah; o Grupo 8D oferece 200–255 Ah. Pesam 60–130 lbs cada e são comuns em veículos comerciais e bancos residenciais de iates.",
  },
  {
    question: "O que é o grupo de bateria L16?",
    answer: "L16 é um grupo de bateria de ciclo profundo de altura estendida, comumente usado em aplicações solares, de telecom e industriais. Mede aproximadamente 11.6 × 7 × 17 inches (mais alto que os grupos padrão). Baterias L16 oferecem 300–400 Ah a 6V e são projetadas para aplicações de ciclo profundo que exigem capacidade máxima.",
  },
];

const relatedCalculators = [
  { title: 'Calculadora de Dimensionamento de Bateria', href: '/pt/tools/battery-sizing-calculator/', type: 'calculator' },
  { title: 'Calculadora de Bateria para RV', href: '/pt/tools/rv-battery-calculator/', type: 'calculator' },
  { title: 'Calculadora de Dimensionamento de Bateria Marítima', href: '/pt/tools/marine-battery-sizing-calculator/', type: 'calculator' },
  { title: 'Calculadora de Pacote de Baterias', href: '/pt/tools/battery-pack-calculator/', type: 'calculator' },
];

const relatedGuides = [
  { title: 'Como Dimensionar um Banco de Baterias', href: '/pt/learn/how-to-size-a-battery-bank/', type: 'guide' },
  { title: 'Referência de Dimensionamento de Bateria', href: '/pt/learn/battery-sizing-reference/', type: 'guide' },
];

const tableOfContents = [
  { id: 'standard-groups', label: 'Tamanhos de Grupo Padrão' },
  { id: 'lithium-equivalents', label: 'Equivalentes em Lítio' },
  { id: 'application-guide', label: 'Guia de Aplicações' },
];
---

<ArticleLayout
  title="Referência de Tamanhos de Grupo de Bateria | Calculadoras de Bateria"
  description="Referência completa de tamanhos de grupo de bateria BCI com dimensões, capacidade, peso e aplicações típicas. Abrange Grupo 24, 27, 31, 4D, 8D, L16 e equivalentes em lítio."
  canonical="https://batterycalculators.com/pt/reference/battery-group-sizes/"
  lang="pt"
  category="REFERÊNCIA"
  categoryHref="/pt/reference/"
  breadcrumbItems={[{ label: 'Tamanhos de Grupo de Bateria' }]}
  relatedCalculators={relatedCalculators}
  relatedGuides={relatedGuides}
  tableOfContents={tableOfContents}
  faqItems={faqItems}
>
  <p class="text-body-md text-body font-light mb-8">
    Os tamanhos de grupo BCI (Battery Council International) definem dimensões padrão de bateria para veículos norte-americanos e sistemas de armazenamento de energia. Esta referência abrange os tamanhos de grupo de ciclo profundo mais comuns usados em aplicações de RV, marítimas, solares e industriais.
  </p>

  <div id="standard-groups">
    <ReferenceTable
    lang="pt"
      title="Tamanhos de Grupo Padrão Chumbo-ácido"
      description="Tamanhos de grupo BCI com dimensões, capacidade, peso e aplicações típicas para baterias chumbo-ácido."
      headers={['Grupo', 'C × L × A (in)', 'C × L × A (mm)', 'Capacidade (Ah)', 'Peso (lbs)', 'Uso Típico']}
      rows={[
        ['24', '10.5 × 6.8 × 9.0', '267 × 173 × 229', '70–85', '40–50', 'RV residencial, partida marítima'],
        ['27', '12.9 × 6.8 × 9.0', '328 × 173 × 229', '85–105', '50–60', 'RV residencial, ciclo profundo marítimo'],
        ['30', '13.5 × 6.8 × 9.5', '343 × 173 × 241', '95–125', '55–70', 'Residencial marítimo, comercial'],
        ['31', '13.0 × 6.8 × 9.4', '330 × 173 × 239', '100–125', '55–75', 'RV residencial, marítimo, telecom'],
        ['4D', '20.8 × 8.3 × 11.0', '528 × 211 × 279', '150–220', '75–100', 'Caminhão comercial, marítimo'],
        ['8D', '20.8 × 11.0 × 11.0', '528 × 279 × 279', '200–255', '100–130', 'Comercial, residencial marítimo'],
        ['L16', '11.6 × 7.0 × 17.0', '295 × 178 × 432', '300–400 (6V)', '80–120', 'Solar, telecom, industrial'],
        ['GC2 (Carrinho de Golfe)', '10.3 × 7.1 × 11.2', '262 × 180 × 285', '180–225 (6V)', '62–70', 'Carrinho de golfe, lavadora de pisos'],
      ]}
      source="Normas de Numeração de Grupo BCI e dados dimensionais de fabricantes"
    />
  </div>

  <div id="lithium-equivalents">
    <ReferenceTable
    lang="pt"
      title="Equivalentes em Lítio (LiFePO4) por Tamanho de Grupo"
      description="Baterias LiFePO4 projetadas nas dimensões dos grupos BCI. Observação: baterias de lítio normalmente pesam 50–65% menos que as equivalentes em chumbo-ácido."
      headers={['Grupo', 'C × L × A (in)', 'Capacidade (Ah)', 'Tensão', 'Peso (lbs)', 'Observações']}
      rows={[
        ['24 (formato Grupo 24)', '10.5 × 6.8 × 7.5', '50–80', '12.8V', '15–25', 'Substituição direta para chumbo-ácido'],
        ['31 (formato Grupo 31)', '13.0 × 6.8 × 8.5', '100–110', '12.8V', '25–30', 'Formato mais popular'],
        ['27 (formato Grupo 27)', '12.9 × 6.8 × 8.0', '80–100', '12.8V', '20–28', 'Cabe na maioria das bandejas de RV'],
        ['4D (formato Grupo 4D)', '20.8 × 8.3 × 8.5', '200–230', '12.8V', '45–55', 'Marítimo comercial'],
        ['8D (formato Grupo 8D)', '20.8 × 11.0 × 8.5', '250–315', '12.8V', '55–70', 'Marítimo/industrial de grande porte'],
        ['12V 100Ah Prismática', '13.0 × 6.8 × 8.5', '100', '12.8V', '25–30', 'Formato DIY comum'],
        ['12V 200Ah Prismática', '20.5 × 9.4 × 8.6', '200', '12.8V', '48–55', 'Sistemas de grande capacidade'],
      ]}
      source="Especificações de fabricantes das principais marcas de LiFePO4 (2024–2026)"
    />
  </div>

  <div id="application-guide">
    <ComparisonTable
      title="Tamanhos de Grupo por Aplicação"
      headers={['Aplicação', 'Grupo Recomendado', 'Faixa de Capacidade', 'Observações']}
      rows={[
        ['Bateria Residencial de RV', '31 (LFP)', '100–110 Ah', 'O Grupo 31 é o formato padrão para LFP de 100Ah. Cabe na maioria das bandejas.'],
        ['Ciclo Profundo Marítimo', '31 (LFP)', '100–110 Ah', 'ABYC recomenda ciclo profundo dedicado. LFP Grupo 31 para banco residencial.'],
        ['Carrinho de Golfe', 'GC2 (LFP)', '100–105 Ah', 'Formato GC2 disponível em LFP. Substitui chumbo-ácido inundada de 6V em série.'],
        ['Cadeira de Rodas / Mobilidade', '22NF ou U1', '35–50 Ah', 'Grupos menores para mobilidade. U1 é comum em cadeiras de rodas motorizadas.'],
        ['Armazenamento Solar (Residencial)', 'L16 ou 8D', '200–400 Ah', 'Grande capacidade para off-grid. L16 comum em configurações de 6V.'],
        ['Caminhão Comercial', '4D ou 8D', '150–255 Ah', 'Partida pesada e cargas de hotelaria. Grupo 8D para carretas grandes.'],
        ['Telecom (Rack 48V)', 'Rack personalizado', '100–200 Ah', 'Módulos LFP 48V para rack. Não é grupo BCI.'],
      ]}
      caption="Meça sempre o compartimento da bateria antes de comprar. Os tamanhos de grupo são padronizados, mas as dimensões podem variar ±0.5 inches entre fabricantes."
    />
  </div>

  <div class="bg-surface-card border border-hairline p-6 mb-12">
    <h3 class="text-title-lg text-primary uppercase tracking-wider mb-3">Aviso Legal</h3>
    <p class="text-body-sm text-muted font-light">
      Os tamanhos de grupo de bateria são padronizados pelo BCI, mas as dimensões reais podem variar até 0.5 inches entre fabricantes. Verifique sempre as dimensões físicas antes de comprar baterias de reposição. As classificações de capacidade são nominais e variam conforme temperatura, taxa de descarga e idade da bateria. Esta referência é apenas para fins informativos.
    </p>
  </div>
</ArticleLayout>
