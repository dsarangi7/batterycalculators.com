      ]}
      source="Tabela NEC 310.15(B)(16) e folhas de dados de fabricantes"
    />
  </div>

  <div id="fusing-current">
    <ReferenceTable
    lang="pt"
      title="Corrente de Fusão (Fio de Cobre)"
      description="Corrente aproximada para fundir um fio de cobre em 10 segundos (com base na equação de Onderdonk). Use apenas para dimensionamento de proteção contra curto-circuito."
      headers={['AWG', 'Corrente de Fusão (10s)', 'Corrente de Fusão (1s)', 'Fusível Máx. NEC (típico)']}
      rows={[
        ['4/0', '5,900A', '13,600A', '400A'],
        ['2/0', '4,170A', '9,610A', '300A'],
        ['1/0', '3,310A', '7,640A', '250A'],
        ['2', '2,070A', '4,780A', '175A'],
        ['4', '1,310A', '3,020A', '100A'],
        ['6', '820A', '1,900A', '60A'],
        ['8', '520A', '1,200A', '40A'],
        ['10', '320A', '740A', '30A'],
        ['12', '200A', '460A', '20A'],
        ['14', '125A', '290A', '15A'],
        ['16', '80A', '180A', '10A'],
        ['18', '49A', '110A', '7A'],
