        ['1/0', '8.252', '53.49', '105,600'],
        ['1', '7.348', '42.41', '83,690'],
        ['2', '6.544', '33.63', '66,360'],
        ['4', '5.189', '21.15', '41,740'],
        ['6', '4.115', '13.30', '26,240'],
        ['8', '3.264', '8.366', '16,510'],
        ['10', '2.588', '5.261', '10,380'],
        ['12', '2.053', '3.309', '6,530'],
        ['14', '1.628', '2.081', '4,109'],
        ['16', '1.291', '1.309', '2,583'],
        ['18', '1.024', '0.8234', '1,624'],
        ['20', '0.8118', '0.5189', '1,022'],
        ['22', '0.6438', '0.3262', '642.4'],
        ['24', '0.5106', '0.2047', '404.0'],
        ['26', '0.4049', '0.1288', '253.9'],
        ['28', '0.3211', '0.08098', '159.8'],
        ['30', '0.2546', '0.05093', '100.5'],
      ]}
      source="Tabelas padrão de bitolas de fio do NIST e da International Electrotechnical Commission"
    />
  </div>

  <div id="resistance-ampacity">
    <ReferenceTable
    lang="pt"
      title="Resistência e Ampacidade (Cobre a 20°C)"
      description="Resistência CC por 1000 pés e ampacidade para tipos comuns de isolação ao ar livre."
      headers={['AWG', 'Resistência (Ω/1000ft)', 'Resistência (Ω/km)', 'Ampacidade (THHN 90°C)', 'Ampacidade (THWN 75°C)']}
      rows={[
        ['4/0', '0.0490', '0.161', '230A', '195A'],
        ['3/0', '0.0618', '0.203', '200A', '170A'],
        ['2/0', '0.0780', '0.256', '175A', '150A'],
        ['1/0', '0.0983', '0.322', '150A', '130A'],
        ['1', '0.1240', '0.407', '130A', '110A'],
