  <div id="application-wiring">
    <ComparisonTable
      title="Seleção de Fio por Aplicação"
      headers={['Aplicação', 'Bitola Mín. do Fio', 'Observações']}
      rows={[
        ['Bateria Residencial Marítima (50A)', '6 AWG', 'Use cobre estanhado, conforme ABYC. Dimensione para 50A contínuos + queda de tensão.'],
        ['Som Automotivo (1000W)', '4 AWG', 'Trechos curtos da bateria ao amplificador. Use cobre OFC.'],
        ['Arranjo de Painéis Solares (30A)', '10 AWG', 'Use fio USE-2 ou fotovoltaico para trechos externos. Verifique a queda de tensão na tensão do sistema.'],
        ['Telecom 48V CC (100A)', '2/0 AWG', 'Circuitos NEC Classe 2. Use cobre encordoado em eletrocalha.'],
        ['Serviço 30A para RV (50ft)', '10 AWG', 'Cabo NM-B (Romex) ou SOOW. Queda máxima de 3% a 120V.'],
        ['Carregamento de VE (40A)', '8 AWG', 'Use THHN/THWN-2 em eletroduto. Circuito com proteção GFCI obrigatório.'],
        ['Bateria ao Inversor (200A)', '2/0 AWG', 'Trechos curtos (<5ft). Use cabo de solda pela flexibilidade. Fusível conforme espec. do inversor.'],
