---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryToolGrid from '../../components/CategoryToolGrid.astro';
import FAQSection from '../../components/FAQSection.astro';

const tools = [
  {
    name: "Calculadora de ROI BESS",
    href: "/pt/tools/bess-roi-calculator/",
    description: "Avalie Valor Presente Líquido (VPL) e período de payback de Sistemas de Armazenamento de Energia de Bateria Comerciais.",
    available: true,
  },
  {
    name: "Calculadora de Corte de Pico",
    href: "/pt/tools/bess-roi-calculator/",
    description: "Calcule economias de demanda de pico com armazenamento de energia de bateria. Usa o mesmo motor da nossa Calculadora de ROI BESS.",
    available: true,
  },
  {
    name: "Calculadora de Economia de Demanda",
    href: "/pt/tools/bess-roi-calculator/",
    description: "Estime a redução mensal de demanda de pico com gerenciamento de carga baseado em bateria.",
    available: true,
  },
];

const learnArticles = [
  { title: "ROI BESS Explicado", href: "/pt/learn/bess-roi-explained/" },
  { title: "Como Dimensionar um Banco de Baterias", href: "/pt/learn/how-to-size-a-battery-bank/" },
  { title: "Degradação de Bateria Explicada", href: "/pt/learn/battery-degradation-explained/" },
  { title: "Como Calcular a Autonomia da Bateria", href: "/pt/learn/how-to-calculate-battery-runtime/" },
];

const faqItems = [
  {
    question: "O que é BESS e como economiza dinheiro?",
    answer: "BESS (Sistema de Armazenamento de Energia de Bateria) armazena eletricidade durante períodos de baixa demanda e descarrega durante pico de demanda, reduzindo cobranças de demanda. Também pode realizar arbitragem de energia, armazenando energia barata fora do pico para uso durante períodos de pico caros. O benefício financeiro depende da estrutura tarifária da concessionária, taxas de eletricidade e padrões de uso.",
  },
  {
    question: "O que é corte de pico?",
    answer: "Corte de pico é a prática de reduzir sua demanda máxima durante períodos de faturamento de pico. Contas de eletricidade comercial frequentemente incluem uma cobrança de demanda baseada na maior média de potência em 15 minutos em cada período de faturamento. Um BESS pode descarregar durante esses picos, reduzindo a cobrança de demanda sem alterar seu consumo real de energia.",
  },
  {
    question: "Como calculo o ROI de um sistema de bateria comercial?",
    answer: "O cálculo de ROI requer comparar o custo total do sistema de bateria (custo de capital + instalação + manutenção) contra as economias totais ao longo da vida útil do sistema (redução de demanda + arbitragem de energia + receita potencial de serviços de rede). Nossa Calculadora de ROI BESS realiza essa análise usando métricas de Valor Presente Líquido (VPL) e período de payback.",
  },
  {
    question: "Qual o período de payback típico para um BESS?",
    answer: "Os períodos de payback variam significativamente com base nas taxas de eletricidade locais, níveis de cobrança de demanda e tamanho do sistema. Em regiões com cobranças de demanda altas ($15–25/kW), períodos de payback de 5–8 anos são comuns. Em áreas com cobranças de demanda menores ou tarifas favoráveis por período de uso, o payback pode se estender para 10–15 anos. Incentivos federais e estaduais podem reduzir períodos de payback em 30–50%.",
  },
  {
    question: "BESS pode participar de serviços de rede?",
    answer: "Sim. Instalações grandes de BESS podem participar de programas de resposta à demanda, regulação de frequência e mercados de capacidade. Esses serviços de rede fornecem fluxos de receita adicionais além da redução de demanda e arbitragem de energia. Os requisitos de participação variam por concessionária e região, e tipicamente exigem tamanhos mínimos de sistema de 100 kW ou maiores.",
  },
];

const relatedCategories = [
  { href: "/pt/engineering/", title: "Engenharia", description: "Ferramentas de C-rate, SOC, queda de tensão e perda em cabos" },
  { href: "/pt/solar/", title: "Solar", description: "Dimensionamento de bateria solar e planejamento off-grid" },
  { href: "/pt/home-backup/", title: "Residencial", description: "Backup de bateria para apagões e cargas essenciais" },
];

const breadcrumbItems = [
  { label: "BESS e Comercial" },
];
---

<Layout
  title="Calculadoras de BESS e Comercial | Calculadoras de Bateria"
  description="Calculadoras gratuitas de ROI BESS para armazenamento de energia comercial, análise de corte de pico e estimativa de economia de demanda."
  schema="website"
  schemaName="Calculadoras de BESS e Comercial"
  schemaDescription="Calculadoras de bateria de nível de engenharia para BESS comercial, corte de pico e gerenciamento de demanda."
  breadcrumbs={[{ label: 'BESS e Comercial' }]}
  lang="pt"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mb-12 md:mb-16 border-b border-hairline pb-12">
    <div class="max-w-4xl">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">BESS E COMERCIAL</span>
      <h1 class="text-display-md text-primary mb-6">Calculadoras de BESS e Comercial</h1>
      <p class="text-body-md text-body max-w-2xl font-light">
        Avalie investimentos em armazenamento de energia de bateria comercial com ferramentas de nível de engenharia. Calcule ROI, analise economias de corte de pico e estime reduções de demanda.
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="max-w-4xl text-body-md text-body font-light flex flex-col gap-6">
      <p>
        Sistemas de Armazenamento de Energia de Bateria (BESS) representam um segmento em rápido crescimento do mercado de energia comercial e industrial. Diferente de sistemas residenciais dimensionados para backup, instalações comerciais de BESS são projetadas para otimizar custos de energia através de redução de demanda, arbitragem de energia por período de uso e participação em mercados de serviços de rede.
      </p>
      <p>
        O principal motor financeiro para BESS comercial é a redução de demanda. A maioria das contas de eletricidade comercial inclui dois componentes: cobranças de energia (baseadas no kWh total consumido) e cobranças de demanda (baseadas na maior potência instantânea durante cada período de faturamento, tipicamente medida em intervalos de 15 minutos). Em muitas regiões, cobranças de demanda representam 30–70% da conta total de eletricidade.
      </p>
      <p>
        A arbitragem de energia é o segundo maior fluxo de receita. BESS pode carregar durante horas fora do pico quando as tarifas de eletricidade são baixas e descarregar durante horas de pico quando as tarifas são altas. A diferença entre o preço de compra e o valor de descarga representa o lucro da arbitragem. A rentabilidade depende da diferença entre tarifas fora e dentro do pico, da eficiência round-trip da bateria e custos de degradação.
      </p>
      <p>
        O dimensionamento de BESS para aplicações comerciais requer equilibrar vários fatores: perfil de demanda de pico da instalação, programas de incentivos disponíveis, taxas de degradação da bateria e estrutura tarifária da concessionária. Sobredimensionar desperdiça capital em capacidade não utilizada. Subdimensionar falha em capturar todo o potencial de redução de demanda.
      </p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary mb-6">Calculadoras Disponíveis</h2>
    <CategoryToolGrid tools={tools} />
  </section>

  {learnArticles.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">Guias BESS e Comercial</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learnArticles.map((article) => (
          <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
            <span class="text-label-uppercase text-muted text-[10px] block mb-2">CENTRO DE APRENDIZAGEM</span>
            <h3 class="text-title-sm text-primary">{article.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <FAQSection items={faqItems} />

  {relatedCategories.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">Categorias Relacionadas</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {relatedCategories.map((cat) => (
          <a href={cat.href} class="bg-surface-card border border-hairline p-6 hover:border-primary transition-colors block">
            <h3 class="text-title-md text-primary mb-2">{cat.title}</h3>
            <p class="text-body-sm text-muted">{cat.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-surface-soft border border-hairline p-6 text-caption text-muted mb-8">
    <span class="text-primary font-bold text-[10px] tracking-wider uppercase border border-hairline px-1.5 py-0.5 mr-2 inline-block mb-3">
      Aviso de Engenharia
    </span>
    Todas as calculadoras fornecem apenas estimativas financeiras. O ROI real depende de estruturas tarifárias, taxas de degradação e condições de mercado. Consulte conselheiros financeiros para decisões de investimento.
  </section>
</Layout>
