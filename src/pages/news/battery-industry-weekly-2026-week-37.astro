---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Battery Industry Weekly — Week 37, 2026 | Battery Calculators";
const description = "This week in batteries: ready-to-build projects become ‘laughing stock’ as venture-capital-style returns disappear in australia, octopus australia refers 2gwh blackstone bess for epbc act assessment in queensland, the eu battery passport from february 2027: what european buyers will ask indian exporters for - t&d india.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-37";
const publishDate = "2026-09-16";
const lastUpdated = "2026-09-16";
const readingTime = 24;

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 37, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 37, 2026"
  schemaDescription={description}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 37</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Sep 7 – Sep 13, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: ready-to-build projects become ‘laughing stock’ as venture-capital-style returns disappear in australia, octopus australia refers 2gwh blackstone bess for epbc act assessment in queensland, the eu battery passport from february 2027: what european buyers will ask indian exporters for - t&d india.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Ready-to-build projects become ‘laughing stock’ as venture-capital-style returns disappear in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">The venture-capital-style returns once available in Australia have disappeared, according to panellists at the Battery Asset Management Summit Australia 2026.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Octopus Australia refers 2GWh Blackstone BESS for EPBC Act assessment in Queensland</h2>
      <p class="text-body-md text-body font-light mb-4">Octopus Australia has referred the Blackstone battery energy storage system (BESS), a 500MW/2,000MWh standalone facility, to Australia\'s federal government for assessment under the Environment Protect</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">REGULATION</span>
      <h2 class="text-title-xl text-primary mb-4">The EU battery passport from February 2027: what European buyers will ask Indian exporters for - T&D India</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMiuwFBVV95cUxObHBIODU4LWpjd0ZnSGY5UFBJbHotQ1VqYnJxTWc4OFhyRkUtd2ExSGstSnAxUy1wbG1XVk0xNzJkOUN3Mk0zYTJ0ZzVsekRMMHBVbE04RFRrd2p6VUJKcXRrcXFLQmZfc2tNcXRhej</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Solid-State Battery Weekly | Steady Progress — Cooling Hype, Stronger Efforts - SMM Metal</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMivgFBVV95cUxQczRWXzZOXzJfLWFWWjlHMV9xN2gtRnNydDZ1ZFJvNWxSNGJFMkptMHRlUHhlMEFlSjAxWjBQWENfSmsyeEtOdmduU1VBSUs2Tkk4X3RseEZfVzFXYlMyeWdBUFhLUk9USUgzczB1RE</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Sodium batteries are coming to Europe - dialogue.earth</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMie0FVX3lxTE1DN3VKSmMtZDIybDFnc1FFalI0NUpqUkF5X2RfbkltcnpuZUdnTkhqM3V2N21VYnhwcm5veENKd3ExNTlWcXJRMnV2bFNWcGJ4bFpiVzJsdnhIUjFHRUs0a0EyWTk0cVJEcEYzanFNSE</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Vattenfall goes ahead with 1GWh battery storage project at former nuclear site in Germany</h2>
      <p class="text-body-md text-body font-light mb-4">Update 14 September 2026: Vattenfall representatives offered more details and responded to Energy-Storage.news enquiries.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Ore Energy’s iron-air technology: LDES applications, trade-offs, deployments and next-gen cells</h2>
      <p class="text-body-md text-body font-light mb-4">We look at the iron-air battery technology of startup Ore Energy, including how it works and technology developments it is pursuing after a recent US$43 million fundraise.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">CATL upgraded to AAA, Wärtsilä downgraded to BB in Bankability Report Q2 update</h2>
      <p class="text-body-md text-body font-light mb-4">The global battery energy storage market is entering a new phase, with shifting cell prices, intensifying competition and rapid international expansion reshaping the supplier landscape.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">CATL, EVE Energy lead Chinese manufacturers’ battery storage cell price hikes</h2>
      <p class="text-body-md text-body font-light mb-4">A new wave of cell price hikes is sweeping the battery energy storage industry.</p>
      <p class="text-body-md text-body font-light">Major manufacturers have initiated price increases, with smaller producers quickly following suit.</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Energy Fiji partners with EPC Renewables on 240MWh solar-plus-storage site</h2>
      <p class="text-body-md text-body font-light mb-4">EPC Renewables has signed an MoU with state-linked utility Energy Fiji Limited for the development of the Yaqara Solar & Battery Project.</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">The Week in Context</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          Three themes worth tracking from this week's news:
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">Scale is the new normal.</strong> Battery deployment continues to grow across every segment — EVs, grid storage, and marine — making batteries a core infrastructure technology rather than a niche market.
          </li>
          <li>
            <strong class="text-primary">Chemistry diversity is accelerating.</strong> LFP, solid-state, sodium-ion, and silicon-anode chemistries are all progressing simultaneously, each targeting different cost and performance tradeoffs.
          </li>
          <li>
            <strong class="text-primary">Regulation is reshaping supply chains.</strong> EU battery passport requirements and domestic manufacturing incentives are forcing companies to rethink sourcing, documentation, and compliance timelines.
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">What to Watch Next Week</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>Continued updates on solid-state battery commercialization timelines</li>
          <li>EU Battery Regulation implementation guidance from the European Commission</li>
          <li>New grid-scale BESS project commissioning and capacity milestone reports</li>
          <li>Lithium and critical mineral pricing trends affecting battery economics</li>
          <li>Sodium-ion and next-generation chemistry production scaling announcements</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/ready-to-build-projects-become-laughing-stock-as-venture-capital-style-returns-disappear-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Ready-to-build projects become ‘laughing stock’ as venture-capital-style returns disappear in Australia — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/octopus-australia-refers-2gwh-blackstone-bess-for-epbc-act-assessment-in-queensland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Octopus Australia refers 2GWh Blackstone BESS for EPBC Act assessment in Queensland — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">The EU battery passport from February 2027: what European buyers will ask Indian exporters for - T&D India — Google News - Battery Passport</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMivgFBVV95cUxQczRWXzZOXzJfLWFWWjlHMV9xN2gtRnNydDZ1ZFJvNWxSNGJFMkptMHRlUHhlMEFlSjAxWjBQWENfSmsyeEtOdmduU1VBSUs2Tkk4X3RseEZfVzFXYlMyeWdBUFhLUk9USUgzczB1RE1Kb1RBVUJpV21EejJkN0xqa0JoejN2c0hZOVBoUXhtMlpIRGE0Rm5iSGo2V1BocnZkVm5CWVR4bF9YSWhHb081UlNHVEZIc2I4VDFyak93?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Solid-State Battery Weekly | Steady Progress — Cooling Hype, Stronger Efforts - SMM Metal — Google News - Solid State Battery</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMie0FVX3lxTE1DN3VKSmMtZDIybDFnc1FFalI0NUpqUkF5X2RfbkltcnpuZUdnTkhqM3V2N21VYnhwcm5veENKd3ExNTlWcXJRMnV2bFNWcGJ4bFpiVzJsdnhIUjFHRUs0a0EyWTk0cVJEcEYzanFNSEs2ZWFPaGxfQldoMA?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Sodium batteries are coming to Europe - dialogue.earth — Google News - Sodium Ion Battery</a></li>
