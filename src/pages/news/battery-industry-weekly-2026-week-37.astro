const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-37";
const publishDate = "2026-09-11";
const lastUpdated = "2026-09-11";
const readingTime = 24;

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 37, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
