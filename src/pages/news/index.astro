---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
const newsFiles = import.meta.glob('./*.astro', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

function extractMeta(raw: string) {
  const fm = raw.match(/^---\n([\s\S]*?)\n---/)?.[1] || '';
  const get = (k: string) =>
    fm.match(new RegExp(`const\\s+${k}\\s*=\\s*["'](.+?)["']`))?.[1] || '';
  return {
    title: get('title'),
    description: get('description'),
    publishDate: get('publishDate'),
    lastUpdated: get('lastUpdated'),
    readingTime: Number(get('readingTime')) || 0,
  };
}

const weeklyEditions = Object.entries(newsFiles)
  .filter(([path]) => !path.endsWith('/index.astro'))
  .map(([path, raw]) => {
    const slug = path.replace('./', '').replace('.astro', '');
    const meta = extractMeta(raw as string);
    const weekMatch = slug.match(/week-(\d+)/);
    const yearMatch = slug.match(/(\d{4})/);
    const week = weekMatch?.[1] || '';
    const year = yearMatch?.[1] || '';
    const cleanTitle = meta.title.replace(/\s*\|\s*Battery Calculators\s*$/, '');
    const dateDisplay = week ? `Week ${week}, ${year}` : meta.publishDate || '';
    return {
      title: cleanTitle,
      slug,
      date: dateDisplay,
      description: meta.description,
      publishDate: meta.publishDate,
      readingTime: meta.readingTime,
    };
  })
  .sort((a, b) => (b.publishDate || '').localeCompare(a.publishDate || ''));
---

<Layout
  title="Battery Industry News | Battery Calculators"
  description="Weekly battery industry news and engineering insights covering EV batteries, grid-scale energy storage, battery regulation, and technology breakthroughs."
  breadcrumbs={[{ label: 'News' }]}
>
  <div class="max-w-4xl mx-auto">

    <!-- Hero -->
    <div class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">NEWS &amp; INSIGHTS</span>
      <h1 class="text-display-lg text-primary mb-4">Battery Industry News</h1>
      <p class="text-body-md text-body font-light max-w-2xl">
        Weekly coverage of the battery industry — EV batteries, grid-scale storage, marine electrification, regulation, and manufacturing. Written for engineers and system designers.
      </p>
    </div>

    <!-- Weekly Editions -->
    <section class="mb-16">
      {weeklyEditions.length > 0 ? (
        <div class="flex flex-col gap-6">
          {weeklyEditions.map((edition) => (
            <a href={`/news/${edition.slug}`} class="block group">
              <CalculatorCard class="h-full">
                <div>
                  <div class="flex flex-wrap items-center gap-3 mb-3">
                    <span class="text-label-uppercase text-m-blue-light text-[10px]">WEEKLY EDITION</span>
                    <span class="text-caption text-muted">{edition.date}</span>
                    {edition.readingTime > 0 && (
                      <span class="text-caption text-muted">{edition.readingTime} min read</span>
                    )}
                  </div>
                  <h2 class="text-title-lg text-primary mb-3 group-hover:text-m-blue-light transition-colors">{edition.title}</h2>
                  <p class="text-body-sm text-muted">{edition.description}</p>
                </div>
              </CalculatorCard>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-surface-card border border-hairline p-8 text-center">
          <p class="text-body-md text-muted">No editions published yet. Check back soon.</p>
        </div>
      )}
    </section>

  </div>
</Layout>
