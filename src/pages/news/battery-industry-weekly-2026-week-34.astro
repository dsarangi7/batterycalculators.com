---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 34, 2026 | Battery Calculators";
const description = "This week in batteries: India’s BESS supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away, Australia’s Cheaper Home Batteries Program officially passes 500,000 installations, and Hithium to supply 421MWh BESS for GPG’s Fraser Coast project in Australia.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-34";
const publishDate = "2026-08-21";
const lastUpdated = "2026-08-21";
const readingTime = 14;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news/' },
  { label: 'Week 34, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 34, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 34</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Aug 17 – Aug 23, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: India’s BESS supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away, Australia’s Cheaper Home Batteries Program officially passes 500,000 installations, and Hithium to supply 421MWh BESS for GPG’s Fraser Coast project in Australia.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">India’s BESS supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away</h2>
      <p class="text-body-md text-body font-light mb-4">India’s battery storage sector will remain far from self-sufficient in cell supply for at least a decade, Wood Mackenzie says.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESIDENTIAL</span>
      <h2 class="text-title-xl text-primary mb-4">Australia’s Cheaper Home Batteries Program officially passes 500,000 installations</h2>
      <p class="text-body-md text-body font-light mb-4">More than 507,000 households, small businesses and community organisations have installed a home battery storage system under Australia\'s Cheaper Home Batteries Program, according to figures announced</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hithium to supply 421MWh BESS for GPG’s Fraser Coast project in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">Hithium has signed a supply agreement with GPG to deliver a 421MWh battery energy storage system for the Fraser Coast project.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">BW ESS acquires 1,000MWh Yanco BESS from ACEnergy in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">BW ESS has acquired a 1,000MWh battery storage system in Riverina, New South Wales, from Australian developer ACEnergy.</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">Kostal launches 25 kW battery inverter</h2>
      <p class="text-body-md text-body font-light mb-4">Kostal’s Plenticore BI 25 is a 25 kW AC-coupled battery inverter for commercial and high-end residential systems, with three-phase backup power up to 25 kVA and peak efficiency of 98.3%.</p>
      <p class="text-body-md text-body font-light">It supports t</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">China TOPCon cell prices jump on firmer upstream sentiment and rising export demand</h2>
      <p class="text-body-md text-body font-light mb-4">In a new weekly update for pv magazine, OPIS, a Dow Jones company, provides a quick look at the main price trends in the global PV industry.</p>
      <p class="text-body-md text-body font-light">The post China TOPCon cell prices jump on firmer upstream s</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Bangladesh mandates solar charging for millions of electric rickshaws</h2>
      <p class="text-body-md text-body font-light mb-4">Bangladesh plans to require millions of battery-powered auto-rickshaws to use solar-powered charging stations as a condition of registration, aiming to reduce pressure on the electricity grid.</p>
      <p class="text-body-md text-body font-light">Industr</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/indias-bess-supply-chain-suffers-a-policy-intent-and-operational-capacity-gap-with-battery-cell-self-sufficiency-a-decade-or-more-away/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">India’s BESS supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/australias-cheaper-home-batteries-program-officially-passes-500000-installations/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Australia’s Cheaper Home Batteries Program officially passes 500,000 installations — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/hithium-to-supply-421mwh-bess-for-gpgs-fraser-coast-project-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hithium to supply 421MWh BESS for GPG’s Fraser Coast project in Australia — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/bw-ess-acquires-1000mwh-yanco-bess-from-acenergy-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">BW ESS acquires 1,000MWh Yanco BESS from ACEnergy in Australia — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/kostal-launches-25-kw-battery-inverter/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Kostal launches 25 kW battery inverter — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/china-topcon-cell-prices-jump-on-firmer-upstream-sentiment-and-rising-export-demand/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">China TOPCon cell prices jump on firmer upstream sentiment and rising export demand — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/bangladesh-mandates-solar-charging-for-millions-of-electric-rickshaws/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Bangladesh mandates solar charging for millions of electric rickshaws — PV Magazine</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
