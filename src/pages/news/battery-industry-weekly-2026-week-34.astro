---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 34, 2026 | Battery Calculators";
const description = "This week in batteries: india’s bess supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away, australia’s cheaper home batteries program officially passes 500,000 installations, nextenergy uk acquires 107mw/151mwh standalone bess portfolio in the uk.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-34";
const publishDate = "2026-08-21";
const lastUpdated = "2026-08-21";
const readingTime = 24;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 34, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 34, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 34</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Aug 17 – Aug 23, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: india’s bess supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away, australia’s cheaper home batteries program officially passes 500,000 installations, nextenergy uk acquires 107mw/151mwh standalone bess portfolio in the uk.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">India’s BESS supply chain suffers a ‘policy intent and operational capacity’ gap, with battery cell self-sufficiency a decade or more away</h2>
      <p class="text-body-md text-body font-light mb-4">India’s battery storage sector will remain far from self-sufficient in cell supply for at least a decade, Wood Mackenzie says.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESIDENTIAL</span>
      <h2 class="text-title-xl text-primary mb-4">Australia’s Cheaper Home Batteries Program officially passes 500,000 installations</h2>
      <p class="text-body-md text-body font-light mb-4">More than 507,000 households, small businesses and community organisations have installed a home battery storage system under Australia\'s Cheaper Home Batteries Program, according to figures announced</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK</h2>
      <p class="text-body-md text-body font-light mb-4">NextEnergy UK has acquired a 107MW/151MWh portfolio of standalone battery energy storage system (BESS) projects in the UK.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hithium to supply 421MWh BESS for GPG’s Fraser Coast project in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">Hithium has signed a supply agreement with GPG to deliver a 421MWh battery energy storage system for the Fraser Coast project.</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">BW ESS acquires 1,000MWh Yanco BESS from ACEnergy in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">BW ESS has acquired a 1,000MWh battery storage system in Riverina, New South Wales, from Australian developer ACEnergy.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">A new all-electric cargo ship with a massive 2.4 MWh battery pack launches in China - Electrek</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMieEFVX3lxTE1XYkk1SjFaV2oxUW4zZ1QzWVRBcHNHZUx6Wmp5bjA4bnlFY2tfdmsyMWwzSnpxOXZPenppVk5OZk5lTFV3QnlJT3FiMHo1U1N2N0FKYzc1OWNScGVnVjBSb2MwT2RyNUJLb0tmRzR3MT</p>
