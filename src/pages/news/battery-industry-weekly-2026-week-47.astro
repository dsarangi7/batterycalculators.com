---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Battery Industry Weekly — Week 47, 2026 | Battery Calculators";
const description = "16–20 Nov 2026: Samsung SDI’s 16 GWh Jupiter Power LFP deal, EQT’s Flatiron Energy agreement, Canadian Solar’s 1.43 GWh X-ELIO order, Ford’s Marshall LFP shipments, and China’s October battery figures.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-47";
const publishDate = "2026-11-20";
const lastUpdated = "2026-11-20";
const readingTime = 5;

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 47, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 47, 2026"
  schemaDescription={description}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 47</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Nov 16 – Nov 22, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This edition covers Monday 16 November through Sunday 22 November 2026. The stories below are sourced items from 16–20 November, so they sit after the catch-up that runs through 15 November.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Samsung SDI agrees to supply 16 GWh of LFP cells to Jupiter Power</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">16 November 2026.</strong> <a href="https://news.samsungsdi.com/global/articleView?seq=477" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Samsung SDI</a> said its U.S. subsidiary signed an agreement to supply Jupiter Power with 16 GWh of lithium iron phosphate batteries over three years starting in 2029, for large U.S. storage projects. Samsung SDI said the cells will be produced in Indiana, and that including an earlier deal its orders from Jupiter Power now total about 27 GWh.
      </p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">EQT agrees to acquire Flatiron Energy</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">17 November 2026.</strong> <a href="https://eqtgroup.com/news/eqt-to-acquire-flatiron-energy-a-leading-developer-and-operator-of-battery-energy-storage-in-the-eastern-us-2026-11-17" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EQT</a> said EQT Transition Infrastructure has agreed to acquire Flatiron Energy from Hull Street Energy. EQT describes a 24 GWh portfolio across New England, New York, and the Mid-Atlantic, with 6 GWh awarded under long-term contracts and 2 GWh in construction. The release does not disclose the price or other financial terms. Closing is expected in the fourth quarter of 2026, subject to customary conditions and approvals.
      </p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Canadian Solar’s e-STORAGE to supply 590 MW / 1.43 GWh for X-ELIO</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">18 November 2026.</strong> <a href="https://investors.canadiansolar.com/news-releases/news-release-details/x-elio-and-e-storage-partner-deploy-590-mw-143-gwh-battery" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Canadian Solar</a> said e-STORAGE has signed agreements with X-ELIO for five battery projects totaling 590 MW / 1.43 GWh DC: four in Texas and one in New South Wales. Each agreement includes a 22-year long-term service agreement. The company said shipments are underway, with commercial operation expected in 2027 and 2028.
      </p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MANUFACTURING</span>
      <h2 class="text-title-xl text-primary mb-4">Ford starts shipping U.S. LFP cells from Marshall for Fathom prototypes</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">18 November 2026.</strong> <a href="https://www.fromtheroad.ford.com/us/en/articles/2026/ford-fathom-lfp-prismatic-battery-cells-ship" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Ford</a> said the first lithium iron phosphate prismatic cells are coming off the line at BlueOval Battery Park Michigan in Marshall and are headed to Louisville Assembly Plant for Fathom pickup prototypes. Ford’s article says the plant uses technology from CATL and can deliver 40 cells a minute. It does not state an annual output in gigawatt-hours. <a href="https://www.cnbc.com/2026/11/18/ford-us-battery-cells-catl-tech.html" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">CNBC</a>, reporting the same start of U.S. production and shipments, says Ford is using technology licensed from CATL and that the Marshall plant equates to about 20 GWh a year.
      </p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MANUFACTURING</span>
      <h2 class="text-title-xl text-primary mb-4">POSCO signs a 2026–2028 lithium supply agreement with CATL</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">18 November 2026.</strong> <a href="https://newsroom.posco.com/en/posco-group-strengthens-lithium-supply-partnership-with-catl-the-worlds-largest-battery-company/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">POSCO</a> said it signed a lithium supply agreement with CATL covering 2026 through 2028, for lithium used in EV battery production, and that supply under the agreement is already underway. The announcement does not state a volume.
      </p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARKETS</span>
      <h2 class="text-title-xl text-primary mb-4">China’s October power-battery installations, as reported from CABIA</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">19 November 2026.</strong> <a href="https://cnevpost.com/2026/11/19/china-oct-2026-power-battery-installations/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">CnEVPost</a>, citing figures from the China Automotive Battery Innovation Alliance (CABIA), reports that China’s power-battery installations in October were 99.4 GWh, with lithium iron phosphate at 86.9% of that. The same report puts energy-storage battery sales at 71.1 GWh, up 70.5% year on year. No CABIA English primary is cited here. These are CABIA figures as reported by CnEVPost.
      </p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RECYCLING</span>
      <h2 class="text-title-xl text-primary mb-4">Moment Energy unveils Nova, a second-life EV-battery storage system</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">17 November 2026.</strong> <a href="https://www.momentenergy.com/news/nova" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Moment Energy</a> unveiled Nova, a storage system it says is built from repurposed EV batteries and certified to UL 1973 and UL 9540. In the release, Jeff Smidt, senior vice president of Testing, Inspection and Certification, Industrial, at UL Solutions, said: “UL Certification demonstrates that the evaluated battery and energy storage system met applicable safety requirements.” Moment Energy said first deliveries are planned for the first quarter of 2027.
      </p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">AGL’s Tomago battery: first units reported in place</h2>
      <p class="text-body-md text-body font-light mb-4">
        <strong class="text-primary">18–19 November 2026.</strong> <a href="https://www.energy-storage.news/agl-tomago-bess-first-100-units-installed-nsw/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Energy-Storage.News</a>, citing AGL, reports that the first 100 of more than 400 Fluence Gridstack Pro units are in place at the Tomago battery, which it describes as a 500 MW / 2,000 MWh grid-forming project still aimed at late 2027. <a href="https://www.agl.com.au/about-agl/operations/tomago-battery" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">AGL’s project page</a> confirms the 500 MW / 2,000 MWh size, an estimated construction cost of approximately A$800 million, Fluence as the EPC contractor, and a target to begin operations in the second half of 2027. That page does not state the 100-unit or 400-unit counts. Those installation figures are Energy-Storage.News citing AGL, not a count confirmed on AGL’s page.
      </p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://news.samsungsdi.com/global/articleView?seq=477" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Samsung SDI, “SAMSUNG SDI Secures 16 GWh LFP Battery Order from Jupiter Power in U.S.,” 16 November 2026</a></li>
        <li><a href="https://eqtgroup.com/news/eqt-to-acquire-flatiron-energy-a-leading-developer-and-operator-of-battery-energy-storage-in-the-eastern-us-2026-11-17" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EQT, “EQT to acquire Flatiron Energy, a leading developer and operator of battery energy storage in the Eastern U.S.,” 17 November 2026</a></li>
        <li><a href="https://investors.canadiansolar.com/news-releases/news-release-details/x-elio-and-e-storage-partner-deploy-590-mw-143-gwh-battery" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Canadian Solar, “X-ELIO and e-STORAGE Partner to Deploy 590 MW / 1.43 GWh of Battery Energy Storage Systems Across the U.S. and Australia,” 18 November 2026</a></li>
        <li><a href="https://www.cnbc.com/2026/11/18/ford-us-battery-cells-catl-tech.html" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Michael Wayland, “Ford starts U.S. battery cell production using Chinese tech amid geopolitical tensions,” CNBC, 18 November 2026</a></li>
        <li><a href="https://www.fromtheroad.ford.com/us/en/articles/2026/ford-fathom-lfp-prismatic-battery-cells-ship" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Charles Poon, “Ford Ships First Battery Cells from Michigan Plant for Fathom Electric Truck,” Ford, 18 November 2026</a></li>
        <li><a href="https://newsroom.posco.com/en/posco-group-strengthens-lithium-supply-partnership-with-catl-the-worlds-largest-battery-company/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">POSCO, “POSCO group Strengthens Lithium Supply Partnership with CATL, the World’s Largest Battery Company,” 18 November 2026</a></li>
        <li><a href="https://cnevpost.com/2026/11/19/china-oct-2026-power-battery-installations/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Phate Zhang, “China’s October power battery installations hit record 99.4 GWh as LFP share reaches 86.9%,” CnEVPost, 19 November 2026 (CABIA figures as reported by CnEVPost; no CABIA English primary cited)</a></li>
        <li><a href="https://www.momentenergy.com/news/nova" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Moment Energy, “Moment Energy Unveils Nova, the Next Generation Battery Energy Storage System Made from EV Batteries,” 17 November 2026</a></li>
        <li><a href="https://www.energy-storage.news/agl-tomago-bess-first-100-units-installed-nsw/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">George Heynes, “AGL installs first 100 units at 2,000MWh Tomago BESS in New South Wales, Australia,” Energy-Storage.News, 19 November 2026</a></li>
        <li><a href="https://www.agl.com.au/about-agl/operations/tomago-battery" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">AGL, Tomago Battery project page (size, cost, Fluence EPC, and second-half 2027 operations target; does not state the unit count)</a></li>
      </ul>
    </section>

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
