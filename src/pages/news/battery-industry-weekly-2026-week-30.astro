---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 30, 2026 | Battery Calculators";
const description = "This week in batteries: wärtsilä completes delivery of 1,038 quantum units to 1,400mwh wooreen bess in australia, german startup launches high-voltage sodium-ion battery for residential applications, idemitsu plans 864 mwh vanadium flow battery at australian coal mine site.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-30";
const publishDate = "2026-07-24";
const lastUpdated = "2026-07-24";
const readingTime = 24;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 30, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 30, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 30</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Jul 20 – Jul 26, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: wärtsilä completes delivery of 1,038 quantum units to 1,400mwh wooreen bess in australia, german startup launches high-voltage sodium-ion battery for residential applications, idemitsu plans 864 mwh vanadium flow battery at australian coal mine site.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Wärtsilä completes delivery of 1,038 Quantum units to 1,400MWh Wooreen BESS in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">All 1,038 Wärtsilä Quantum battery units have been delivered and installed at the 1.4GWh Wooreen BESS in Victoria, Australia.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESIDENTIAL</span>
      <h2 class="text-title-xl text-primary mb-4">German startup launches high-voltage sodium-ion battery for residential applications</h2>
      <p class="text-body-md text-body font-light mb-4">Revolta has introduced a high-voltage residential sodium-ion battery storage system with modular capacity from 2 kWh to 20 kWh.</p>
      <p class="text-body-md text-body font-light">The system features a 450 V DC nominal voltage, over 95% efficiency, 105</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Idemitsu plans 864 MWh vanadium flow battery at Australian coal mine site</h2>
      <p class="text-body-md text-body font-light mb-4">Idemitsu Australia is proposing a 108 MW vanadium flow battery with eight hours of storage at a former coal mine site in New South Wales.</p>
      <p class="text-body-md text-body font-light">The post Idemitsu plans 864 MWh vanadium flow battery at Austr</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Sodium-ion BESS: CATL in 2GWh Eastern Europe collaboration, ESS Inc signs LOI for 500MWh of US deployments</h2>
      <p class="text-body-md text-body font-light mb-4">ESS Tech Inc is deploying sodium-ion BESS in the US with Juniper Energy, while CATL deploys its sodium-ion technology in Eastern Europe with Solarpro.</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">South Australia’s Lunio Energy brings 20MWh grid-scale battery storage system online</h2>
      <p class="text-body-md text-body font-light mb-4">South Australia battery storage developer Lunio Energy has energised its first grid-scale BESS at Strathalbyn and started trading in the NEM.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">California batteries missing out on revenue due to suboptimal bidding strategies, Gridmatic analysis finds</h2>
      <p class="text-body-md text-body font-light mb-4">Battery energy storage systems (BESS) operating in California\'s grid left approximately US$98 million on the table due to suboptimal bidding strategies, according to a new analysis from Gridmatic.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Waaree, India’s biggest PV module supplier, opens 5.15GWh battery storage assembly plant</h2>
      <p class="text-body-md text-body font-light mb-4">A subsidiary of Indian renewable energy equipment and component manufacturer Waaree Energies has opened a battery energy storage system (BESS) enclosure factory.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">ib vogt wins approval for 480MWh battery storage site in Australia’s Wagga Wagga Special Activation Precinct</h2>
      <p class="text-body-md text-body font-light mb-4">German solar and storage developer ib vogt has received state planning approval for the 120MW/480MWh Wagga North battery energy storage system (BESS) in New South Wales, Australia.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alfen and CATL agree 5GWh sodium-ion BESS partnership in Europe</h2>
      <p class="text-body-md text-body font-light mb-4">System integrator Alfen and battery company CATL have struck a 5GWh partnership for sodium-ion BESS deployments in Europe.</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWW</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">The Week in Context</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          Three themes worth tracking from this week's news:
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">Scale is the new normal.</strong> Battery deployment continues to grow across every segment — EVs, grid storage, and marine — making batteries a core infrastructure technology rather than a niche market.
          </li>
          <li>
            <strong class="text-primary">Chemistry diversity is accelerating.</strong> LFP, solid-state, sodium-ion, and silicon-anode chemistries are all progressing simultaneously, each targeting different cost and performance tradeoffs.
          </li>
          <li>
            <strong class="text-primary">Regulation is reshaping supply chains.</strong> EU battery passport requirements and domestic manufacturing incentives are forcing companies to rethink sourcing, documentation, and compliance timelines.
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">What to Watch Next Week</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>Continued updates on solid-state battery commercialization timelines</li>
          <li>EU Battery Regulation implementation guidance from the European Commission</li>
          <li>New grid-scale BESS project commissioning and capacity milestone reports</li>
          <li>Lithium and critical mineral pricing trends affecting battery economics</li>
          <li>Sodium-ion and next-generation chemistry production scaling announcements</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/wartsila-completes-delivery-of-1038-quantum-units-to-1400mwh-wooreen-bess-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Wärtsilä completes delivery of 1,038 Quantum units to 1,400MWh Wooreen BESS in Australia — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/24/german-startup-launches-high-voltage-sodium-ion-battery-for-residential-applications/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">German startup launches high-voltage sodium-ion battery for residential applications — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/24/idemitsu-plans-864-mwh-vanadium-flow-battery-at-australian-coal-mine-site/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Idemitsu plans 864 MWh vanadium flow battery at Australian coal mine site — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/sodium-ion-bess-catl-in-2gwh-eastern-europe-collaboration-ess-inc-signs-loi-for-500mwh-of-us-deployments/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Sodium-ion BESS: CATL in 2GWh Eastern Europe collaboration, ESS Inc signs LOI for 500MWh of US deployments — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/south-australias-lunio-energy-brings-20mwh-grid-scale-battery-storage-system-online/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">South Australia’s Lunio Energy brings 20MWh grid-scale battery storage system online — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/california-batteries-missing-out-on-revenue-due-to-suboptimal-bidding-strategies-gridmatic-analysis-finds/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">California batteries missing out on revenue due to suboptimal bidding strategies, Gridmatic analysis finds — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/waaree-indias-biggest-pv-module-supplier-opens-5-15gwh-battery-storage-assembly-plant/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Waaree, India’s biggest PV module supplier, opens 5.15GWh battery storage assembly plant — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/ib-vogt-wins-approval-for-480mwh-battery-storage-site-in-australias-wagga-wagga-special-activation-precinct/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">ib vogt wins approval for 480MWh battery storage site in Australia’s Wagga Wagga Special Activation Precinct — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/alfen-and-catl-agree-5gwh-sodium-ion-bess-partnership-in-europe/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Alfen and CATL agree 5GWh sodium-ion BESS partnership in Europe — Energy Storage News</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWWwtUHZVaVdWOFVOZVAyd1Q1RTBfUmhPdmxBaFExSFRTRWpCdw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK — Google News - Battery Technology</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
