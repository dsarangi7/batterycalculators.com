---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 33, 2026 | Battery Calculators";
const description = "This week in batteries: ev manufacturer ola electric brings cell-to-pack vertical integration into india’s utility-scale bess market with 20gwh mou, hydrogen-iron flow batteries: how elestor’s tech works, nextenergy uk acquires 107mw/151mwh standalone bess portfolio in the uk.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-33";
const publishDate = "2026-08-14";
const lastUpdated = "2026-08-14";
const readingTime = 24;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 33, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 33, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 33</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Aug 10 – Aug 16, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: ev manufacturer ola electric brings cell-to-pack vertical integration into india’s utility-scale bess market with 20gwh mou, hydrogen-iron flow batteries: how elestor’s tech works, nextenergy uk acquires 107mw/151mwh standalone bess portfolio in the uk.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">EV manufacturer Ola Electric brings cell-to-pack vertical integration into India’s utility-scale BESS market with 20GWh MoU</h2>
      <p class="text-body-md text-body font-light mb-4">EV manufacturer Ola Electric has entered India’s utility-scale battery storage market with a vertically integrated business model.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Hydrogen-iron flow batteries: How Elestor’s tech works</h2>
      <p class="text-body-md text-body font-light mb-4">Elestor claims its hydrogen-iron flow battery delivers 75%+ round-trip efficiency, a 20-25 year lifespan, and 15€/kWh capex for long-duration storage.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK</h2>
      <p class="text-body-md text-body font-light mb-4">NextEnergy UK has acquired a 107MW/151MWh portfolio of standalone battery energy storage system (BESS) projects in the UK.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Acciona Energía to add 33MW/66MWh BESS in Spain</h2>
      <p class="text-body-md text-body font-light mb-4">Spanish renewables developer Acciona Energía has unveiled plans to install two battery energy storage systems (BESS).</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India</h2>
      <p class="text-body-md text-body font-light mb-4">Serentica Renewables has commissioned the first phase of a battery storage project that will help deliver round-the-clock (RTC) renewable energy in Rajasthan, India.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">ZEBRE submits 180MW BESS to Australia’s EPBC Act as ZEN Energy administration fails to slow pipeline</h2>
      <p class="text-body-md text-body font-light mb-4">ZEBRE has submitted the 180MW/360MWh Noblevale Battery in Queensland for federal environmental assessment under the EPBC Act.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Invinity sells 43MWh long-duration flow battery system to US Midwest rural electric cooperative</h2>
      <p class="text-body-md text-body font-light mb-4">Flow battery company Invinity Energy Systems has sold 43MWh of battery systems to utility Dairyland Power Cooperative for deployment across long duration energy storage (LDES) projects in the US Midwe</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">Corvus Energy Secures 40MWh Landmark Battery Contract for BC Ferries’ New Major Vessels Program - Fuel Cells Works</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMi1wFBVV95cUxQNUw1eFdfbk85VExpb0xZLXk0UTNLbVlsaFpLNFc5dHZORVM3OXpDNTRudlBsWlJaSk9wMF9Db2V0bGdkUGF6MjJKeENqbEtWanlnWl9GN3BkNXVCa3c2QlRQWm00ZEMwY0pjMHllcH</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">A new all-electric cargo ship with a massive 2.4 MWh battery pack launches in China - Electrek</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMieEFVX3lxTE1XYkk1SjFaV2oxUW4zZ1QzWVRBcHNHZUx6Wmp5bjA4bnlFY2tfdmsyMWwzSnpxOXZPenppVk5OZk5lTFV3QnlJT3FiMHo1U1N2N0FKYzc1OWNScGVnVjBSb2MwT2RyNUJLb0tmRzR3MT</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWW</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">The Week in Context</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          Three themes worth tracking from this week's news:
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">Scale is the new normal.</strong> Battery deployment continues to grow across every segment — EVs, grid storage, and marine — making batteries a core infrastructure technology rather than a niche market.
          </li>
          <li>
            <strong class="text-primary">Chemistry diversity is accelerating.</strong> LFP, solid-state, sodium-ion, and silicon-anode chemistries are all progressing simultaneously, each targeting different cost and performance tradeoffs.
          </li>
          <li>
            <strong class="text-primary">Regulation is reshaping supply chains.</strong> EU battery passport requirements and domestic manufacturing incentives are forcing companies to rethink sourcing, documentation, and compliance timelines.
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">What to Watch Next Week</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>Continued updates on solid-state battery commercialization timelines</li>
          <li>EU Battery Regulation implementation guidance from the European Commission</li>
          <li>New grid-scale BESS project commissioning and capacity milestone reports</li>
          <li>Lithium and critical mineral pricing trends affecting battery economics</li>
          <li>Sodium-ion and next-generation chemistry production scaling announcements</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/ev-manufacturer-ola-electric-brings-cell-to-pack-vertical-integration-into-indias-utility-scale-bess-market-with-20gwh-mou/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EV manufacturer Ola Electric brings cell-to-pack vertical integration into India’s utility-scale BESS market with 20GWh MoU — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/elestor-hydrogen-iron-flow-battery/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hydrogen-iron flow batteries: How Elestor’s tech works — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/nextenergy-uk-acquires-107mw-151mwh-standalone-bess-portfolio-uk/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/acciona-energia-to-add-33mw-66mwh-bess-in-spain/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Acciona Energía to add 33MW/66MWh BESS in Spain — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/serentica-renewables-commissions-first-phase-of-1gwh-bess-for-round-the-clock-renewable-energy-delivery-in-rajasthan-india/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/zebre-submits-180mw-bess-to-australias-epbc-act-as-zen-energy-administration-fails-to-slow-pipeline/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">ZEBRE submits 180MW BESS to Australia’s EPBC Act as ZEN Energy administration fails to slow pipeline — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/invinity-sells-43mwh-long-duration-flow-battery-system-to-us-midwest-rural-electric-cooperative/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Invinity sells 43MWh long-duration flow battery system to US Midwest rural electric cooperative — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Corvus Energy Secures 40MWh Landmark Battery Contract for BC Ferries’ New Major Vessels Program - Fuel Cells Works — Google News - Battery Technology</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMieEFVX3lxTE1XYkk1SjFaV2oxUW4zZ1QzWVRBcHNHZUx6Wmp5bjA4bnlFY2tfdmsyMWwzSnpxOXZPenppVk5OZk5lTFV3QnlJT3FiMHo1U1N2N0FKYzc1OWNScGVnVjBSb2MwT2RyNUJLb0tmRzR3MTZQd2hUaUhzUw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">A new all-electric cargo ship with a massive 2.4 MWh battery pack launches in China - Electrek — Google News - Marine Batteries</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWWwtUHZVaVdWOFVOZVAyd1Q1RTBfUmhPdmxBaFExSFRTRWpCdw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK — Google News - Sodium Ion Battery</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
