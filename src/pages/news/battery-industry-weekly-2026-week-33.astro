---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 33, 2026 | Battery Calculators";
const description = "This week in batteries: NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK, Acciona Energía to add 33MW/66MWh BESS in Spain, and Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-33";
const publishDate = "2026-08-14";
const lastUpdated = "2026-08-14";
const readingTime = 16;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news/' },
  { label: 'Week 33, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 33, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 33</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Aug 10 – Aug 16, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK, Acciona Energía to add 33MW/66MWh BESS in Spain, and Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK</h2>
      <p class="text-body-md text-body font-light mb-4">NextEnergy UK has acquired a 107MW/151MWh portfolio of standalone battery energy storage system (BESS) projects in the UK.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Acciona Energía to add 33MW/66MWh BESS in Spain</h2>
      <p class="text-body-md text-body font-light mb-4">Spanish renewables developer Acciona Energía has unveiled plans to install two battery energy storage systems (BESS).</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India</h2>
      <p class="text-body-md text-body font-light mb-4">Serentica Renewables has commissioned the first phase of a battery storage project that will help deliver round-the-clock (RTC) renewable energy in Rajasthan, India.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">Corvus Energy Secures 40MWh Landmark Battery Contract for BC Ferries’ New Major Vessels Program - Fuel Cells Works</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMi1wFBVV95cUxQNUw1eFdfbk85VExpb0xZLXk0UTNLbVlsaFpLNFc5dHZORVM3OXpDNTRudlBsWlJaSk9wMF9Db2V0bGdkUGF6MjJKeENqbEtWanlnWl9GN3BkNXVCa3c2QlRQWm00ZEMwY0pjMHllcH</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Avantus closes a US$1.05 billion facility for solar and storage</h2>
      <p class="text-body-md text-body font-light mb-4">Avantus has closed a US$1.05 billion corporate credit facility to fund its independent-power-producer strategy and speed development of its solar and storage portfolio, Energy-Storage.News reported on 10 August 2026.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">CIP reaches financial close on a 750MWh solar-plus-storage project in Mexico</h2>
      <p class="text-body-md text-body font-light mb-4">Copenhagen Infrastructure Partners has reached financial close on the La Esperanza solar-plus-storage project in Campeche, Mexico, which includes 750MWh of storage, Energy-Storage.News reported on 11 August 2026.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">EIA says the US is on track to add 54GW of batteries by 2028</h2>
      <p class="text-body-md text-body font-light mb-4">The US Energy Information Administration says operators expect to bring another 54GW of battery storage online over the next two and a half years, putting the country on track to double battery capacity by 2028, Energy-Storage.News reported on 12 August 2026.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Sungrow to supply the battery for Verano Energy’s 606MWh project in Chile</h2>
      <p class="text-body-md text-body font-light mb-4">Verano Energy has awarded Sungrow the battery supply for its 152MW/606MWh Observatorio hybrid project in Chile, Energy-Storage.News reported on 12 August 2026.</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/nextenergy-uk-acquires-107mw-151mwh-standalone-bess-portfolio-uk/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">NextEnergy UK acquires 107MW/151MWh standalone BESS portfolio in the UK — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/acciona-energia-to-add-33mw-66mwh-bess-in-spain/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Acciona Energía to add 33MW/66MWh BESS in Spain — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/serentica-renewables-commissions-first-phase-of-1gwh-bess-for-round-the-clock-renewable-energy-delivery-in-rajasthan-india/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Serentica Renewables commissions first phase of 1GWh BESS for round-the-clock renewable energy delivery in Rajasthan, India — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Corvus Energy Secures 40MWh Landmark Battery Contract for BC Ferries’ New Major Vessels Program - Fuel Cells Works — Google News - Battery Technology</a></li>
        <li><a href="https://www.energy-storage.news/us-ipp-avantus-closes-billion-dollar-financing-for-solar-pv-and-battery-storage-projects/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">US IPP Avantus closes billion-dollar financing for solar PV and battery storage projects — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/copenhagen-infrastructure-partners-closes-on-750mwh-solar-plus-storage-project-in-mexico/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Copenhagen Infrastructure Partners closes on 750MWh solar-plus-storage project in Mexico — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/us-double-bess-capacity-2028-eia-reports/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">US on track to double BESS capacity by 2028, EIA reports — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/sungrow-provides-bess-to-verano-energys-606mwh-chilean-hybrid-project/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Sungrow provides BESS to Verano Energy’s 606MWh Chilean hybrid project — Energy-Storage.News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
