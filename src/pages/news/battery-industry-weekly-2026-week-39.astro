---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Battery Industry Weekly — Week 39, 2026 | Battery Calculators";
const description = "This week in batteries: eu battery passport will be an evolving tool rather than a one-off, how transferability and us-china tensions are transforming us bess and renewables financing, india flow battery player delectrik talks 100mwh ntpc project award, targets gigawatt-hour order book.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-39";
const publishDate = "2026-09-25";
const lastUpdated = "2026-09-25";
const readingTime = 24;

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 39, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 39, 2026"
  schemaDescription={description}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 39</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Sep 21 – Sep 27, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: eu battery passport will be an evolving tool rather than a one-off, how transferability and us-china tensions are transforming us bess and renewables financing, india flow battery player delectrik talks 100mwh ntpc project award, targets gigawatt-hour order book.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">REGULATION</span>
      <h2 class="text-title-xl text-primary mb-4">EU Battery Passport will be an evolving tool rather than a one-off</h2>
      <p class="text-body-md text-body font-light mb-4">During the Battery & Energy Storage Tech Expo in Barcelona, Spain, Energy-storage.news spoke with Ken Davies, chief commercial officer at Digital Product Passport (DPP) provider DigiProd Pass and conf</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">How transferability and US-China tensions are transforming US BESS and renewables financing</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.news speaks with Nathan Picarsic, co-founder of Horizon Advisory, at the 2026 US Battery Asset Management and Solar and Storage Finance Summits in Garden Grove, California.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">India flow battery player Delectrik talks 100MWh NTPC project award, targets gigawatt-hour order book</h2>
      <p class="text-body-md text-body font-light mb-4">Vishal Mittal, founder and CEO of Delectrik makes the case for flow batteries to meet India’s long-duration needs in an exclusive ESN Premium interview.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">EV</span>
      <h2 class="text-title-xl text-primary mb-4">C&D Technologies to Showcase Next-Generation Telecom Battery Solutions at SCTE TechExpo26 - PR Newswire</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMi3AFBVV95cUxOeTFxR0tuVzg2VUZJVUpZQ3NsNWhEdVl0T1ZWZ29hYWJQM2lmVEVsYkktTC1ISlhTZUdGODlwNUlZQ20ySjdJdjNCZUd6UWZsRmdlSTA3cGJiUlZ2MnZpZEh2RkpFYXZxeFNneHJXdm</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Nova Scotia Power switches on Atlantic Canada’s biggest battery storage projects</h2>
      <p class="text-body-md text-body font-light mb-4">Nova Scotia Power has inaugurated three 50MW/200MWh battery energy storage systems (BESS) in Bridgewater, Waverley and White Rock, now Atlantic Canada\'s largest battery storage facilities.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Covenergo and Delta Capacity begin construction on 300MWh AKKU One BESS in Finland</h2>
      <p class="text-body-md text-body font-light mb-4">Covenergo and Delta Capacity have begun construction on AKKU One, a standalone 125MW/300MWh battery energy storage system (BESS) in Lapinlahti, Finland, with commissioning targeted for the fourth quar</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Google-backed pilot demonstrates hourly carbon accounting for US BESS using granular certificates</h2>
      <p class="text-body-md text-body font-light mb-4">A US battery storage pilot sponsored by tech giant Google has demonstrated how batteries can capture surplus renewable energy and deliver it during hours with greater fossil generation.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Fluence and Eve Energy agree 206GWh battery supply deal</h2>
      <p class="text-body-md text-body font-light mb-4">System integrator Fluence and lithium-ion battery OEM Eve Energy have struck a massive 206GWh battery supply framework agreement for 2027-31, one of the largest deals of its kind ever announced.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">Android flagships could soon pack massive 10,000mAh batteries, thanks to iPhone\'s battery tech - Android Authority</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMijwFBVV95cUxPTDNVY3BhMGZmalN4TG9Rd205eHNfX0JzWDdlXzVBTXVoVE5vNGNWYlRBVzQzZVMyb1R1OWtaem9qb29ZaV9TVDZwN2s0VWNCcUNIQUtxMFhGUExCUlRQRTg1SmhsT05jVW45UldGQ3</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">CBAK signs deal for 12 GWh sodium-ion battery project in Nanjing - TNGlobal</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMiiAFBVV95cUxNSmNGWFlpU1pFWVRIaUFRVF9sbTVqQVJHc245aWtpQVlHWEtabVJXUVhfZnRLUTNtQ1FON3pSd2xKMHlCb3Z6NmpVOEpJU3dmWjRTTWFqWFNoMWh2Y3hfbmxtQVhiOHdZaWJnMnZ0a2</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">The Week in Context</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          Three themes worth tracking from this week's news:
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">Scale is the new normal.</strong> Battery deployment continues to grow across every segment — EVs, grid storage, and marine — making batteries a core infrastructure technology rather than a niche market.
          </li>
          <li>
            <strong class="text-primary">Chemistry diversity is accelerating.</strong> LFP, solid-state, sodium-ion, and silicon-anode chemistries are all progressing simultaneously, each targeting different cost and performance tradeoffs.
          </li>
          <li>
            <strong class="text-primary">Regulation is reshaping supply chains.</strong> EU battery passport requirements and domestic manufacturing incentives are forcing companies to rethink sourcing, documentation, and compliance timelines.
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">What to Watch Next Week</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>Continued updates on solid-state battery commercialization timelines</li>
          <li>EU Battery Regulation implementation guidance from the European Commission</li>
          <li>New grid-scale BESS project commissioning and capacity milestone reports</li>
          <li>Lithium and critical mineral pricing trends affecting battery economics</li>
          <li>Sodium-ion and next-generation chemistry production scaling announcements</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/eu-battery-passport-will-be-an-evolving-tool-rather-than-a-one-off/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EU Battery Passport will be an evolving tool rather than a one-off — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/how-transferability-and-us-china-tensions-are-transforming-us-bess-and-renewables-financing/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">How transferability and US-China tensions are transforming US BESS and renewables financing — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/india-flow-battery-player-delectrik-talks-100mwh-ntpc-project-award-targets-gigawatt-hour-order-book/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">India flow battery player Delectrik talks 100MWh NTPC project award, targets gigawatt-hour order book — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">C&D Technologies to Showcase Next-Generation Telecom Battery Solutions at SCTE TechExpo26 - PR Newswire — Google News - Battery Technology</a></li>
        <li><a href="https://www.energy-storage.news/nova-scotia-power-switches-on-atlantic-canadas-biggest-battery-storage-projects/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Nova Scotia Power switches on Atlantic Canada’s biggest battery storage projects — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/covenergo-and-delta-capacity-begin-construction-on-300mwh-akku-one-bess-in-finland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Covenergo and Delta Capacity begin construction on 300MWh AKKU One BESS in Finland — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/google-backed-pilot-demonstrates-hourly-carbon-accounting-for-us-bess-using-granular-certificates/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Google-backed pilot demonstrates hourly carbon accounting for US BESS using granular certificates — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/fluence-and-eve-energy-agree-206gwh-battery-supply-deal/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Fluence and Eve Energy agree 206GWh battery supply deal — Energy Storage News</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMijwFBVV95cUxPTDNVY3BhMGZmalN4TG9Rd205eHNfX0JzWDdlXzVBTXVoVE5vNGNWYlRBVzQzZVMyb1R1OWtaem9qb29ZaV9TVDZwN2s0VWNCcUNIQUtxMFhGUExCUlRQRTg1SmhsT05jVW45UldGQ3RHclF1a3hfMkVMcDdvVUhvNUNKQnZyaTh4UGIyaUVKSQ?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Android flagships could soon pack massive 10,000mAh batteries, thanks to iPhone\'s battery tech - Android Authority — Google News - Battery Technology</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMiiAFBVV95cUxNSmNGWFlpU1pFWVRIaUFRVF9sbTVqQVJHc245aWtpQVlHWEtabVJXUVhfZnRLUTNtQ1FON3pSd2xKMHlCb3Z6NmpVOEpJU3dmWjRTTWFqWFNoMWh2Y3hfbmxtQVhiOHdZaWJnMnZ0a2JLWVZXOTBXQmlwWUZJbFlPUEF6LU9EQUxO?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">CBAK signs deal for 12 GWh sodium-ion battery project in Nanjing - TNGlobal — Google News - Sodium Ion Battery</a></li>
      </ul>
    </section>

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
