---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 28, 2026 | Battery Calculators";
const description = "This week in batteries: Amazon signs a PPA for a 220MWh solar-plus-storage project in Australia, Engie agrees an offtake for 625MWh of battery storage in Spain, and CleanPeak to install 30MW/120MWh of storage at Western Sydney International Airport.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-28";
const publishDate = "2026-08-08";
const lastUpdated = "2026-08-08";
const readingTime = 18;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news/' },
  { label: 'Week 28, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 28, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 28</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Jul 6 – Jul 12, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: Amazon signs a PPA for a 220MWh solar-plus-storage project in Australia, Engie agrees an offtake for 625MWh of battery storage in Spain, and CleanPeak to install 30MW/120MWh of storage at Western Sydney International Airport.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Amazon signs a PPA for a 220MWh solar-plus-storage project in Australia</h2>
      <p class="text-body-md text-body font-light mb-4">Amazon has signed a power purchase agreement for energy from European Energy’s 220MWh Winton North solar-plus-storage project in northeast Victoria, Energy-Storage.News reported on 6 July 2026.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Engie agrees an offtake for 625MWh of battery storage in Spain</h2>
      <p class="text-body-md text-body font-light mb-4">Engie has entered a long-term flexibility purchase agreement with developer Ignis for 625MWh of battery storage in Spain, Energy-Storage.News reported on 6 July 2026.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">CleanPeak to install 30MW/120MWh of storage at Western Sydney International Airport</h2>
      <p class="text-body-md text-body font-light mb-4">CleanPeak Energy has signed a 15-year agreement to supply Western Sydney International Airport with renewable electricity, including 30MW/120MWh of battery storage on site, Energy-Storage.News reported on 7 July 2026.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MANUFACTURING</span>
      <h2 class="text-title-xl text-primary mb-4">Eni Storage breaks ground on an LFP gigafactory in Italy as Hithium wins Spanish support</h2>
      <p class="text-body-md text-body font-light mb-4">Eni Storage Systems has broken ground on an Italian gigafactory that will build LFP cells for energy storage, and Hithium has won an €80 million grant from the Spanish government for a battery and storage plant, Energy-Storage.News reported on 7 July 2026.</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Elestor and Windpark Zeewolde plan a 20MW hydrogen-iron flow battery</h2>
      <p class="text-body-md text-body font-light mb-4">Elestor and Windpark Zeewolde will deploy a 20MW hydrogen-iron flow battery, sized from 200MWh to 800MWh, at what Energy-Storage.News describes as Europe’s largest onshore wind farm. The article was published on 8 July 2026.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Akaysha starts work on a 20MW/82MWh battery in Fukuoka</h2>
      <p class="text-body-md text-body font-light mb-4">Akaysha Energy, Ibeet and Tokyu Land have started construction of the 20MW/82MWh Iizuka Seta project in Fukuoka Prefecture. Energy-Storage.News, writing on 8 July 2026, says the partners announced the start on 3 July.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MANUFACTURING</span>
      <h2 class="text-title-xl text-primary mb-4">Honda and LG Energy Solution joint venture starts cell production in Ohio</h2>
      <p class="text-body-md text-body font-light mb-4">L-H Battery Company, the LG Energy Solution and Honda joint venture, has started lithium-ion cell production at its Jeffersonville, Ohio plant for automotive and stationary storage. Energy-Storage.News reported on 8 July 2026 that the start was announced on 1 July and that initial production was redirected from electric-vehicle cells toward stationary storage.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Argentina awards 700.5MW of battery storage in the AlmaSADI tender</h2>
      <p class="text-body-md text-body font-light mb-4">pv magazine reported on 9 July 2026 that Argentina awarded 20 battery projects, 700.5MW in total, to five developers under the AlmaSADI tender. The magazine put the estimated investment at $700 million, aimed at strengthening the grid outside the Buenos Aires metropolitan area.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Field finances a 1GWh UK portfolio and Pulse selects Envision for 310MWh</h2>
      <p class="text-body-md text-body font-light mb-4">Field has closed financing on a 1GWh UK portfolio, and Pulse Clean Energy has selected Envision for a 310MWh project. Energy-Storage.News, on 9 July 2026, put the combined capacity above 1.3GWh.</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/amazon-pens-battery-storage-ppa-for-220mwh-solar-plus-storage-site-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Amazon pens battery storage PPA for 220MWh solar-plus-storage site in Australia — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/engie-agrees-offtake-deal-developer-625mwh-spain-bess-flexibility-floor-toll/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Engie agrees offtake deal with developer for 625MWh of Spain BESS — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/australias-cleanpeak-energy-to-deploy-120mwh-battery-storage-system-at-western-sydney-international-airport/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Australia’s CleanPeak Energy to deploy 120MWh battery storage system at Western Sydney International Airport — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/european-battery-manufacturing-boost-eni-storage-hithium-lfp-gigafactory-milestones-italy-spain/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">European battery &amp; BESS manufacturing gets boost with Eni Storage and Hithium gigafactory milestones in Italy, Spain — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/elestor-windpark-zeewolde-partner-on-10-40-hour-hydrogen-iron-flow-battery-ldes-project-in-netherlands/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Elestor, Windpark Zeewolde partner on 10-40-hour hydrogen-iron flow battery LDES project in Netherlands — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/akaysha-energy-begins-construction-of-82mwh-bess-in-southern-japan-with-itochu-tokyo-century-jv/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Akaysha Energy begins construction of 82MWh BESS in southern Japan with Itochu-Tokyo Century JV — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/honda-lg-es-begin-ess-cell-production-at-retooled-ohio-ev-cell-facility/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Honda-LG ES begin ESS cell production at retooled Ohio EV cell facility — Energy-Storage.News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/09/argentina-awards-700-5-mw-of-battery-storage-across-critical-grid-nodes/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Argentina awards 700.5 MW of battery storage across critical grid nodes — pv magazine</a></li>
        <li><a href="https://www.energy-storage.news/uk-roundup-field-closes-financing-on-1gwh-portfolio-pulse-clean-energy-selects-envision-for-310mwh-project/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">UK ROUNDUP: Field closes financing on 1GWh portfolio; Pulse Clean Energy selects Envision for 310MWh project — Energy-Storage.News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
