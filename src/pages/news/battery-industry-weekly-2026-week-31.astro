    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">&lt;a href=&quot;https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWW</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
