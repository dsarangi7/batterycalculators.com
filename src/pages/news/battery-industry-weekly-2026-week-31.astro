---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 31, 2026 | Battery Calculators";
const description = "This week in batteries: hanoi power corporation inaugurates the first 100mwh battery storage portfolio in vietnamese capital, sodium-ion bess: catl in 2gwh eastern europe collaboration, ess inc signs loi for 500mwh of us deployments, alpiq follows harmony energy acquisition with 1.2gwh project announcement.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-31";
const publishDate = "2026-07-31";
const lastUpdated = "2026-07-31";
const readingTime = 24;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news' },
  { label: 'Week 31, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 31, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 31</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Jul 27 – Aug 2, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: hanoi power corporation inaugurates the first 100mwh battery storage portfolio in vietnamese capital, sodium-ion bess: catl in 2gwh eastern europe collaboration, ess inc signs loi for 500mwh of us deployments, alpiq follows harmony energy acquisition with 1.2gwh project announcement.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital</h2>
      <p class="text-body-md text-body font-light mb-4">Hanoi Power Corporation (EVNHANOI) has begun pilot operation of five battery energy storage systems at substations in Hanoi, Vietnam.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Sodium-ion BESS: CATL in 2GWh Eastern Europe collaboration, ESS Inc signs LOI for 500MWh of US deployments</h2>
      <p class="text-body-md text-body font-light mb-4">ESS Tech Inc is deploying sodium-ion BESS in the US with Juniper Energy, while CATL deploys its sodium-ion technology in Eastern Europe with Solarpro.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement</h2>
      <p class="text-body-md text-body font-light mb-4">Two weeks after announcing its acquisition of Harmony Energy, Swiss power firm Alpiq has unveiled its first large-scale battery project in its home country.</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">A new all-electric cargo ship with a massive 2.4 MWh battery pack launches in China - Electrek</h2>
