---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';

const title = "Battery Industry Weekly — Week 31, 2026 | Battery Calculators";
const description = "This week in batteries: Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital, Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement, and Colombia awards 725 MW of solar on second day of green energy auction.";
const canonical = "https://batterycalculators.com/news/battery-industry-weekly-2026-week-31";
const publishDate = "2026-07-31";
const lastUpdated = "2026-07-31";
const readingTime = 20;

const faqItems = [
  {
    "question": "What is the Battery Industry Weekly?",
    "answer": "A short editorial digest covering the most important battery industry news each week — EV batteries, grid-scale storage, regulation, manufacturing, and research."
  },
  {
    "question": "How are stories selected?",
    "answer": "The generator fetches RSS feeds from trusted sources, deduplicates similar stories, scores them by relevance, and selects the top stories for the week."
  },
  {
    "question": "When is the digest published?",
    "answer": "A new edition is generated every Friday covering the current week."
  }
];

const breadcrumbs = [
  { label: 'News', href: '/news/' },
  { label: 'Week 31, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="Battery Industry Weekly — Week 31, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; Back to News</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">WEEKLY EDITION</span>
      <h1 class="text-display-md text-primary mb-4">Battery Industry Weekly — Week 31</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>Jul 27 – Aug 2, 2026</span>
        <span>{readingTime} min read</span>
      </div>
      <p class="text-body-md text-body font-light">
        This week in batteries: Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital, Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement, and Colombia awards 725 MW of solar on second day of green energy auction.
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital</h2>
      <p class="text-body-md text-body font-light mb-4">Hanoi Power Corporation (EVNHANOI) has begun pilot operation of five battery energy storage systems at substations in Hanoi, Vietnam.</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement</h2>
      <p class="text-body-md text-body font-light mb-4">Two weeks after announcing its acquisition of Harmony Energy, Swiss power firm Alpiq has unveiled its first large-scale battery project in its home country.</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Colombia awards 725 MW of solar on second day of green energy auction</h2>
      <p class="text-body-md text-body font-light mb-4">The country\'s Clean Energy Procurement Auction awarded 995 MW of solar and nearly 100 MW of battery energy storage systems across two days.</p>
      <p class="text-body-md text-body font-light">The post Colombia awards 725 MW of solar on second day of gr</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">RESEARCH</span>
      <h2 class="text-title-xl text-primary mb-4">Antora Energy closes US$550 million Series C to scale US thermal battery deployment</h2>
      <p class="text-body-md text-body font-light mb-4">Thermal energy storage (TES) technology provider Antora Energy has closed a US$550 million Series C funding round to accelerate deployment of its thermal battery storage systems for industrial facilit</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Veolia to operate 350MW microgrid for AI data centre in central Ohio</h2>
      <p class="text-body-md text-body font-light mb-4">Environmental services company Veolia has been selected to operate and maintain a 350MW microgrid to power an AI data centre campus in New Albany, Ohio, US, which includes a 430MWh BESS.</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">MARINE</span>
      <h2 class="text-title-xl text-primary mb-4">Battery storage is an important growth driver, NextEra CEO says, amid merger to create largest regulated utility in US</h2>
      <p class="text-body-md text-body font-light mb-4">NextEra Energy recorded a 9.5% increase in its net earnings in Q2 2026, as the company advanced its plan to merge with Dominion Energy to form the world\'s largest regulated power utility.</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Georgia Power completes construction of 198MWh BESS next to Moody Air Force Base</h2>
      <p class="text-body-md text-body font-light mb-4">Utility Georgia Power has completed construction of the 49.5MW/198MWh Moody Battery Facility, located outside of Valdosta, Georgia, US.</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Central & Eastern Europe: UK’s Alcemi buys 2.3GWh Romania projects, Slovakia’s biggest BESS brought online</h2>
      <p class="text-body-md text-body font-light mb-4">Alcemi, developer of some of the UK’s biggest projects, has entered the Romanian battery storage market, while Slovakia’s biggest project to date has gone into operation.</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">EV</span>
      <h2 class="text-title-xl text-primary mb-4">EV demand in Europe, BESS in the US drive LG Energy Solution’s return to profit in Q2</h2>
      <p class="text-body-md text-body font-light mb-4">LG Energy Solution (LG ES) posted a profitable second quarter this year, with investments in battery storage in the US and EV cell production in Europe paying off.</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Greenvolt inaugurates 200MW/800MWh capacity market-contracted BESS in Poland</h2>
      <p class="text-body-md text-body font-light mb-4">Greenvolt Power has inaugurated the 200MW Turośń Kościelna Battery Energy Storage Facility in Poland, which energy trader Entrix will optimise.</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/hanoi-power-corporation-inaugurates-the-first-100mwh-battery-storage-portfolio-in-vietnamese-capital/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hanoi Power Corporation inaugurates the first 100MWh battery storage portfolio in Vietnamese capital — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/alpiq-follows-harmony-energy-acquisition-with-1-2gwh-project-announcement/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Alpiq follows Harmony Energy acquisition with 1.2GWh project announcement — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/31/colombia-awards-725-mw-of-solar-on-second-day-of-green-energy-auction/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Colombia awards 725 MW of solar on second day of green energy auction — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/antora-energy-closes-us550-million-series-c-to-scale-us-thermal-battery-deployment/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Antora Energy closes US$550 million Series C to scale US thermal battery deployment — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/veolia-to-operate-350mw-microgrid-for-ai-data-centre-in-central-ohio/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Veolia to operate 350MW microgrid for AI data centre in central Ohio — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/battery-storage-is-an-important-growth-driver-nextera-ceo-says-amid-merger-to-create-largest-regulated-utility-in-us/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Battery storage is an important growth driver, NextEra CEO says, amid merger to create largest regulated utility in US — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/georgia-power-completes-construction-of-198mwh-bess-next-to-moody-air-force-base/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Georgia Power completes construction of 198MWh BESS next to Moody Air Force Base — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/central-eastern-europe-uks-alcemi-buys-2-3gwh-romania-projects-slovakias-biggest-bess-brought-online/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Central & Eastern Europe: UK’s Alcemi buys 2.3GWh Romania projects, Slovakia’s biggest BESS brought online — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/ev-demand-in-europe-bess-in-the-us-drive-lg-energy-solutions-return-to-profit-in-q2/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EV demand in Europe, BESS in the US drive LG Energy Solution’s return to profit in Q2 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/greenvolt-inaugurates-200mw-800mwh-capacity-market-contracted-bess-in-poland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Greenvolt inaugurates 200MW/800MWh capacity market-contracted BESS in Poland — Energy Storage News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">Disclaimer</h3>
        <p class="text-body-sm text-muted">
          This article summarizes publicly available news and analysis. BatteryCalculators.com does not guarantee the accuracy of third-party information. Always verify facts with primary sources before making engineering or procurement decisions. This content is provided for informational purposes only and does not constitute professional engineering advice.
        </p>
      </div>
    </section>

  </article>
</Layout>
