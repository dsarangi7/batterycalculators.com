---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ReferenceTable from '../../components/ReferenceTable.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';

const faqItems = [
  {
    question: "What is the difference between Group 24 and Group 27 batteries?",
    answer: "Group 27 batteries are physically larger and hold more capacity. A typical Group 24 lead-acid battery is 70–85 Ah, while a Group 27 is 85–105 Ah. Group 27 measures approximately 12.9 × 6.8 × 9.0 inches versus Group 24 at 10.5 × 6.8 × 9.0 inches. If your battery tray fits, Group 27 provides more runtime.",
  },
  {
    question: "What battery group size do I need for my RV?",
    answer: "Most RV house battery trays accept Group 24 or Group 27. For lead-acid, Group 27 provides more capacity (85–105 Ah). For LiFePO4, many 100Ah batteries are built to Group 31 dimensions (13 × 7 × 9 inches). Always measure your battery tray before purchasing.",
  },
  {
    question: "Are BCI group sizes the same as DIN or EN sizes?",
    answer: "No. BCI (Battery Council International) is the North American standard. DIN (Deutsche Industrie Norm) and EN (European Norm) use different dimension standards. A BCI Group 31 is not the same as DIN 100. Always verify dimensions when cross-referencing between standards.",
  },
  {
    question: "Can I use a Group 31 battery in a Group 24 tray?",
    answer: "Only if the tray is large enough. Group 31 dimensions (approximately 13 × 6.8 × 9.4 inches) are larger than Group 24 (10.5 × 6.8 × 9.0 inches). The Group 31 is about 2.5 inches longer. Many RV and marine battery trays have adjustable holds that accommodate Group 31.",
  },
  {
    question: "What are Group 4D and Group 8D batteries used for?",
    answer: "Group 4D and Group 8D are large deep-cycle batteries used in commercial trucks, buses, marine house banks, and industrial applications. Group 4D provides 150–220 Ah; Group 8D provides 200–255 Ah. They weigh 60–130 lbs each and are common in commercial vehicles and yacht house banks.",
  },
  {
    question: "What is the L16 battery group?",
    answer: "L16 is an extended-height deep-cycle battery group commonly used in solar, telecom, and industrial applications. It measures approximately 11.6 × 7 × 17 inches (taller than standard groups). L16 batteries provide 300–400 Ah at 6V and are designed for deep-cycle applications requiring maximum capacity.",
  },
];

const relatedCalculators = [
  { title: 'Battery Sizing Calculator', href: '/tools/battery-sizing-calculator', type: 'calculator' },
  { title: 'RV Battery Calculator', href: '/tools/rv-battery-calculator', type: 'calculator' },
  { title: 'Marine Battery Sizing Calculator', href: '/tools/marine-battery-sizing-calculator', type: 'calculator' },
  { title: 'Battery Pack Calculator', href: '/tools/battery-pack-calculator', type: 'calculator' },
];

const relatedGuides = [
  { title: 'How to Size a Battery Bank', href: '/learn/how-to-size-a-battery-bank', type: 'guide' },
  { title: 'Battery Sizing Reference', href: '/learn/battery-sizing-reference', type: 'guide' },
];

const tableOfContents = [
  { id: 'standard-groups', label: 'Standard Group Sizes' },
  { id: 'lithium-equivalents', label: 'Lithium Equivalents' },
  { id: 'application-guide', label: 'Application Guide' },
];
---

<ArticleLayout
  title="Battery Group Sizes Reference | Battery Calculators"
  description="Complete BCI battery group size reference with dimensions, capacity, weight, and typical applications. Covers Group 24, 27, 31, 4D, 8D, L16, and lithium equivalents."
  category="REFERENCE"
  categoryHref="/reference"
  breadcrumbItems={[{ label: 'Battery Group Sizes' }]}
  relatedCalculators={relatedCalculators}
  relatedGuides={relatedGuides}
  tableOfContents={tableOfContents}
  faqItems={faqItems}
>
  <p class="text-body-md text-body font-light mb-8">
    BCI (Battery Council International) group sizes define standard battery dimensions for North American vehicles and energy storage systems. This reference covers the most common deep-cycle group sizes used in RV, marine, solar, and industrial applications.
  </p>

  <div id="standard-groups">
    <ReferenceTable
      title="Standard Lead-Acid Group Sizes"
      description="BCI group sizes with dimensions, capacity, weight, and typical applications for lead-acid batteries."
      headers={['Group', 'L × W × H (in)', 'L × W × H (mm)', 'Capacity (Ah)', 'Weight (lbs)', 'Typical Use']}
      rows={[
        ['24', '10.5 × 6.8 × 9.0', '267 × 173 × 229', '70–85', '40–50', 'RV house, marine starting'],
        ['27', '12.9 × 6.8 × 9.0', '328 × 173 × 229', '85–105', '50–60', 'RV house, marine deep cycle'],
        ['30', '13.5 × 6.8 × 9.5', '343 × 173 × 241', '95–125', '55–70', 'Marine house, commercial'],
        ['31', '13.0 × 6.8 × 9.4', '330 × 173 × 239', '100–125', '55–75', 'RV house, marine, telecom'],
        ['4D', '20.8 × 8.3 × 11.0', '528 × 211 × 279', '150–220', '75–100', 'Commercial truck, marine'],
        ['8D', '20.8 × 11.0 × 11.0', '528 × 279 × 279', '200–255', '100–130', 'Commercial, marine house'],
        ['L16', '11.6 × 7.0 × 17.0', '295 × 178 × 432', '300–400 (6V)', '80–120', 'Solar, telecom, industrial'],
        ['GC2 (Golf Cart)', '10.3 × 7.1 × 11.2', '262 × 180 × 285', '180–225 (6V)', '62–70', 'Golf cart, floor scrubber'],
      ]}
      source="BCI Group Number Standards and manufacturer dimensional data"
    />
  </div>

  <div id="lithium-equivalents">
    <ReferenceTable
      title="Lithium (LiFePO4) Group Size Equivalents"
      description="LiFePO4 batteries designed to BCI group dimensions. Note: lithium batteries typically weigh 50–65% less than lead-acid equivalents."
      headers={['Group', 'L × W × H (in)', 'Capacity (Ah)', 'Voltage', 'Weight (lbs)', 'Notes']}
      rows={[
        ['24 (Group 24 form)', '10.5 × 6.8 × 7.5', '50–80', '12.8V', '15–25', 'Drop-in replacement for lead-acid'],
        ['31 (Group 31 form)', '13.0 × 6.8 × 8.5', '100–110', '12.8V', '25–30', 'Most popular form factor'],
        ['27 (Group 27 form)', '12.9 × 6.8 × 8.0', '80–100', '12.8V', '20–28', 'Fits most RV trays'],
        ['4D (Group 4D form)', '20.8 × 8.3 × 8.5', '200–230', '12.8V', '45–55', 'Commercial marine'],
        ['8D (Group 8D form)', '20.8 × 11.0 × 8.5', '250–315', '12.8V', '55–70', 'Large marine/industrial'],
        ['12V 100Ah Prismatic', '13.0 × 6.8 × 8.5', '100', '12.8V', '25–30', 'Common DIY form factor'],
        ['12V 200Ah Prismatic', '20.5 × 9.4 × 8.6', '200', '12.8V', '48–55', 'Large capacity systems'],
      ]}
      source="Manufacturer specifications from major LiFePO4 brands (2024–2026)"
    />
  </div>

  <div id="application-guide">
    <ComparisonTable
      title="Group Sizes by Application"
      headers={['Application', 'Recommended Group', 'Capacity Range', 'Notes']}
      rows={[
        ['RV House Battery', '31 (LFP)', '100–110 Ah', 'Group 31 is the standard form factor for 100Ah LFP. Fits most trays.'],
        ['Marine Deep Cycle', '31 (LFP)', '100–110 Ah', 'ABYC recommends dedicated deep-cycle. Group 31 LFP for house bank.'],
        ['Golf Cart', 'GC2 (LFP)', '100–105 Ah', 'GC2 form factor available in LFP. Replaces 6V flooded lead-acid in series.'],
        ['Wheelchair / Mobility', '22NF or U1', '35–50 Ah', 'Smaller groups for mobility. U1 is common for power wheelchairs.'],
        ['Solar Storage (Home)', 'L16 or 8D', '200–400 Ah', 'Large capacity for off-grid. L16 common in 6V configurations.'],
        ['Commercial Truck', '4D or 8D', '150–255 Ah', 'Heavy-duty starting and hotel loads. Group 8D for large rigs.'],
        ['Telecom (48V Rack)', 'Custom rack', '100–200 Ah', 'Rack-mounted 48V LFP modules. Not BCI group.'],
      ]}
      caption="Always measure your battery compartment before purchasing. Group sizes are standardized but dimensions can vary ±0.5 inches between manufacturers."
    />
  </div>

  <div class="bg-surface-card border border-hairline p-6 mb-12">
    <h3 class="text-title-lg text-primary uppercase tracking-wider mb-3">Disclaimer</h3>
    <p class="text-body-sm text-muted font-light">
      Battery group sizes are standardized by BCI but actual dimensions may vary between manufacturers by up to 0.5 inches. Always verify physical dimensions before purchasing replacement batteries. Capacity ratings are nominal and vary by temperature, discharge rate, and battery age. This reference is for informational purposes only.
    </p>
  </div>
</ArticleLayout>
