---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';

const referencePages = [
  { title: 'Battery Voltage Reference', description: 'All common battery voltages with typical configurations, applications, and cable requirements.', href: '/reference/battery-voltage-reference' },
  { title: 'C-Rate Reference', description: 'Complete C-rate reference from 0.05C to 5C with current values for common capacities.', href: '/reference/c-rate-reference' },
  { title: 'Battery Temperature Reference', description: 'Temperature effects on capacity and charge/discharge limits for LFP, NMC, and Lead-Acid.', href: '/reference/battery-temperature-reference' },
  { title: 'Marine Electrical Standards', description: 'ISO 13297, ABYC E-11, and USCG 33 CFR 183 requirements for marine electrical systems.', href: '/reference/marine-electrical-standards' },
  { title: 'Solar Sizing Reference', description: 'Peak sun hours, array sizing, and system configurations for common solar applications.', href: '/reference/solar-sizing-reference' },
  { title: 'Battery Formulas Reference', description: 'All essential battery formulas including Ohm\'s law, C-rate, voltage drop, sizing, and energy calculations.', href: '/reference/battery-formulas-reference' },
];

const relatedCalculators = [
  { title: 'Battery Sizing Calculator', href: '/tools/battery-sizing-calculator', type: 'calculator' as const },
  { title: 'C-Rate Calculator', href: '/tools/c-rate-calculator', type: 'calculator' as const },
  { title: 'Runtime Calculator', href: '/tools/runtime-calculator', type: 'calculator' as const },
  { title: 'Voltage Drop Calculator', href: '/tools/voltage-drop-calculator', type: 'calculator' as const },
];
---

<ArticleLayout
  title="Technical Reference Library | Battery Calculators"
  description="Quick-reference tables, formulas, and standards for battery systems, solar sizing, marine electrical, and more. Download CSV versions of every reference table."
  category="REFERENCE"
  categoryHref="/reference"
  breadcrumbItems={[{ label: 'Reference Library' }]}
  relatedCalculators={relatedCalculators}
>
  <p class="text-body-md text-body font-light mb-8">
    This reference library provides technical data, engineering formulas, and industry standards for battery system design. Every table is downloadable as CSV for use in spreadsheets and engineering tools. Use these references alongside the calculator tools for precise system design.
  </p>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">Reference Pages</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {referencePages.map((page) => (
        <CalculatorCard>
          <a href={page.href} class="text-primary hover:underline font-bold block mb-2">{page.title}</a>
          <p class="text-body-sm text-muted">{page.description}</p>
        </CalculatorCard>
      ))}
    </div>
  </section>
</ArticleLayout>
