---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ReferenceTable from '../../components/ReferenceTable.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';

const faqItems = [
  {
    question: "What is the difference between pure sine and modified sine wave inverters?",
    answer: "Pure sine wave (PSW) inverters produce a smooth sinusoidal waveform identical to grid power. Modified sine wave (MSW) inverters produce a stepped waveform that approximates a sine wave. PSW is required for sensitive electronics, medical equipment, motors, and appliances with microprocessors. MSW is acceptable for simple resistive loads (lights, heaters) but can damage motors and electronics.",
  },
  {
    question: "What size inverter do I need for my RV?",
    answer: "For basic loads (lights, phone charging, TV), a 1000W inverter is sufficient. For microwave (1000W), coffee maker (800W), and hair dryer (1500W), use a 2000–3000W inverter. Add up all simultaneous loads and add 20% margin. Consider inverter-chargers for shore power integration.",
  },
  {
    question: "How do I size an inverter for my battery bank?",
    answer: "Match inverter continuous wattage to your loads. For battery bank sizing, divide inverter wattage by battery voltage to get current draw. A 2000W inverter on 12V draws ~167A. Ensure your battery bank can sustain this current. For lead-acid, max discharge should not exceed 25% of capacity. For LFP, 80% DoD is acceptable.",
  },
  {
    question: "What is the difference between an inverter and an inverter-charger?",
    answer: "An inverter converts DC battery power to AC output. An inverter-charger adds a built-in AC battery charger that can charge the batteries from shore power or a generator. Inverter-chargers automatically switch between inverter and charger mode. They are ideal for RV, marine, and home backup applications.",
  },
  {
    question: "What efficiency should I expect from a quality inverter?",
    answer: "Quality pure sine wave inverters operate at 88–94% efficiency at rated load. At light loads (10–20% of rated capacity), efficiency drops to 80–85%. Peak efficiency is typically at 40–60% load. Always check the efficiency curve, not just peak efficiency. Higher efficiency means less battery drain.",
  },
  {
    question: "Can I run an air conditioner from a battery inverter?",
    answer: "Yes, but you need a large system. A 15,000 BTU RV air conditioner draws 1,500–2,000W running but requires 3,000–4,000W for startup surge. You need a 5,000W inverter minimum and at least 200Ah of 12V LFP (or 400Ah lead-acid) for 8 hours of runtime. A soft-start device reduces surge to manageable levels.",
  },
];

const relatedCalculators = [
  { title: 'Inverter Battery Calculator', href: '/tools/inverter-battery-calculator', type: 'calculator' },
  { title: 'Runtime Calculator', href: '/tools/runtime-calculator', type: 'calculator' },
  { title: 'Battery Sizing Calculator', href: '/tools/battery-sizing-calculator', type: 'calculator' },
  { title: 'DC Cable Loss Calculator', href: '/tools/dc-cable-loss-calculator', type: 'calculator' },
];

const relatedGuides = [
  { title: 'Inverter Battery Runtime Guide', href: '/learn/inverter-battery-runtime-guide', type: 'guide' },
  { title: 'Battery Sizing Reference', href: '/learn/battery-sizing-reference', type: 'guide' },
];

const tableOfContents = [
  { id: 'inverter-specs', label: 'Inverter Specifications' },
  { id: 'inverter-types', label: 'Inverter Type Comparison' },
];
---

<ArticleLayout
  title="Inverter Specifications Reference | Battery Calculators"
  description="Complete inverter specification reference covering 500W to 10kW inverters with input voltage, output, efficiency, weight, and inverter type comparison."
  category="REFERENCE"
  categoryHref="/reference"
  breadcrumbItems={[{ label: 'Inverter Specs' }]}
  relatedCalculators={relatedCalculators}
  relatedGuides={relatedGuides}
  tableOfContents={tableOfContents}
  faqItems={faqItems}
>
  <p class="text-body-md text-body font-light mb-8">
    This reference covers common DC-to-AC inverters from 500W to 10kW for RV, marine, solar, and home backup applications. Specifications represent typical products from major manufacturers as of 2026.
  </p>

  <div id="inverter-specs">
    <ReferenceTable
      title="Inverter Specifications"
      description="Common inverter models with input voltage, output, efficiency, surge capability, and weight."
      headers={['Power', 'Input Voltage', 'Output', 'Efficiency', 'Surge (10s)', 'Weight (lbs)', 'Form Factor']}
      rows={[
        ['500W', '12V DC', '120V AC, 60Hz', '88%', '1,000W', '5.5', 'Compact'],
        ['1,000W', '12V DC', '120V AC, 60Hz', '90%', '2,000W', '7.5', 'Compact'],
        ['1,500W', '12V DC', '120V AC, 60Hz', '90%', '3,000W', '10', 'Mid-size'],
        ['2,000W', '12V DC', '120V AC, 60Hz', '91%', '4,000W', '12', 'Mid-size'],
        ['3,000W', '12/24V DC', '120V AC, 60Hz', '92%', '6,000W', '15', 'Full-size'],
        ['3,000W', '24V DC', '120V AC, 60Hz', '92%', '6,000W', '14', 'Full-size'],
        ['5,000W', '24/48V DC', '120/240V AC', '93%', '10,000W', '28', 'Rack-mount'],
        ['5,000W', '48V DC', '120/240V AC', '93%', '10,000W', '25', 'Rack-mount'],
        ['7,500W', '48V DC', '120/240V AC', '93%', '15,000W', '40', 'Floor-standing'],
        ['10,000W', '48V DC', '120/240V AC', '94%', '20,000W', '55', 'Floor-standing'],
      ]}
      source="Typical specifications from Victron, Magnum, Aims Power, and Growatt product lines"
    />
  </div>

  <div id="inverter-types">
    <ComparisonTable
      title="Inverter Type Comparison"
      headers={['Feature', 'Pure Sine Wave', 'Modified Sine Wave', 'Inverter-Charger']}
      rows={[
        ['Output Waveform', 'Smooth sine wave', 'Stepped approximation', 'Pure sine wave'],
        ['Price Range', '$$$', '$', '$$$$'],
        ['Efficiency', '88–94%', '85–90%', '88–94%'],
        ['Compatible Loads', 'All loads', 'Resistive only', 'All loads'],
        ['Motor Compatible', 'Yes', 'No (overheats)', 'Yes'],
        ['Medical Equipment', 'Yes', 'No', 'Yes'],
        ['Sensitive Electronics', 'Yes', 'No (may damage)', 'Yes'],
        ['Built-in Charger', 'No', 'No', 'Yes (30–100A)'],
        ['Transfer Switch', 'No', 'No', 'Yes (30–50A)'],
        ['Best For', 'Solar, RV, marine', 'Lights, basic tools', 'RV, marine, home backup'],
        ['Typical Weight (2kW)', '12 lbs', '8 lbs', '25 lbs'],
        ['Remote Monitoring', 'Some models', 'No', 'Most models'],
      ]}
      caption="Pure sine wave is recommended for all applications. Modified sine wave is only acceptable for simple resistive loads."
    />
  </div>

  <div class="bg-surface-card border border-hairline p-6 mb-12">
    <h3 class="text-title-lg text-primary uppercase tracking-wider mb-3">Disclaimer</h3>
    <p class="text-body-sm text-muted font-light">
      Inverter specifications vary by manufacturer, model, and operating conditions. Efficiency ratings are at nominal load; actual efficiency varies with load level and battery voltage. Surge ratings are typically for 10 seconds. Always consult manufacturer datasheets for specific product specifications. This reference is for informational and educational purposes only.
    </p>
  </div>
</ArticleLayout>
