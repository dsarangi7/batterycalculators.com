---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout
  title="联系我们 | 电池计算器"
  description="与电池计算器团队联系，获取计算器反馈、问题报告、内容更正或合作咨询。"
  canonical="https://batterycalculators.com/zh/contact/"
  lang="zh"
>
  <div class="max-w-3xl mx-auto">
    <Breadcrumb items={[{ label: '联系我们' }]} />

    <div class="mb-12 border-b border-hairline pb-8">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">联系</span>
      <h1 class="text-display-md text-primary mb-6">联系我们</h1>
      <p class="text-body-md text-body font-light">
        如需计算器反馈、问题报告、内容更正或合作咨询，请通过以下表单或邮箱联系我们。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Contact Info -->
      <div class="md:col-span-1 flex flex-col gap-6 text-body-sm">
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">邮箱</h4>
          <p class="text-muted">
            <a href="mailto:dsarangi7@gmail.com" class="hover:text-primary transition-colors underline underline-offset-4">dsarangi7@gmail.com</a>
          </p>
          <p class="text-caption text-muted mt-1 italic">
            用于计算器反馈、问题报告或合作咨询。
          </p>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">响应时间</h4>
          <p class="text-muted">1–3 个工作日</p>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">主题</h4>
          <ul class="flex flex-col gap-1 text-muted">
            <li>计算器反馈</li>
            <li>问题报告</li>
            <li>内容更正</li>
            <li>合作咨询</li>
          </ul>
        </div>
        <div>
          <h4 class="text-label-uppercase text-primary text-xs mb-1">教育范围</h4>
          <p class="text-muted">
            所有算法均为公开，仅用于电池系统选型设计的教育性校验。
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2">
        <CalculatorCard>
          <form id="contact-form" class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-label-uppercase text-xs text-primary">您的姓名</label>
              <input type="text" id="name" required class="text-input" placeholder="您的姓名" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="text-label-uppercase text-xs text-primary">邮箱地址</label>
              <input type="email" id="email" required class="text-input" placeholder="您的邮箱@example.com" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="topic" class="text-label-uppercase text-xs text-primary">主题</label>
              <select id="topic" required class="select-input">
                <option value="" disabled selected>选择主题</option>
                <option value="calculator-feedback">计算器反馈</option>
                <option value="bug-report">问题报告</option>
                <option value="content-correction">内容更正</option>
                <option value="partnership">合作咨询</option>
                <option value="other">其他</option>
              </select>
            </div>

            <div class="flex flex-col gap-2">
              <label for="message" class="text-label-uppercase text-xs text-primary">留言</label>
              <textarea id="message" required class="text-input h-32 resize-none" placeholder="您的留言..."></textarea>
            </div>

            <button type="submit" class="btn-primary w-full text-xs h-12">发送留言</button>
          </form>
          
          <div id="form-success" class="hidden mt-4 p-4 border border-green-600 bg-surface-soft text-body-sm text-green-500">
            感谢您的留言。这是一个静态网站——您的留言已本地记录，但未发送到服务器。如有实际需求，请直接发送邮件。
          </div>
        </CalculatorCard>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successDiv = document.getElementById('form-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      if (successDiv) {
        successDiv.classList.remove('hidden');
        setTimeout(() => {
          successDiv.classList.add('hidden');
        }, 8000);
      }
    });
  </script>
</Layout>