                  <td class="p-4 text-muted">良好工作范围</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">70%</td>
                  <td class="p-4 text-muted">12.34V</td>
                  <td class="p-4 text-muted">24.68V</td>
                  <td class="p-4 text-muted">49.36V</td>
                  <td class="p-4 text-muted">日常使用可接受</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">60%</td>
                  <td class="p-4 text-muted">12.24V</td>
                  <td class="p-4 text-muted">24.48V</td>
                  <td class="p-4 text-muted">48.96V</td>
                  <td class="p-4 text-muted">应尽快开始回充</td>
                </tr>
                <tr>
                  <td class="p-4 font-mono text-primary">50%</td>
                  <td class="p-4 text-muted">12.12V</td>
                  <td class="p-4 text-muted">24.24V</td>
                  <td class="p-4 text-muted">48.48V</td>
