---
import Layout from "../../../layouts/Layout.astro";
import CalculatorCard from "../../../components/CalculatorCard.astro";
import FAQSection from "../../../components/FAQSection.astro";
import ReferenceChart from "../../../components/ReferenceChart.astro";
import ReferenceTable from "../../../components/ReferenceTable.astro";

const faqItems = [
  {
    question:
      "充满电的 12V 铅酸电池静置电压是多少？",
    answer:
      "充满电的富液式铅酸电池静置电压大约为 12.6–12.8V。AGM 和胶体电池通常略高，为 12.8–13.0V。充电后，表面电荷可能把读数抬高到 13.0–13.4V，因此测量静置电压前至少等待 30 分钟。",
  },
  {
    question: "温度如何影响铅酸电压读数？",
    answer:
      "温度会影响电芯的化学平衡。低温会增加内阻并降低电压读数。在 0°C 时，一块充满电的电池读数可能比 25°C 时低 0.2–0.3V。在高温（高于 40°C）下，电压读数可能略有升高。由电压估算 SOC 时，务必做温度补偿。",
  },
  {
    question: "什么是表面电荷？",
    answer:
      "表面电荷是充电后出现的暂时电压升高。它由极板表面附近酸浓度不均匀引起，会在静置 30–60 分钟内消散。刚充完电就测量电压，会得到偏高的 SOC 读数。务必先让电池静置，再测量电压。",
  },
  {
    question:
      "富液式、AGM 和胶体电池的电压曲线不同吗？",
    answer:
      "不同。在相同 SOC 下，AGM 和胶体电池的静置电压略高于富液式电池。AGM 通常比富液式高出 0.1–0.2V。胶体电池与 AGM 相近。差异不大，但在由电压估算 SOC 时仍有意义。请使用与你的电池类型对应的电压曲线。",
  },
];

const tableOfContents = [
  { id: "flooded-lead-acid", label: "富液式铅酸" },
  { id: "agm-gel", label: "AGM 和胶体" },
  { id: "surface-charge", label: "表面电荷" },
  { id: "temperature-effects", label: "温度影响" },
  { id: "common-mistakes", label: "常见错误" },
];

const relatedCalculators = [
  {
    title: "电池容量计算器",
    href: "/zh/tools/battery-sizing-calculator/",
  },
  { title: "电池续航时间计算器", href: "/zh/tools/runtime-calculator/" },
];

const references = [
  {
    title: "Battery University — 铅酸电压",
    url: "https://batteryuniversity.com/article/bu-403-lead-acid",
  },
  {
    title: "Concorde Battery — AGM 规格",
    url: "https://www.concordebattery.com/products/sealed-lead-acid/",
  },
];
---

<Layout
  title="铅酸电池电压图表 — SOC 参考 | 电池计算器"
  description="富液式、AGM 和胶体铅酸电池在 12V、24V 和 48V 下的电压参考表。按荷电状态给出近似静置电压。"
  canonical="https://batterycalculators.com/zh/learn/lead-acid-voltage-chart/"
  faqItems={faqItems}
  lang="zh"
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a
        href="/zh/learn/"
        class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block"
        >&larr; 返回指南</a
