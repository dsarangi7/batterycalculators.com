---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryToolGrid from '../../components/CategoryToolGrid.astro';
import FAQSection from '../../components/FAQSection.astro';

const tools = [
  {
    name: "BESS ROI 计算器",
    href: "/zh/tools/bess-roi-calculator/",
    description: "评估商用电池储能系统的净现值（NPV）和回收期。",
    available: true,
  },
  {
    name: "削峰计算器",
    href: "/zh/tools/bess-roi-calculator/",
    description: "计算削峰储能的需求费用节省。使用我们 BESS ROI 计算器的相同引擎。",
    available: true,
  },
  {
    name: "需求费用节省计算器",
    href: "/zh/tools/bess-roi-calculator/",
    description: "估算基于电池的需求管理月度需求费用减少。",
    available: true,
  },
];

const learnArticles = [
  { title: "BESS ROI 详解", href: "/zh/learn/bess-roi-explained/" },
  { title: "如何选型电池组", href: "/zh/learn/how-to-size-a-battery-bank/" },
  { title: "电池衰减详解", href: "/zh/learn/battery-degradation-explained/" },
  { title: "如何计算电池续航", href: "/zh/learn/how-to-calculate-battery-runtime/" },
];

const faqItems = [
  {
    question: "什么是 BESS 以及它如何省钱？",
    answer: "BESS（电池储能系统）在低需求时段存储电力并在高峰需求时放电，减少需求费用。它还可以通过存储便宜的低谷时段电力用于昂贵的高峰时段来执行能源套利。财务效益取决于您的供电公司电价结构、电价和使用模式。",
  },
  {
    question: "什么是削峰？",
    answer: "削峰是在高峰计费期间减少最大需求的做法。商业电费通常包括基于每个计费周期内最高 15 分钟平均功率的需求费用。BESS 可在这些峰值期间放电，降低需求费用而不改变实际能耗。",
  },
  {
    question: "如何计算商用电池系统的 ROI？",
    answer: "ROI 计算需要比较电池系统总成本（资本成本 + 安装 + 维护）与系统寿命期内的总节省（需求费用减少 + 能源套利 + 潜在电网服务收入）。我们的 BESS ROI 计算器使用净现值（NPV）和回收期指标执行此分析。",
  },
  {
    question: "BESS 的典型回收期是多少？",
    answer: "回收期因当地电价、需求费用水平和系统规模而异。在需求费用高的地区（$15–25/kW），5–8 年的回收期很常见。在需求费用较低或分时电价优惠的地区，回收期可延长至 10–15 年。联邦和州激励措施可将回收期减少 30–50%。",
  },
  {
    question: "BESS 可以参与电网服务吗？",
    answer: "可以。大型 BESS 安装可以参与需求响应计划、频率调节和容量市场。这些电网服务在需求费用减少和能源套利之外提供额外收入流。参与要求因供电公司和地区而异，通常要求最小系统规模为 100 kW 或更大。",
  },
];

const relatedCategories = [
  { href: "/zh/engineering/", title: "工程", description: "C-rate、SOC、压降和电缆损耗工具" },
  { href: "/zh/solar/", title: "太阳能", description: "太阳能电池选型和离网规划" },
  { href: "/zh/home-backup/", title: "家庭备用", description: "停电和关键负载的电池备用" },
];

const breadcrumbItems = [
  { label: "BESS 与商用" },
];
---

<Layout
  title="BESS 与商用电池计算器 | 电池计算器"
  description="免费 BESS ROI 计算器用于商用电池储能、削峰分析和需求费用节省估算。"
  schema="website"
  schemaName="BESS 与商用电池计算器"
  schemaDescription="商用 BESS、削峰和需求费用管理的工程级电池计算器。"
  breadcrumbs={[{ label: 'BESS 与商用' }]}
  lang="zh"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mb-12 md:mb-16 border-b border-hairline pb-12">
    <div class="max-w-4xl">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">BESS 与商用</span>
      <h1 class="text-display-md text-primary mb-6">BESS 与商用电池计算器</h1>
      <p class="text-body-md text-body max-w-2xl font-light">
        使用工程级工具评估商用电池储能投资。计算 ROI、分析削峰节省并估算需求费用减少。
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="max-w-4xl text-body-md text-body font-light flex flex-col gap-6">
      <p>
        电池储能系统（BESS）代表商用和工业能源市场快速增长的细分领域。与为备用电源设计的住宅电池系统不同，商用 BESS 安装旨在通过减少需求费用、分时能源套利和参与电网服务市场来优化能源成本。
      </p>
      <p>
        商用 BESS 的主要财务驱动因素是需求费用减少。大多数商业电费包括两个组成部分：能量费用（基于总消耗 kWh）和需求费用（基于每个计费周期内最高瞬时功率，通常以 15 分钟间隔测量）。在许多地区，需求费用占总电费的 30–70%。BESS 可在峰值需求期间放电，减少从电网抽取的最大功率并降低需求费用。
      </p>
      <p>
        能源套利是第二主要收入流。BESS 可在电价低的低谷时段充电，在电价高的高峰时段放电。购买价与放电值之间的差额代表套利利润。盈利能力取决于低谷与高峰电价差、电池往返效率和衰减成本。
      </p>
      <p>
        商用 BESS 选型需要在多个因素间平衡：设施的峰值需求曲线、可用激励措施、电池衰减率和供电公司电价结构。过度选型浪费未使用容量的资本。选型不足无法充分捕获需求费用减少潜力。我们的 BESS ROI 计算器帮助您为特定财务状况找到最优系统规模。
      </p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary mb-6">可用计算器</h2>
    <CategoryToolGrid tools={tools} />
  </section>

  {learnArticles.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">BESS 与商用指南</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learnArticles.map((article) => (
          <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
            <span class="text-label-uppercase text-muted text-[10px] block mb-2">学习中心</span>
            <h3 class="text-title-sm text-primary">{article.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <FAQSection items={faqItems} />

  {relatedCategories.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">相关分类</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {relatedCategories.map((cat) => (
          <a href={cat.href} class="bg-surface-card border border-hairline p-6 hover:border-primary transition-colors block">
            <h3 class="text-title-md text-primary mb-2">{cat.title}</h3>
            <p class="text-body-sm text-muted">{cat.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-surface-soft border border-hairline p-6 text-caption text-muted mb-8">
    <span class="text-primary font-bold text-[10px] tracking-wider uppercase border border-hairline px-1.5 py-0.5 mr-2 inline-block mb-3">
      工程免责声明
    </span>
    所有计算器仅提供财务估算。实际 ROI 取决于供电公司电价结构、衰减率和市场状况。咨询财务顾问进行投资决策。
  </section>
</Layout>