---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import InputField from '../../components/InputField.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const applicationOptions = [
  { label: "固定式ESS", value: "Stationary ESS" },
  { label: "船用ESS", value: "Marine ESS" },
  { label: "电动汽车（EV）", value: "EV" },
  { label: "工业电池组", value: "Industrial" },
  { label: "UPS / 备用电源", value: "UPS" },
  { label: "梯次利用储能", value: "Second-life" },
  { label: "其他应用", value: "Other" }
];

const chemistryOptions = [
  { label: "LFP（磷酸铁锂 / LiFePO4）", value: "LFP / LiFePO4" },
  { label: "NMC（镍锰钴）", value: "NMC" },
  { label: "NCA（镍钴铝）", value: "NCA" },
  { label: "LTO（钛酸锂）", value: "LTO" },
  { label: "铅酸（深循环）", value: "Lead-acid" },
  { label: "钠离子", value: "Sodium-ion" },
  { label: "其他化学类型", value: "Other" }
];

const carbonUnitOptions = [
  { label: "kg CO2e / kWh", value: "kg CO2e/kWh" },
  { label: "kg CO2e 总量", value: "kg CO2e total" },
  { label: "未知 / 未声明", value: "Unknown" }
];

const secondLifeOptions = [
  { label: "高度适用（SOH >= 80%，低循环次数）", value: "High" },
  { label: "中等适用（SOH 70-79%，中等应力）", value: "Medium" },
  { label: "低适用（SOH < 70%或有安全事件记录）", value: "Low" },
  { label: "未知 / 未测试", value: "Unknown" }
];

const faqItems = [
  {
    question: "什么是电池护照？",
    answer: "电池护照是一种结构化数字记录，存储和共享电池生命周期的关键信息。它追踪制造来源、材料组成、碳足迹、性能历史、健康状态（SOH）和回收说明等详情，以促进安全、透明和循环经济再利用。"
  },
  {
    question: "谁需要电池护照？",
    answer: "根据欧盟电池法规等法规，工业电池（2kWh以上）、电动汽车（EV）电池和大型轻型运输工具（LMT）电池必须具备电池护照。目标用户包括制造商、OEM、电池实验室、ESS开发商和回收团队。"
  },
  {
    question: "这是经认证的欧盟电池护照吗？",
    answer: "不是。本工具生成用于工程和规划目的的电池护照就绪报告。它不是法律合规认证。官方合规需要独立验证、特定数据架构（如去中心化注册表）、安全数字标识符和经审计的碳足迹模型。"
  },
  {
    question: "我可以将此报告用作官方电池护照吗？",
    answer: "不可以。本报告是用于工程和规划的就绪性和数据缺口评估。官方电池护照可能需要经验证的数据、批准的数据模型、数字标识符、QR基础设施、供应商声明、碳足迹方法论、经认证的记录和监管审查。"
  },
  {
    question: "电池护照需要哪些电池数据？",
    answer: "所需数据分为五大类：1）电池身份（序列号、化学类型、制造商），2）性能与耐久性（SOH、往返效率、循环次数），3）生命周期与运行数据（温度、安全事件），4）可持续性（碳足迹、原材料、再生材料含量），5）文档（合格声明、安全手册）。"
  },
  {
    question: "电池护照包含SOH数据吗？",
    answer: "是的。健康状态（SOH）是关键的运行参数。必须在电池使用寿命期间定期更新，以告知运营商、梯次利用评估者和回收商系统的剩余能力和容量衰减。"
  },
  {
    question: "什么是电池护照就绪度？",
    answer: "电池就绪度衡量制造商或运营商数据相对于法规要求的完整性和准确性。高就绪度分数表示所有身份、性能、碳足迹和安全文件已汇编并准备提交正式注册。"
  },
  {
    question: "此工具能创建QR码吗？",
    answer: "此工具在预览卡和打印报告中生成可视QR码占位符。它不生成或托管实时持久数据库URL。在生产系统中，QR码链接到安全数字产品护照注册页面。"
  },
  {
    question: "我可以将此用于船用ESS电池吗？",
    answer: "可以。船用储能系统（ESS）团队可使用此工具汇编基线数据、追踪运行事件、评估SOH并验证其文档是否符合标准工业电池法规。"
  },
  {
    question: "完整电池护照缺少什么？",
    answer: "生产就绪的护照需要：安全分布式账本集成（或授权API注册表）、经验证的生命周期碳足迹声明（ISO 14067/14044）、官方供应链监管审计，以及实时BMS连接以推送遥测数据。"
  },
  {
    question: "欧盟电池护照要求何时生效？",
    answer: "欧盟电池护照要求计划于2027年2月生效。在欧盟市场投放的工业和EV电池必须在此截止日期前携带链接到其数字护照注册条目的可见QR码。"
  },
  {
    question: "电池护照费用多少？",
    answer: "费用因实施范围而异。对于内部就绪评估，此类免费工具有助于构建数据结构。正式合规通常涉及软件平台、审计和注册费。规划完整电池护照计划时，请预算数据管理基础设施、第三方验证和持续维护费用。"
  },
  {
    question: "没有付费供应商可以准备电池护照数据吗？",
    answer: "可以，您可以使用电子表格或免费工具开始组织现有数据。但正式合规需要安全数字标识符、经验证的碳足迹计算和注册集成。大多数组织使用专业平台进行最终实施，但早期数据准备可独立完成。"
  },
  {
    question: "电池护照与电池数据表有什么区别？",
    answer: "电池数据表提供制造商的静态技术规格。电池护照是动态数字记录，追踪电池整个生命周期，包括实时性能数据、维护历史、碳足迹和回收说明。护照随时间更新，而数据表保持固定。"
  },
  {
    question: "电池护照需要碳足迹数据吗？",
    answer: "是的，碳足迹数据是欧盟电池法规等法规的核心要求。需要使用ISO 14067或PEF指南等公认方法论声明产品碳足迹（PCF）。这包括从原材料开采到制造、使用和报废处理的全生命周期排放。"
  }
];

const relatedTools = [
  { href: "/zh/tools/battery-degradation-estimator/", title: "退化评估器", description: "计算容量衰减和随时间的SOH。" },
  { href: "/zh/tools/runtime-calculator/", title: "续航计算器", description: "根据容量、负载和效率估算续航。" },
  { href: "/zh/tools/battery-sizing-calculator/", title: "电池尺寸计算器", description: "根据电气负载曲线设计储能组尺寸。" },
  { href: "/zh/tools/soc-estimator/", title: "SOC估算器", description: "根据电压或电流积分估算荷电状态。" }
];

const breadcrumbs = [
  { label: '工具', href: '/zh/tools/' },
  { label: '电池护照生成器' }
];
---

<Layout
  lang="zh"
  title="电池护照生成器 | 数字电池护照就绪工具"
  description="创建包含生命周期数据、SOH、性能、耐久性、可追溯性、碳足迹和合规清单字段的电池护照就绪报告。"
  schema="webApplication"
  schemaName="电池护照生成器"
  schemaDescription="结构化电池护照就绪评估和工程报告生成器。"
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <div class="mb-8 print:hidden">
    <Breadcrumb items={breadcrumbs} />
    <span class="text-label-uppercase text-m-blue-light text-[11px] block mt-4 mb-2">工程规划工具</span>
    <h1 class="text-display-md text-primary leading-tight mb-3">电池护照生成器</h1>
    <p class="text-body-md text-body font-light max-w-4xl">
      使用电池身份、SOH、性能、耐久性、可追溯性、碳足迹和文档数据创建结构化电池生命周期和合规就绪报告。
    </p>
  </div>

  <!-- Hero Highlight / Mockup Area -->
  <section id="hero-section" class="bg-surface-card border border-hairline p-6 md:p-8 mb-12 print:hidden relative overflow-hidden">
    <div class="absolute -right-24 -top-24 w-72 h-72 rounded-full bg-m-blue-dark/15 blur-[80px] pointer-events-none"></div>
    <div class="absolute -left-24 -bottom-24 w-72 h-72 rounded-full bg-m-red/10 blur-[80px] pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8 items-center relative z-10">
      <div>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-3">合规与生命周期规划</h2>
        <p class="text-body-sm text-body leading-relaxed mb-6">
          即将生效的欧盟电池法规和全球矿产可追溯性倡议等法规要求工业电池系统记录核心技术、安全和碳参数。使用此工程规划工具自评数据集、衡量合规就绪水平并导出格式化的生命周期就绪报告。
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#generator-tool" class="btn-primary text-xs h-11 inline-flex items-center">
            开始电池护照报告
          </a>
          <a href="#data-fields" class="btn-primary-outline text-xs h-11 inline-flex items-center">
            查看所需数据字段
          </a>
        </div>
      </div>

      <!-- Simulated Preview Card -->
      <div class="bg-canvas border border-hairline p-6 relative rounded-none flex flex-col justify-between h-full min-h-[200px]">
        <div class="absolute top-0 left-0 w-full h-[4px] bg-gradient-to-r from-m-blue-light via-m-blue-dark to-m-red"></div>
        <div>
          <div class="flex justify-between items-start mb-4">
            <div>
              <span class="text-[9px] text-muted tracking-wider uppercase block">护照初始预览</span>
              <span class="text-sm font-mono text-primary font-bold">BP-2026-X9B2</span>
            </div>
            <span class="text-[9px] font-bold border border-m-blue-light text-m-blue-light px-2 py-0.5 uppercase tracking-wider">待审核</span>
          </div>

          <div class="grid grid-cols-2 gap-y-3 gap-x-2 border-t border-hairline pt-3 mb-4 text-xs font-light text-body">
            <div>
              <span class="text-[10px] text-muted block">电池型号：</span>
              <span class="text-primary font-medium">LiFePO4船用ESS</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">化学类型：</span>
              <span class="text-primary font-medium">LFP / LiFePO4</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">标称电压：</span>
              <span class="text-primary font-medium">51.2 V</span>
            </div>
            <div>
              <span class="text-[10px] text-muted block">标称容量：</span>
              <span class="text-primary font-medium">200 Ah</span>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-end border-t border-hairline pt-3">
          <div>
            <span class="text-[10px] text-muted block">数据完整度：</span>
            <div class="flex items-center gap-2">
              <div class="w-24 h-2 bg-surface-card rounded-none overflow-hidden">
                <div class="bg-m-blue-light h-full" style="width: 82%"></div>
              </div>
              <span class="text-xs font-mono text-primary font-bold">82%</span>
            </div>
          </div>
          <div class="w-10 h-10 border border-hairline flex items-center justify-center p-0.5 bg-white shrink-0">
            <div class="w-full h-full bg-canvas grid grid-cols-3 gap-0.5 p-0.5">
              <div class="bg-primary"></div><div class="bg-primary"></div><div class="bg-canvas"></div>
              <div class="bg-primary"></div><div class="bg-canvas"></div><div class="bg-primary"></div>
              <div class="bg-canvas"></div><div class="bg-primary"></div><div class="bg-primary"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Generator Section -->
  <section id="generator-tool" class="mb-16 scroll-mt-6">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8">
      
      <!-- Input Form Column -->
      <div id="form-column" class="flex flex-col gap-6 print:hidden">
        
        <!-- SECTION A: Battery Identity -->
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-blue-light text-m-blue-light flex items-center justify-center font-mono text-xs font-bold">A</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">电池身份</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="identity-name" label="电池组/系统名称" type="text" value="" placeholder="例如：Navis Marine LFP-10" />
            <InputField id="identity-manufacturer" label="制造商 / 组织" type="text" value="" placeholder="例如：Apex Power Systems" />
            <InputField id="identity-application" label="应用场景" type="select" options={applicationOptions} value="Stationary ESS" />
            <InputField id="identity-category" label="电池类别" type="text" value="" placeholder="例如：工业/ESS电池组" />
            <InputField id="identity-chemistry" label="电芯化学类型" type="select" options={chemistryOptions} value="LFP / LiFePO4" />
            <InputField id="identity-nominal-voltage" label="标称电压 (V)" type="number" value="" placeholder="例如：51.2" min={0.1} step="any" />
            <InputField id="identity-nominal-capacity" label="标称容量 (Ah)" type="number" value="" placeholder="例如：200" min={0.1} step="any" />
            <div class="flex flex-col gap-2 w-full">
              <label for="identity-energy-capacity" class="text-label-uppercase text-xs text-primary flex justify-between">
                <span>能量容量 (kWh)</span>
                <span id="auto-calc-indicator" class="text-[9px] text-m-blue-light lowercase tracking-normal hidden">自动计算</span>
              </label>
              <div class="relative flex items-center">
                <input id="identity-energy-capacity" type="number" class="text-input w-full" placeholder="例如：10.24" min={0.01} step="any" />
                <span class="absolute right-3 text-caption text-muted">kWh</span>
              </div>
              <p class="text-caption text-muted">留空则自动根据电压 × 安时计算。</p>
            </div>
            <InputField id="identity-manufacturing-date" label="制造日期" type="text" value="" placeholder="YYYY-MM-DD" />
            <InputField id="identity-country" label="制造国家" type="text" value="" placeholder="例如：德国" />
            <InputField id="identity-serial-number" label="序列号 / 电池组ID" type="text" value="" placeholder="例如：SN-LFP4-883719" />
          </div>
        </CalculatorCard>

        <!-- SECTION B: Performance and Durability -->
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-blue-dark text-m-blue-dark flex items-center justify-center font-mono text-xs font-bold">B</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">性能与耐久性</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="perf-rated-cycles" label="额定循环寿命（次）" type="number" value="" placeholder="例如：6000" min={1} />
            <InputField id="perf-current-cycles" label="当前循环次数" type="number" value="" placeholder="例如：120" min={0} />
            <InputField id="perf-soh" label="健康状态 (SOH %)" type="number" value="" placeholder="例如：98" min={0} max={120} />
            <InputField id="perf-efficiency" label="往返效率 (%)" type="number" value="" placeholder="例如：95" min={0} max={100} />
            <InputField id="perf-temp-min" label="最低工作温度 (°C)" type="number" value="" placeholder="例如：-10" step="any" />
            <InputField id="perf-temp-max" label="最高工作温度 (°C)" type="number" value="" placeholder="例如：45" step="any" />
            <InputField id="perf-dod" label="推荐放电深度 (%)" type="number" value="" placeholder="例如：80" min={0} max={100} />
            <InputField id="perf-warranty" label="保修期（年）" type="number" value="" placeholder="例如：10" min={0} />
            <InputField id="perf-service-life" label="预期服务寿命（年）" type="number" value="" placeholder="例如：15" min={0} />
          </div>
        </CalculatorCard>

        <!-- SECTION C: Lifecycle and Operational Data -->
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-m-red text-m-red flex items-center justify-center font-mono text-xs font-bold">C</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">生命周期与运行数据</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="life-commissioning-date" label="投运日期" type="text" value="" placeholder="YYYY-MM-DD" />
            <InputField id="life-profile" label="运行工况" type="text" value="" placeholder="例如：太阳能削峰" />
            <InputField id="life-average-c-rate" label="平均C倍率" type="number" value="" placeholder="例如：0.5" min={0} step="any" />
            <InputField id="life-max-discharge" label="最大放电电流 (A)" type="number" value="" placeholder="例如：200" min={0} step="any" />
            <InputField id="life-max-charge" label="最大充电电流 (A)" type="number" value="" placeholder="例如：100" min={0} step="any" />
            <InputField id="life-average-temp" label="平均工作温度 (°C)" type="number" value="" placeholder="例如：23" step="any" />
            <InputField id="life-thermal-events" label="已记录热事件" type="number" value="" placeholder="例如：0" min={0} />
            <InputField id="life-safety-incidents" label="已记录安全事故" type="number" value="" placeholder="例如：0" min={0} />
            <InputField id="life-maintenance-status" label="维护状态" type="text" value="" placeholder="例如：正常" />
          </div>
        </CalculatorCard>

        <!-- SECTION D: Sustainability and Traceability -->
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-hairline text-muted flex items-center justify-center font-mono text-xs font-bold">D</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">可持续性与可追溯性</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <InputField id="sust-carbon-value" label="碳足迹数值" type="number" value="" placeholder="例如：68" min={0} step="any" />
            <InputField id="sust-carbon-unit" label="碳足迹单位" type="select" options={carbonUnitOptions} value="kg CO2e/kWh" />
            <InputField id="sust-carbon-method" label="LCA方法论标准" type="text" value="" placeholder="例如：ISO 14067" />
            
            <InputField id="sust-recycled" label="已声明再生材料含量？" type="select" options={[{label: "未声明", value: ""}, {label: "是", value: "yes"}, {label: "否", value: "no"}]} value="" />
            <InputField id="sust-critical-materials" label="已声明关键材料？" type="select" options={[{label: "未声明", value: ""}, {label: "是", value: "yes"}, {label: "否", value: "no"}]} value="" />
            <InputField id="sust-traceability" label="供应商可追溯性可用？" type="select" options={[{label: "未声明", value: ""}, {label: "是", value: "yes"}, {label: "否", value: "no"}]} value="" />
            <InputField id="sust-recycling-instructions" label="已声明回收说明？" type="select" options={[{label: "未声明", value: ""}, {label: "是", value: "yes"}, {label: "否", value: "no"}]} value="" />
            
            <InputField id="sust-second-life" label="梯次利用适用性评估" type="select" options={secondLifeOptions} value="Unknown" />
          </div>
        </CalculatorCard>

        <!-- SECTION E: Documentation Checklist -->
        <CalculatorCard>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-6 border border-hairline text-muted flex items-center justify-center font-mono text-xs font-bold">E</span>
            <h3 class="text-title-lg text-primary uppercase tracking-wider">文档清单</h3>
          </div>
          <p class="text-caption text-muted mb-4">勾选为此电池系统汇编的所有文档文件：</p>
          <div class="flex flex-col gap-3">
            {[
              { id: "doc-datasheet", label: "技术数据表已汇编" },
