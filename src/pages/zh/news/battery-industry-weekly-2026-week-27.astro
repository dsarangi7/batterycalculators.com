---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周刊 — 第27周, 2026 | Battery Calculators";
const description = "本周电池动态：IEA报告显示2025年电动汽车电池部署量达1.2 TWh，福特在美国开始生产LFP电芯，CATL推进固态电池量产，欧盟电池护照截止日期日益临近。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-27";
const publishDate = "2026-07-03";
const lastUpdated = "2026-07-03";
const readingTime = 12;

const faqItems = [
  {
    "question": "本周最大的电池新闻是什么？",
    "answer": "IEA《全球电动汽车展望2026》报告显示，2025年电动汽车电池部署量达到1.2 TWh，较2024年增长30%。这证实电池产业已进入太瓦时时代。"
  },
  {
    "question": "福特在美国生产LFP电池有何重要意义？",
    "answer": "福特是首家在美国本土生产LFP电芯的大型汽车制造商。LFP化学体系成本更低，且不含钴和镍，是实现电动汽车平价的关键。这些电芯将为福特售价3万美元的中型电动皮卡提供动力。"
  },
  {
    "question": "CATL在固态电池方面进展如何？",
    "answer": "CATL已开始试产能量密度达500 Wh/kg的半固态电池，并计划在2027年前实现小批量全固态电池生产。该公司近期获得了一项涵盖硫化物电解质设计的关键专利，用于下一代电芯。"
  },
  {
    "question": "什么是欧盟电池护照？何时必须执行？",
    "answer": "欧盟电池护照是一种数字记录，包含电池的碳足迹、回收含量、材料来源和性能数据。所有在欧盟销售的超过2 kWh的电动汽车和工业电池必须在2027年2月前拥有电池护照。"
  },
  {
    "question": "BESS市场发展如何？",
    "answer": "电网级电池储能正在快速扩张。南澳大利亚FERM招标尽管采用技术中立模式，最终全部由电池方案中标。澳大利亚、印度和美国多个GWh级项目正在推进中。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '第27周, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 第27周, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第27周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>6月27日 – 7月3日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        表面看似平静的一周，但行业底层正在悄然转变。IEA确认电池已跨越太瓦时门槛。福特开始在美国本土生产LFP电芯。而欧盟电池护照截止日期已不足八个月。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">电动汽车电池部署量突破1.2 TWh — IEA</h2>
      <p class="text-body-md text-body font-light mb-4">
        国际能源署（IEA）本周发布了《全球电动汽车展望2026》，核心数据令人震惊：2025年电动汽车电池部署量达到1.2太瓦时。较2024年增长30%，是2020年水平的七倍以上。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        轻型车辆仍占主导地位，占部署量的85%以上。但增长最快的是电动卡车领域，电池需求翻倍以上——主要由中国驱动，2025年中国每售出四辆卡车就有一辆是电动的。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        从区域来看，中国占全球电动汽车电池部署量的60%。欧盟约占15%，而美国停滞在10%。中国以外的新兴市场占6%，表明电动化进程不再局限于少数大型经济体。
      </p>
      <p class="text-body-md text-body font-light">
        纯电动汽车的平均电池容量保持稳定——欧盟接近70 kWh，中国低于60 kWh。这说明增长来自更多车辆，而非更大的电池。这一趋势有利于LFP等在适中能量密度下实现更低单位成本的化学体系。
      </p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">制造</span>
      <h2 class="text-title-xl text-primary mb-4">福特在美国开始生产LFP电池电芯</h2>
      <p class="text-body-md text-body font-light mb-4">
        福特已在其位于密歇根州马歇尔的工厂开始生产磷酸铁锂（LFP）电池电芯——使其成为首家在美国本土制造LFP电芯的大型汽车制造商。这些电芯将为福特即将推出的售价3万美元的中型电动皮卡提供动力。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        LFP化学体系对大众市场电动汽车具有多项优势。不含钴和镍，降低了成本和供应链风险。同时提供出色的循环寿命和热稳定性，使其在大规模消费应用中更加安全。与NMC或NCA化学体系相比，能量密度较低是其缺点，但对于面向主流买家的中型皮卡，成本优势超过了续航里程的损失。
      </p>
      <p class="text-body-md text-body font-light">
        福特的举措标志着美国电池制造业的更广泛转变。此前，国内LFP生产一直由中国企业主导。福特的投资部分得益于美国《通胀削减法案》对国内电池生产的激励。如果成功，这可能加速LFP在美国整个汽车行业的普及。
      </p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">CATL推进固态电池试产</h2>
      <p class="text-body-md text-body font-light mb-4">
        CATL持续推进其固态电池项目从实验室走向工厂。该公司已开始试产能量密度达500 Wh/kg的半固态电芯——约为当前商用锂离子电池密度的两倍。WIPO今年3月公布的一项新专利揭示了CATL的技术路线：采用含氟锂盐稳定电解质界面的固态硫化物电解质配合多层正极设计。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        时间表雄心勃勃但具体明确。CATL正从20 Ah样品向60 Ah车规级原型推进。公司计划在2027年达到技术成熟度7级或8级，这意味着从实验室原型向量产级电芯的过渡。全固态电池小批量生产计划于2027年启动，规模化量产目标定在2030年左右。
      </p>
      <p class="text-body-md text-body font-light">
        CATL还锁定了重要的材料承诺：与广东嘉元科技签订2026–2028年62.6万吨铜箔的采购协议，价值约84亿欧元。铜箔是固态电芯设计中关键的负极集流体，如此大规模的订单表明CATL正在为远超实验室规模的产量做准备。
      </p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">特斯拉4680电池生产达到拐点</h2>
      <p class="text-body-md text-body font-light mb-4">
        埃隆·马斯克本周在X上发帖称，特斯拉内部4680电池电芯的生产"正在变好"。这句简短的话背后含义重大：特斯拉花了数年时间努力扩大其干法电极制造工艺的规模，该工艺有望比传统湿法电极降低30%的成本。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        特斯拉目前已生产超过1亿颗4680电芯。德克萨斯超级工厂年产能已超过6 GWh——足以每周生产超过1,000辆Cybertruck。该公司还在内华达超级工厂建设了约10 GWh产能的正极设施，并开始在Giga Nevada的LFP工厂进行早期生产，目标产能为7 GWh。位于德克萨斯州罗布敦的锂精炼厂——北美首家——已投入运营，目标年产能为30 GWh。
      </p>
      <p class="text-body-md text-body font-light">
        干法电极突破是关键推动力。传统电极制造使用溶剂，需要在大型烘箱中蒸发，消耗大量能源。特斯拉的干法工艺完全消除了这一步骤，同时降低了成本和环境足迹。如果该工艺真正成熟，可能重塑全球圆柱形电芯生产的经济性。
      </p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">法规</span>
      <h2 class="text-title-xl text-primary mb-4">欧盟电池护照截止日期：倒计时不足八个月</h2>
      <p class="text-body-md text-body font-light mb-4">
        欧盟电池法规的数字电池护照要求将于2027年2月生效——现在距离截止日期不足八个月。所有在欧盟市场投放的超过2 kWh的电动汽车电池和工业电池必须携带可通过二维码访问的数字护照，包含碳足迹、回收含量、材料来源和性能特征等数据。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        欧盟委员会今年发布了2026年5月的实施更新，明确了数据访问规则以及制造商、OEM和进口商的责任。委员会还发布了计算废旧电池回收效率和材料回收率的新规则，这些数据将用于电池护照的回收含量验证。
      </p>
      <p class="text-body-md text-body font-light">
        行业准备情况参差不齐。大型制造商已深入合规计划，但许多小型供应商仍在构建填充护照字段所需的数据基础设施。该法规要求每块电池约100个数据属性，第三方验证流程可能需要6-12个月。起步较晚的企业可能难以在截止日期前完成。
      </p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电网级BESS</span>
      <h2 class="text-title-xl text-primary mb-4">澳大利亚主导电网级电池项目管线</h2>
      <p class="text-body-md text-body font-light mb-4">
        澳大利亚持续作为公用事业级电池储能的全球试验场。仅本周就有三个主要项目通过开发管线推进。
      </p>
      <p class="text-body-md text-body font-light mb-4">
        BLT Energy获得西澳大利亚Red Gully BESS的开发许可——该项目规模为800 MW / 4,800 MWh，将成为全球最大的电池安装项目之一。Eku Energy根据澳大利亚《环境保护与生物多样性保护法》提交了两个300 MW / 1,200 MWh项目的环境评估。Neoen Australia与能源零售商签署了虚拟电池协议，覆盖其昆士兰Western Downs Battery项目第2和第3阶段共计2.3 GWh的容量。
      </p>
      <p class="text-body-md text-body font-light">
        另外，南澳大利亚的FERM招标——采用技术中立模式——最终全部由电池方案中标。ASL Energy在接受Energy Storage News采访时解释，电池在成本和可调度性方面均胜过其他技术。这强烈表明，在有利市场中，电池储能已成为新增容量的默认选择。
      </p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">安全</span>
      <h2 class="text-title-xl text-primary mb-4">电池认证标准在热失控事故后受到审查</h2>
      <p class="text-body-md text-body font-light mb-4">
        Battery Technology Online本周发布的一篇报告质疑当前电池认证标准是否足以防止现实中的热失控事故。文章认为，现有测试协议侧重于电芯级别的滥用条件——过充、挤压、针刺——但未能充分反映安装在车辆或建筑中的大型电池组所发生的级联故障模式。
      </p>
      <p class="text-body-md text-body font-light">
        这一担忧恰逢其时。随着电池系统从消费电子的数十颗电芯扩展到电动汽车的数千颗电芯以及电网级安装的数百万颗电芯，热失控事件的概率和后果都在增加。新的测试方法——包括模组级和系统级热传播测试——正在被标准机构采用，但尚未被普遍强制要求。
      </p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中出现了三个值得持续关注的主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">太瓦时时代已经到来。</strong> IEA确认2025年电动汽车电池部署量跨越1.2 TWh，这改变了所有领域的叙事——原材料需求、回收基础设施、电网影响。电池产业已不再是小众市场。
          </li>
          <li>
            <strong class="text-primary">LFP正在赢得平价竞赛。</strong> 福特在美国生产LFP电芯，加上IEA数据显示电池容量适中，表明市场越来越倾向于成本和安全性，而非最大能量密度。
          </li>
          <li>
            <strong class="text-primary">固态电池已成现实但尚不迫近。</strong> CATL的试产和专利活动证实技术正在进步，但2027–2030年的量产时间表意味着锂离子电池将在至少未来半个世纪内继续占据主导地位。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>BYD在巴西持续扩大电池产能及其对拉丁美洲电动汽车供应链的影响</li>
          <li>特斯拉干法电极制造成熟度的更多细节及潜在向其他电芯制造商授权</li>
          <li>欧盟委员会关于电池护照数据共享的指导方针</li>
          <li>澳大利亚大型BESS项目的融资公告</li>
          <li>CATL从20 Ah到60 Ah固态原型的进展</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li>IEA Global EV Outlook 2026 — <a href="https://www.iea.org/reports/global-ev-outlook-2026/electric-vehicle-batteries" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Electric Vehicle Batteries</a></li>
        <li>Electrek — <a href="https://electrek.co/2026/06/17/ford-begins-building-low-cost-lfp-batteries-for-30k-ev-pickup" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Ford Begins Building LFP Batteries in the US</a></li>
        <li>Electrive — <a href="https://www.electrive.com/2026/03/13/catl-makes-progress-on-its-solid-state-battery" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">CATL Makes Progress on Solid-State Battery</a></li>
        <li>Battery Technology Online — <a href="https://www.batterytechonline.com/market-analysis/byd-closing-in-on-top-spots-in-battery-ev-production-vs-catl-tesla" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Battery Certification Standards and Thermal Runaway</a></li>
        <li>Energy Storage News — <a href="https://www.energy-storage.news/inside-south-australias-ferm-tender-why-a-technology-neutral-process-produced-an-all-battery-outcome/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">South Australia FERM Tender</a></li>
        <li>European Commission — <a href="https://environment.ec.europa.eu/topics/waste-and-recycling/batteries_en" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EU Battery Regulation</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可获取的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过原始来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
