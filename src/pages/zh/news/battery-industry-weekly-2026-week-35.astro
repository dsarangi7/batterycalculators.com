---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周刊 — 2026年第35周 | 电池计算器";
const description = "本周电池资讯：氢能源动态：非洲首个光伏驱动氢能源枢纽投入运营，美国Lyten公司在收购Northvolt后将目光投向挪威Morrow Batteries，Invinity确认瑞士2.1GWh里程碑式液流电池EPC合同授标。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-35";
const publishDate = "2026-08-28";
const lastUpdated = "2026-08-28";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周刊？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对类似新闻进行去重，按相关性评分，并选出当周的头条新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新刊于每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第35周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 2026年第35周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第35周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>8月24日 – 8月30日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：氢能源动态：非洲首个光伏驱动氢能源枢纽投入运营，美国Lyten公司在收购Northvolt后将目光投向挪威Morrow Batteries，Invinity确认瑞士2.1GWh里程碑式液流电池EPC合同授标。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">氢能源动态：非洲首个光伏驱动氢能源枢纽投入运营</h2>
      <p class="text-body-md text-body font-light mb-4">Cbm-Tech在沃尔维斯湾（Walvis Bay）启动了一座绿色氢能源枢纽，整合了5 MW光伏、5 MW PEM电解槽和5.9 MWh电池储能。</p>
      <p class="text-body-md text-body font-light">原文：The Hydrogen Stream: Africa's first PV-driven hydrogen hub powers up</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">美国Lyten公司在收购Northvolt后将目光投向挪威Morrow Batteries</h2>
      <p class="text-body-md text-body font-light mb-4">美国锂硫电池公司Lyten正瞄准收购欧洲另一家失败的本土电池初创企业——挪威Morrow Batteries，该公司于今年早些时候进入破产程序。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Invinity确认瑞士2.1GWh里程碑式液流电池EPC合同授标</h2>
      <p class="text-body-md text-body font-light mb-4">Invinity Energy Systems已为其位于瑞士Laufenberg的吉瓦时级钒氧化还原液流电池（VRFB）储能项目聘请了EPC合作伙伴。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Quinbrook携手GE Vernova和CATL打造澳大利亚最大储能系统第三期</h2>
      <p class="text-body-md text-body font-light mb-4">GE Vernova和CATL被选为昆士兰州Supernode第三期1,216MWh项目的供应商，该项目将扩展澳大利亚最大的电池储能系统。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">印度BESS供应链面临"政策意图与运营能力"缺口，电池电芯自主供应需十年以上</h2>
      <p class="text-body-md text-body font-light mb-4">Wood Mackenzie表示，印度电池储能行业在电芯供应方面至少十年内将远未实现自给自足。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">澳大利亚Allegro Energy与Jena Flow Batteries合作扩大微乳液液流电池制造</h2>
      <p class="text-body-md text-body font-light mb-4">Allegro Energy已与Jena Flow Batteries及其母公司宿迁时代储能科技达成战略合作。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">应对电芯不均衡、通信互操作性及其他BESS资产成功障碍</h2>
      <p class="text-body-md text-body font-light mb-4">Ryan Franks指出，协调电池储能组件、集装箱、系统和组合是成功运营的关键。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">制造</span>
      <h2 class="text-title-xl text-primary mb-4">LG Energy Solution在密歇根工厂启动LFP和NMC BESS及EV电芯生产</h2>
      <p class="text-body-md text-body font-light mb-4">两家韩国总部企业LG Energy Solution和DeltaX正在美国建立电池电芯工厂。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">APA将为Evolution Mining的Ernest Henry运营建造104MWh电池储能系统</h2>
      <p class="text-body-md text-body font-light mb-4">APA Group已做出最终投资决定，将在澳大利亚建设、拥有和运营104MWh Sybella Creek光储一体化项目。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">HPQ和Novacium向三家欧洲无人机制造商交付定制电池组进行最终阶段评估</h2>
      <p class="text-body-md text-body font-light mb-4">HPQ和Novacium已向三家欧洲无人机制造商交付定制配置的电池组，用于最终阶段评估。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得追踪的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化已成新常态。</strong> 电池部署在各细分领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施，而非小众市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极化学体系均在同步推进，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策迫使企业重新思考采购、文档和合规时间线。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间线的持续更新</li>
          <li>欧盟委员会关于EU电池法规实施指南</li>
          <li>新电网级BESS项目投运和容量里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.pv-magazine.com/2026/08/28/the-hydrogen-stream-africas-first-full-stack-pv-driven-hydrogen-hub-powers-up-in-namibia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">氢能源动态：非洲首个光伏驱动氢能源枢纽投入运营 — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/us-firm-lyten-sets-sights-on-norways-morrow-batteries-following-northvolt-acquisition/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">美国Lyten公司在收购Northvolt后将目光投向挪威Morrow Batteries — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/invinity-confirms-epc-contract-award-for-2-1gwh-landmark-flow-battery-in-switzerland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Invinity确认瑞士2.1GWh里程碑式液流电池EPC合同授标 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/quinbrook-taps-ge-vernova-and-catl-for-the-third-stage-of-australias-largest-battery-storage-system/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Quinbrook携手GE Vernova和CATL打造澳大利亚最大储能系统第三期 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/indias-bess-supply-chain-suffers-a-policy-intent-and-operational-capacity-gap-with-battery-cell-self-sufficiency-a-decade-or-more-away/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">印度BESS供应链面临"政策意图与运营能力"缺口 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/australias-allegro-energy-partners-with-jena-batteries-to-scale-microemulsion-flow-battery-manufacturing/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">澳大利亚Allegro Energy与Jena Flow Batteries合作扩大微乳液液流电池制造 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/handling-cell-imbalances-communications-interoperability-and-other-blockers-to-bess-asset-success/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">应对电芯不均衡、通信互操作性及其他BESS资产成功障碍 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/lg-energy-solution-begins-lfp-and-nmc-bess-and-ev-cell-production-at-michigan-factory/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">LG Energy Solution在密歇根工厂启动LFP和NMC BESS及EV电芯生产 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/apa-to-build-104mwh-battery-storage-system-for-evolution-minings-ernest-henry-operations-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">APA将为Evolution Mining的Ernest Henry运营建造104MWh电池储能系统 — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">HPQ和Novacium向三家欧洲无人机制造商交付定制电池组进行最终阶段评估 — Google News - Battery Technology</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过主要来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
