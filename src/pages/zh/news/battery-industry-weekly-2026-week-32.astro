---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周报 — 2026年第32周 | Battery Calculators";
const description = "本周电池资讯：氢铁液流电池——Elestor技术详解，Prosalia和EDP在葡萄牙、西班牙将太阳能光伏/风电项目与电池混合化，Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-32";
const publishDate = "2026-08-07";
const lastUpdated = "2026-08-07";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周报？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出当周的热门新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新版本在每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第32周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周报 — 2026年第32周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周报 — 第32周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>8月3日 – 8月9日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：氢铁液流电池——Elestor技术详解，Prosalia和EDP在葡萄牙、西班牙将太阳能光伏/风电项目与电池混合化，Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">氢铁液流电池：Elestor技术详解</h2>
      <p class="text-body-md text-body font-light mb-4">Elestor声称其氢铁液流电池具有75%以上的往返效率、20至25年的使用寿命，以及15欧元/kWh的长时储能资本支出。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Prosalia和EDP在葡萄牙、西班牙将太阳能光伏/风电项目与电池混合化</h2>
      <p class="text-body-md text-body font-light mb-4">IPP Prosalia已在葡萄牙一座太阳能光伏电站投运15MW/60MWh电池储能系统，而电力集团EDP则在西班牙一个混合风能和太阳能项目中增加了电池储能。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统</h2>
      <p class="text-body-md text-body font-light mb-4">液流电池公司Invinity Energy Systems已向公用事业公司Dairyland Power Cooperative出售43MWh电池系统，用于在美国中部长时储能（LDES）项目中部署。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">日本：Tokyo Gas签署200MWh福岛BESS购电协议，Eku Energy首个项目接近完工</h2>
      <p class="text-body-md text-body font-light mb-4">日本公用事业公司Tokyo Gas已签署一项长期购电协议，涉及福岛县一个49.7MW/202.1MWh电池储能项目。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">欧盟委员会批准支持斯洛文尼亚370MWh电池储能的计划</h2>
      <p class="text-body-md text-body font-light mb-4">欧盟委员会（EC）已批准一项财政支持计划，以加速斯洛文尼亚电池储能技术的部署。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">制造</span>
      <h2 class="text-title-xl text-primary mb-4">Samsung SDI美国LFP电芯生产进展顺利，预计需求将超过产能</h2>
      <p class="text-body-md text-body font-light mb-4">Samsung SDI正按计划于今年第三季度在美国开始生产磷酸铁锂（LFP）电池电芯。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Greenvolt在波兰投运200MW/800MWh容量市场签约BESS</h2>
      <p class="text-body-md text-body font-light mb-4">Greenvolt Power已在波兰投运200MW Turośń Kościelna电池储能设施，将由能源交易商Entrix进行优化运营。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">中东欧：英国Alcemi收购2.3GWh罗马尼亚项目，斯洛伐克最大BESS投运</h2>
      <p class="text-body-md text-body font-light mb-4">英国大型项目开发商Alcemi已进入罗马尼亚电池储能市场，而斯洛伐克迄今最大的项目已投入运营。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">欧洲电动汽车需求和美国BESS推动LG Energy Solution第二季度扭亏为盈</h2>
      <p class="text-body-md text-body font-light mb-4">LG Energy Solution今年第二季度实现盈利，其在美国电池储能和欧洲电动汽车电芯生产方面的投资开始回报。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Georgia Power完成Moody空军基地旁198MWh BESS建设</h2>
      <p class="text-body-md text-body font-light mb-4">公用事业公司Georgia Power已完成位于美国佐治亚州Valdosta郊外的49.5MW/198MWh Moody电池储能设施建设。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得关注的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化成为新常态。</strong> 电池部署在各个领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施而非利基市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极等化学体系同步发展，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策正迫使企业重新思考采购、文档和合规时间表。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间表的最新进展</li>
          <li>欧盟委员会发布的电池法规实施指南</li>
          <li>新型电网级BESS项目投产和产能里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/elestor-hydrogen-iron-flow-battery/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">氢铁液流电池：Elestor技术详解 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/prosalia-and-edp-hybridise-solar-pv-wind-projects-with-batteries-in-portugal-spain/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Prosalia和EDP在葡萄牙、西班牙将太阳能光伏/风电项目与电池混合化 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/invinity-sells-43mwh-long-duration-flow-battery-system-to-us-midwest-rural-electric-cooperative/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/japan-tokyo-gas-enters-offtake-for-200mwh-fukushima-bess-eku-energy-nears-completion-of-first-project/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">日本：Tokyo Gas签署200MWh福岛BESS购电协议，Eku Energy首个项目接近完工 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/european-commission-approves-scheme-to-support-370mwh-of-battery-storage-in-slovenia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">欧盟委员会批准支持斯洛文尼亚370MWh电池储能的计划 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/samsung-sdi-on-track-with-us-lfp-cell-production-expects-demand-to-outstrip-production/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Samsung SDI美国LFP电芯生产进展顺利，预计需求将超过产能 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/greenvolt-inaugurates-200mw-800mwh-capacity-market-contracted-bess-in-poland/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Greenvolt在波兰投运200MW/800MWh容量市场签约BESS — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/central-eastern-europe-uks-alcemi-buys-2-3gwh-romania-projects-slovakias-biggest-bess-brought-online/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中东欧：英国Alcemi收购2.3GWh罗马尼亚项目，斯洛伐克最大BESS投运 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/ev-demand-in-europe-bess-in-the-us-drive-lg-energy-solutions-return-to-profit-in-q2/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">欧洲电动汽车需求和美国BESS推动LG Energy Solution第二季度扭亏为盈 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/georgia-power-completes-construction-of-198mwh-bess-next-to-moody-air-force-base/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Georgia Power完成Moody空军基地旁198MWh BESS建设 — Energy Storage News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文汇总了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策之前，请务必通过主要来源核实事实。本文仅供信息参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
