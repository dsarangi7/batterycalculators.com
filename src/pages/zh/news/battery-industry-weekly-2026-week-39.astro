---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const title = "电池行业周刊 — 2026年第39周 | 电池计算器";
const description = "本周电池资讯：Battwoo提供二手电动汽车电池用于太阳能储能，成本降低30%，马来西亚为企业太阳能设定固定电网费用和10年合同，中国科学家开发33.3%效率的钙钛矿-硅叠层太阳能电池，在环境空气中加工。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-39";
const publishDate = "2026-09-22";
const lastUpdated = "2026-09-22";
const readingTime = 24;

const breadcrumbs = [
  { label: '资讯', href: '/zh/news' },
  { label: '2026年第39周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 2026年第39周"
  schemaDescription={description}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第39周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>9月21日 – 9月27日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：Battwoo提供二手电动汽车电池用于太阳能储能，成本降低30%，马来西亚为企业太阳能设定固定电网费用和10年合同，中国科学家开发33.3%效率的钙钛矿-硅叠层太阳能电池，在环境空气中加工。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">Battwoo：二手电动汽车电池用于太阳能储能，成本降低30%</h2>
      <p class="text-body-md text-body font-light mb-4">Battwoo为太阳能储能系统提供二手电动汽车电池，与新电池相比成本降低高达30%，同时促进能源储存领域的循环经济。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">马来西亚为企业太阳能设定固定电网费用和10年合同</h2>
      <p class="text-body-md text-body font-light mb-4">马来西亚政府宣布了一系列措施，加速其企业可再生能源供应计划，包括为可靠电力设定固定电网接入费和强制性10年合同。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">中国科学家开发33.3%效率的钙钛矿-硅叠层太阳能电池，在环境空气中加工</h2>
      <p class="text-body-md text-body font-light mb-4">中国研究人员开发了PNCC聚合物空穴传输层，使得高效稳定的钙钛矿太阳能电池可以在环境条件下制造。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">挪威电动渡轮可能在菲律宾找到大市场</h2>
      <p class="text-body-md text-body font-light mb-4">自2025年11月在马尼拉举行首届挪威-菲律宾电动渡轮会议以来已近一年，电动和混合动力推进渡轮的兴趣似乎在增长。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">沙特阿拉伯波斯湾石油出口在管道袭击后增加</h2>
      <p class="text-body-md text-body font-light mb-4">沙特阿美周日在波斯湾内装载了约1400万桶原油到七艘VLCC上，TankerTrackers.com数据显示，该王国增加了海湾出口终端的装载量。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">油轮穿梭运输保持霍尔木兹海峡石油流动，成本飙升</h2>
      <p class="text-body-md text-body font-light mb-4">一种新的穿梭运输系统正在重塑中东石油市场，生产商寻求在地区冲突升级的情况下保持出口流动。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">Dragonfly Energy与Sphere Energy合作开发人工智能增强的下一代电池技术</h2>
      <p class="text-body-md text-body font-light mb-4">Dragonfly Energy宣布与Sphere Energy合作，利用人工智能开发下一代电池技术，旨在提高能量密度和循环寿命。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">松下能源开设全球电池研发中心</h2>
      <p class="text-body-md text-body font-light mb-4">松下能源开设了新的全球研发中心，专注于电动汽车和储能领域的下一代电池，巩固市场地位。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">研究人员调整传统锂离子电池配方，在大功率放电中提供高容量</h2>
      <p class="text-body-md text-body font-light mb-4">研究人员修改了传统锂离子电池配方，在大功率放电中提供高容量——这正是家用储能和电动汽车电池所需要的。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">Gamma Technologies与Gotion Illinois合作加速下一代电池设计</h2>
      <p class="text-body-md text-body font-light mb-4">Gamma Technologies宣布与Gotion Illinois合作，利用先进仿真技术加速下一代电池设计，优化性能和安全性。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得追踪的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化已成新常态。</strong> 电池部署在各细分领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施，而非小众市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极化学体系均在同步推进，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策迫使企业重新思考采购、文档和合规时间线。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间线的持续更新</li>
          <li>欧盟委员会关于EU电池法规实施指南</li>
          <li>新电网级BESS项目投运和容量里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.pv-magazine.com/2026/09/21/malaysia-sets-fixed-grid-charge-10-year-contracts-for-corporate-solar/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">马来西亚为企业太阳能设定固定电网费用和10年合同 — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/09/21/chinese-scientists-build-33-3-efficient-perovskite-silicon-tandem-solar-cell-processed-in-ambient-air/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国科学家开发33.3%效率的钙钛矿-硅叠层太阳能电池 — PV Magazine</a></li>
        <li><a href="https://cleantechnica.com/2026/09/21/norways-electric-ferries-could-find-a-big-market-in-the-philippines/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">挪威电动渡轮可能在菲律宾找到大市场 — CleanTechnica</a></li>
        <li><a href="https://www.marinelink.com/news/saudi-gulf-oil-exports-pick-pipeline-543132" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">沙特阿拉伯波斯湾石油出口在管道袭击后增加 — MarineLink</a></li>
        <li><a href="https://www.marinelink.com/news/tanker-shuttles-keep-hormuz-oil-moving-543115" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">油轮穿梭运输保持霍尔木兹海峡石油流动 — MarineLink</a></li>
      </ul>
    </section>

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过主要来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
