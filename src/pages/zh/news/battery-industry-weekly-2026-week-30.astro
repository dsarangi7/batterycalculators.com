---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周刊 — 第30周, 2026 | Battery Calculators";
const description = "本周电池动态：Wärtsilä完成向澳大利亚1,400MWh Wooreen BESS交付1,038套Quantum电池单元、德国初创公司推出住宅用高压钠离子电池、出光在澳大利亚煤矿旧址规划864 MWh全钒液流电池。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-30";
const publishDate = "2026-07-24";
const lastUpdated = "2026-07-24";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周刊？",
    "answer": "一份简短的编辑摘要，每周涵盖最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "系统从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出本周最重要的新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新摘要于每周五生成，覆盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '第30周, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 第30周, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第30周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>7月20日 – 7月26日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池动态：Wärtsilä完成向澳大利亚1,400MWh Wooreen BESS交付1,038套Quantum电池单元、德国初创公司推出住宅用高压钠离子电池、出光在澳大利亚煤矿旧址规划864 MWh全钒液流电池。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Wärtsilä完成向澳大利亚1,400MWh Wooreen BESS交付1,038套Quantum电池单元</h2>
      <p class="text-body-md text-body font-light mb-4">全部1,038套Wärtsilä Quantum电池单元已交付并安装到位，位于澳大利亚维多利亚州的1.4 GWh Wooreen BESS项目。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">住宅</span>
      <h2 class="text-title-xl text-primary mb-4">德国初创公司推出住宅用高压钠离子电池</h2>
      <p class="text-body-md text-body font-light mb-4">Revolta推出了一款高压住宅钠离子电池储能系统，模块化容量从2 kWh到20 kWh可选。</p>
      <p class="text-body-md text-body font-light">该系统标称电压450 V DC，效率超过95%，循环寿命达105次以上。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">出光在澳大利亚煤矿旧址规划864 MWh全钒液流电池</h2>
      <p class="text-body-md text-body font-light mb-4">出光澳大利亚公司正在新南威尔士州一处煤矿旧址规划一座108 MW、8小时储能的全钒液流电池项目。</p>
      <p class="text-body-md text-body font-light">该项目标志着从化石能源向可再生能源储能的转型。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">钠离子BESS：CATL在东欧推进2GWh合作，ESS Inc签署500MWh美国部署意向书</h2>
      <p class="text-body-md text-body font-light mb-4">ESS Tech Inc正与Juniper Energy合作在美国部署钠离子BESS，而CATL则与Solarpro合作在东欧部署其钠离子技术。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">南澳大利亚Lunio Energy投运20MWh电网级电池储能系统</h2>
      <p class="text-body-md text-body font-light mb-4">南澳大利亚电池储能开发商Lunio Energy已在Strathalbyn投运其首座电网级BESS，并开始在NEM市场交易。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Gridmatic分析发现：加利福尼亚电池因次优竞价策略损失收入</h2>
      <p class="text-body-md text-body font-light mb-4">据Gridmatic最新分析，加利福尼亚电网中运行的电池储能系统（BESS）因次优竞价策略损失了约9,800万美元的潜在收入。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">印度最大光伏组件供应商Waaree开设5.15GWh电池储能组装工厂</h2>
      <p class="text-body-md text-body font-light mb-4">印度可再生能源设备及组件制造商Waaree Energies的子公司已开设一座电池储能系统（BESS）外壳工厂。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">ib vogt获得澳大利亚Wagga Wagga特别激活区480MWh电池储能项目批准</h2>
      <p class="text-body-md text-body font-light mb-4">德国太阳能及储能开发商ib vogt已获得新南威尔士州120MW/480MWh Wagga North电池储能系统（BESS）的州规划许可。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alfen与CATL达成欧洲5GWh钠离子BESS合作伙伴关系</h2>
      <p class="text-body-md text-body font-light mb-4">系统集成商Alfen与电池公司CATL已达成5GWh钠离子BESS部署合作协议，面向欧洲市场。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">中国电池通过关键测试，有望替代锂电芯 — Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">一种有望替代锂电芯的中国电池技术通过了关键测试，标志着该技术向商业化迈进重要一步。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中三个值得持续关注的主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化已成为新常态。</strong> 电池部署在每个领域持续增长——电动汽车、电网储能和船舶——使电池成为核心基础设施技术而非小众市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化正在加速。</strong> LFP、固态、钠离子和硅负极等化学体系齐头并进，各自瞄准不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内生产激励措施迫使企业重新思考采购、文档和合规时间表。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间表的最新进展</li>
          <li>欧盟委员会关于电池法规实施的指导意见</li>
          <li>新电网级BESS项目投运和产能里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩展公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/wartsila-completes-delivery-of-1038-quantum-units-to-1400mwh-wooreen-bess-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Wärtsilä completes delivery of 1,038 Quantum units to 1,400MWh Wooreen BESS in Australia — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/24/german-startup-launches-high-voltage-sodium-ion-battery-for-residential-applications/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">German startup launches high-voltage sodium-ion battery for residential applications — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/24/idemitsu-plans-864-mwh-vanadium-flow-battery-at-australian-coal-mine-site/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Idemitsu plans 864 MWh vanadium flow battery at Australian coal mine site — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/sodium-ion-bess-catl-in-2gwh-eastern-europe-collaboration-ess-inc-signs-loi-for-500mwh-of-us-deployments/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Sodium-ion BESS: CATL in 2GWh Eastern Europe collaboration, ESS Inc signs LOI for 500MWh of US deployments — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/south-australias-lunio-energy-brings-20mwh-grid-scale-battery-storage-system-online/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">South Australia's Lunio Energy brings 20MWh grid-scale battery storage system online — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/california-batteries-missing-out-on-revenue-due-to-suboptimal-bidding-strategies-gridmatic-analysis-finds/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">California batteries missing out on revenue due to suboptimal bidding strategies, Gridmatic analysis finds — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/waaree-indias-biggest-pv-module-supplier-opens-5-15gwh-battery-storage-assembly-plant/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Waaree, India's biggest PV module supplier, opens 5.15GWh battery storage assembly plant — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/ib-vogt-wins-approval-for-480mwh-battery-storage-site-in-australias-wagga-wagga-special-activation-precinct/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">ib vogt wins approval for 480MWh battery storage site in Australia's Wagga Wagga Special Activation Precinct — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/alfen-and-catl-agree-5gwh-sodium-ion-bess-partnership-in-europe/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Alfen and CATL agree 5GWh sodium-ion BESS partnership in Europe — Energy Storage News</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWWwtUHZVaVdWOFVOZVAyd1Q1RTBfUmhPdmxBaFExSFRTRWpCdw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Chinese battery that could offer alternative to lithium cells passes key test - Yahoo Finance UK — Google News - Battery Technology</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可获取的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过原始来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
