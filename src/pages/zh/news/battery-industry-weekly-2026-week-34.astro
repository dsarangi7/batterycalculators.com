---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周报 — 2026年第34周 | Battery Calculators";
const description = "本周电池动态：印度BESS供应链面临\"政策意向与运营能力\"差距，电池电芯自主化尚需十年以上、澳大利亚更便宜的家庭电池计划正式突破50万安装量、Hithium将为GPG澳大利亚Fraser Coast项目供应421MWh BESS。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-34";
const publishDate = "2026-08-21";
const lastUpdated = "2026-08-21";
const readingTime = 14;

const faqItems = [
  {
    "question": "什么是电池行业周报？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出当周的热门新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新版本在每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第34周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周报 — 2026年第34周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周报 — 第34周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>8月17日 – 8月23日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池动态：印度BESS供应链面临&quot;政策意向与运营能力&quot;差距，电池电芯自主化尚需十年以上、澳大利亚更便宜的家庭电池计划正式突破50万安装量、Hithium将为GPG澳大利亚Fraser Coast项目供应421MWh BESS。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">印度BESS供应链面临"政策意向与运营能力"差距，电池电芯自主化尚需十年以上</h2>
      <p class="text-body-md text-body font-light mb-4">Wood Mackenzie表示，印度电池储能行业在电芯供应方面至少十年内将远未实现自给自足。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">住宅</span>
      <h2 class="text-title-xl text-primary mb-4">澳大利亚更便宜的家庭电池计划正式突破50万安装量</h2>
      <p class="text-body-md text-body font-light mb-4">根据公布的数据，已有超过50.7万户家庭、小型企业和社区组织在澳大利亚更便宜的家庭电池计划下安装了家庭电池储能系统。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hithium将为GPG澳大利亚Fraser Coast项目供应421MWh BESS</h2>
      <p class="text-body-md text-body font-light mb-4">Hithium已与GPG签署供应协议，为Fraser Coast项目交付421MWh电池储能系统。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">BW ESS从澳大利亚ACEnergy收购1,000MWh Yanco BESS</h2>
      <p class="text-body-md text-body font-light mb-4">BW ESS已从澳大利亚开发商ACEnergy手中收购了位于新南威尔士州Riverina的1,000MWh电池储能系统。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Kostal推出25 kW电池逆变器</h2>
      <p class="text-body-md text-body font-light mb-4">Kostal的Plenticore BI 25是一款25 kW交流耦合电池逆变器，适用于商业和高端住宅系统，具有高达25 kVA的三相备用电源和98.3%的峰值效率。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">中国TOPCon电池价格因上游信心增强和出口需求上升而上涨</h2>
      <p class="text-body-md text-body font-light mb-4">在pv杂志的最新周报中，道琼斯公司OPIS对全球光伏产业的主要价格趋势进行了快速概览。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">孟加拉国要求数百万电动三轮车使用太阳能充电</h2>
      <p class="text-body-md text-body font-light mb-4">孟加拉国计划要求数百万电池驱动的机动三轮车使用太阳能充电站作为注册条件，以减轻电网压力。</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/indias-bess-supply-chain-suffers-a-policy-intent-and-operational-capacity-gap-with-battery-cell-self-sufficiency-a-decade-or-more-away/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">印度BESS供应链面临"政策意向与运营能力"差距，电池电芯自主化尚需十年以上 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/australias-cheaper-home-batteries-program-officially-passes-500000-installations/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">澳大利亚更便宜的家庭电池计划正式突破50万安装量 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/hithium-to-supply-421mwh-bess-for-gpgs-fraser-coast-project-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hithium将为GPG澳大利亚Fraser Coast项目供应421MWh BESS — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/bw-ess-acquires-1000mwh-yanco-bess-from-acenergy-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">BW ESS从澳大利亚ACEnergy收购1,000MWh Yanco BESS — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/kostal-launches-25-kw-battery-inverter/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Kostal推出25 kW电池逆变器 — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/china-topcon-cell-prices-jump-on-firmer-upstream-sentiment-and-rising-export-demand/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国TOPCon电池价格因上游信心增强和出口需求上升而上涨 — PV Magazine</a></li>
        <li><a href="https://www.pv-magazine.com/2026/08/21/bangladesh-mandates-solar-charging-for-millions-of-electric-rickshaws/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">孟加拉国要求数百万电动三轮车使用太阳能充电 — PV Magazine</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文汇总了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策之前，请务必通过主要来源核实事实。本文仅供信息参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
