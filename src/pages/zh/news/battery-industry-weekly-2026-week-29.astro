---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周刊 — 第29周, 2026 | Battery Calculators";
const description = "本周电池动态：泄露的欧盟计划承认2030年前需要200GW储能、Giga Storage为比利时700MW/2.8GWh电池完成融资、Lazard称美国公用事业级储能成本上升。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-29";
const publishDate = "2026-08-08";
const lastUpdated = "2026-08-08";
const readingTime = 16;

const faqItems = [
  {
    "question": "什么是电池行业周刊？",
    "answer": "一份简短的编辑摘要，每周涵盖最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "系统从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出本周最重要的新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新摘要于每周五生成，覆盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '第29周, 2026' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 第29周, 2026"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第29周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>7月13日 – 7月19日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池动态：泄露的欧盟计划承认2030年前需要200GW储能、Giga Storage为比利时700MW/2.8GWh电池完成融资、Lazard称美国公用事业级储能成本上升。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">法规</span>
      <h2 class="text-title-xl text-primary mb-4">泄露的欧盟计划承认2030年前需要200GW储能</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月13日报道，欧盟电气化行动计划的一份泄露草案称，到2030年欧盟需要200GW储能。同一篇文章在7月16日的更新中称，Energy Storage Europe欢迎这一目标，并警告更快的电气化需要多得多的灵活性以及协同监管。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Giga Storage为比利时700MW/2.8GWh电池完成融资</h2>
      <p class="text-body-md text-body font-light mb-4">Giga Storage已为其位于比利时的Green Turtle项目（700MW/2,800MWh）落实4.5亿欧元（5.12亿美元）融资。Energy-Storage.News于2026年7月14日报道，来自10家银行的债务在7月10日宣布，其余股权由InfraVia Capital Partners提供。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Lazard称美国公用事业级储能成本上升</h2>
      <p class="text-body-md text-body font-light mb-4">Lazard第11版储能平准化成本分析称，美国公用事业级电池成本上升，扭转了2025年版的下降，原因是关税以及针对使用中国电芯项目的投资税收抵免“受关注外国实体”限制，切断了更便宜的中国电芯供应。Energy-Storage.News于2026年7月14日报道，对100MW/400MWh系统，Lazard给出的2025年区间为无税收抵免时115–254美元/MWh、有抵免时83–192美元/MWh，今年则分别为210–292美元/MWh和148–209美元/MWh。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">CSIRO的GenCost更新上调抽水蓄能成本、下调电池成本</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月15日报道，澳大利亚CSIRO在GenCost 2025-26报告终稿中上调了抽水蓄能成本估算，并下调了电池储能成本估算。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">2026年上半年全球大型储能投运量增长27%</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月15日报道，2026年上半年大型电池投运量增长27%，6月投运9.1GW/33.5GWh，沙特阿拉伯占该月总量的三分之一以上。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">澳大利亚可再生能源优先清单新增超过4GWh储能</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月15日报道，澳大利亚联邦政府向国家可再生能源优先清单新增11个发电与储能项目，其中包括超过4GWh电池储能。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Transgrid为新南威尔士900MW构网型电池打开路径</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月16日报道，在同步调相机成本上涨38%之后，Transgrid为900MW构网型电池储能计入新南威尔士最低系统强度要求开辟了路径。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Avantus与Fluence推进加州两个光储项目</h2>
      <p class="text-body-md text-body font-light mb-4">Energy-Storage.News于2026年7月15日报道，Avantus与Fluence正在推进加州两个光储项目，由Fluence提供符合国产含量要求的电池系统。</p>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/leaked-eu-electrification-action-plan-recognises-need-for-200gw-of-energy-storage-by-2030/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Leaked EU Electrification Action Plan recognises need for 200GW of energy storage by 2030 — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/giga-storage-secures-finance-for-2-8gwh-critical-infrastructure-belgium-bess/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Giga Storage secures finance for 2.8GWh critical infrastructure Belgium BESS — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/lazard-us-utility-scale-energy-storage-lcos-has-increased-since-restrictions-on-chinese-cells-came-into-force/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Lazard: US utility-scale energy storage LCOS has increased since restrictions on Chinese cells came into force — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/pumped-hydro-costs-revised-up-battery-storage-costs-down-as-australias-csiro-publishes-final-gencost-2025-26-report/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Pumped hydro costs revised up, battery storage costs down, as Australia’s CSIRO publishes final GenCost 2025-26 report — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/global-bess-deployments-soar-27-in-h1-2026-saudi-arabia-drives-figures-in-june/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Global BESS deployments soar 27% in H1 2026, Saudi Arabia drives figures in June — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/over-4gwh-of-battery-storage-added-to-australias-updated-national-renewable-energy-priority-list/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Over 4GWh of battery storage added to Australia’s updated National Renewable Energy Priority List — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/australias-transgrid-opens-pathway-for-900mw-of-grid-forming-battery-storage-as-synchronous-condenser-costs-surge-38/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Australia’s Transgrid opens pathway for 900MW of grid-forming battery storage as synchronous condenser costs surge 38% — Energy-Storage.News</a></li>
        <li><a href="https://www.energy-storage.news/avantus-progresses-california-solar-plus-storage-projects-fluence-providing-domestic-content-bess/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Avantus progresses California solar-plus-storage projects, Fluence providing domestic content BESS — Energy-Storage.News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可获取的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过原始来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
