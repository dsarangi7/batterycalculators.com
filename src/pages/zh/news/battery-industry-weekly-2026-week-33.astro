---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周报 — 2026年第33周 | Battery Calculators";
const description = "本周电池资讯：电动汽车制造商Ola Electric以20GWh谅解备忘录将Cell-to-Pack垂直整合引入印度公用事业级BESS市场，氢铁液流电池——Elestor技术详解，NextEnergy UK收购英国107MW/151MWh独立BESS组合。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-33";
const publishDate = "2026-08-14";
const lastUpdated = "2026-08-14";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周报？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出当周的热门新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新版本在每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第33周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周报 — 2026年第33周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周报 — 第33周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>8月10日 – 8月16日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：电动汽车制造商Ola Electric以20GWh谅解备忘录将Cell-to-Pack垂直整合引入印度公用事业级BESS市场，氢铁液流电池——Elestor技术详解，NextEnergy UK收购英国107MW/151MWh独立BESS组合。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">电动汽车制造商Ola Electric以20GWh谅解备忘录将Cell-to-Pack垂直整合引入印度公用事业级BESS市场</h2>
      <p class="text-body-md text-body font-light mb-4">电动汽车制造商Ola Electric已通过垂直整合商业模式进入印度公用事业级电池储能市场。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">氢铁液流电池：Elestor技术详解</h2>
      <p class="text-body-md text-body font-light mb-4">Elestor声称其氢铁液流电池具有75%以上的往返效率、20至25年的使用寿命，以及15欧元/kWh的长时储能资本支出。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">NextEnergy UK收购英国107MW/151MWh独立BESS组合</h2>
      <p class="text-body-md text-body font-light mb-4">NextEnergy UK已收购英国一个107MW/151MWh的独立电池储能系统（BESS）项目组合。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Acciona Energía将在西班牙新增33MW/66MWh BESS</h2>
      <p class="text-body-md text-body font-light mb-4">西班牙可再生能源开发商Acciona Energía公布了安装两套电池储能系统（BESS）的计划。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Serentica Renewables在印度拉贾斯坦邦投运1GWh BESS第一阶段，实现全天候可再生能源供应</h2>
      <p class="text-body-md text-body font-light mb-4">Serentica Renewables已投运电池储能项目第一阶段，该项目将助力在印度拉贾斯坦邦实现全天候（RTC）可再生能源供应。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">ZEBRE向澳大利亚EPBC法案提交180MW BESS，ZEN Energy管理程序未能减缓项目推进</h2>
      <p class="text-body-md text-body font-light mb-4">ZEBRE已将昆士兰州180MW/360MWh Noblevale电池储能项目提交至澳大利亚联邦环境评估（EPBC法案）。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统</h2>
      <p class="text-body-md text-body font-light mb-4">液流电池公司Invinity Energy Systems已向公用事业公司Dairyland Power Cooperative出售43MWh电池系统，用于在美国中部长时储能（LDES）项目中部署。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">Corvus Energy获得BC Ferries新主力船舶项目40MWh里程碑式电池合同 — Fuel Cells Works</h2>
      <p class="text-body-md text-body font-light mb-4">Corvus Energy获得了BC Ferries新主力船舶项目的一份具有里程碑意义的40MWh电池合同。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">中国推出搭载2.4 MWh巨型电池组的新型全电动货船 — Electrek</h2>
      <p class="text-body-md text-body font-light mb-4">中国推出了一艘全新的全电动货船，搭载容量高达2.4 MWh的电池组，标志着电动船舶技术的重大突破。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">中国电池通过关键测试，有望成为锂电替代方案 — Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">一种可能为锂离子电池提供替代方案的中国电池技术通过了关键测试，引发业界关注。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得关注的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化成为新常态。</strong> 电池部署在各个领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施而非利基市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极等化学体系同步发展，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策正迫使企业重新思考采购、文档和合规时间表。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间表的最新进展</li>
          <li>欧盟委员会发布的电池法规实施指南</li>
          <li>新型电网级BESS项目投产和产能里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/ev-manufacturer-ola-electric-brings-cell-to-pack-vertical-integration-into-indias-utility-scale-bess-market-with-20gwh-mou/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">电动汽车制造商Ola Electric以20GWh谅解备忘录将Cell-to-Pack垂直整合引入印度公用事业级BESS市场 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/elestor-hydrogen-iron-flow-battery/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">氢铁液流电池：Elestor技术详解 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/nextenergy-uk-acquires-107mw-151mwh-standalone-bess-portfolio-uk/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">NextEnergy UK收购英国107MW/151MWh独立BESS组合 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/acciona-energia-to-add-33mw-66mwh-bess-in-spain/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Acciona Energía将在西班牙新增33MW/66MWh BESS — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/serentica-renewables-commissions-first-phase-of-1gwh-bess-for-round-the-clock-renewable-energy-delivery-in-rajasthan-india/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Serentica Renewables在印度拉贾斯坦邦投运1GWh BESS第一阶段，实现全天候可再生能源供应 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/zebre-submits-180mw-bess-to-australias-epbc-act-as-zen-energy-administration-fails-to-slow-pipeline/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">ZEBRE向澳大利亚EPBC法案提交180MW BESS，ZEN Energy管理程序未能减缓项目推进 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/invinity-sells-43mwh-long-duration-flow-battery-system-to-us-midwest-rural-electric-cooperative/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Invinity向美国中西部农村电力合作社出售43MWh长时液流电池系统 — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Corvus Energy获得BC Ferries新主力船舶项目40MWh里程碑式电池合同 — Fuel Cells Works — Google News - Battery Technology</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMieEFVX3lxTE1XYkk1SjFaV2oxUW4zZ1QzWVRBcHNHZUx6Wmp5bjA4bnlFY2tfdmsyMWwzSnpxOXZPenppVk5OZk5lTFV3QnlJT3FiMHo1U1N2N0FKYzc1OWNScGVnVjBSb2MwT2RyNUJLb0tmRzR3MTZQd2hUaUhzUw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国推出搭载2.4 MWh巨型电池组的新型全电动货船 — Electrek — Google News - Marine Batteries</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWWwtUHZVaVdWOFVOZVAyd1Q1RTBfUmhPdmxBaFExSFRTRWpCdw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国电池通过关键测试，有望成为锂电替代方案 — Yahoo Finance UK — Google News - Sodium Ion Battery</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文汇总了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策之前，请务必通过主要来源核实事实。本文仅供信息参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
