---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周报 — 2026年第31周 | Battery Calculators";
const description = "本周电池资讯：河内电力公司在越南首都启用首个100MWh电池储能组合，钠离子BESS：CATL在东欧开展2GWh合作，ESS Inc签署500MWh美国部署意向书，Alpiq在收购Harmony Energy后宣布1.2GWh项目。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-31";
const publishDate = "2026-07-31";
const lastUpdated = "2026-07-31";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周报？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对相似新闻进行去重，按相关性评分，并选出当周的热门新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新版本在每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第31周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周报 — 2026年第31周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周报 — 第31周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>7月27日 – 8月2日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：河内电力公司在越南首都启用首个100MWh电池储能组合，钠离子BESS：CATL在东欧开展2GWh合作，ESS Inc签署500MWh美国部署意向书，Alpiq在收购Harmony Energy后宣布1.2GWh项目。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">河内电力公司在越南首都启用首个100MWh电池储能组合</h2>
      <p class="text-body-md text-body font-light mb-4">河内电力公司（EVNHANOI）已在越南河内的变电站开始试点运行五套电池储能系统。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">钠离子BESS：CATL在东欧开展2GWh合作，ESS Inc签署500MWh美国部署意向书</h2>
      <p class="text-body-md text-body font-light mb-4">ESS Tech Inc正与Juniper Energy在美国部署钠离子BESS，而CATL则与Solarpro在东欧部署其钠离子技术。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Alpiq在收购Harmony Energy后宣布1.2GWh项目</h2>
      <p class="text-body-md text-body font-light mb-4">在宣布收购Harmony Energy两周后，瑞士电力公司Alpiq在其本国公布了首个大型电池项目。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">中国推出搭载2.4 MWh巨型电池组的新型全电动货船 — Electrek</h2>
      <p class="text-body-md text-body font-light mb-4">中国推出了一艘全新的全电动货船，搭载容量高达2.4 MWh的电池组，标志着电动船舶技术的重大突破。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">中国电池通过关键测试，有望成为锂电替代方案 — Yahoo Finance UK</h2>
      <p class="text-body-md text-body font-light mb-4">一种可能为锂离子电池提供替代方案的中国电池技术通过了关键测试，引发业界关注。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">CATL签署2GWh钠离子电池储能协议 — Fuel Cells Works</h2>
      <p class="text-body-md text-body font-light mb-4">CATL签署了一项2GWh的钠离子电池储能协议，进一步推动钠离子技术的商业化进程。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">哥伦比亚在绿色能源拍卖第二天授予725 MW太阳能项目</h2>
      <p class="text-body-md text-body font-light mb-4">该国清洁能源采购拍卖在两天内共授予了995 MW太阳能和近100 MW电池储能系统。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">Antora Energy完成5.5亿美元C轮融资，加速美国热电池部署</h2>
      <p class="text-body-md text-body font-light mb-4">热能存储（TES）技术提供商Antora Energy已完成5.5亿美元C轮融资，以加速其工业设施热电池储能系统的部署。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Veolia将运营俄亥俄州中部AI数据中心350MW微电网</h2>
      <p class="text-body-md text-body font-light mb-4">环境服务公司Veolia被选中运营和维护一个350MW微电网，为美国俄亥俄州New Albany的AI数据中心园区供电，其中包括一个430MWh的BESS。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">NextEra CEO称电池储能是重要增长驱动力，合并将打造美国最大受监管公用事业公司</h2>
      <p class="text-body-md text-body font-light mb-4">NextEra Energy在2026年第二季度净利润增长9.5%，该公司正推进与Dominion Energy的合并计划，以打造全球最大的受监管电力公用事业公司。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得关注的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化成为新常态。</strong> 电池部署在各个领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施而非利基市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极等化学体系同步发展，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策正迫使企业重新思考采购、文档和合规时间表。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间表的最新进展</li>
          <li>欧盟委员会发布的电池法规实施指南</li>
          <li>新型电网级BESS项目投产和产能里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/hanoi-power-corporation-inaugurates-the-first-100mwh-battery-storage-portfolio-in-vietnamese-capital/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">河内电力公司在越南首都启用首个100MWh电池储能组合 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/sodium-ion-bess-catl-in-2gwh-eastern-europe-collaboration-ess-inc-signs-loi-for-500mwh-of-us-deployments/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">钠离子BESS：CATL在东欧开展2GWh合作，ESS Inc签署500MWh美国部署意向书 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/alpiq-follows-harmony-energy-acquisition-with-1-2gwh-project-announcement/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Alpiq在收购Harmony Energy后宣布1.2GWh项目 — Energy Storage News</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMieEFVX3lxTE1XYkk1SjFaV2oxUW4zZ1QzWVRBcHNHZUx6Wmp5bjA4bnlFY2tfdmsyMWwzSnpxOXZPenppVk5OZk5lTFV3QnlJT3FiMHo1U1N2N0FKYzc1OWNScGVnVjBSb2MwT2RyNUJLb0tmRzR3MTZQd2hUaUhzUw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国推出搭载2.4 MWh巨型电池组的新型全电动货船 — Electrek — Google News - Marine Batteries</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMikgFBVV95cUxNdEdtaXFoUWpoTXNWdjYtVjY2TC0tUnc3MWhEUi0xSnZDTzV2U3lqNllxTDJJNmdtdzBVemJVMGt4bC0zWE5hU3hxM0w3RkN3NXFUUnNKRzdBbVZFUUJfT1FYT3A3N3RjSG10VnlwWWwtUHZVaVdWOFVOZVAyd1Q1RTBfUmhPdmxBaFExSFRTRWpCdw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">中国电池通过关键测试，有望成为锂电替代方案 — Yahoo Finance UK — Google News - Sodium Ion Battery</a></li>
        <li><a href="https://news.google.com/rss/articles/CBMivAFBVV95cUxNcFg2TnhkTDVLaGtXVkZCa1lZeHp1VlBLQlBkM1hXbnFFRXFLaEI3cEtETHh4WWVweHpqRFlQQkk3WFVDeG45a1h1OFNvRWFwRXdnS0N3U2NlYlJIUXJ4RlNHb2ZpVDB3OU9rOUdSb0lVZTlDbUJsMWpVSlQ0WmFSLVJSTUROVDB3VVVyOFJVdUZVYkhMellQUjcwMVF3MTg0MElsZzZLS1VEUWh6QTZFank4RDZzUDEwZXJUSw?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">CATL签署2GWh钠离子电池储能协议 — Fuel Cells Works — Google News - Sodium Ion Battery</a></li>
        <li><a href="https://www.pv-magazine.com/2026/07/31/colombia-awards-725-mw-of-solar-on-second-day-of-green-energy-auction/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">哥伦比亚在绿色能源拍卖第二天授予725 MW太阳能项目 — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/antora-energy-closes-us550-million-series-c-to-scale-us-thermal-battery-deployment/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Antora Energy完成5.5亿美元C轮融资，加速美国热电池部署 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/veolia-to-operate-350mw-microgrid-for-ai-data-centre-in-central-ohio/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Veolia将运营俄亥俄州中部AI数据中心350MW微电网 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/battery-storage-is-an-important-growth-driver-nextera-ceo-says-amid-merger-to-create-largest-regulated-utility-in-us/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">NextEra CEO称电池储能是重要增长驱动力，合并将打造美国最大受监管公用事业公司 — Energy Storage News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文汇总了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策之前，请务必通过主要来源核实事实。本文仅供信息参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
