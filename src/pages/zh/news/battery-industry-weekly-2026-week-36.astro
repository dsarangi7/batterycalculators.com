---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';

const title = "电池行业周刊 — 2026年第36周 | 电池计算器";
const description = "本周电池资讯：电动汽车制造商Ola Electric以20GWh谅解备忘录将电芯到包垂直整合引入印度公用事业级BESS市场，SK On与NeoVolta Power签署18GWh互惠LFP供应协议用于美国制造电池储能，TÜV Rheinland验证Aptera太阳能电动汽车4 kWh发电量。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-36";
const publishDate = "2026-09-04";
const lastUpdated = "2026-09-04";
const readingTime = 24;

const faqItems = [
  {
    "question": "什么是电池行业周刊？",
    "answer": "一份简短的编辑摘要，涵盖每周最重要的电池行业新闻——电动汽车电池、电网级储能、法规、制造和研究。"
  },
  {
    "question": "新闻是如何筛选的？",
    "answer": "生成器从可信来源获取RSS订阅源，对类似新闻进行去重，按相关性评分，并选出当周的头条新闻。"
  },
  {
    "question": "摘要何时发布？",
    "answer": "每期新刊于每周五生成，涵盖当周内容。"
  }
];

const breadcrumbs = [
  { label: '资讯', href: '/zh/news/' },
  { label: '2026年第36周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 2026年第36周"
  schemaDescription={description}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news/" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第36周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>8月31日 – 9月6日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：电动汽车制造商Ola Electric以20GWh谅解备忘录将电芯到包垂直整合引入印度公用事业级BESS市场，SK On与NeoVolta Power签署18GWh互惠LFP供应协议用于美国制造电池储能，TÜV Rheinland验证Aptera太阳能电动汽车4 kWh发电量。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">电动汽车制造商Ola Electric以20GWh谅解备忘录将电芯到包垂直整合引入印度公用事业级BESS市场</h2>
      <p class="text-body-md text-body font-light mb-4">电动汽车制造商Ola Electric以垂直整合商业模式进入印度公用事业级电池储能市场。</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">SK On与NeoVolta Power签署18GWh互惠LFP供应协议用于美国制造电池储能</h2>
      <p class="text-body-md text-body font-light mb-4">韩国电池制造商SK On的美国生产基地将在五年协议下向NeoVolta Power供应9GWh磷酸铁锂（LFP）软包电芯。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">TÜV Rheinland验证Aptera太阳能电动汽车4 kWh发电量</h2>
      <p class="text-body-md text-body font-light mb-4">独立第三方测试测量到超过4 kWh的可用太阳能，经转换后输送到车辆高压电池。</p>
      <p class="text-body-md text-body font-light">原文：TÜV Rheinland validates 4 kWh generation in Aptera's solar electric vehicle</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">Sungrow电池储能收入超越光伏业务，上半年出货量达25GWh</h2>
      <p class="text-body-md text-body font-light mb-4">Sungrow上半年（H1）营收同比下降28.99%，归属于母公司股东的净利润下降32.01%。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Hyperstrong启动LEAG德国1.6GWh BESS交钥匙工程建设</h2>
      <p class="text-body-md text-body font-light mb-4">电力生产商LEAG与其交钥匙BESS建设合作伙伴HyperStrong已开始在德国建设400MW/1,600MWh项目，Sunotec也同时启动了441MWh项目建设。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Return实现财务交割并与Vattenfall签署荷兰800MWh电池储能长期托管协议</h2>
      <p class="text-body-md text-body font-light mb-4">BESS业主运营商Return已与电力公司Vattenfall就其荷兰200MW/800MWh Sirius BESS项目签署长期托管协议，同时完成财务交割。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">研究</span>
      <h2 class="text-title-xl text-primary mb-4">"澳大利亚是为电池而生的市场"：Wärtsilä战略负责人谈波动性与储能商业逻辑</h2>
      <p class="text-body-md text-body font-light mb-4">Wärtsilä的Kashish Shah在接受ESN Premium采访时解释了澳大利亚波动的市场结构为何使其独特适合电池储能。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">Octopus Australia提交4.8GWh Hanworth电池项目申请EPBC法案审批</h2>
      <p class="text-body-md text-body font-light mb-4">Octopus Australia通过其开发合作伙伴Enervest提交了1.2GW/4.8GWh BESS项目，申请澳大利亚EPBC法案评估。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">船舶</span>
      <h2 class="text-title-xl text-primary mb-4">HMC Capital的KKR合作为澳大利亚首个新建电池储能项目提供90%股权资金</h2>
      <p class="text-body-md text-body font-light mb-4">HMC表示已承诺投入股权资金开发其在澳大利亚的首个新建电池储能项目——位于维多利亚州的300MW/1,200MWh设施。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">BESS</span>
      <h2 class="text-title-xl text-primary mb-4">沙特电力采购公司授标2GW/8GWh电池储能合同</h2>
      <p class="text-body-md text-body font-light mb-4">沙特阿拉伯电力主要买家已为四个大型电池储能项目授予服务合同，中标联合体包括ACWA Power和Engie。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得追踪的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化已成新常态。</strong> 电池部署在各细分领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施，而非小众市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极化学体系均在同步推进，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策迫使企业重新思考采购、文档和合规时间线。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间线的持续更新</li>
          <li>欧盟委员会关于EU电池法规实施指南</li>
          <li>新电网级BESS项目投运和容量里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://www.energy-storage.news/ev-manufacturer-ola-electric-brings-cell-to-pack-vertical-integration-into-indias-utility-scale-bess-market-with-20gwh-mou/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">电动汽车制造商Ola Electric以20GWh谅解备忘录将电芯到包垂直整合引入印度公用事业级BESS市场 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/sk-on-signs-18gwh-reciprocal-lfp-supply-deal-with-neovolta-power-for-us-made-battery-storage/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">SK On与NeoVolta Power签署18GWh互惠LFP供应协议用于美国制造电池储能 — Energy Storage News</a></li>
        <li><a href="https://www.pv-magazine.com/2026/09/04/tuv-rheinland-validates-4-kwh-generation-in-apteras-solar-electric-vehicle/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">TÜV Rheinland验证Aptera太阳能电动汽车4 kWh发电量 — PV Magazine</a></li>
        <li><a href="https://www.energy-storage.news/sungrows-battery-storage-revenue-tops-pv-business-h1-shipments-hit-25gwh/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Sungrow电池储能收入超越光伏业务，上半年出货量达25GWh — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/hyperstrong-starts-building-leags-1-6gwh-germany-bess-under-turnkey-contract/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Hyperstrong启动LEAG德国1.6GWh BESS交钥匙工程建设 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/return-financial-close-vattenfall-toll-800mwh-dutch-netherlands-battery-storage/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Return实现财务交割并与Vattenfall签署荷兰800MWh电池储能长期托管协议 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/australia-is-a-market-made-for-batteries-wartsila-strategy-lead-on-volatility-and-the-business-case-for-energy-storage/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">"澳大利亚是为电池而生的市场"：Wärtsilä战略负责人谈波动性与储能商业逻辑 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/octopus-australia-submits-4-8gwh-hanworth-battery-project-for-epbc-act-approval/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Octopus Australia提交4.8GWh Hanworth电池项目申请EPBC法案审批 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/hmc-capitals-kkr-partnership-funds-90-of-first-new-build-battery-storage-site-equity-in-australia/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">HMC Capital的KKR合作为澳大利亚首个新建电池储能项目提供90%股权资金 — Energy Storage News</a></li>
        <li><a href="https://www.energy-storage.news/saudi-power-procurement-company-awards-2gw-8gwh-battery-storage-contracts/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">沙特电力采购公司授标2GW/8GWh电池储能合同 — Energy Storage News</a></li>
      </ul>
    </section>

    <!-- FAQ -->
    <FAQSection items={faqItems} />

    <!-- Disclaimer -->
    <section class="mb-16 border-t border-hairline pt-12">
      <div class="bg-surface-elevated border border-hairline p-6">
        <h3 class="text-title-lg text-primary mb-3">免责声明</h3>
        <p class="text-body-sm text-muted">
          本文总结了公开可用的新闻和分析。BatteryCalculators.com不保证第三方信息的准确性。在做出工程或采购决策前，请务必通过主要来源核实事实。本内容仅供参考，不构成专业工程建议。
        </p>
      </div>
    </section>

  </article>
</Layout>
