---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const title = "电池行业周刊 — 2026年第40周 | 电池计算器";
const description = "本周电池资讯：评论文章：即将举行的菲律宾电动汽车峰会是对国家政策的一次审查，EnerVenue开设工厂并在中国油田获得30,000次循环镍氢电池的首个多兆瓦时订单，American Battery Technology Company获得美国商务部许可，获准出口销售1亿美元再生黑粉关键矿物。";
const canonical = "https://batterycalculators.com/zh/news/battery-industry-weekly-2026-week-40";
const publishDate = "2026-10-02";
const lastUpdated = "2026-10-02";
const readingTime = 24;

const breadcrumbs = [
  { label: '资讯', href: '/zh/news' },
  { label: '2026年第40周' },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  schema="webApplication"
  schemaName="电池行业周刊 — 2026年第40周"
  schemaDescription={description}
  breadcrumbs={breadcrumbs}
  lang="zh"
>
  <article class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-12 border-b border-hairline pb-8">
      <a href="/zh/news" class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block">&larr; 返回资讯</a>
      <Breadcrumb items={breadcrumbs} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">每周期刊</span>
      <h1 class="text-display-md text-primary mb-4">电池行业周刊 — 第40周</h1>
      <div class="flex flex-wrap items-center gap-4 text-caption text-muted mb-6">
        <span>9月28日 – 10月4日, 2026</span>
        <span>{readingTime} 分钟阅读</span>
      </div>
      <p class="text-body-md text-body font-light">
        本周电池资讯：评论文章：即将举行的菲律宾电动汽车峰会是对国家政策的一次审查，EnerVenue开设工厂并在中国油田获得30,000次循环镍氢电池的首个多兆瓦时订单，American Battery Technology Company获得美国商务部许可，获准出口销售1亿美元再生黑粉关键矿物。
      </p>
    </div>

    <!-- Story 1 -->
    <section class="mb-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">电动汽车</span>
      <h2 class="text-title-xl text-primary mb-4">评论文章：即将举行的菲律宾电动汽车峰会是对国家政策的一次审查</h2>
      <p class="text-body-md text-body font-light mb-4">该峰会是对菲律宾电动汽车进展的一次实务审查。马尼拉，菲律宾——当第14届菲律宾电动汽车峰会（PEVS）于今年10月开幕时，展会现场</p>
    </section>

    <!-- Story 2 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">制造</span>
      <h2 class="text-title-xl text-primary mb-4">EnerVenue开设工厂，在中国油田获得30,000次循环镍氢电池的首个多兆瓦时订单</h2>
      <p class="text-body-md text-body font-light mb-4">镍氢电池公司EnerVenue已获得首个兆瓦时级商业订单。</p>
    </section>

    <!-- Story 3 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">再生回收</span>
      <h2 class="text-title-xl text-primary mb-4">American Battery Technology Company获美国商务部许可，获准出口销售1亿美元再生黑粉关键矿物</h2>
      <p class="text-body-md text-body font-light mb-4">ABTC已获美国商务部批准，可出口销售价值最高1亿美元的再生黑粉关键矿物，为美国本土回收的电池材料打开海外市场。</p>
    </section>

    <!-- Story 4 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">再生回收</span>
      <h2 class="text-title-xl text-primary mb-4">American Battery获价值1亿美元黑粉出口许可 — Waste Dive</h2>
      <p class="text-body-md text-body font-light mb-4">Waste Dive报道称，该许可覆盖1亿美元的再生黑粉，这是新正极生产的关键原料。</p>
    </section>

    <!-- Story 5 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">市场</span>
      <h2 class="text-title-xl text-primary mb-4">高盛列出中国电池龙头股 — Yahoo Finance</h2>
      <p class="text-body-md text-body font-light mb-4">随着电网储能与电动汽车电芯需求持续扩大，Yahoo Finance梳理了高盛看好的中国电池制造商标的。</p>
    </section>

    <!-- Story 6 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">市场</span>
      <h2 class="text-title-xl text-primary mb-4">获出口批准后American Battery Technology股价上涨10% — Yahoo Finance</h2>
      <p class="text-body-md text-body font-light mb-4">在公司披露出口批准后，ABTC股价上涨约10%。</p>
    </section>

    <!-- Story 7 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">再生回收</span>
      <h2 class="text-title-xl text-primary mb-4">American Battery Technology获BIS出口许可，可出口至多1亿美元再生黑粉 — TradingView</h2>
      <p class="text-body-md text-body font-light mb-4">TradingView指出，美国工业与安全局（BIS）的许可允许该公司出口至多1亿美元的再生黑粉。</p>
    </section>

    <!-- Story 8 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">再生回收</span>
      <h2 class="text-title-xl text-primary mb-4">American Battery Technology获得美国出口许可，可销售至多1亿美元再生黑粉 — Seeking Alpha</h2>
      <p class="text-body-md text-body font-light mb-4">Seeking Alpha认为，该许可为再生电池原料对接海外买家提供了通道。</p>
    </section>

    <!-- Story 9 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">市场</span>
      <h2 class="text-title-xl text-primary mb-4">出口批准推动American Battery Technology股价大涨 — Investing.com</h2>
      <p class="text-body-md text-body font-light mb-4">Investing.com报道称，批准公告发布后ABTC股价出现大幅单日波动。</p>
    </section>

    <!-- Story 10 -->
    <section class="mb-12 border-t border-hairline pt-12">
      <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">再生回收</span>
      <h2 class="text-title-xl text-primary mb-4">American Battery Technology获再生材料出口许可 — Investing.com</h2>
      <p class="text-body-md text-body font-light mb-4">关于覆盖美国本土生产再生电池材料的出口许可的进一步报道。</p>
    </section>

    <!-- Analysis -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">本周聚焦</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <p class="text-body-md text-body font-light mb-4">
          本周新闻中值得追踪的三大主题：
        </p>
        <ul class="flex flex-col gap-4 text-body-sm text-muted">
          <li>
            <strong class="text-primary">规模化已成新常态。</strong> 电池部署在各细分领域持续增长——电动汽车、电网储能和船舶——使电池成为核心技术基础设施，而非小众市场。
          </li>
          <li>
            <strong class="text-primary">化学体系多元化加速。</strong> LFP、固态、钠离子和硅负极化学体系均在同步推进，各自针对不同的成本和性能权衡。
          </li>
          <li>
            <strong class="text-primary">法规正在重塑供应链。</strong> 欧盟电池护照要求和国内制造激励政策迫使企业重新思考采购、文档和合规时间线。
          </li>
        </ul>
      </div>
    </section>

    <!-- What to Watch -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-6">下周关注</h2>
      <div class="bg-surface-card border border-hairline p-6">
        <ul class="flex flex-col gap-3 text-body-sm text-muted list-disc pl-5">
          <li>固态电池商业化时间线的持续更新</li>
          <li>欧盟委员会关于EU电池法规实施指南</li>
          <li>新电网级BESS项目投运和容量里程碑报告</li>
          <li>影响电池经济性的锂和关键矿石价格趋势</li>
          <li>钠离子和下一代化学体系产能扩张公告</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="mb-12 border-t border-hairline pt-12">
      <h2 class="text-display-sm text-primary mb-4">来源</h2>
      <ul class="flex flex-col gap-2 text-body-sm text-muted list-disc pl-5">
        <li><a href="https://cleantechnica.com/2026/09/29/op-ed-upcoming-philippine-electric-vehicle-summit-is-an-audit-of-national-policy/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">评论文章：即将举行的菲律宾电动汽车峰会是对国家政策的一次审查 — CleanTechnica</a></li>
        <li><a href="https://www.energy-storage.news/enervenue-opens-factory-secures-first-multi-mwh-order-for-30000-cycle-nickel-hydrogen-batteries-at-chinese-oilfield/" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">EnerVenue开设工厂，获得30,000次循环镍氢电池首个多兆瓦时订单 — Energy Storage News</a></li>
        <li><a href="https://news.google.?oc=5" class="text-m-blue-light hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">American Battery Technology Company获准出口销售1亿美元再生黑粉关键矿物 — Google News</a></li>
