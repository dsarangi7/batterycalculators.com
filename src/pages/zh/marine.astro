  <!-- Marine Decarbonization Resource Center -->
  <section class="mb-16 border-t border-hairline pt-12">
    <h2 class="text-title-lg text-primary mb-4">海事脱碳资源中心</h2>
    <p class="text-body-sm text-muted max-w-3xl mb-8">
      面向船东、运营商、船舶设计师、顾问和船舶工程师的教育指南，探索电气化和排放减少。
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {resourceArticles.map((article) => (
        <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-label-uppercase text-muted text-[10px]">资源中心</span>
          </div>
          <h3 class="text-title-sm text-primary">{article.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- Marine Learning Center -->
  {learnArticles.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">船舶电气化学习中心</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learnArticles.map((article) => (
          <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-label-uppercase text-muted text-[10px]">学习中心</span>
            </div>
            <h3 class="text-title-sm text-primary">{article.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Related Tools (Internal Linking) -->
  <section class="mb-16 border-t border-hairline pt-12">
    <h2 class="text-title-lg text-primary mb-6">船舶工程计算器</h2>
    <p class="text-body-sm text-muted max-w-3xl mb-8">
      浏览我们完整的船舶CO₂计算器、船舶排放计算器和海事脱碳工具——专为船东、运营商和船舶工程师设计。
    </p>
    <RelatedTools tools={relatedTools} />
  </section>

  <!-- Advisory Section + Get Support Form -->
  <section id="marine-advisory" class="mb-16 border-t border-hairline pt-12 scroll-mt-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

      <!-- Advisory Content -->
      <div>
        <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">专家咨询</span>
        <h2 class="text-title-lg text-primary mb-4">需要关于减少船舶排放和能耗的建议？</h2>
        <p class="text-body-md text-muted font-light mb-6">
          与电池和船舶电气化专家就船舶脱碳、混合动力推进、储能尺寸、岸电集成和运营效率改进进行交流。
        </p>
        <h3 class="text-label-uppercase text-primary text-xs mb-3">我们能提供的帮助</h3>
        <ul class="flex flex-col gap-2 mb-6">
          {advisoryBenefits.map((benefit) => (
            <li class="flex items-start gap-2 text-body-sm text-muted">
              <span class="text-m-blue-light shrink-0 mt-0.5">→</span>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
        <div class="bg-surface-soft border border-hairline p-4 text-caption text-muted">
          <span class="text-primary font-bold">教育性咨询服务。</span> 我们团队提供工程指导和初步可行性分析。最终船舶设计、船级认证和法规合规请咨询持证船舶工程师和船级社。
        </div>
      </div>

      <!-- Get Support Form -->
      <div>
        <CalculatorCard>
          <h3 class="text-title-md text-primary mb-6 uppercase tracking-wider">获取支持</h3>
          <form id="marine-support-form" class="flex flex-col gap-4">
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="Marine Electrification Support Request" />
            <input type="hidden" name="from_name" value="Battery Calculators - Marine Advisory" />
            <input type="text" name="honeypot" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;overflow:hidden;" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="first-name" class="text-label-uppercase text-[10px] text-primary">名 *</label>
                <input type="text" id="first-name" name="first_name" required class="text-input" placeholder="名" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="last-name" class="text-label-uppercase text-[10px] text-primary">姓 *</label>
                <input type="text" id="last-name" name="last_name" required class="text-input" placeholder="姓" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="business-email" class="text-label-uppercase text-[10px] text-primary">商务邮箱 *</label>
              <input type="email" id="business-email" name="email" required class="text-input" placeholder="name@company.com" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="company" class="text-label-uppercase text-[10px] text-primary">公司 *</label>
                <input type="text" id="company" name="company" required class="text-input" placeholder="公司名称" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="country" class="text-label-uppercase text-[10px] text-primary">国家/地区 *</label>
                <input type="text" id="country" name="country" required class="text-input" placeholder="国家" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="job-title" class="text-label-uppercase text-[10px] text-primary">职位 *</label>
                <input type="text" id="job-title" name="job_title" required class="text-input" placeholder="职位" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="phone" class="text-label-uppercase text-[10px] text-primary">电话号码</label>
                <input type="tel" id="phone" name="phone" class="text-input" placeholder="+1 (555) 000-0000" />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="comments" class="text-label-uppercase text-[10px] text-primary">留言/项目详情 *</label>
              <textarea id="comments" name="comments" required class="text-input h-28 resize-none" placeholder="描述您的船舶、航线和脱碳目标..."></textarea>
            </div>

            <div class="flex items-start gap-2">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 shrink-0" />
              <label for="consent" class="text-caption text-muted leading-relaxed">
                我同意就我的咨询被联系，并理解我的信息将根据网站<a href="/zh/privacy/" class="underline underline-offset-2 hover:text-primary transition-colors">隐私政策</a>进行处理。
              </label>
            </div>

            <button type="submit" class="btn-primary w-full text-xs h-12 mt-2">联系Battery Calculators专家</button>
          </form>

          <div id="form-success" class="hidden mt-4 p-4 border border-green-600 bg-surface-soft text-body-sm text-green-500">
            感谢您的咨询。船舶电气化专家将在1–2个工作日内与您联系。
          </div>
          <div id="form-error" class="hidden mt-4 p-4 border border-m-red bg-surface-soft text-body-sm text-m-red">
            出了点问题。请重试或直接给我们发邮件。
            <span class="block mt-2">如果表单不工作，请通过<a href="/zh/contact/" class="underline underline-offset-2 hover:text-primary transition-colors">联系页面</a>联系我们。</span>
          </div>
        </CalculatorCard>
      </div>

    </div>
  </section>

  <!-- FAQ Section -->
  <section class="mb-16 border-t border-hairline pt-12">
    <FAQSection items={faqItems} />
  </section>

  <!-- Engineering Disclaimer -->
  <section class="bg-surface-soft border border-hairline p-6 text-caption text-muted mb-8">
    <span class="text-primary font-bold text-[10px] tracking-wider uppercase border border-hairline px-1.5 py-0.5 mr-2 inline-block mb-3">
      工程免责声明
    </span>
    所有计算器仅提供教育性工程估算。旨在用于初步规划、可行性分析和学习目的。这些工具不能替代船级社计算、船旗国提交、IMO合规文件或监管备案。船舶电气和推进系统必须遵守适用的船级社规则、船旗国法规和IMO公约。最终系统设计和官方合规请咨询持证船舶工程师和船舶设计师。
  </section>

  <!-- Form Submission Script -->
  <script>
    const form = document.getElementById('marine-support-form') as HTMLFormElement;
    const successDiv = document.getElementById('form-success');
    const errorDiv = document.getElementById('form-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const honeypot = form.querySelector('input[name="honeypot"]') as HTMLInputElement;
      if (honeypot?.value) {
        console.log('[MarineForm] Honeypot triggered, aborting.');
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SENDING...';
      }

      try {
        const formData = new FormData(form);
        console.log('[MarineForm] Submitting to Web3Forms...');
        console.log('[MarineForm] Fields:', Object.fromEntries(formData.entries()));

        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();
        console.log('[MarineForm] Response:', result);

        if (result.success) {
          form.reset();
          if (successDiv) successDiv.classList.remove('hidden');
          if (errorDiv) errorDiv.classList.add('hidden');
          setTimeout(() => { if (successDiv) successDiv.classList.add('hidden'); }, 10000);
        } else {
          console.error('[MarineForm] Submission failed:', result.message);
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err) {
        console.error('[MarineForm] Error:', err);
        if (errorDiv) errorDiv.classList.remove('hidden');
        if (successDiv) successDiv.classList.add('hidden');
        setTimeout(() => { if (errorDiv) errorDiv.classList.add('hidden'); }, 8000);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Contact Battery Calculators Expert';
        }
      }
    });
  </script>

</Layout>
