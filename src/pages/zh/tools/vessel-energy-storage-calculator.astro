        ]}
        steps={[
          { label: "步骤 1：每日能量需求", formula: "每日 = (400 + 800) × 12", result: "14,400 kWh" },
          { label: "步骤 2：应用储备余量", formula: "可用 = 14,400 × 1.25", result: "18,000 kWh" },
