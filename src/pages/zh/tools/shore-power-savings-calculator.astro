        inputs={[
          { label: "酒店负荷", value: "500 kW" },
          { label: "每次停泊时间", value: "12 小时" },
          { label: "年停靠次数", value: "150" },
          { label: "电网电价", value: "$0.15/kWh" },
          { label: "MGO 燃油价格", value: "$0.75/L" },
          { label: "发电机组燃油消耗率", value: "500 kW 下 130 L/小时" },
