          { label: "混合动力化比例", value: "10%（负荷均衡）" },
          { label: "岸电使用比例", value: "40%" },
        ]}
        steps={[
          { label: "步骤1：混合动力化节省的燃油", formula: "350,000 × 0.10 × (1 - 0.40) = 21,000 L", result: "通过负荷均衡节省21,000升" },
          { label: "步骤2：岸电节省的燃油", formula: "350,000 × 0.40 = 140,000 L", result: "港口空闲期间节省140,000升" },
          { label: "步骤3：总节省燃油", formula: "21,000 + 140,000 = 161,000 L", result: "总计161,000 L（减少46.0%）" },
          { label: "步骤4：CO₂减排", formula: "161,000 × 3.206 / 1000 = 516.2 t", result: "消除516.2吨CO₂" },
          { label: "步骤5：电网修正后净减排", formula: "516.2 × 0.60（可再生能源占比）+ 516.2 × 0.40 × (1 - 0.4) = 432.0 t", result: "考虑电网结构后净减排432.0吨CO₂" },
        ]}
        answer="考虑电网碳强度后，岸电加负荷均衡每年净减少432.0吨CO₂。"
        interpretation="拖船是岸电系统的理想对象，因为它们在作业间隙长时间靠港。40%的空闲时间岸电连接消除了最低效的发电机组运行——低负荷运行。电网碳强度对净效益有显著影响。"
        variant="marine"
      />

      <WorkedExample
