        inputs={[
          { label: "燃油类型", value: "MGO（3.206 kg CO₂/L）" },
          { label: "发电机组燃油消耗", value: "8 L/小时" },
          { label: "太阳能输出", value: "32 kWh/天" },
          { label: "发电机组负荷抵消", value: "等效4小时/天" },
          { label: "运行天数", value: "300天/年" },
        ]}
        steps={[
          { label: "步骤1：太阳能每日燃油抵消", formula: "32 kWh / (8 L/小时 × 5.0 kWh/L) = 0.8小时等效 → 8 × 0.8 = 6.4 L/天", result: "每日抵消6.4升柴油" },
          { label: "步骤2：年燃油抵消", formula: "6.4 × 300 = 1,920 L/年", result: "年抵消1,920升柴油" },
          { label: "步骤3：CO₂减排", formula: "1,920 × 3.206 / 1000 = 6.2 t", result: "年消除6.16吨CO₂" },
          { label: "步骤4：等效影响", formula: "6.16 / 4.6 = 1.3辆 | 6,160 / 21 = 293棵", result: "相当于减少1.3辆汽车或种植293棵树一年" },
        ]}
        answer="25米游艇上的太阳能板每年可抵消6.2吨CO₂——相当于减少1.3辆乘用车上路。"
        interpretation="游艇上的太阳能板提供了有意义但适度的CO₂抵消，相对于船舶总燃油消耗而言。其主要价值在于锚泊时提供静音、无排放的酒店负荷发电，改善宾客体验的同时减少发电机组运行时间和燃油成本。"
        variant="marine"
