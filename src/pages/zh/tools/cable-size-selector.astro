  <ComparisonTable
    title="铜缆与铝缆对比——电缆选型"
    headers={["参数", "铜", "铝", "比值"]}
    rows={[
      ["电阻率 (Ω·m)", "1.72×10⁻⁸", "2.82×10⁻⁸", "1.64×"],
