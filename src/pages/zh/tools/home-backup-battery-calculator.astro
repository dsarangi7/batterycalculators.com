      ["关键级", "冰箱、医疗、安防、通信", "500–800W", "24–72 小时", "5–15 kWh"],
      ["必需级", "加照明、网络、手机充电", "1,000–1,500W", "12–24 小时", "10–25 kWh"],
      ["舒适级", "加电视、洗衣机、做饭", "2,000–4,000W", "8–12 小时", "20–40 kWh"],
      ["整屋级", "除大功率暖通外的全部回路", "5,000–8,000W", "8–24 小时", "30–60 kWh"],
    ]}
    caption="家庭电池备用选型的分级方法"
  />

