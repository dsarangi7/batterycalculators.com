---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import InputField from '../../components/InputField.astro';
import ResultBox from '../../components/ResultBox.astro';
import FormulaBox from '../../components/FormulaBox.astro';
import FAQSection from '../../components/FAQSection.astro';
import WorkedExample from '../../components/WorkedExample.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import EngineeringDiagram from '../../components/EngineeringDiagram.astro';

const whatIs = `家庭停电电池备用计算器帮助您估算在电网停电期间保持关键电器运行所需的电池容量、逆变器尺寸和整体备用电力系统。无论您是在为飓风季、山火停电、冬季暴风还是突发停电做准备，本工具根据您需要供电的具体设备——冰箱、CPAP呼吸机、排水泵、Wi-Fi路由器、照明等——来设计电池组尺寸。它考虑逆变器转换损耗、电池化学类型放电深度限制和可配置的安全裕度，为您提供工程级的精确估算。`;

const whyItMatters = [
  "美国停电在过去十年增加了67%——暴风雨、山火和电网压力使备用电力在许多地区成为实际必需。",
  "电池系统过小会导致多天停电中无法冷藏食物或为医疗设备供电。满载冰箱食物变质需花费300-600美元重新购置。",
  "系统过大浪费资金——每多余的5kWh LFP容量增加2,000-4,000美元成本。合理设计可节省数千美元。",
  "忽略排水泵和冰箱等电器的浪涌负载会在最糟糕的时刻使逆变器跳闸——合理的浪涌设计可防止停电中途故障。",
  "未规划极端温度意味着电池容量在低温下降低10-30%，在冬季暴风最需要备用时出现不足。"
];

const practicalApplications = [
  { title: "飓风与暴风备灾", description: "设计电池系统以在飓风、东北风暴和强雷暴常见的24-72小时停电中维持关键负载。" },
  { title: "山火公共安全停电", description: "为高火险期间的计划电网停电做准备。加州和美国西部公用事业公司经常断电以防止起火。" },
  { title: "医疗设备备用电力", description: "确保CPAP呼吸机、制氧机、雾化器和其他维持生命的医疗设备有足够的电池续航。" },
  { title: "冬季暴风与冰暴备用", description: "在冰暴和暴风雪导致数天断电时保持加热控制、排水泵、冷藏和通信设备运行。" },
  { title: "便携式电源站选型", description: "在购买前使用本计算器将便携式电源站或太阳能发电机与您的具体应急负载需求匹配。" },
  { title: "冰箱与冷冻柜保护", description: "精确计算电池可保持冰箱和冷冻柜运行多长时间，防止长时间停电中的食物变质。" }
];

const expertNotes: { title: string; variant: 'engineering' | 'tip' | 'warning'; content: string }[] = [
  {
    title: "电器工作周期很重要",
    variant: "engineering",
    content: "冰箱在压缩机运行时消耗150W，但循环开停——通常运行30-50%的时间。本计算器使用连续运行功率进行保守设计。对于冰箱和冷冻柜等循环负载，实际续航可能比计算值长40-60%。"
  },
  {
    title: "LiFePO4 vs 铅酸用于应急备用",
    variant: "tip",
    content: "LiFePO4（LFP）电池提供80-100%可用容量，重量轻60%，循环寿命长10倍，且无需维护。铅酸电池放电深度限制50%，且低温下容量快速下降。对于可靠性至关重要的应急备用，LFP是明确推荐。"
  },
  {
    title: "浪涌负载可使逆变器跳闸",
    variant: "warning",
    content: "排水泵、冰箱和微波炉启动时消耗运行功率的2-3倍。如果逆变器浪涌额定值过低，会在您最需要时关机。务必为最差启动场景设计逆变器浪涌容量。"
  }
];

const trustSection = {
  text: "本计算器使用标准电气工程公式进行电池系统尺寸设计，符合UL 1741逆变器标准和IEEE 1547互联指南。所有计算透明，源自公开的电器功率数据和制造商规格。数学公式完全可验证。",
  link: { label: "查看我们的方法论和公式推导", href: "/zh/methodology/" }
};

const references = [
  { title: "美国EIA — 住宅用电数据", url: "https://www.eia.gov/electricity/monthly/", source: "U.S. Energy Information Administration" },
  { title: "UL 1741 — 分布式能源逆变器标准", url: "https://www.ul.com/resources/ul-1741-edition-3", source: "Underwriters Laboratories" },
  { title: "FEMA — 应急备用电力指南", url: "https://www.fema.gov/emergency-managers/risk-management/power/guidance", source: "Federal Emergency Management Agency" },
  { title: "NREL — 住宅应用电池储能设计", url: "https://www.nrel.gov/docs/fy23osti/85472.pdf", source: "National Renewable Energy Laboratory" }
];

const faqItems = [
  {
    question: "停电需要多大的电池？",
    answer: "基本网络和手机备用（Wi-Fi路由器+笔记本+照明8小时）约需300-500Wh。食物保护（冰箱+冷冻柜12小时）建议2,000-4,000Wh。包含医疗设备的全面应急备用，3,000-8,000Wh可覆盖大多数关键家用负载24小时。",
  },
  {
    question: "100Ah电池能为冰箱供电多长时间？",
    answer: "12V 100Ah LiFePO4电池（1,280Wh）可运行标准冰箱约8-12小时。冰箱压缩机循环开停，实际续航取决于环境温度、冰箱效率和开门频率。高温频繁开门时约6-8小时。",
  },
  {
    question: "LiFePO4比铅酸更适合家庭备用吗？",
    answer: "是的，对于应急备用电力。LiFePO4提供80-100%可用放电深度（铅酸50%），循环寿命3,000-6,000次（铅酸300-500次），充电更快，重量轻60%，无需维护。初始成本较高但每次循环的生命周期成本显著更低。",
  },
  {
    question: "冰箱需要多大的逆变器？",
    answer: "标准冰箱需要1,500-2,000W连续逆变器，至少3,000W浪涌容量。运行负载通常150W，但压缩机启动浪涌可达600W或更高。如运行额外电器，将其运行功率和最大单个浪涌负载相加来设计逆变器。",
  },
  {
    question: "便携式电源站能运行冰箱吗？",
    answer: "可以，标称1,500W+连续、3,000W+浪涌的便携式电源站可运行标准冰箱。需要至少1,000-1,500Wh容量以获得8-12小时备用。热门选择包括EcoFlow Delta 2（1,024Wh）、Bluetti AC200MAX（2,048Wh）和Goal Zero Yeti 1500X（1,516Wh）。",
  },
  {
    question: "CPAP需要多少电池备用？",
    answer: "典型CPAP带加湿器功耗30-60W（不带10-30W）。8小时睡眠需240-480Wh。12V 50Ah LiFePO4电池（640Wh）提供整夜CPAP供电。不带加湿器，12V 20Ah电池（256Wh）可维持一晚。",
  },
  {
    question: "家庭备用应该用12V、24V还是48V？",
    answer: "超过1,000W的家庭备用系统使用24V或48V。更高电压减小电流，允许更细的线缆和更低的损耗。48V适合3,000W以上的系统，是现代家庭电池系统的标准。12V仅适用于1,000W以下的小型便携设置。",
  },
  {
    question: "太阳能板能在停电期间为电池充电吗？",
    answer: "可以，如果有带电池输入的混合逆变器。400W太阳能板阵列在4-5小时峰值日照下每天可产生1,600-2,000Wh——足以部分充电家用电池或显著延长备用续航。这是多天停电生存的最有效策略。",
  },
  {
    question: "为什么我的电池没有计算器说的那么久？",
    answer: "常见原因：电池老化和退化（容量数年内下降20-30%），低温使容量降低10-30%，实际浪涌高于额定值，线路损耗，逆变器待机功耗，以及与假设不同的电器循环模式。本计算器提供保守估算——实际结果会有差异。",
  },
  {
    question: "应避免在电池备用上运行哪些电器？",
    answer: "避免高功耗电阻负载：空调（1,500-5,000W）、电炉（2,000-5,000W）、电热水器（4,500W）、衣物烘干机（2,500-5,000W）和取暖器（1,500W）。这些快速耗尽电池，需要不切实际的大型系统。专注于关键负载：冷藏、照明、医疗设备、通信和小型电子设备。",
  },
];

const commonMistakes = [
  "逆变器对浪涌负载设计不足——排水泵、冰箱和微波炉启动时消耗运行功率的2-3倍，使廉价逆变器跳闸。",
  "忽略逆变器效率损耗——10-15%的直流到交流转换损耗意味着1,000Wh电池仅提供850-900Wh的可用交流能量。",
  "按运行功率设计而未考虑电器工作周期——冰箱30-50%的时间循环运行，连续运行估算偏保守。",
  "铅酸电池使用全额定容量——铅酸不应超过50% DoD，需要LiFePO4的双倍标称容量。",
  "忘记电池老化和温度的安全裕度——低温使容量降低10-30%，且电池寿命内容量退化20-30%。",
  "未规划转换开关安装——将电池系统连接到家庭线路而无转换开关可能电死电力公司工作人员。",
  "电池组过大而无充电策略——10kWh电池若无太阳能或发电机充电是一次性系统。",
  "从电池运行高功耗电阻负载——空调、电炉和热水器（1,500-5,000W）数小时内耗尽电池。"
];

const relatedArticles = [
  { title: "家庭电池备用规划", href: "/zh/learn/home-battery-backup-planning/" },
  { title: "家庭备用续航指南", href: "/zh/learn/home-backup-runtime-guide/" },
  { title: "LiFePO4 vs 铅酸电池", href: "/zh/learn/lifepo4-vs-lead-acid/" },
  { title: "全屋电池备用", href: "/zh/learn/whole-house-battery-backup/" },
  { title: "停电电池指南", href: "/zh/learn/power-outage-battery-guide/" },
];

const relatedCalculators = [
  { href: "/zh/fridge-battery-backup-calculator/", title: "冰箱电池备用计算器", description: "专为停电期间冰箱备用设计的电池尺寸计算。" },
  { href: "/zh/cpap-battery-backup-calculator/", title: "CPAP电池备用计算器", description: "为CPAP整夜运行设计电池尺寸。" },
  { href: "/zh/sump-pump-battery-backup-calculator/", title: "排水泵电池备用计算器", description: "确保排水泵在暴风停电期间持续运行。" },
  { href: "/zh/portable-power-station-runtime-calculator/", title: "便携式电源站续航计算器", description: "查看便携式电源站可为您的负载供电多长时间。" },
  { href: "/zh/solar-generator-sizing-calculator/", title: "太阳能发电机尺寸计算器", description: "设计含面板和电池的完整太阳能备用系统。" },
  { href: "/zh/tools/runtime-calculator/", title: "电池续航计算器", description: "根据容量和负载估算放电时间。" },
  { href: "/zh/tools/battery-sizing-calculator/", title: "电池尺寸计算器", description: "含温度降额的完整电池组尺寸设计。" },
  { href: "/zh/tools/solar-battery-sizing-calculator/", title: "太阳能电池尺寸计算器", description: "设计与太阳能板阵列配套的电池尺寸。" },
  { href: "/zh/tools/energy-conversion-calculator/", title: "能量转换计算器", description: "在任意电压下转换Ah、Wh和kWh。" },
  { href: "/zh/tools/charging-time-calculator/", title: "充电时间计算器", description: "估算太阳能或电网充电时间。" },
  { href: "/zh/tools/voltage-drop-calculator/", title: "电压降计算器", description: "设计线径以最小化电压降。" },
  { href: "/zh/tools/dc-cable-loss-calculator/", title: "直流电缆损耗计算器", description: "计算直流连接中的线路损耗。" },
];

const appliancePresets = [
  { name: "Refrigerator", runningW: 150, surgeW: 600 },
  { name: "Freezer", runningW: 120, surgeW: 500 },
  { name: "Wi-Fi Router", runningW: 12, surgeW: 12 },
  { name: "LED Light", runningW: 10, surgeW: 10 },
  { name: "Laptop", runningW: 60, surgeW: 90 },
  { name: "TV", runningW: 100, surgeW: 150 },
  { name: "CPAP Machine", runningW: 40, surgeW: 80 },
  { name: "Fan", runningW: 50, surgeW: 75 },
  { name: "Sump Pump", runningW: 800, surgeW: 2000 },
  { name: "Microwave", runningW: 1000, surgeW: 1500 },
];
---

<CalculatorLayout
  lang="zh"
  title="家庭停电电池备用计算器 | Battery Calculators"
  description="计算在停电、暴风雨、飓风、山火停电或紧急电网故障期间运行关键电器所需的电池尺寸、逆变器尺寸和备用电力系统。"
  faqItems={faqItems}
  whatIs={whatIs}
  whyItMatters={whyItMatters}
  practicalApplications={practicalApplications}
  trustSection={trustSection}
  references={references}
  expertNotes={expertNotes}
  relatedCalculators={relatedCalculators}
  commonMistakes={commonMistakes}
  relatedArticles={relatedArticles}
>

  <!-- Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mb-16">

    <!-- Input Form -->
    <CalculatorCard>
      <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">电器负载</h3>
      <div class="flex flex-col gap-5" id="appliance-list">
        <div class="flex flex-col gap-2">
          <label class="text-label-uppercase text-xs text-primary">添加电器</label>
          <div class="relative flex items-center">
            <select id="appliance-select" class="select-input w-full">
              <option value="">选择电器...</option>
              {appliancePresets.map((a) => (
                <option value={a.name} class="bg-surface-card">{a.name} ({a.runningW}W / {a.surgeW}W浪涌)</option>
              ))}
              <option value="custom" class="bg-surface-card">自定义负载...</option>
            </select>
          </div>
          <p class="text-caption text-muted">选择电器将其添加到备用计划中。</p>
        </div>

        <div id="custom-load-fields" class="hidden flex-col gap-4 p-4 bg-surface-soft border border-hairline">
          <div class="flex flex-col gap-2">
            <label for="custom-name" class="text-label-uppercase text-xs text-primary">自定义电器名称</label>
            <input id="custom-name" type="text" class="text-input w-full" placeholder="例如：水泵" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label for="custom-running" class="text-label-uppercase text-xs text-primary">运行功率</label>
              <input id="custom-running" type="number" class="text-input w-full" value={500} min={1} />
            </div>
            <div class="flex flex-col gap-2">
              <label for="custom-surge" class="text-label-uppercase text-xs text-primary">浪涌功率</label>
              <input id="custom-surge" type="number" class="text-input w-full" value={750} min={1} />
            </div>
          </div>
          <button id="add-custom-btn" type="button" class="btn-primary w-full">添加自定义负载</button>
        </div>

        <div id="selected-appliances" class="flex flex-col gap-2"></div>
      </div>

      <div class="border-t border-hairline mt-6 pt-6 flex flex-col gap-5">
        <h3 class="text-title-lg text-primary uppercase tracking-wider">备用设置</h3>

        <InputField id="backup-hours" label="备用时长" value={8} min={0.5} max={72} step={0.5} unit="小时" helperText="停电期间您需要备用电力的时长。" />

        <InputField
          id="battery-voltage"
          label="电池系统电压"
          type="select"
          value="24"
          helperText="12V用于小型便携设置，24V用于中型，48V用于全屋。"
          options={[
            { label: "12 V", value: "12" },
            { label: "24 V", value: "24" },
            { label: "48 V", value: "48" },
          ]}
        />

        <InputField
          id="battery-chemistry"
          label="电池化学类型"
          type="select"
          value="lifepo4"
          helperText="推荐LiFePO4：最安全、寿命最长、放电最深。"
          options={[
            { label: "LiFePO4", value: "lifepo4" },
            { label: "AGM / 密封铅酸", value: "agm" },
            { label: "富液式铅酸", value: "flooded" },
          ]}
        />

        <InputField id="dod-percent" label="放电深度" value={80} min={10} max={100} step={1} unit="%" helperText="由化学类型自动设置。LiFePO4：80%，铅酸：50%。可手动覆盖。" />

        <InputField id="inverter-efficiency" label="逆变器效率" value={90} min={80} max={98} step={1} unit="%" helperText="现代纯正弦波逆变器：90-95%。保守设计用90%。" />

        <InputField id="safety-margin" label="安全裕度" value={20} min={0} max={50} step={1} unit="%" helperText="温度、老化和意外负载的额外容量缓冲。" />
      </div>

      <div class="border-t border-hairline mt-6 pt-6 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="solar-enabled" class="w-4 h-4 accent-m-blue-light" />
          <label for="solar-enabled" class="text-label-uppercase text-xs text-primary cursor-pointer">启用太阳能充电</label>
        </div>

        <div id="solar-fields" class="hidden flex-col gap-5">
          <InputField id="solar-watts" label="太阳能板功率" value={400} min={50} max={10000} step={50} unit="W" helperText="连接到充电控制器的太阳能板总功率。" />

          <InputField id="peak-sun-hours" label="峰值日照时数" value={5} min={1} max={10} step={0.5} unit="小时" helperText="您所在地区的平均每日峰值日照时数。美国平均：4-6小时。" />

          <InputField id="charge-controller-efficiency" label="充电控制器效率" value={95} min={80} max={99} step={1} unit="%" helperText="MPPT控制器：95-98%。PWM控制器：80-90%。" />
        </div>
      </div>
    </CalculatorCard>

    <!-- Results -->
    <CalculatorCard class="border-m-blue-light flex flex-col justify-between">
      <div>
        <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">备用系统结果</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <ResultBox
            label="所需电池能量"
            value="0 Wh"
            suffix="总计电池组 kWh"
            variant="primary"
            id="result-battery-wh"
          />
          <ResultBox
            label="电池容量"
            value="0 Ah"
            suffix="标称电压下"
            id="result-battery-ah"
          />
          <ResultBox
            label="总运行负载"
            value="0 W"
            suffix="连续功耗"
            id="result-running-w"
          />
          <ResultBox
            label="估算浪涌"
            value="0 W"
            suffix="启动峰值"
            id="result-surge-w"
          />
          <ResultBox
            label="逆变器连续功率"
            value="0 W"
            suffix="建议最低值"
            id="result-inverter-cont"
          />
          <ResultBox
