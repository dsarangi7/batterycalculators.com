---
import Layout from "../../layouts/Layout.astro";
import CalculatorCard from "../../components/CalculatorCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQSection from "../../components/FAQSection.astro";

const resources = [
  {
    title: "LiFePO4 电压表",
    description:
      "按充电状态划分的 12V、24V 和 48V LiFePO4 电池 resting 电压参考表。",
    category: "参考图表",
    href: "/zh/learn/lifepo4-voltage-chart/",
    tags: ["lifepo4", "电压", "SOC"],
  },
  {
    title: "SOC 参考图表",
    description:
      "LiFePO4 电池充电状态参考及说明，包括为什么电压行为在中 SOC 时可能产生误导。",
    category: "参考图表",
    href: "/zh/learn/lifepo4-soc-chart/",
    tags: ["SOC", "充电状态", "估算"],
  },
  {
    title: "电池选型参考",
    description:
      "房车、太阳能、船舶、家庭备用和商业 BESS 应用的实用电池选型表。",
    category: "参考",
    href: "/zh/learn/battery-sizing-reference/",
    tags: ["选型", "规划", "参考"],
  },
  {
    title: "C-Rate 参考",
    description:
      "C-Rate 参考，将放电/充电电流转换为电池容量（反之亦然）。",
    category: "参考表",
    href: "/zh/learn/battery-c-rate-reference/",
    tags: ["C-rate", "充电", "放电"],
  },
  {
    title: "温度校正图表",
    description:
      "温度如何影响可用容量、充电行为和衰减风险，附校正系数。",
    category: "参考图表",
    href: "/zh/learn/battery-temperature-correction-chart/",
    tags: ["温度", "校正", "容量"],
  },
];

const faqItems = [
  {
    question: "这些资源是什么？",
    answer:
      "这些是关于关键电池工程主题的参考页面——图表、表格和选型指南——撰写时易于在设计和排查电池系统时查阅。",
  },
  {
    question: "这些参考对真实项目实用吗？",
    answer:
      "是的。图表和表格基于标准工程关系和我们经过验证的假设。实际结果仍取决于电池化学、温度、年龄和运行条件。",
  },
  {
    question: "参考多久更新一次？",
    answer:
      "它们随底层工程指南的修订而更新。当发生重大变更（新化学、修正或改进的表格）时，参考内容会刷新。",
  },
];
---

<Layout
  title="免费电池工程资源 — 速查表与工作表 | 电池计算器"
  description="免费电池工程资源：参考图表、电压表、选型指南和太阳能、房车及船舶应用的规划参考。"
  canonical="https://batterycalculators.com/zh/resources/"
  lang="zh"
  faqItems={faqItems}
>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 border-b border-hairline pb-8">
      <a
        href="/zh/"
        class="text-label-uppercase text-xs text-muted hover:text-primary transition-colors mb-4 inline-block"
        >&larr; 首页</a
      >
      <Breadcrumb items={[{ label: "资源" }]} />
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4"
        >参考资源</span
      >
      <h1 class="text-display-md text-primary mb-6">
        电池工程参考资源
      </h1>
      <p class="text-body-md text-body font-light">
        电池系统设计的图表、表格和选型参考。在规划和设计您的系统时，
        将这些页面作为快速参考。
      </p>
    </div>

    <div class="flex flex-col gap-12">
      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-6">
          可用资源
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            resources.map((resource) => (
              <CalculatorCard class="flex flex-col justify-between">
                <div>
                  <span class="text-label-uppercase text-m-blue-light text-[10px] block mb-2">
                    {resource.category}
                  </span>
                  <h3 class="text-title-lg text-primary mb-3">
                    {resource.title}
                  </h3>
                  <p class="text-body-sm text-muted mb-4">
                    {resource.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {resource.tags.map((tag) => (
                      <span class="text-[10px] text-primary border border-hairline px-2 py-0.5 uppercase tracking-wider">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="flex gap-3">
                  <a
                    href={resource.href}
                    class="btn-primary text-xs py-3 px-6 inline-block"
                  >
                    打开参考
                  </a>
                </div>
              </CalculatorCard>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">
          如何使用这些资源
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">1. 打开参考</h4>
            <p class="text-body-sm text-muted">
              选择您需要的参考，直接在浏览器中查看图表或表格。
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">
              2. 作为快速参考使用
            </h4>
            <p class="text-body-sm text-muted">
              在设计、验证或调整电池系统时随身携带参考。
            </p>
          </CalculatorCard>
          <CalculatorCard>
            <h4 class="text-primary font-bold mb-2">
              3. 用计算器验证
            </h4>
            <p class="text-body-sm text-muted">
              将这些参考与我们的在线计算器搭配使用，定制结果以适应您的电池和负载条件。
            </p>
          </CalculatorCard>
        </div>
      </section>

      <section>
        <h2 class="text-title-lg text-primary uppercase tracking-wider mb-4">
          相关计算器
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">续航计算器</h4>
            <p class="text-body-sm text-muted mb-3">
              计算您特定电池和负载配置的精确续航时间。
            </p>
            <a
              href="/zh/tools/runtime-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >打开计算器 →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">
              电池选型计算器
            </h4>
            <p class="text-body-sm text-muted mb-3">
              从负载、续航和化学要求选型电池组。
            </p>
            <a
              href="/zh/tools/battery-sizing-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >打开计算器 →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">SOC 估算器</h4>
            <p class="text-body-sm text-muted mb-3">
              从电压或库仑计数估算充电状态。
            </p>
            <a
              href="/zh/tools/soc-estimator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >打开计算器 →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">太阳能电池选型</h4>
            <p class="text-body-sm text-muted mb-3">
              从日耗电量和自主天数选型太阳能电池组。
            </p>
            <a
              href="/zh/tools/solar-battery-sizing-calculator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >打开计算器 →</a
            >
          </CalculatorCard>
          <CalculatorCard class="border-m-blue-light">
            <h4 class="text-primary font-bold mb-2">电池护照生成器</h4>
            <p class="text-body-sm text-muted mb-3">
              创建结构化的电池生命周期和合规准备报告。
            </p>
            <a
              href="/zh/battery-passport-generator/"
              class="text-label-uppercase text-m-blue-light text-xs hover:text-primary transition-colors"
              >打开生成器 →</a
            >
          </CalculatorCard>
        </div>
      </section>

      <FAQSection items={faqItems} />
    </div>
  </div>
</Layout>