---
import Layout from "../../layouts/Layout.astro";

const popularCalculators = [
  {
    title: "电池续航时间计算器",
    url: "/zh/tools/runtime-calculator/",
    description:
      "由容量、负载与效率估算电池放电续航时间。",
  },
  {
    title: "太阳能蓄电池计算器",
    url: "/zh/tools/solar-battery-sizing-calculator/",
    description:
      "由日耗电与备用天数规划太阳能蓄电池容量。",
  },
  {
    title: "电池组计算器",
    url: "/zh/tools/battery-pack-calculator/",
    description:
      "由单体规格与串并数设计电池组电压容量。",
  },
];
---

<Layout
  title="页面未找到｜电池计算器"
  description="您访问的页面不存在，请使用中文电池计算器或返回首页。"
  canonical="https://batterycalculators.com/zh/404/"
  lang="zh"
>
  <div class="max-w-[700px] mx-auto text-center py-12 md:py-20">
    <!-- Error Code -->
    <span class="text-label-uppercase text-m-blue-light text-xs block mb-4"
      >错误</span
    >
    <h1 class="text-display-lg text-primary mb-6">404</h1>
    <p
      class="text-body-md text-body font-light mb-10 mx-auto whitespace-normal"
    >
      您访问的页面不存在或已移动，请检查网址或使用下方导航。
    </p>

    <!-- Action Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16"
    >
      <a href="/zh/" class="btn-primary text-xs">首页</a>
      <a href="/zh/tools/" class="btn-primary-outline text-xs">浏览计算器</a
      >
      <a href="/zh/tools/runtime-calculator/" class="btn-primary-outline text-xs">续航计算器</a>
    </div>

    <!-- Popular Calculators -->
    <div class="border-t border-hairline pt-12">
      <span class="text-label-uppercase text-primary text-xs block mb-6"
        >热门计算器</span
      >
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          popularCalculators.map((calc) => (
            <a
              href={calc.url}
              class="bg-surface-card border border-hairline p-6 flex flex-col gap-3 hover:border-primary transition-colors text-left group"
            >
              <span class="text-title-md text-primary group-hover:text-m-blue-light transition-colors">
                {calc.title}
              </span>
              <span class="text-body-sm text-muted">{calc.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
