---
import Layout from '../../layouts/Layout.astro';

const popularCalculators = [
  { title: "续航计算器", url: "/zh/tools/runtime-calculator/", description: "根据容量、负载和效率估算电池续航时间。" },
  { title: "太阳能电池选型计算器", url: "/zh/tools/solar-battery-sizing-calculator/", description: "根据日耗电量和自主天数选型太阳能电池组。" },
  { title: "电池组计算器", url: "/zh/tools/battery-pack-calculator/", description: "从单体电芯设计电池组，支持串并联配置。" },
];
---

<Layout
  title="服务器错误 | 电池计算器"
  description="发生意外错误。请重试或浏览我们的电池计算器和学习资源。"
  canonical="https://batterycalculators.com/zh/500/"
  lang="zh"
>
  <div class="max-w-3xl mx-auto text-center py-12 md:py-20">
    <!-- Error Code -->
    <span class="text-label-uppercase text-m-red text-xs block mb-4">错误</span>
    <h1 class="text-display-lg text-primary mb-6">500</h1>
    <p class="text-body-md text-body font-light mb-10 max-w-lg mx-auto">
      出现问题。发生意外错误。请重试或使用以下链接继续浏览。
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="/zh/" class="btn-primary text-xs">返回首页</a>
      <a href="/zh/tools/" class="btn-primary-outline text-xs">浏览计算器</a>
      <a href="/zh/learn/" class="btn-primary-outline text-xs">学习中心</a>
    </div>

    <!-- Popular Calculators -->
    <div class="border-t border-hairline pt-12">
      <span class="text-label-uppercase text-primary text-xs block mb-6">热门计算器</span>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {popularCalculators.map((calc) => (
          <a
            href={calc.url}
            class="bg-surface-card border border-hairline p-6 flex flex-col gap-3 hover:border-primary transition-colors text-left group"
          >
            <span class="text-title-md text-primary group-hover:text-m-blue-light transition-colors">
              {calc.title}
            </span>
            <span class="text-body-sm text-muted">
              {calc.description}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>