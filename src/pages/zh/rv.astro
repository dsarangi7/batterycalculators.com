---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryToolGrid from '../../components/CategoryToolGrid.astro';
import FAQSection from '../../components/FAQSection.astro';

const tools = [
  {
    name: "RV电池计算器",
    href: "/zh/tools/rv-battery-calculator/",
    description: "计算您的房车或露营车所需的电池组尺寸。估算露营旅行的每日消耗量和所需容量。",
    available: true,
  },
  {
    name: "逆变器电池计算器",
    href: "/zh/tools/inverter-battery-calculator/",
    description: "考虑放电深度和效率调整，计算交流逆变器负载所需的电池容量。",
    available: true,
  },
  {
    name: "露营车电池运行时间",
    href: "/zh/tools/runtime-calculator/",
    description: "估算您的露营车电池在野外露营时为照明、冰箱、风扇和设备供电的时长。",
    available: true,
  },
  {
    name: "逆变器电池匹配",
    href: "/zh/tools/energy-conversion-calculator/",
    description: "进行安时与瓦时的换算，将逆变器负载需求与电池容量匹配。",
    available: true,
  },
];

const learnArticles = [
  { title: "RV电池尺寸指南", href: "/learn/rv-battery-sizing-guide/" },
  { title: "露营车电池运行时间指南", href: "/learn/camper-battery-runtime-guide/" },
  { title: "房车生活电池规划", href: "/learn/van-life-battery-planning/" },
  { title: "RV需要多少电池？", href: "/learn/how-many-batteries-for-rv/" },
  { title: "RV锂电池指南", href: "/learn/rv-lithium-battery-guide/" },
  { title: "如何配置电池组尺寸", href: "/learn/how-to-size-a-battery-bank/" },
  { title: "电池尺寸参考", href: "/learn/battery-sizing-reference/" },
  { title: "LiFePO4电压表", href: "/learn/lifepo4-voltage-chart/" },
  { title: "RV最佳电池化学体系", href: "/learn/best-battery-chemistry-for-rv/" },
  { title: "12V与24V RV电池对比", href: "/learn/12v-vs-24v-rv-batteries/" },
];

const faqItems = [
  {
    question: "我的RV需要多少电池？",
    answer: "周末露营通常一块100Ah 12V LiFePO4电池就能为照明、水泵、手机充电和小型冰箱提供足够电力。全职房车生活或长时间野外露营建议使用12V 200–400Ah（或24V系统）以为微波炉、咖啡机和娱乐系统等电器供电。",
  },
  {
    question: "RV使用的最佳电池化学体系是什么？",
    answer: "LiFePO4（磷酸铁锂）是RV应用推荐的化学体系。它提供80–90%的可用容量（铅酸电池为50%），3000–5000次循环寿命，重量减轻50%，且免维护。较高的初始成本被3–5倍更长的使用寿命和RV环境中出色的性能所抵消。",
  },
  {
    question: "我的RV应该使用12V还是24V系统？",
    answer: "12V是大多数RV的标准，兼容最广泛的电器和配件。24V对于较大系统（超过2kW）具有优势，因为它将电流减半，降低线缆成本和电压降。如果您从零开始构建有较大功率需求的新系统，24V值得考虑。",
  },
  {
    question: "野外露营时RV电池能用多久？",
    answer: "运行时间取决于电池容量和每日负载。典型的周末露营者使用100Ah LiFePO4电池运行照明（50W）、冰箱（60W）、水泵（间歇性）和手机充电，充电间隔预计2–3天。拥有300Ah+系统和太阳能板的全职野外露营者通过谨慎的负载管理可以无限期使用。",
  },
  {
    question: "我的RV电池系统需要太阳能板吗？",
    answer: "强烈推荐为RV电池系统配备太阳能板，特别是长时间野外露营。200–400W太阳能阵列每天可补充600–1200Wh，覆盖大多数中等RV设置的日常消耗。没有太阳能的话，您需要运行发电机或开车去充电，两者都有局限性。",
  },
];

const relatedCategories = [
  { href: "/zh/solar/", title: "太阳能", description: "太阳能电池尺寸和离网规划" },
  { href: "/zh/marine/", title: "船舶", description: "船舶和游艇电池系统" },
  { href: "/zh/engineering/", title: "工程工具", description: "C倍率、SOC、电压降和线缆损耗工具" },
];

const breadcrumbItems = [
  { label: "RV与露营车" },
];
---

<Layout
  title="RV与露营车电池计算器 | Battery Calculators"
  description="免费的RV电池计算器，用于露营车电池尺寸、房车生活运行时间和逆变器电池匹配。"
  schema="website"
  schemaName="RV与露营车电池计算器"
  schemaDescription="用于RV、露营车和房车生活电源系统的工程级电池计算器。"
  breadcrumbs={[{ label: 'RV与露营车' }]}
  lang="zh"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mb-12 md:mb-16 border-b border-hairline pb-12">
    <div class="max-w-4xl">
      <span class="text-label-uppercase text-m-blue-light text-xs block mb-4">RV与露营车</span>
      <h1 class="text-display-md text-primary mb-6">RV与露营车电池计算器</h1>
      <p class="text-body-md text-body max-w-2xl font-light">
        使用工程级工具规划您的RV或露营车电池系统。为野外露营配置家用电池尺寸，估算电器运行时间，匹配逆变器负载与电池容量。
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="max-w-4xl text-body-md text-body font-light flex flex-col gap-6">
      <p>
        RV电池系统必须平衡三个在固定应用中很少同时存在的约束条件：有限空间、有限重量以及对可靠离网电力的需求。与家庭备用系统中电池尺寸仅受预算限制不同，RV安装必须适应车辆的承载能力和可用隔间尺寸。
      </p>
      <p>
        RV电池设计的第一步是列出您计划运行的所有电气负载。常见的RV负载包括LED照明（总计10–20W）、12V压缩机冰箱（40–60W连续，200–400Wh/天）、水泵（间歇性）、通风风扇（每个5–15W）、手机和笔记本电脑充电（50–100Wh/天）以及娱乐系统（50–200W）。对于配备微波炉、咖啡机或空调的露营车，您将需要显著的逆变器和电池组。
      </p>
      <p>
        系统电压选择影响成本和性能。12V系统最常见，兼容最广泛的RV电器和配件。对于超过2kW连续负载的较大系统，24V将电流减半，允许使用更细的线缆并减少电压降。我们的计算器帮助您根据具体负载情况评估12V和24V配置之间的权衡。
      </p>
      <p>
        锂LiFePO4电池已成为专业RV应用的标准。其80–90%的放电深度意味着您可以在不损害循环寿命的情况下使用几乎全部额定容量。一块200Ah 12V LiFePO4电池在约50磅重量下提供2,048Wh可用能量，而铅酸电池组需要400Ah（且超过130磅）在50%放电深度下提供相同的可用能量。
      </p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-title-lg text-primary mb-6">可用计算器</h2>
    <CategoryToolGrid tools={tools} />
  </section>

  {learnArticles.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">RV与露营车指南</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learnArticles.map((article) => (
          <a href={article.href} class="bg-surface-card border border-hairline p-4 hover:border-primary transition-colors">
            <span class="text-label-uppercase text-muted text-[10px] block mb-2">学习中心</span>
            <h3 class="text-title-sm text-primary">{article.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <FAQSection items={faqItems} />

  {relatedCategories.length > 0 && (
    <section class="mb-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg text-primary mb-6">相关分类</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {relatedCategories.map((cat) => (
          <a href={cat.href} class="bg-surface-card border border-hairline p-6 hover:border-primary transition-colors block">
            <h3 class="text-title-md text-primary mb-2">{cat.title}</h3>
            <p class="text-body-sm text-muted">{cat.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-surface-soft border border-hairline p-6 text-caption text-muted mb-8">
    <span class="text-primary font-bold text-[10px] tracking-wider uppercase border border-hairline px-1.5 py-0.5 mr-2 inline-block mb-3">
      工程免责声明
    </span>
    所有计算器仅提供尺寸估算。实际运行时间取决于电池寿命、温度、负载特性和线缆损耗。安全关键的RV电气系统请核实计算结果。
  </section>
</Layout>
