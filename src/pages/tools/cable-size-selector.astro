---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import InputField from '../../components/InputField.astro';
import ResultBox from '../../components/ResultBox.astro';
import FormulaBox from '../../components/FormulaBox.astro';
import FAQSection from '../../components/FAQSection.astro';
import WorkedExample from '../../components/WorkedExample.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import EngineeringDiagram from '../../components/EngineeringDiagram.astro';

const whatIs = `Cable sizing for DC power systems determines the minimum conductor cross-section that satisfies both <strong>ampacity</strong> (thermal current-carrying capacity) and <strong>voltage drop</strong> limits. Ampacity is governed by IEC/National Electrical Code standards and prevents insulation melting from resistive heating. Voltage drop depends on current, cable length, conductor material, and cross-sectional area — and must stay below application-specific thresholds (3% for marine critical loads, 2% for solar DC wiring). The correct cable size is the larger of the two minimums: the ampacity-minimum and the voltage-drop-minimum. Undersized cables cause overheating, equipment malfunction, and wasted energy through I²R losses.`;

const whyItMatters = [
  "Undersized cables cause voltage drop that triggers BMS low-voltage disconnects and inverter shutdowns.",
  "A cable safe by ampacity standards may still exhibit unacceptable voltage drop over long runs.",
  "In 12V systems, a 0.5V drop represents 4% loss — enough to dim lights and crash electronics.",
  "Higher system voltages (48V vs 12V) reduce current for the same power, dramatically reducing cable requirements.",
  "Copper resistance increases by 0.393% per °C — hot environments demand larger cables.",
];

const practicalApplications = [
  { title: "Marine Electrical Systems", description: "Size battery cables to meet ISO 13297 voltage drop limits for navigation and propulsion." },
  { title: "Solar PV DC Wiring", description: "Calculate wire sizing for charge controller to battery bank runs." },
  { title: "Automotive & RV", description: "Size battery-to-inverter cables for high-current 12V and 24V systems." },
  { title: "Off-Grid Cabin Wiring", description: "Select cable sizes for long runs between remote battery banks and loads." },
  { title: "Telecom DC Distribution", description: "Verify cable sizing for 48V DC power distribution to telecom equipment." },
];

const expertNotes = [
  { title: 'Dual-Criteria Sizing', variant: 'engineering', content: 'Always check BOTH ampacity and voltage drop. A cable can be thermally safe (ampacity OK) but still exhibit excessive voltage drop over long runs. The final cable size is the larger of the two minimums.' },
  { title: 'Temperature Derating', variant: 'warning', content: 'Copper resistance increases by 0.393% per °C. At 60°C (engine compartment), cable resistance is 15.7% higher than at 20°C. Always account for actual operating temperature, not ambient room temperature.' },
];

const trustSection = {
  text: "This calculator uses the standard resistivity-based voltage drop model with temperature correction factors. Ampacity values follow IEC 60364 and NEC Chapter 3 tables. All formulas and intermediate values are displayed for independent verification.",
  link: { label: "View our full methodology", href: "/methodology" },
};

const references = [
  { title: "IEC 60364 — Low-Voltage Electrical Installations", url: "https://www.iec.ch/", source: "International Electrotechnical Commission" },
  { title: "NEC Chapter 3 — Wiring Methods and Materials", url: "https://www.nfpa.org/codes-and-standards/nfpa-70-standard-for-electrical-safety-in-the-workplace", source: "NFPA / National Electrical Code" },
  { title: "ISO 13297 — Marine Electrical Installation", url: "https://www.iso.org/standard/68333.html", source: "International Organization for Standardization" },
  { title: "Copper Development Association — Wire Tables", url: "https://www.copper.org/", source: "Copper Development Association" },
];

const faqItems = [
  {
    question: "What is the difference between ampacity and voltage drop sizing?",
    answer: "Ampacity is the maximum current a cable can carry without overheating (fire safety). Voltage drop is the voltage lost along the cable length (performance). You must satisfy BOTH criteria — use the larger cable size.",
  },
  {
    question: "Why is voltage drop more critical in 12V systems?",
    answer: "A 400W load draws 33A at 12V but only 8.3A at 48V. At 12V, a 0.5V drop is 4.2% loss. At 48V, the same cable produces only a 0.12V drop (0.25%). Higher voltage dramatically reduces cable requirements.",
  },
  {
    question: "What AWG wire do I need for 30 amps at 5 meters?",
    answer: "For 30A at 5m on a 12V system with 3% max drop: 6 AWG (13.3 mm²) copper. At 48V, 10 AWG (5.26 mm²) suffices. Always verify ampacity as well — 10 AWG is rated for 30A in free air.",
  },
  {
    question: "Should I use copper or aluminum cable?",
    answer: "Copper is preferred for most battery/solar installations: lower resistance, higher flexibility, no oxidation issues. Aluminum is lighter and cheaper but needs 1.6× the cross-sectional area and anti-oxidant compound at connections.",
  },
  {
    question: "What is an acceptable voltage drop percentage?",
    answer: "DC power systems: 3% max for critical loads (navigation, safety), 5% for general loads, 10% for non-critical lighting. Solar DC wiring targets ≤2% between charge controller and battery.",
  },
  {
    question: "How does cable length affect voltage drop?",
    answer: "Voltage drop is directly proportional to length. Doubling the cable distance doubles the drop. For a 5m cable with 0.5V drop, a 10m cable will have 1.0V drop at the same current and wire size.",
  },
  {
    question: "Can I use a cable that passes ampacity but fails voltage drop?",
    answer: "No. The cable will be thermally safe but equipment will malfunction due to insufficient voltage. Voltage drop sizing is a performance requirement, not just a recommendation.",
  },
  {
    question: "How does temperature affect cable sizing?",
    answer: "Higher temperatures increase conductor resistance (0.393%/°C for copper). A cable rated for 30A at 20°C may only carry 25A at 60°C. Always derate ampacity for actual operating temperature.",
  },
  {
    question: "What is loop resistance?",
    answer: "Loop resistance is the total resistance of both the positive and return conductors. Since current flows out and back, the total cable length is 2× the one-way distance. Loop resistance = ρ × (2 × distance) / area.",
  },
  {
    question: "How do I measure actual voltage drop?",
    answer: "Measure voltage at battery terminals under load, then at load terminals under the same load. The difference is voltage drop. Compare the percentage to your system limits.",
  },
];

const commonMistakes = [
  "Using one-way distance instead of loop distance — voltage drop applies to both supply and return conductors. Always double the one-way distance.",
  "Checking only ampacity, not voltage drop — a cable safe by thermal standards can still cause equipment malfunction over long runs.",
  "Ignoring temperature effects — at 60°C, copper resistance is 15.7% higher than at 20°C. Hot environments need larger cables.",
  "Using nominal voltage instead of actual battery voltage — a 0.5V drop at 12.8V is 3.9%, but at 12.0V it is 4.2%.",
  "Forgetting connection resistance — corroded terminals and loose bolts add significant resistance not included in cable-only calculations.",
  "Using aluminum without upsizing — aluminum requires 1.6× the cross-sectional area of copper for equivalent voltage drop.",
  "Not considering peak vs average current — voltage drop is proportional to current. Peak loads cause transient voltage dips that trigger BMS faults.",
  "Assuming cable size is the same for all voltages — a 2kW load needs 167A at 12V but only 42A at 48V, requiring dramatically different cables.",
];

const relatedArticles = [
  { href: "/learn/voltage-drop-explained", title: "Voltage Drop Explained" },
  { href: "/learn/dc-cable-sizing-guide", title: "DC Cable Sizing Guide" },
  { href: "/learn/marine-wire-sizing", title: "Marine Wire Sizing" },
];
---

<CalculatorLayout
  title="Cable Size Selector | Battery Calculators"
  description="Select the correct cable size for your DC system based on voltage drop limits, ampacity, and conductor material."
  faqItems={faqItems}
  commonMistakes={commonMistakes}
  relatedArticles={relatedArticles}
  relatedCalculators={[
    { href: "/tools/voltage-drop-calculator", title: "Voltage Drop Calculator", description: "Calculate voltage drop for a specific cable." },
    { href: "/tools/dc-cable-loss-calculator", title: "DC Cable Loss", description: "Calculate resistive power losses directly." },
    { href: "/tools/battery-sizing-calculator", title: "Battery Sizing Tool", description: "Determine daily consumption sizing requirements." },
    { href: "/tools/parallel-string-calculator", title: "Parallel String Tool", description: "Configure series and parallel strings layout." },
    { href: "/tools/runtime-calculator", title: "Runtime Calculator", description: "Compute runtime from load wattage profiles." },
    { href: "/tools/battery-pack-calculator", title: "Battery Pack Calculator", description: "Design series/parallel cell configurations." },
  ]}
  whatIs={whatIs}
  whyItMatters={whyItMatters}
  practicalApplications={practicalApplications}
  trustSection={trustSection}
  references={references}
  expertNotes={expertNotes}
>

  <!-- Main Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mb-16">

    <!-- Input Form -->
    <CalculatorCard>
      <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">System Parameters</h3>
      <div class="flex flex-col gap-6">
        <InputField id="voltage" label="System DC Voltage (V)" value={12.8} min={1} step="any" helperText="Nominal battery voltage. Common: 12.8V, 25.6V, 51.2V." />
        <InputField id="power" label="Load Power (Watts)" value={500} min={1} step="any" helperText="Total continuous power draw from the battery." />
        <InputField id="distance" label="One-Way Cable Distance (meters)" value={5} min={0.1} step="any" helperText="Distance from battery to load. The calculator doubles this for loop." />
        <InputField
          id="material"
          label="Conductor Material"
          type="select"
          value="copper"
          options={[
            { label: "Copper (High conductivity)", value: "copper" },
            { label: "Aluminum (Lower cost, lighter)", value: "aluminum" },
          ]}
        />
        <InputField id="temperature" label="Operating Temperature (°C)" value={30} min={-40} max={200} helperText="Ambient temperature where cable is installed. Affects resistance." />
        <InputField id="max-drop" label="Max Allowable Voltage Drop (%)" value={3} min={0.5} max={10} step={0.5} helperText="Marine critical: 3%, Solar DC: 2%, General: 5%, Non-critical: 10%." />
      </div>
    </CalculatorCard>

    <!-- Calculation Results -->
    <CalculatorCard class="border-m-blue-light flex flex-col justify-between">
      <div>
        <h3 class="text-title-lg text-primary mb-6 uppercase tracking-wider">Cable Recommendation</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <ResultBox
            label="Recommended Cable Size"
            value="6 AWG"
            suffix="13.3 mm² copper"
            variant="primary"
            id="result-cable"
          />
          <ResultBox
            label="Voltage Drop"
            value="2.48%"
            suffix="0.32V along loop"
            id="result-drop"
          />
          <ResultBox
            label="Load Current"
            value="39.1 A"
            suffix="Continuous draw"
            id="result-current"
          />
          <ResultBox
            label="Power Loss in Cable"
            value="12.4 W"
            suffix="2.48% of load power"
            id="result-loss"
          />
        </div>
      </div>

      <!-- Action Area -->
      <div class="border-t border-hairline pt-6">
        <h4 class="text-label-uppercase text-primary text-xs mb-2">Cable Sizing Notes</h4>
        <p class="text-body-sm text-muted" id="cable-notes">
          At 12.8V, the recommended cable meets both the voltage drop limit and ampacity requirements. Check both criteria before selecting.
        </p>
      </div>
    </CalculatorCard>

  </div>

  <!-- AWG Voltage Drop Table -->
  <section class="mb-16 border-t border-hairline pt-12">
    <h2 class="text-title-lg text-primary uppercase mb-6 tracking-wider">Voltage Drop by AWG Size</h2>
    <p class="text-body-sm text-muted mb-8">Interactive voltage drop comparison for your system parameters. The highlighted row meets your voltage drop limit.</p>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b border-hairline">
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">AWG Size</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Area (mm²)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Ampacity (A)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Voltage Drop (%)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Power Loss (W)</th>
            <th class="text-label-uppercase text-xs text-primary p-3 text-left">Status</th>
          </tr>
        </thead>
        <tbody id="awg-table-body">
        </tbody>
      </table>
    </div>
  </section>

  <!-- Technical Explanation and Equations -->
  <section class="mb-16 border-t border-hairline pt-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

      <FormulaBox title="Mathematical Formulas">
        <p>
          Cable sizing requires satisfying two independent criteria — ampacity and voltage drop:
        </p>
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          Load Current (A) = Power (W) / System Voltage (V)
        </div>
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          Loop Resistance (Ω) = ρ(T) × (2 × Distance) / Area
        </div>
        <p>
          Where ρ(T) is temperature-corrected resistivity:
        </p>
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          ρ(T) = ρ(20°C) × [1 + α × (T - 20)]
        </div>
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          Voltage Drop (%) = (I × R_loop / V_source) × 100
        </div>
        <div class="bg-surface-soft p-4 font-mono text-primary border border-hairline my-2">
          Min Area for Drop = ρ(T) × 2L / R_max
          where R_max = (V × max_drop%) / (100 × I)
        </div>
      </FormulaBox>

      <div class="flex flex-col gap-8">
        <h2 class="text-title-lg text-primary uppercase mb-2 tracking-wider">Worked Engineering Examples</h2>

        <WorkedExample
          number={1}
          title="12V Marine Navigation Circuit — 30A, 5m"
          scenario="Size a copper cable for a 30A navigation light circuit with a 5m one-way run on a 12.8V system at 25°C. Maximum 3% voltage drop."
          inputs={[
            { label: "System Voltage", value: "12.8 V" },
            { label: "Load Current", value: "30 A" },
            { label: "One-Way Distance", value: "5 m (10 m loop)" },
            { label: "Conductor", value: "Copper at 25°C" },
            { label: "Max Drop", value: "3%" },
          ]}
          steps={[
            { label: "Step 1: Max allowed resistance", formula: "R_max = (12.8 × 0.03) / 30", result: "0.0128 Ω" },
            { label: "Step 2: Required cable area", formula: "A = 1.72×10⁻⁸ × 10 / 0.0128", result: "13.44 mm²" },
            { label: "Step 3: Select AWG", formula: "13.44 mm² → 6 AWG (13.3 mm²)", result: "6 AWG" },
            { label: "Step 4: Actual voltage drop", formula: "V_drop = 30 × (1.72e-8 × 10 / 13.3e-6)", result: "0.388V (3.03%)" },
          ]}
          answer="6 AWG (13.3 mm²) copper — meets 3% voltage drop limit."
          interpretation="At 3.03%, this is right at the limit. For comfortable margin, 4 AWG (21.15 mm²) reduces drop to 1.9%. For critical navigation, always add margin."
          variant="marine"
        />

        <WorkedExample
          number={2}
          title="48V Solar System — 20A Charge Controller, 15m"
          scenario="A 48V solar system with 20A charge controller output over a 15m cable run at 35°C. Solar DC wiring targets ≤2% drop."
          inputs={[
            { label: "System Voltage", value: "51.2 V" },
            { label: "Charge Current", value: "20 A" },
            { label: "One-Way Distance", value: "15 m (30 m loop)" },
            { label: "Conductor", value: "Copper at 35°C" },
            { label: "Max Drop", value: "2%" },
          ]}
          steps={[
            { label: "Step 1: Temp-corrected resistivity", formula: "ρ(35°C) = 1.72×10⁻⁸ × [1 + 0.00393 × 15]", result: "1.82×10⁻⁸ Ω·m" },
            { label: "Step 2: Max allowed resistance", formula: "R_max = (51.2 × 0.02) / 20", result: "0.0512 Ω" },
            { label: "Step 3: Required cable area", formula: "A = 1.82×10⁻⁸ × 30 / 0.0512", result: "10.66 mm²" },
            { label: "Step 4: Select AWG", formula: "10.66 mm² → 8 AWG (8.37) or 6 AWG (13.3)", result: "6 AWG recommended" },
          ]}
          answer="6 AWG (13.3 mm²) copper — achieves 1.44% voltage drop, well within 2% target."
          interpretation="Higher system voltage (48V vs 12V) keeps current low. With 15m distance, 6 AWG provides comfortable margin below the 2% solar DC target."
          variant="solar"
        />

        <WorkedExample
          number={3}
          title="12V RV Inverter — 2000W, 1m"
          scenario="A 2000W inverter draws 167A from a 12V battery. Size cable for a 1m run with ≤3% drop."
          inputs={[
            { label: "Inverter Power", value: "2000 W" },
            { label: "System Voltage", value: "12.8 V" },
            { label: "Load Current", value: "167 A" },
            { label: "One-Way Distance", value: "1 m (2 m loop)" },
            { label: "Max Drop", value: "3%" },
          ]}
          steps={[
            { label: "Step 1: Max allowed resistance", formula: "R_max = (12.8 × 0.03) / 167", result: "0.0023 Ω" },
            { label: "Step 2: Required cable area", formula: "A = 1.72×10⁻⁸ × 2 / 0.0023", result: "14.96 mm²" },
            { label: "Step 3: Select AWG", formula: "14.96 mm² → 4 AWG (21.15 mm²)", result: "4 AWG" },
          ]}
          answer="4 AWG (21.15 mm²) copper — achieves 1.38% voltage drop."
          interpretation="High-current 12V systems demand very thick cables. This is why 24V or 48V systems are preferred for loads above 2kW — they reduce cable requirements dramatically."
          variant="rv"
        />

      </div>
    </div>
  </section>

  <EngineeringDiagram
    title="DC Cable Sizing System"
    description="From battery through cable to load, showing where voltage is lost and current is limited"
    variant="circuit"
    steps={[
      { label: "Battery Source", icon: "battery" },
      { label: "Positive Cable", icon: "cable" },
      { label: "Connected Load", icon: "load" },
      { label: "Return Cable", icon: "cable" },
    ]}
  />

  <ComparisonTable
    title="Acceptable Voltage Drop by Application"
    headers={["Application", "Max Drop", "Standard", "Target", "Notes"]}
    rows={[
      ["Marine Critical", "3%", "ISO 13297", "1% preferred", "Navigation, bilge pumps, electronics"],
      ["Solar DC Wiring", "2%", "NEC 690", "1%", "Charge controller to battery"],
      ["Automotive", "2%", "SAE J1127", "1%", "Battery to starter, ignition"],
      ["Telecom 48V", "1%", "ITU-T", "0.5%", "DC power distribution"],
      ["General DC", "3%", "IEEE", "1%", "Battery to load systems"],
      ["Non-Critical Lighting", "10%", "ISO 13297", "5%", "Cabin lights, domestic loads"],
    ]}
    caption="Industry standards for maximum allowable voltage drop in DC systems"
  />

  <ComparisonTable
    title="Copper vs Aluminum — Cable Sizing"
    headers={["Parameter", "Copper", "Aluminum", "Ratio"]}
    rows={[
      ["Resistivity (Ω·m)", "1.72×10⁻⁸", "2.82×10⁻⁸", "1.64×"],
      ["Area for same drop", "1.0×", "1.6×", "Al needs 60% more"],
      ["Weight per meter", "1.0×", "0.5×", "Al is 50% lighter"],
      ["Cost per ampacity", "1.0×", "0.6×", "Al is 40% cheaper"],
      ["Oxidation risk", "Low", "High", "Al needs anti-oxidant"],
      ["Flexibility", "High", "Low", "Cu preferred for tight runs"],
    ]}
    caption="Material comparison for DC power conductors"
  />

  <FAQSection items={faqItems} />

  <!-- Calculation Script -->
  <script>
    const voltageInput = document.getElementById('voltage') as HTMLInputElement;
    const powerInput = document.getElementById('power') as HTMLInputElement;
    const distanceInput = document.getElementById('distance') as HTMLInputElement;
    const materialSelect = document.getElementById('material') as HTMLSelectElement;
    const temperatureInput = document.getElementById('temperature') as HTMLInputElement;
    const maxDropInput = document.getElementById('max-drop') as HTMLInputElement;

    // Result elements
    const resultCableBox = document.getElementById('result-cable');
    const resultCableValue = resultCableBox?.querySelector('.text-display-md') as HTMLElement;
    const resultCableNote = resultCableBox?.querySelector('.text-caption') as HTMLElement;

    const resultDropBox = document.getElementById('result-drop');
    const resultDropValue = resultDropBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultDropNote = resultDropBox?.querySelector('.text-caption') as HTMLElement;

    const resultCurrentBox = document.getElementById('result-current');
    const resultCurrentValue = resultCurrentBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultCurrentNote = resultCurrentBox?.querySelector('.text-caption') as HTMLElement;

    const resultLossBox = document.getElementById('result-loss');
    const resultLossValue = resultLossBox?.querySelector('.text-title-lg') as HTMLElement;
    const resultLossNote = resultLossBox?.querySelector('.text-caption') as HTMLElement;

    const cableNotes = document.getElementById('cable-notes');
    const awgTableBody = document.getElementById('awg-table-body');

    const AWG_SIZES = [
      { awg: '18', areaMm2: 0.823, ampacityA: 10 },
      { awg: '16', areaMm2: 1.31, ampacityA: 15 },
      { awg: '14', areaMm2: 2.08, ampacityA: 20 },
      { awg: '12', areaMm2: 3.31, ampacityA: 25 },
      { awg: '10', areaMm2: 5.26, ampacityA: 35 },
      { awg: '8', areaMm2: 8.37, ampacityA: 50 },
      { awg: '6', areaMm2: 13.3, ampacityA: 65 },
      { awg: '4', areaMm2: 21.15, ampacityA: 85 },
      { awg: '2', areaMm2: 33.6, ampacityA: 115 },
      { awg: '1/0', areaMm2: 53.5, ampacityA: 150 },
      { awg: '2/0', areaMm2: 67.4, ampacityA: 175 },
      { awg: '4/0', areaMm2: 107.0, ampacityA: 230 },
    ];

    const COPPER_RESISTIVITY = 1.72e-8;
    const ALUMINUM_RESISTIVITY = 2.82e-8;
    const TEMP_COEF = 0.00393;

    function calculateCableMetrics(
      voltage: number, power: number, distance: number,
      material: string, temperature: number, areaMm2: number
    ): { dropPct: number; dropV: number; current: number; lossW: number } {
      const current = power / voltage;
      const rho20 = material === 'copper' ? COPPER_RESISTIVITY : ALUMINUM_RESISTIVITY;
      const rhoT = rho20 * (1 + TEMP_COEF * (temperature - 20));
      const loopLength = 2 * distance;
      const areaM2 = areaMm2 * 1e-6;
      const loopR = rhoT * loopLength / areaM2;
      const dropV = current * loopR;
      const dropPct = (dropV / voltage) * 100;
      const lossW = current * current * loopR;
      return { dropPct, dropV, current, lossW };
    }

    function getRecommendedAWG(
      voltage: number, power: number, distance: number,
      material: string, temperature: number, maxDropPct: number
    ): { awg: string; areaMm2: number; dropPct: number; meetsAmpacity: boolean } {
      const current = power / voltage;
      const rho20 = material === 'copper' ? COPPER_RESISTIVITY : ALUMINUM_RESISTIVITY;
      const rhoT = rho20 * (1 + TEMP_COEF * (temperature - 20));
      const loopLength = 2 * distance;

      // Min area for voltage drop
      const rMax = (voltage * maxDropPct / 100) / current;
      const minAreaForDrop = rhoT * loopLength / rMax;

      // Min area for ampacity
      let minAreaForAmpacity = 0;
      for (const awg of AWG_SIZES) {
        if (awg.ampacityA >= current) {
          minAreaForAmpacity = awg.areaMm2;
          break;
        }
      }
      if (minAreaForAmpacity === 0) minAreaForAmpacity = AWG_SIZES[AWG_SIZES.length - 1].areaMm2;

      const minArea = Math.max(minAreaForDrop, minAreaForAmpacity);

      // Find smallest AWG that meets both criteria
      let best = AWG_SIZES[AWG_SIZES.length - 1];
      for (const awg of AWG_SIZES) {
        if (awg.areaMm2 >= minArea) {
          best = awg;
          break;
        }
      }

      const metrics = calculateCableMetrics(voltage, power, distance, material, temperature, best.areaMm2);
      return { awg: best.awg, areaMm2: best.areaMm2, dropPct: metrics.dropPct, meetsAmpacity: best.ampacityA >= current };
    }

    function updateCalculations() {
      const voltage = parseFloat(voltageInput.value) || 12.8;
      const power = parseFloat(powerInput.value) || 500;
      const distance = parseFloat(distanceInput.value) || 5;
      const material = materialSelect.value;
      const temperature = parseFloat(temperatureInput.value) || 30;
      const maxDrop = parseFloat(maxDropInput.value) || 3;

      const rec = getRecommendedAWG(voltage, power, distance, material, temperature, maxDrop);
      const metrics = calculateCableMetrics(voltage, power, distance, material, temperature, rec.areaMm2);
      const current = power / voltage;

      // Render cable
      if (resultCableValue) resultCableValue.textContent = `${rec.awg} AWG`;
      if (resultCableNote) resultCableNote.textContent = `${rec.areaMm2} mm² ${material}`;

      // Render drop
      if (resultDropValue) resultDropValue.textContent = `${metrics.dropPct.toFixed(2)}%`;
      if (resultDropNote) resultDropNote.textContent = `${metrics.dropV.toFixed(3)}V along loop`;

      // Render current
      if (resultCurrentValue) resultCurrentValue.textContent = `${current.toFixed(1)} A`;
      if (resultCurrentNote) resultCurrentNote.textContent = 'Continuous draw';

      // Render loss
      if (resultLossValue) resultLossValue.textContent = `${metrics.lossW.toFixed(1)} W`;
      if (resultLossNote) resultLossNote.textContent = `${metrics.dropPct.toFixed(1)}% of load power`;

      // Render notes
      if (cableNotes) {
        if (current > 100) {
          cableNotes.textContent = `High-current 12V system. Consider upgrading to 48V to reduce current and cable requirements. At ${current.toFixed(0)}A, cable thickness is substantial.`;
        } else if (metrics.dropPct > maxDrop) {
          cableNotes.textContent = `Warning: No standard AWG size meets the ${maxDrop}% drop limit at this distance. Consider shorter cable runs, higher system voltage, or accepting higher drop.`;
        } else if (!rec.meetsAmpacity) {
          cableNotes.textContent = `The cable meets voltage drop limits but may not meet ampacity requirements at ${current.toFixed(0)}A continuous. Verify ampacity for your installation.`;
        } else {
          cableNotes.textContent = `At ${voltage}V with ${current.toFixed(0)}A load current, ${rec.awg} AWG copper meets both the ${maxDrop}% voltage drop limit and ampacity requirements.`;
        }
      }

      // Render AWG table
      if (awgTableBody) {
        awgTableBody.innerHTML = '';
        for (const awg of AWG_SIZES) {
          const m = calculateCableMetrics(voltage, power, distance, material, temperature, awg.areaMm2);
          const meetsDrop = m.dropPct <= maxDrop;
          const meetsAmp = awg.ampacityA >= current;
          const isRecommended = awg.awg === rec.awg;

          const row = document.createElement('tr');
          row.className = `border-b border-hairline ${isRecommended ? 'bg-surface-elevated' : ''}`;
          row.innerHTML = `
            <td class="p-3 text-body-sm text-primary font-mono">${isRecommended ? '→ ' : ''}${awg.awg} AWG</td>
            <td class="p-3 text-body-sm text-muted">${awg.areaMm2}</td>
            <td class="p-3 text-body-sm text-muted">${awg.ampacityA}</td>
            <td class="p-3 text-body-sm ${meetsDrop ? 'text-success' : 'text-red-500'}">${m.dropPct.toFixed(2)}%</td>
            <td class="p-3 text-body-sm text-muted">${m.lossW.toFixed(1)} W</td>
            <td class="p-3 text-body-sm ${meetsDrop && meetsAmp ? 'text-success' : 'text-red-500'}">${meetsDrop && meetsAmp ? '✓ OK' : meetsDrop ? 'Ampacity low' : 'Drop too high'}</td>
          `;
          awgTableBody.appendChild(row);
        }
      }

      // Update drop box border color
      if (resultDropBox) {
        resultDropBox.className = "bg-surface-soft p-6 border col-span-1 md:col-span-2 " +
          (metrics.dropPct > 10 ? "border-red-600" :
           metrics.dropPct > maxDrop ? "border-yellow-500" : "border-hairline");
      }
    }

    [voltageInput, powerInput, distanceInput, materialSelect, temperatureInput, maxDropInput].forEach(el => {
      el.addEventListener('input', updateCalculations);
    });

    updateCalculations();
  </script>
</CalculatorLayout>
