# Utility and error URLs are reachable for users, but they are not search documents.
# The worker also returns 404/500 for the error URLs; this header covers asset responses.
/404
  X-Robots-Tag: noindex, nofollow
/404/*
  X-Robots-Tag: noindex, nofollow
/500
  X-Robots-Tag: noindex, nofollow
/500/*
  X-Robots-Tag: noindex, nofollow
